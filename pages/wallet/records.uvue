<template>
	<view class="account-page account-secondary">
		<view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav vapor-account-secondary--account-nav"><button class="account-back vapor-account-secondary--account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">{{ recordType == 'RECHARGE' ? '充值记录' : (recordType == 'PAY' ? '消费记录' : '余额明细') }}</text></view>
		<view class="record-tabs vapor-account-secondary--record-tabs"><button class="record-tab vapor-account-secondary--record-tab" :class="recordType == '' ? 'record-tab-on vapor-account-secondary--record-tab-on' : ''" :disabled="loading" @click="selectType('')"><text :class="(recordType == '' ? 'vapor-account-secondary--record-tab-on--record-tab-text' : '')" class="record-tab-text vapor-account-secondary--record-tab-text">全部</text></button><button class="record-tab vapor-account-secondary--record-tab" :class="recordType == 'RECHARGE' ? 'record-tab-on vapor-account-secondary--record-tab-on' : ''" :disabled="loading" @click="selectType('RECHARGE')"><text :class="(recordType == 'RECHARGE' ? 'vapor-account-secondary--record-tab-on--record-tab-text' : '')" class="record-tab-text vapor-account-secondary--record-tab-text">充值</text></button><button class="record-tab vapor-account-secondary--record-tab" :class="recordType == 'PAY' ? 'record-tab-on vapor-account-secondary--record-tab-on' : ''" :disabled="loading" @click="selectType('PAY')"><text :class="(recordType == 'PAY' ? 'vapor-account-secondary--record-tab-on--record-tab-text' : '')" class="record-tab-text vapor-account-secondary--record-tab-text">消费</text></button></view>
		<scroll-view class="account-scroll" scroll-y="true" @scrolltolower="loadMore" :refresher-enabled="refreshing || !loading" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
                <refresh-header slot="refresher" :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
<view class="account-content vapor-account-secondary--account-content">
            <view class="account-banner">
                <view class="banner-copy">
                    <text class="banner-kicker">我的账单</text>
                    <text class="banner-title">每一笔，都有记录</text>
                    <text class="banner-note">充值、消费与退款，按时间清晰呈现。</text>
                </view>
                <view class="banner-symbol symbol-ledger" aria-hidden="true"><view class="symbol-part-one vapor-symbol-ledger--symbol-part-one"></view><view class="symbol-part-two vapor-symbol-ledger--symbol-part-two"></view><view class="symbol-part-three vapor-symbol-ledger--symbol-part-three"></view></view>
            </view>
			<text class="records-intro">仅展示已入账的余额变动，最新记录在前</text>
			<view v-for="item in records" :key="item.recordId" class="record-card vapor-account-secondary--record-card">
				<view class="record-main"><view class="record-type-mark" :class="item.changeType == 'PAY' ? 'record-mark-pay' : ''"><text :class="(item.changeType == 'PAY' ? 'vapor-record-mark-pay--record-mark-text' : '')" class="record-mark-text">{{ item.changeType == 'PAY' ? '支' : (item.changeType == 'REFUND' ? '退' : '充') }}</text></view><text class="record-name">{{ item.title }}</text><text class="record-amount" :class="item.changeType == 'PAY' ? 'record-expense' : 'record-income'">{{ item.changeType == 'PAY' ? '−' : '+' }}¥{{ item.amountText }}</text></view>
				<text class="record-date">{{ item.createdAt }}</text>
				<text class="record-description">{{ item.remark }}</text>
				<view class="record-bottom"><text class="record-reference vapor-account-secondary--record-reference">{{ item.bizRef }}</text><text class="record-after">余额 ¥{{ item.balanceText }}</text></view>
			</view>
			<view v-if="!loading && records.length == 0 && errorText.length == 0" class="account-card vapor-account-secondary--account-card"><text class="account-heading">{{ recordType == 'RECHARGE' ? '还没有充值记录' : (recordType == 'PAY' ? '还没有消费记录' : '还没有余额变动') }}</text><text class="account-note">{{ recordType == 'PAY' ? '使用余额支付后，会在这里显示消费记录。' : '充值到账后，会在这里留下记录。' }}</text></view>
			<text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>

			<text v-if="loading || hasMore" class="records-end">{{ loading ? '正在加载…' : '上滑加载更多' }}</text>
			<text v-if="!loading && !hasMore && records.length > 0 && errorText.length == 0" class="records-end">已显示全部记录</text>
		</view></scroll-view>
	</view>
</template>

<script setup lang="uts">
import { reactive, toRefs } from 'vue'
import { onLoad, onShow } from '@dcloudio/uni-app'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue';
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts';
import { fetchBalanceRecords, walletPayload } from '../../api/wallet.uts';
import { HttpResult } from '../../common/http.uts';
import { jsonArray, jsonString, jsonNumber, jsonBoolean } from '../../common/json.uts';
import { isLoggedIn, currentUser } from '../../store/auth.uts';
import { accountDate, backToAccount } from '../../common/account.uts';
type WalletRecord = {
    recordId: number;
    changeType: string;
    title: string;
    amountText: string;
    balanceText: string;
    createdAt: string;
    remark: string;
    bizRef: string;
};

const initialRows: Array<WalletRecord> = [];
const state = reactive({ refreshing: false, currentRefreshTime: '', statusBarHeight: 0, recordType: '', records: initialRows, loading: false, errorText: '', nextCursor: 0, hasMore: false })

const { refreshing, currentRefreshTime, statusBarHeight, recordType, records, loading, errorText, nextCursor, hasMore } = toRefs(state)

function refreshPage() {
    if (state.refreshing || state.loading)
        return;
    state.refreshing = true;
    const refreshStartedAt = Date.now();
    state.currentRefreshTime = refreshTimeLabel(refreshStartedAt);
    loadRecords(true).then(() => {
        finishPullRefresh(refreshStartedAt, state.errorText.length == 0, (time: string) => {
            if (time.length > 0)
                state.currentRefreshTime = time;
            state.refreshing = false;
        });
    }).catch(() => {
        finishPullRefresh(refreshStartedAt, false, (_time: string) => { state.refreshing = false; });
    });
}

function goBack() {
    backToAccount();
}

function selectType(value: string) {
    if (state.loading || state.recordType == value)
        return;
    state.recordType = value;
    const rows: Array<WalletRecord> = [];
    state.records = rows;
    state.nextCursor = 0;
    state.hasMore = false;
    loadRecords(true);
}

function loadMore() {
    if (state.hasMore)
        loadRecords(false);
}

function loadRecords(reset: boolean): Promise<void> {
    if (state.loading)
        return Promise.resolve();
    state.loading = true;
    state.errorText = '';
    return fetchBalanceRecords(state.recordType, reset ? 0 : state.nextCursor).then((result: HttpResult) => {
        state.loading = false;
        const data = walletPayload(result);
        if (data == null) {
            state.errorText = result.message.length > 0 ? result.message : '记录获取失败';
            return;
        }
        const rawRows = jsonArray(data, 'items');
        if (rawRows == null) {
            state.errorText = '记录格式异常，请重试';
            return;
        }
        const converted: Array<WalletRecord> = [];
        for (let i = 0; i < rawRows.length; i++) {
            if (rawRows[i] == null || typeof rawRows[i] != 'object' || Array.isArray(rawRows[i])) {
                state.errorText = '记录格式异常，请重试';
                return;
            }
            const raw = rawRows[i] as UTSJSONObject;
            const type = jsonString(raw, 'changeType') ?? '';
            const id = jsonNumber(raw, 'recordId');
            const amount = jsonNumber(raw, 'amount');
            const after = jsonNumber(raw, 'balanceAfter');
            if (id == null || id <= 0 || amount == null || amount < 0 || after == null || after < 0 || (type != 'RECHARGE' && type != 'PAY' && type != 'REFUND')) {
                state.errorText = '记录格式异常，请重试';
                return;
            }
            const item: WalletRecord = {
                recordId: id, changeType: type,
                title: type == 'RECHARGE' ? '余额充值' : (type == 'PAY' ? '余额消费' : '余额退款'),
                amountText: amount.toFixed(2),
                balanceText: after.toFixed(2),
                createdAt: accountDate(jsonString(raw, 'createdAt') ?? ''),
                remark: type == 'RECHARGE' ? '余额充值' : (jsonString(raw, 'remark') ?? ''), bizRef: jsonString(raw, 'bizRef') ?? ''
            };
            converted.push(item);
        }
        const cursor = jsonNumber(data, 'nextCursor') ?? 0;
        const more = jsonBoolean(data, 'hasMore') ?? false;
        if (more && (cursor <= 0 || converted.length == 0)) {
            state.errorText = '分页信息异常，请重试';
            return;
        }
        if (reset)
            state.records = converted;
        else
            for (let i = 0; i < converted.length; i++)
                state.records.push(converted[i]);
        state.nextCursor = cursor;
        state.hasMore = more;
    });
}

onLoad((options: OnLoadOptions) => {
    if (options['type'] == 'RECHARGE')
        state.recordType = 'RECHARGE';
    if (options['type'] == 'PAY')
        state.recordType = 'PAY';
})

onShow(() => {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight;
    if (!isLoggedIn()) {
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    const user = currentUser();
    if (user == null || user.roleCode != 'CUSTOMER') {
        uni.switchTab({ url: '/pages/mine/mine' });
        return;
    }
    loadRecords(true);
})
</script>

<style>
	@import '../../styles/account.css';
	.record-tabs { flex-direction: row; padding: 8px 20px 12px 20px; background-color: #FFFFFF; }
	.record-tab { display: flex; flex: 1; height: 40px; margin: 0 6px 0 0; padding: 0; border-width: 0; border-radius: 10px; background-color: #F7F2EE; align-items: center; justify-content: center; }
	.record-tab-on { background-color: #FCE4D8; }
	.record-tab-text { font-size: 14px; color: #C2410C; }
	.records-intro { margin-bottom: 14px; font-size: 11px; line-height: 18px; color: #7A6C60; }
	.record-card { margin-bottom: 12px; padding: 18px; border-radius: 16px; background-color: #FFFFFF; }
	.record-main { flex-direction: row; align-items: center; justify-content: space-between; }
	.record-name { flex: 1; font-size: 15px; line-height: 24px; font-weight: bold; color: #211C18; }
	.record-amount { margin-left: 8px; font-size: 20px; line-height: 28px; font-weight: bold; }
	.record-income { color: #386341; }
	.record-expense { color: #211C18; }
	.record-date { margin-top: 6px; font-size: 11px; line-height: 18px; color: #7A6C60; }
	.record-description { margin-top: 4px; font-size: 12px; line-height: 18px; color: #7A6C60; }
	.record-bottom { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-style: solid; border-top-color: #F4EBE4; }
	.record-reference { font-size: 10px; line-height: 17px; color: #A2968B; }
	.record-after { margin-top: 4px; font-size: 12px; line-height: 18px; color: #7A6C60; }
	.records-end { padding: 12px; font-size: 12px; text-align: center; color: #A2968B; }

	/* #ifdef WEB */
	.account-page .record-tabs { flex-direction: row; }
	.account-page .record-main { flex-direction: row; }
	/* #endif */
</style>
