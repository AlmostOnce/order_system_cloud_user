<template>
    <view class="password-overlay">
        <view class="password-backdrop" @click="cancel"></view>
        <scroll-view class="password-viewport" direction="vertical" :style="'height:' + availableHeight + 'px'">
            <view class="password-placement" :style="'min-height:' + availableHeight + 'px'" @click="cancel">
                <view class="password-card" @click.stop>
                    <text class="password-title">{{ title }}</text>
                    <text class="password-amount">{{ amount }}</text>
                    <text class="password-label">支付密码</text>
                    <input class="password-input" v-model="password" type="text" :password="true" :focus="focused" :maxlength="20" :disabled="closing" :adjust-position="false" placeholder="请输入支付密码" aria-label="支付密码" confirm-type="done" @confirm="confirm" @keyboardheightchange="keyboardChanged" />
                    <button class="password-confirm button-text button-text-46" :disabled="closing" @click="confirm">确认</button>
                    <button class="password-cancel button-text button-text-44" :disabled="closing" @click="cancel">取消</button>
                </view>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import { reactive, toRefs, computed } from 'vue'
import { toast } from '../../common/feedback.uts'
import { paymentPasswordPrompt, finishPaymentPassword } from '../../common/payment-password.uts'
const state = reactive({ id: 0, title: '', amount: '', password: '', focused: false, closing: false, windowHeight: 0, keyboardHeight: 0 })
const { title, amount, password, focused, closing } = toRefs(state)
const availableHeight = computed((): number => Math.max(0, state.windowHeight - state.keyboardHeight))
function keyboardChanged(event: UniInputKeyboardHeightChangeEvent) { state.keyboardHeight = Math.max(0, event.detail.height) }
function close(value: string | null) {
    if (state.closing) return
    state.closing = true; state.password = ''; state.focused = false
    uni.closeDialogPage({
        success: () => { finishPaymentPassword(state.id, value) },
        fail: () => { state.closing = false; toast('窗口关闭失败，请重试') }
    })
}
function confirm() {
    if (state.closing) return
    if (state.password.length < 6 || state.password.length > 20) { toast('请输入6至20位支付密码'); return }
    close(state.password)
}
function cancel() { close(null) }
onLoad((options: OnLoadOptions) => {
    state.id = Number(options['id'] ?? '0')
    state.windowHeight = uni.getWindowInfo().windowHeight
    const prompt = paymentPasswordPrompt(state.id)
    if (prompt == null) { cancel(); return }
    state.title = prompt.title; state.amount = prompt.amount
})
onReady(() => { state.focused = true })
onPageHide(() => { state.password = ''; state.focused = false })
onUnload(() => { state.password = ''; state.focused = false; if (!state.closing) finishPaymentPassword(state.id, null) })
</script>
<style>
.password-overlay { flex: 1; }
.password-backdrop { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(33, 28, 24, 0.45); }
.password-viewport { position: absolute; top: 0; left: 0; right: 0; }
.password-placement { padding: 20px; justify-content: center; align-items: center; }
.password-card { width: 100%; max-width: 380px; padding: 22px; background-color: #FFFFFF; border-radius: 20px; }
.password-title { font-size: 18px; line-height: 26px; font-weight: bold; color: #211C18; text-align: center; }
.password-amount { margin-top: 8px; font-size: 30px; line-height: 40px; font-weight: bold; color: #C2410C; text-align: center; }
.password-label { margin-top: 14px; margin-bottom: 8px; font-size: 13px; line-height: 20px; color: #6B5F56; }
.password-input { height: 48px; padding: 0 12px; border-width: 1px; border-style: solid; border-color: #EADDD1; border-radius: 10px; background-color: #FCF9F6; font-size: 16px; color: #211C18; }
.password-confirm { height: 46px; line-height: 46px; margin: 18px 0 0 0; padding: 0; border-width: 0; border-radius: 12px; background-color: #E4572E; color: #FFFFFF; font-size: 16px; font-weight: bold; text-align: center; }
.password-cancel { height: 44px; line-height: 44px; margin: 4px 0 0 0; padding: 0; border-width: 0; background-color: transparent; color: #7A6C60; font-size: 14px; text-align: center; }
/* #ifdef WEB */
.password-overlay { height: 100%; }
.password-placement { display: flex; flex-direction: column; box-sizing: border-box; }
.password-card { display: flex; flex-direction: column; box-sizing: border-box; }
/* #endif */
</style>
