<template>
    <view class="account-page account-secondary">
        <view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav vapor-account-secondary--account-nav"><button class="account-back vapor-account-secondary--account-back" aria-label="返回" :disabled="submitting || imageBusy" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">{{ productId > 0 ? '评价菜品' : '评价店铺' }}</text></view>
        <scroll-view class="account-scroll" scroll-y="true" :refresher-enabled="!submitting && !imageBusy && !pending && !succeeded && (refreshing || !loading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" refresher-default-style="none" :refresher-threshold="72" @refresherrefresh="refreshPage">
            <refresh-header slot="refresher" :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            <view class="account-content vapor-account-secondary--account-content">
                <view class="review-intro"><text class="review-eyebrow">记录这次用餐</text><text class="review-title">{{ productName.length > 0 ? productName : '分享你的真实感受' }}</text><text class="review-subtitle">{{ productId > 0 ? '每笔已完成订单中的每道菜可评价一次' : '每笔已完成订单可评价店铺一次' }}</text></view>
                <view v-if="succeeded" class="account-success"><text class="account-success-text">评价已发布</text><text class="account-note">谢谢分享，其他同学可以看到你的用餐评价。</text><button class="account-primary vapor-account-secondary--account-primary" @click="openMine"><text class="account-primary-text">查看我的评价</text></button></view>
                <view v-if="eligible && !succeeded" class="account-card vapor-account-secondary--account-card">
                    <text class="account-heading">这道菜怎么样？</text>
                    <view class="review-stars"><button v-for="value in scores" :key="value" class="review-star-button" :aria-label="value + '星'" :disabled="pending || submitting" @click="setScore(value)"><image class="review-star" :src="score >= value ? '/static/review/star-filled.svg' : '/static/review/star-outline.svg'"></image></button></view>
                    <text class="review-score-hint">{{ score == 0 ? '请选择评分' : score + ' 星 · ' + scoreLabels[score - 1] }}</text>
                    <text class="account-label">用餐感受</text>
                    <textarea class="review-textarea" v-model="content" :maxlength="1000" :disabled="pending || submitting" placeholder="聊聊味道、分量，或你希望改进的地方" aria-label="评价内容"></textarea>
                    <text class="review-counter">{{ content.length }} / 1000</text>
                    <text class="account-label">印象标签（选填）</text>
                    <view class="review-tags"><button v-for="tag in tagOptions" :key="tag" class="review-tag-button" :class="tags.indexOf(tag) >= 0 ? 'review-tag-selected' : ''" :disabled="pending || submitting" @click="toggleTag(tag)"><text class="review-tag-label" :class="tags.indexOf(tag) >= 0 ? 'review-tag-label-selected' : ''">{{ tag }}</text></button></view>
                    <view class="review-section-row"><text class="account-label">用餐照片（选填）</text><text class="account-muted">{{ photos.length }} / 6</text></view>
                    <view class="review-photos"><view v-for="(photo, index) in photos" :key="photo.fileKey" class="review-photo-cell"><image class="review-photo" :src="photoSource(photo.url)" mode="aspectFill" @click="previewPhoto(index)"></image><button v-if="!pending && !submitting" class="review-photo-remove" :disabled="imageBusy" :aria-label="'移除第' + (index + 1) + '张照片'" @click="removePhoto(index)"><text class="review-remove-label">移除</text></button></view><button v-if="photos.length < 6 && !pending" class="review-add-photo" :disabled="imageBusy || submitting" @click="addPhoto"><text class="review-add-mark">＋</text><text class="account-muted">{{ imageBusy ? '正在处理…' : '添加照片' }}</text></button></view>
                    <text v-if="pending" class="review-pending">上次提交结果待确认，内容已保留。请重试确认，不会重复发布。</text>
                    <button class="account-primary vapor-account-secondary--account-primary" :class="submitting || imageBusy || loading ? 'account-disabled' : ''" :disabled="submitting || imageBusy || loading" @click="submit"><text class="account-primary-text">{{ submitting ? '正在发布…' : (pending ? '重试确认评价' : '发布评价') }}</text></button>
                    <text class="account-note">评价将展示你的昵称，请勿填写个人联系方式。</text>
                </view>
                <text v-if="loading" class="account-note">正在确认订单信息…</text>
                <text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
                <button v-if="!succeeded" class="account-link" :disabled="submitting || imageBusy" @click="openMine"><text class="account-link-text">查看我的评价</text></button>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import { reactive, toRefs } from 'vue'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue'
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
import { currentUser } from '../../store/auth.uts'
import { backToAccount } from '../../common/account.uts'
import { fetchOrder, orderPayload, parseOrder } from '../../api/order.uts'
import { commentPayload, createComment, createWindowReview, parseComment, strings } from '../../api/comments.uts'
import { commentPendingKey, newCommentKey, readPendingReview } from '../../common/comments.uts'
import { uploadImage } from '../../api/files.uts'
import { chooseLocalImage } from '../../common/image-picker.uts'
import { imageSource } from '../../common/images.uts'
import { jsonNumber, jsonString } from '../../common/json.uts'

type ReviewPhoto = { fileKey: string, url: string }
const initialPhotos: Array<ReviewPhoto> = []
const initialTags: Array<string> = []
const state = reactive({ statusBarHeight: 0, orderId: 0, productId: 0, userUuid: '', productName: '', loading: false, eligible: false,
    refreshing: false, currentRefreshTime: '', score: 0, content: '', tags: initialTags, photos: initialPhotos,
    scores: [1, 2, 3, 4, 5], scoreLabels: ['不满意', '有待改进', '还不错', '很满意', '非常满意'],
    tagOptions: ['味道好', '分量足', '出餐快', '包装好', '值得推荐'], imageBusy: false, submitting: false, pending: false, succeeded: false, requestKey: '', errorText: '' })
const { statusBarHeight, productId, productName, loading, eligible, refreshing, currentRefreshTime, score, content, tags, photos, scores, scoreLabels, tagOptions, imageBusy, submitting, pending, succeeded, errorText } = toRefs(state)

function setScore(value: number) { if (!state.pending && !state.submitting) state.score = value }
function toggleTag(value: string) {
    if (state.pending || state.submitting) return
    const index = state.tags.indexOf(value)
    if (index >= 0) state.tags.splice(index, 1)
    else if (state.tags.length < 5) state.tags.push(value)
}
function photoSource(url: string): string { return imageSource(url, 'product') }
function previewPhoto(index: number) {
    const urls: Array<string> = []
    for (let i = 0; i < state.photos.length; i++) urls.push(photoSource(state.photos[i].url))
    if (index >= 0 && index < urls.length) uni.previewImage({ current: urls[index], urls: urls })
}
function removePhoto(index: number) { if (!state.pending && !state.submitting && !state.imageBusy) state.photos.splice(index, 1) }
async function addPhoto(): Promise<void> {
    if (state.pending || state.submitting || state.imageBusy || state.photos.length >= 6) return
    state.imageBusy = true
    state.errorText = ''
    try {
        const choice = await chooseLocalImage()
        if (choice.error.length > 0) { state.errorText = choice.error; return }
        if (choice.path.length == 0) return
        const result = await uploadImage(choice.path, 'COMMENT_IMAGE', 0)
        const data = commentPayload(result)
        const key = data == null ? '' : (jsonString(data, 'fileKey') ?? '')
        if (!result.ok || !/^[a-f0-9]{32}$/.test(key)) { state.errorText = result.message.length > 0 ? result.message : '照片上传结果异常'; return }
        state.photos.push({ fileKey: key, url: '/api/files/' + key + '/content' })
    } finally { state.imageBusy = false }
}
async function loadOrder(): Promise<void> {
    if (state.loading || state.submitting || state.succeeded) return
    state.eligible = false
    if (!Number.isInteger(state.orderId) || state.orderId <= 0 || !Number.isInteger(state.productId) || state.productId < 0) { state.errorText = '评价入口无效，请从已完成订单进入'; return }
    state.loading = true
    state.errorText = ''
    try {
        const result = await fetchOrder(state.orderId)
        const raw = orderPayload(result)
        const order = raw == null ? null : parseOrder(raw)
        if (order == null) { state.errorText = result.message.length > 0 ? result.message : '订单信息暂不可用'; return }
        if (order.status != '已完成') { state.errorText = '完成取餐后才可以评价'; return }
        if (state.productId == 0) { state.productName = '评价本次店铺体验'; state.eligible = true; return }
        for (let i = 0; i < order.items.length; i++) {
            if (order.items[i].productId == state.productId) { state.productName = order.items[i].productName; state.eligible = true; return }
        }
        state.errorText = '这笔订单中没有这道菜'
    } finally { state.loading = false }
}
function restorePending() {
    const draft = readPendingReview(commentPendingKey(state.userUuid, state.orderId, state.productId), state.orderId, state.productId)
    if (draft == null) return
    state.requestKey = draft.key
    state.pending = true
    state.score = jsonNumber(draft.body, 'score') ?? 0
    state.content = jsonString(draft.body, 'content') ?? ''
    state.tags = strings(draft.body, 'tags') ?? []
    const keys = strings(draft.body, 'imageFileKeys') ?? []
    state.photos = []
    for (let i = 0; i < keys.length; i++) state.photos.push({ fileKey: keys[i], url: '/api/files/' + keys[i] + '/content' })
}
async function submit(): Promise<void> {
    if (state.loading || state.submitting || state.imageBusy || !state.eligible || state.succeeded) return
    state.errorText = ''
    if (state.score < 1 || state.score > 5 || state.content.trim().length == 0) { state.errorText = '请选择评分，并填写用餐感受'; return }
    const storageKey = commentPendingKey(state.userUuid, state.orderId, state.productId)
    let body: UTSJSONObject
    if (state.pending) {
        const draft = readPendingReview(storageKey, state.orderId, state.productId)
        if (draft == null) { state.errorText = '待确认评价读取失败，请保留此页面稍后重试'; return }
        body = draft.body
        state.requestKey = draft.key
    } else {
        const keys: Array<string> = []
        for (let i = 0; i < state.photos.length; i++) keys.push(state.photos[i].fileKey)
        body = state.productId > 0
            ? { orderId: state.orderId, productId: state.productId, score: state.score, content: state.content.trim(), imageFileKeys: keys, tags: state.tags.slice() }
            : { orderId: state.orderId, score: state.score, content: state.content.trim(), imageFileKeys: keys, tags: state.tags.slice() }
        state.requestKey = newCommentKey()
        try { uni.setStorageSync(storageKey, JSON.stringify({ key: state.requestKey, body: body })) }
        catch (error) { state.errorText = '无法保存提交记录，请检查设备存储空间后重试'; return }
        state.pending = true
    }
    state.submitting = true
    try {
        const result = state.productId > 0 ? await createComment(body, state.requestKey) : await createWindowReview(body, state.requestKey)
        const raw = commentPayload(result)
        const saved = raw == null || state.productId == 0 ? null : parseComment(raw)
        const savedWindowId = raw == null ? 0 : (jsonNumber(raw, 'windowId') ?? 0)
        const savedReviewId = raw == null ? '' : (jsonString(raw, 'reviewId') ?? '')
        if (result.ok && ((saved != null && saved.productId == state.productId) || (state.productId == 0 && savedWindowId > 0 && savedReviewId.length > 0))) {
            uni.removeStorageSync(storageKey)
            state.pending = false
            state.succeeded = true
            return
        }
        // 明确业务拒绝允许修改；超时、限流与服务异常仍保留原始请求确认结果。
        if (result.statusCode == 400 || result.statusCode == 403 || result.statusCode == 404 || result.statusCode == 409 || result.statusCode == 422) {
            uni.removeStorageSync(storageKey)
            state.pending = false
        }
        state.errorText = result.message.length > 0 ? result.message : '评价结果暂未确认，请重试确认'
    } finally { state.submitting = false }
}
function refreshPage() {
    if (state.refreshing || state.loading || state.submitting || state.imageBusy || state.pending || state.succeeded) return
    state.refreshing = true
    const start = Date.now()
    state.currentRefreshTime = refreshTimeLabel(start)
    loadOrder().then(() => { finishPullRefresh(start, state.errorText.length == 0, (_time: string) => { state.refreshing = false }) })
}
function goBack() { if (!state.submitting && !state.imageBusy) backToAccount() }
function openMine() { if (!state.submitting && !state.imageBusy) uni.navigateTo({ url: '/pages/review/list' }) }
onLoad((options: OnLoadOptions) => { state.orderId = Number(options['orderId'] ?? '0'); state.productId = Number(options['productId'] ?? '0') })
onPageShow(() => {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight
    const user = currentUser()
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    if (user.roleCode != 'CUSTOMER') { uni.switchTab({ url: '/pages/home/home' }); return }
    state.userUuid = user.userUuid
    restorePending()
    loadOrder()
})
</script>
<style>
@import '../../styles/account.css';
@import '../../styles/review.css';
</style>
