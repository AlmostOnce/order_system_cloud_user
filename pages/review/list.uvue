<template>
    <!-- 独立评价路由只负责解析参数；列表界面和查询习性全部复用 review-list，避免再维护一份评论页。 -->
    <review-list :embedProductId="productId" :embedWindowId="windowId" :embedProductName="productName" :embedError="embedError"></review-list>
</template>
<script setup lang="uts">
import { reactive, toRefs } from 'vue'
import ReviewList from '../../components/review-list/review-list.uvue'

/**
 * 评价列表独立页。
 *
 * 只解析路由里的店铺/菜品编号和名称，再交给共用列表。非法编号不发请求，把错误文案传给列表展示。
 * 「我的评价」仍要求学生身份，由共用列表在页面显示时校验；本页不重复做权限判断。
 */
const state = reactive({ productId: 0, windowId: 0, productName: '', embedError: '' })
const { productId, windowId, productName, embedError } = toRefs(state)
onLoad((options: OnLoadOptions) => {
    if (options['windowId'] != null) {
        state.windowId = Number(options['windowId'])
        if (!Number.isInteger(state.windowId) || state.windowId <= 0) { state.productId = -1; state.embedError = '店铺编号无效' }
    }
    if (options['productId'] != null) {
        state.productId = Number(options['productId'])
        if (!Number.isInteger(state.productId) || state.productId <= 0) { state.productId = -1; state.embedError = '菜品编号无效' }
    }
    const name = options['name'] ?? ''
    try { state.productName = decodeURIComponent(name) ?? '' }
    catch (error) { state.productName = '' }
})
</script>
