<template>
	<view class="account-page">
		<view class="mine-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <scroll-view class="account-scroll" direction="vertical" :refresher-enabled="!signingOut && (refreshing || (!profileLoading && !balanceLoading))" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
			<view class="mine-hero">
				<text class="mine-eyebrow">校园食堂 · 账户中心</text>
				<text class="mine-title">我的</text>
				<text class="mine-subtitle">用餐、账单与账号信息，都在这里</text>
			</view>
			<view class="mine-content">
                <view class="profile-card" @click="openProfile">
                    <view class="mine-avatar" @click.stop="openAvatarPreview">
						<business-image class="mine-avatar-image" :src="avatarUrl" kind="avatar"></business-image>
					</view>
					<view class="account-entry-body">
						<text class="profile-name">{{ username }}</text>
						<text class="profile-meta">{{ roleName }}</text>
						<text class="profile-note">{{ email.length > 0 ? email : '查看个人资料' }}</text>
					</view>
					<view class="account-arrow"></view>
                </view>
				<text v-if="profileError.length > 0" class="account-error">{{ profileError }}</text>
				<view v-if="roleCode == 'CUSTOMER'" class="order-center">
                    <view class="order-center-heading"><text class="account-heading">订单中心</text>
                        <view class="order-center-all" @click="openOrders">
                            <text class="order-center-all-text">全部订单</text><view class="account-arrow"></view>
                    </view>
                </view>
                    <view class="order-center-shortcuts">
                        <view class="order-center-shortcut" @click="openPendingOrders">
                            <view class="order-center-symbol"><view class="center-clock"></view><view class="center-clock-hand"></view></view><text class="order-center-label">待支付</text>
                        </view>
                        <view class="order-center-shortcut" @click="openActiveOrders">
                            <view class="order-center-symbol"><view class="center-receipt"></view><view class="center-receipt-line"></view><view class="center-receipt-line center-receipt-line-two"></view></view><text class="order-center-label">进行中</text>
                        </view>
                        <view class="order-center-shortcut" @click="openCompletedOrders">
                            <view class="order-center-symbol"><view class="center-clock"></view><view class="center-check"></view></view><text class="order-center-label">已完成</text>
                        </view>
                        <view class="order-center-shortcut" @click="openCancelledOrders">
                            <view class="order-center-symbol"><view class="center-clock"></view><view class="center-cross"></view><view class="center-cross center-cross-other"></view></view><text class="order-center-label">已取消</text>
                        </view>
                    </view>
                </view>
                <view v-if="roleCode == 'CUSTOMER'" class="entry-group">
                    <view class="account-entry" @click="openReviews">
                        <view class="account-entry-icon"><image class="review-entry-icon" src="/static/review/star-outline.svg"></image></view><view class="account-entry-body"><text class="account-entry-title">我的评价</text><text class="account-entry-note">回顾用餐感受，查看已发布评价</text></view><view class="account-arrow"></view>
                    </view>
                </view>
                <text v-if="roleCode == 'CUSTOMER'" class="account-section-label">我的钱包</text>
				<view v-if="roleCode == 'CUSTOMER'" class="entry-group">
                    <view class="account-entry" @click="openWallet">
                        <view class="account-entry-icon"><view class="wallet-icon-outline"></view><view class="wallet-icon-pocket"></view></view>
                        <view class="account-entry-body"><text class="account-entry-title">余额与充值</text><text class="account-entry-note">查看账户余额，进入钱包充值</text></view>
                        <view class="account-arrow"></view>
                    </view>
                    <view class="entry-divider"></view>
                    <view class="account-entry" @click="openRechargeRecords">
                        <view class="account-entry-icon"><view class="flow-stem"></view><view class="flow-tip"></view></view><view class="account-entry-body"><text class="account-entry-title">充值记录</text><text class="account-entry-note">查看每一笔到账与余额</text></view><view class="account-arrow"></view>
                    </view>
					<view class="entry-divider"></view>
                    <view class="account-entry" @click="openPayRecords">
                        <view class="account-entry-icon"><view class="flow-stem"></view><view class="flow-tip flow-tip-out"></view></view><view class="account-entry-body"><text class="account-entry-title">消费记录</text><text class="account-entry-note">查看余额支付支出</text></view><view class="account-arrow"></view>
				</view>
                </view>
				<text v-if="roleCode == 'STALL_MANAGER' || roleCode == 'RESTAURANT_MANAGER'" class="account-section-label">窗口管理</text>
                <view v-if="roleCode == 'STALL_MANAGER' || roleCode == 'RESTAURANT_MANAGER'" class="entry-group">
                    <view class="account-entry" @click="openPickupVerification">
                        <view class="account-entry-icon"><view class="center-receipt"></view></view><view class="account-entry-body"><text class="account-entry-title">取餐核销</text><text class="account-entry-note">输入顾客取餐码，确认餐品交付</text></view><view class="account-arrow"></view>
                    </view>
                    <view class="entry-divider"></view>
                    <view class="account-entry" @click="openImageManagement">
                        <view class="account-entry-icon"><view class="account-icon-line"></view><view class="account-icon-line"></view></view><view class="account-entry-body"><text class="account-entry-title">窗口与菜品图片</text><text class="account-entry-note">上传封面，维护菜品展示图片</text></view><view class="account-arrow"></view>
                    </view>
                </view>
                <text v-if="roleCode == 'CUSTOMER'" class="account-section-label">账号与安全</text>
				<view v-if="roleCode == 'CUSTOMER'" class="entry-group">
                    <view v-if="roleCode == 'CUSTOMER'" class="account-entry" @click="openPayPassword">
                        <view class="account-entry-icon"><view class="lock-hoop"></view><view class="lock-body"></view></view><view class="account-entry-body"><text class="account-entry-title">支付密码</text><text class="account-entry-note">{{ payPasswordSet ? '修改独立支付密码' : '设置后可充值和使用余额' }}</text></view><view class="account-arrow"></view>
				</view>
                </view>
                <view class="signout-button" hover-class="signout-button-pressed" @click="confirmSignOut">
                    <view class="signout-icon"><view class="signout-door"></view><view class="signout-shaft"></view><view class="signout-tip"></view></view><text class="signout-label">退出登录</text>
                </view>
				<text class="mine-footer">湖北经济学院 · 食堂管理中心</text>
            </view>
            <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
			</view>
		</scroll-view>
        <confirm-dialog v-if="signOutConfirm" title="退出登录？" message="退出后需要重新登录才能查看账户。" cancel-text="继续使用" confirm-text="确认退出" :busy="signingOut" busy-text="退出中…" @cancel="cancelSignOut" @confirm="signOut" />
	</view>
</template>

<script setup lang="uts">
import ConfirmDialog from '../../components/confirm-dialog/confirm-dialog.uvue';
import { reactive, toRefs } from 'vue'
import { saveImageToAlbum } from '../../common/save-image.uts';
import { imageSource } from '../../common/images.uts';
import BusinessImage from '../../components/business-image/business-image.uvue';
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue';
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts';
import { logout as doLogout, isLoggedIn, currentUser } from '../../store/auth.uts';
import { fetchMyProfile, fetchMyBalance, walletPayload } from '../../api/wallet.uts';
import { HttpResult } from '../../common/http.uts';
import { jsonString, jsonNumber, jsonBoolean } from '../../common/json.uts';
import { accountRoleLabel } from '../../common/account.uts';
import { openOrderList } from '../../common/order-navigation.uts';
import { startNotificationSession, refreshNotificationCount } from '../../store/notifications.uts';

const state = reactive({ refreshing: false, currentRefreshTime: '', profileLoading: false, statusBarHeight: 0, username: '校园用户', roleName: '', roleCode: '', userUuid: '',
    email: '', avatarUrl: '', profileError: '', balanceLoading: false, balanceReady: false,
    balanceText: '--', balanceError: '', payPasswordSet: false, signOutConfirm: false, signingOut: false })

const { refreshing, currentRefreshTime, profileLoading, statusBarHeight, username, roleName, roleCode, userUuid, email, avatarUrl, profileError, balanceLoading, balanceReady, balanceText, balanceError, payPasswordSet, signOutConfirm, signingOut } = toRefs(state)

function refreshPage() {
    if (state.refreshing || state.profileLoading || state.balanceLoading || state.signingOut)
        return;
    state.refreshing = true;
    const refreshStartedAt = Date.now();
    state.currentRefreshTime = refreshTimeLabel(refreshStartedAt);
    const tasks: Array<Promise<void>> = [loadProfile()];
    if (state.roleCode == 'CUSTOMER')
        tasks.push(loadBalance());
    if (state.roleCode == 'CUSTOMER') tasks.push(loadUnreadCount());
    Promise.all(tasks).then(() => {
        finishPullRefresh(refreshStartedAt, state.profileError.length == 0 && (state.roleCode != 'CUSTOMER' || state.balanceError.length == 0), (time: string) => {
            if (time.length > 0)
                state.currentRefreshTime = time;
            state.refreshing = false;
        });
    }).catch(() => {
        finishPullRefresh(refreshStartedAt, false, (_time: string) => { state.refreshing = false; });
    });
}

function loadProfile(): Promise<void> {
    state.profileError = '';
    state.profileLoading = true;
    return fetchMyProfile().then((result: HttpResult) => {
        state.profileLoading = false;
        const data = walletPayload(result);
        if (data == null) {
            state.profileError = result.message.length > 0 ? result.message : '资料暂时无法获取，可进入个人资料重试';
            return;
        }
        state.username = jsonString(data, 'username') ?? state.username;
        state.email = jsonString(data, 'email') ?? '';
        state.avatarUrl = jsonString(data, 'avatarUrl') ?? '';
    });
}

function loadBalance(): Promise<void> {
    if (state.balanceLoading)
        return Promise.resolve();
    state.balanceLoading = true;
    state.balanceReady = false;
    state.balanceError = '';
    return fetchMyBalance().then((result: HttpResult) => {
        state.balanceLoading = false;
        const data = walletPayload(result);
        if (data == null || jsonNumber(data, 'balance') == null) {
            state.balanceError = result.message.length > 0 ? result.message : '余额暂时无法获取';
            return;
        }
        state.balanceText = (jsonNumber(data, 'balance') ?? 0).toFixed(2);
        state.payPasswordSet = jsonBoolean(data, 'payPasswordSet') ?? false;
        state.balanceReady = true;
    });
}

function openReviews() { uni.navigateTo({ url: '/pages/review/list' }); }
function loadUnreadCount(): Promise<void> {
    startNotificationSession();
    return refreshNotificationCount();
}

function openOrders() {
    openOrderList('all');
}

function openPendingOrders() {
    openOrderList('pending');
}

function openActiveOrders() {
    openOrderList('active');
}

function openCompletedOrders() {
    openOrderList('completed');
}

function openCancelledOrders() {
    openOrderList('cancelled');
}

function openPickupVerification() { uni.navigateTo({ url: '/pages/manage/pickup' }); }

function openImageManagement() {
    uni.navigateTo({ url: '/pages/manage/images' });
}

function openAvatarPreview() {
    if (state.profileLoading || state.signingOut) return;
    const source = imageSource(state.avatarUrl, 'avatar');
    uni.previewImage({
        current: 0, urls: [source],
        longPressActions: {
            itemList: ['保存图片', '更换头像'],
            success: (result: LongPressActionsSuccessResult) => {
                if (result.tapIndex == 0) { saveImageToAlbum(source); return; }
                if (result.tapIndex != 1) return;
                uni.closePreviewImage({ success: () => {
                    uni.navigateTo({ url: '/pages/account/profile?avatar=change' });
                } });
            }
        }
    });
}

function openProfile() {
    uni.navigateTo({ url: '/pages/account/profile' });
}

function openWallet() {
    uni.navigateTo({ url: '/pages/wallet/recharge' });
}

function openAllRecords() {
    uni.navigateTo({ url: '/pages/wallet/records' });
}

function openRechargeRecords() {
    uni.navigateTo({ url: '/pages/wallet/records?type=RECHARGE' });
}

function openPayRecords() {
    uni.navigateTo({ url: '/pages/wallet/records?type=PAY' });
}

function openPayPassword() {
    uni.navigateTo({ url: '/pages/account/pay-password' });
}

function confirmSignOut() {
    state.signOutConfirm = true;
}

function cancelSignOut() {
    if (state.signingOut) return;
    state.signOutConfirm = false;
}

function signOut() {
    if (state.signingOut)
        return;
    state.signingOut = true;
    doLogout().catch(() => {}).finally(() => {
        state.signingOut = false;
        state.signOutConfirm = false;
        uni.reLaunch({ url: '/pages/login/login' });
    });
}

onPageShow(() => {
    startNotificationSession()
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight;
    if (!isLoggedIn()) {
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    const user = currentUser();
    if (user == null) {
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    state.username = user.username.length > 0 ? user.username : '校园用户';
    state.userUuid = user.userUuid;
    state.roleCode = user.roleCode;
    state.roleName = accountRoleLabel(user.roleCode);
    loadProfile();
    if (state.roleCode == 'CUSTOMER')
        loadBalance();
    if (state.roleCode == 'CUSTOMER') loadUnreadCount();
})
</script>

<style>
@import '../../styles/review.css';
	@import '../../styles/account.css';
	.mine-status { background-color: #E4572E; }
	.mine-hero { background-color: #E4572E; padding: 12px 20px 14px 20px; }
	.mine-eyebrow { font-size: 12px; line-height: 18px; color: #FFE3D6; }
	.mine-title { margin-top: 4px; font-size: 24px; line-height: 32px; font-weight: bold; color: #FFFFFF; }
	.mine-subtitle { margin-top: 4px; font-size: 12px; line-height: 18px; color: #FFE3D6; }
	.mine-content { padding: 12px 16px 20px 16px; }
	.profile-card { display: flex; width: 100%; text-align: left; line-height: 22px; flex-direction: row; align-items: center; margin: 0 0 12px 0; padding: 14px 12px; border-width: 0; border-radius: 18px; background-color: #FFFFFF; }
	.mine-avatar { flex-shrink: 0; width: 52px; height: 52px; border-radius: 18px; background-color: #FDF0E8; align-items: center; justify-content: center; overflow: hidden; }
	.mine-avatar-image { width: 52px; height: 52px; }
	.mine-avatar-text { font-size: 23px; font-weight: bold; color: #C2410C; }
	.profile-name { font-size: 17px; line-height: 24px; font-weight: bold; color: #211C18; }
	.profile-meta { margin-top: 3px; font-size: 11px; line-height: 18px; color: #7A6C60; }
	.profile-note { margin-top: 4px; font-size: 12px; line-height: 18px; color: #C2410C; }
	.entry-group { margin-bottom: 14px; border-radius: 16px; overflow: hidden; }
	.entry-divider { height: 1px; margin-left: 60px; margin-right: 16px; background-color: #F4EBE4; }
	.flow-stem { position: absolute; left: 15px; top: 8px; width: 2px; height: 15px; background-color: #C2410C; }
	.flow-tip { position: absolute; left: 12px; top: 15px; width: 6px; height: 6px; border-right-width: 2px; border-right-style: solid; border-right-color: #C2410C; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #C2410C; transform: rotate(45deg); }
	.flow-tip-out { top: 9px; transform: rotate(225deg); }
	.lock-hoop { position: absolute; top: 6px; left: 11px; width: 10px; height: 10px; border-radius: 5px; border-width: 2px; border-style: solid; border-color: #C2410C; }
	.lock-body { position: absolute; top: 14px; left: 8px; width: 16px; height: 12px; border-radius: 3px; background-color: #C2410C; }
	.signout-button { display: flex; flex-direction: row; width: 100%; min-height: 48px; margin: 4px 0 0 0; padding: 10px 16px; border-width: 1px; border-style: solid; border-color: #E8DCD2; border-radius: 16px; background-color: #FFFFFF; align-items: center; justify-content: center; }
	.signout-button-pressed { background-color: #FDF0E8; border-color: #C2410C; }
	.signout-label { margin-left: 10px; font-size: 15px; line-height: 22px; font-weight: 500; color: #7A6C60; }
	.signout-icon { position: relative; flex-shrink: 0; width: 20px; height: 20px; }
	.signout-door { position: absolute; left: 2px; top: 3px; width: 9px; height: 14px; border-width: 2px; border-style: solid; border-color: #7A6C60; border-right-width: 0; border-radius: 2px; }
	.signout-shaft { position: absolute; left: 8px; top: 9px; width: 10px; height: 2px; background-color: #7A6C60; }
	.signout-tip { position: absolute; left: 13px; top: 6px; width: 7px; height: 7px; border-top-width: 2px; border-top-style: solid; border-top-color: #7A6C60; border-right-width: 2px; border-right-style: solid; border-right-color: #7A6C60; transform: rotate(45deg); }
	.mine-footer { margin-top: 14px; font-size: 11px; line-height: 18px; text-align: center; color: #A2968B; }

	/* #ifdef WEB */
	.account-page .signout-button { flex-direction: row; cursor: pointer;  min-height: 48px;  padding: 10px 16px; }
	.signout-button:focus-visible { outline: 2px solid #C2410C; outline-offset: 3px; }
	.account-page .profile-card { flex-direction: row;  padding: 14px 12px;  margin: 0 0 12px 0; }
	/* #endif */

    .wallet-icon-outline { position: absolute; left: 6px; top: 9px; width: 20px; height: 15px; border-width: 2px; border-style: solid; border-color: #C2410C; border-radius: 4px; }
    .wallet-icon-pocket { position: absolute; left: 19px; top: 14px; width: 7px; height: 5px; border-radius: 2px; background-color: #C2410C; }

    .order-center { margin-bottom: 14px; padding: 12px; border-radius: 18px; background-color: #FFFFFF; }
    .order-center-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
    .order-center-all { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; min-height: 44px; margin: 0; padding: 0 0 0 12px; border-width: 0; background-color: transparent; line-height: 20px; }
    .order-center-all-text { font-size: 12px; line-height: 20px; color: #7A6C60; }
    .order-center-shortcuts { display: flex; flex-direction: row; padding-top: 4px; }
    .order-center-shortcut { display: flex; flex-direction: column; flex: 1; min-width: 0; align-items: center; margin: 0; padding: 8px 0; border-width: 0; border-radius: 12px; background-color: transparent; line-height: 20px; }
    .order-center-symbol { position: relative; width: 44px; height: 44px; border-radius: 14px; background-color: #FDF0E8; }
    .order-center-label { margin-top: 6px; font-size: 12px; line-height: 20px; color: #211C18; }
    .center-clock { position: absolute; left: 11px; top: 11px; width: 22px; height: 22px; border-width: 2px; border-style: solid; border-color: #C2410C; border-radius: 11px; }
    .center-clock-hand { position: absolute; left: 21px; top: 16px; width: 6px; height: 8px; border-left-width: 2px; border-left-style: solid; border-left-color: #C2410C; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #C2410C; }
    .center-receipt { position: absolute; left: 13px; top: 9px; width: 18px; height: 26px; border-width: 2px; border-style: solid; border-color: #C2410C; border-radius: 4px; }
    .center-receipt-line { position: absolute; left: 18px; top: 17px; width: 8px; height: 2px; background-color: #C2410C; }
    .center-receipt-line-two { top: 24px; }
    .center-check { position: absolute; left: 17px; top: 17px; width: 10px; height: 6px; border-left-width: 2px; border-left-style: solid; border-left-color: #C2410C; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #C2410C; transform: rotate(-45deg); }
    /* #ifdef WEB */
    .account-page .order-center-heading, .account-page .order-center-shortcuts { flex-direction: row;  padding-top: 4px; }
    .order-center-all::after, .order-center-shortcut::after { border: none; }
    /* #endif */
    .center-cross { position: absolute; left: 16px; top: 21px; width: 12px; height: 2px; border-radius: 1px; background-color: #C2410C; transform: rotate(45deg); }
    .center-cross-other { transform: rotate(-45deg); }
</style>
