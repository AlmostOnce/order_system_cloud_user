<template>
	<view class="account-page">
		<view class="mine-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<scroll-view class="account-scroll" scroll-y="true">
			<view class="mine-hero">
				<text class="mine-eyebrow">校园食堂 · 账户中心</text>
				<text class="mine-title">我的</text>
				<text class="mine-subtitle">用餐、账单与账号信息，都在这里</text>
			</view>
			<view class="mine-content">
				<button class="profile-card" aria-label="查看个人资料" @click="openProfile">
					<view class="mine-avatar">
						<image v-if="avatarUrl.length > 0" class="mine-avatar-image" :src="avatarUrl" mode="aspectFill"></image>
						<text v-else class="mine-avatar-text">{{ username.substring(0, 1) }}</text>
					</view>
					<view class="account-entry-body">
						<text class="profile-name">{{ username }}</text>
						<text class="profile-meta">{{ roleName }} · ID {{ userId }}</text>
						<text class="profile-note">{{ email.length > 0 ? email : '查看个人资料' }}</text>
					</view>
					<view class="account-arrow"></view>
				</button>
				<text v-if="profileError.length > 0" class="account-error">{{ profileError }}</text>

				<view v-if="roleCode == 'CUSTOMER'" class="order-center">
                    <view class="order-center-heading"><text class="account-heading">订单中心</text><button class="order-center-all" @click="openOrders"><text class="order-center-all-text">全部订单</text><view class="account-arrow"></view></button></view>
                    <view class="order-center-shortcuts">
                        <button class="order-center-shortcut" @click="openPendingOrders"><view class="order-center-symbol"><view class="center-clock"></view><view class="center-clock-hand"></view></view><text class="order-center-label">待支付</text></button>
                        <button class="order-center-shortcut" @click="openActiveOrders"><view class="order-center-symbol"><view class="center-receipt"></view><view class="center-receipt-line"></view><view class="center-receipt-line center-receipt-line-two"></view></view><text class="order-center-label">进行中</text></button>
                        <button class="order-center-shortcut" @click="openCompletedOrders"><view class="order-center-symbol"><view class="center-clock"></view><view class="center-check"></view></view><text class="order-center-label">已完成</text></button>
                    </view>
                </view>
                <text v-if="roleCode == 'CUSTOMER'" class="account-section-label">我的钱包</text>
				<view v-if="roleCode == 'CUSTOMER'" class="entry-group">
                    <button class="account-entry" @click="openWallet">
                        <view class="account-entry-icon"><view class="wallet-icon-outline"></view><view class="wallet-icon-pocket"></view></view>
                        <view class="account-entry-body"><text class="account-entry-title">余额与充值</text><text class="account-entry-note">查看账户余额，进入钱包充值</text></view>
                        <view class="account-arrow"></view>
                    </button>
                    <view class="entry-divider"></view>
					<button class="account-entry" @click="openRechargeRecords"><view class="account-entry-icon"><view class="flow-stem"></view><view class="flow-tip"></view></view><view class="account-entry-body"><text class="account-entry-title">充值记录</text><text class="account-entry-note">查看每一笔到账与余额</text></view><view class="account-arrow"></view></button>
					<view class="entry-divider"></view>
					<button class="account-entry" @click="openPayRecords"><view class="account-entry-icon"><view class="flow-stem"></view><view class="flow-tip flow-tip-out"></view></view><view class="account-entry-body"><text class="account-entry-title">消费记录</text><text class="account-entry-note">查看余额支付支出</text></view><view class="account-arrow"></view></button>
				</view>

				<text class="account-section-label">账号与安全</text>
				<view class="entry-group">
					<button class="account-entry" @click="openProfile"><view class="account-entry-icon"><view class="person-head"></view><view class="person-body"></view></view><view class="account-entry-body"><text class="account-entry-title">个人资料</text><text class="account-entry-note">用户名、联系方式与账号信息</text></view><view class="account-arrow"></view></button>
					<view v-if="roleCode == 'CUSTOMER'" class="entry-divider"></view>
					<button v-if="roleCode == 'CUSTOMER'" class="account-entry" @click="openPayPassword"><view class="account-entry-icon"><view class="lock-hoop"></view><view class="lock-body"></view></view><view class="account-entry-body"><text class="account-entry-title">支付密码</text><text class="account-entry-note">{{ payPasswordSet ? '修改独立支付密码' : '设置后可充值和使用余额' }}</text></view><view class="account-arrow"></view></button>
				</view>
				<view v-if="signOutConfirm" class="account-card"><text class="account-heading">确认退出登录？</text><text class="account-note">退出后需要重新登录才能查看账户。</text><button class="account-primary" :disabled="signingOut" @click="signOut"><text class="account-primary-text">{{ signingOut ? '退出中…' : '确认退出' }}</text></button><button class="account-link" :disabled="signingOut" @click="cancelSignOut"><text class="account-link-text">继续使用</text></button></view>
				<button v-else class="signout-button" @click="confirmSignOut"><text class="signout-label">退出登录</text></button>
				<text class="mine-footer">湖北经济学院 · 食堂管理中心</text>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts">
	import { logout as doLogout, isLoggedIn, currentUser } from '../../store/auth.uts'
	import { fetchMyProfile, fetchMyBalance, walletPayload } from '../../api/wallet.uts'
	import { HttpResult } from '../../common/http.uts'
	import { jsonString, jsonNumber, jsonBoolean } from '../../common/json.uts'
	import { accountRoleLabel } from '../../common/account.uts'

	export default {
		data() {
			return { statusBarHeight: 0, username: '校园用户', roleName: '', roleCode: '', userId: 0,
				email: '', avatarUrl: '', profileError: '', balanceLoading: false, balanceReady: false,
				balanceText: '--', balanceError: '', payPasswordSet: false, signOutConfirm: false, signingOut: false }
		},
		onShow() {
			this.statusBarHeight = uni.getWindowInfo().statusBarHeight
			if (!isLoggedIn()) { uni.reLaunch({ url: '/pages/login/login' }); return }
			const user = currentUser()
			if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
			this.username = user.username.length > 0 ? user.username : '校园用户'
			this.userId = user.userId
			this.roleCode = user.roleCode
			this.roleName = accountRoleLabel(user.roleCode)
			this.loadProfile()
			if (this.roleCode == 'CUSTOMER') this.loadBalance()
		},
		methods: {
			loadProfile() {
				this.profileError = ''
				fetchMyProfile().then((result: HttpResult) => {
					const data = walletPayload(result)
					if (data == null) { this.profileError = result.message.length > 0 ? result.message : '资料暂时无法获取，可进入个人资料重试'; return }
					this.username = jsonString(data, 'username') ?? this.username
					this.email = jsonString(data, 'email') ?? ''
					this.avatarUrl = jsonString(data, 'avatarUrl') ?? ''
				})
			},
			loadBalance() {
				if (this.balanceLoading) return
				this.balanceLoading = true
				this.balanceReady = false
				this.balanceError = ''
				fetchMyBalance().then((result: HttpResult) => {
					this.balanceLoading = false
					const data = walletPayload(result)
					if (data == null || jsonNumber(data, 'balance') == null) { this.balanceError = result.message.length > 0 ? result.message : '余额暂时无法获取'; return }
					this.balanceText = (jsonNumber(data, 'balance') ?? 0).toFixed(2)
					this.payPasswordSet = jsonBoolean(data, 'payPasswordSet') ?? false
					this.balanceReady = true
				})
			},
			openOrders() { uni.navigateTo({ url: '/pages/order/list' }) },
            openPendingOrders() { uni.navigateTo({ url: '/pages/order/list?filter=pending' }) },
            openActiveOrders() { uni.navigateTo({ url: '/pages/order/list?filter=active' }) },
            openCompletedOrders() { uni.navigateTo({ url: '/pages/order/list?filter=completed' }) },
			openProfile() { uni.navigateTo({ url: '/pages/account/profile' }) },
			openWallet() { uni.navigateTo({ url: '/pages/wallet/recharge' }) },
			openAllRecords() { uni.navigateTo({ url: '/pages/wallet/records' }) },
			openRechargeRecords() { uni.navigateTo({ url: '/pages/wallet/records?type=RECHARGE' }) },
			openPayRecords() { uni.navigateTo({ url: '/pages/wallet/records?type=PAY' }) },
			openPayPassword() { uni.navigateTo({ url: '/pages/account/pay-password' }) },
			confirmSignOut() { this.signOutConfirm = true },
			cancelSignOut() { this.signOutConfirm = false },
			signOut() {
				if (this.signingOut) return
				this.signingOut = true
				doLogout().then(() => { this.signingOut = false; uni.reLaunch({ url: '/pages/login/login' }) })
			}
		}
	}
</script>

<style>
	@import '../../styles/account.css';
	.mine-status { background-color: #E4572E; }
	.mine-hero { background-color: #E4572E; padding: 20px 24px 24px 24px; }
	.mine-eyebrow { font-size: 12px; line-height: 18px; color: #FFE3D6; }
	.mine-title { margin-top: 8px; font-size: 28px; line-height: 36px; font-weight: bold; color: #FFFFFF; }
	.mine-subtitle { margin-top: 6px; font-size: 12px; line-height: 20px; color: #FFE3D6; }
	.mine-content { padding: 20px 20px 32px 20px; }
	.profile-card { display: flex; width: 100%; text-align: left; line-height: 22px; flex-direction: row; align-items: center; margin: 0 0 18px 0; padding: 20px 16px; border-width: 0; border-radius: 18px; background-color: #FFFFFF; }
	.mine-avatar { flex-shrink: 0; width: 52px; height: 52px; border-radius: 18px; background-color: #FDF0E8; align-items: center; justify-content: center; overflow: hidden; }
	.mine-avatar-image { width: 52px; height: 52px; }
	.mine-avatar-text { font-size: 23px; font-weight: bold; color: #C2410C; }
	.profile-name { font-size: 19px; line-height: 27px; font-weight: bold; color: #211C18; }
	.profile-meta { margin-top: 3px; font-size: 11px; line-height: 18px; color: #7A6C60; }
	.profile-note { margin-top: 4px; font-size: 12px; line-height: 18px; color: #C2410C; }
	.entry-group { margin-bottom: 24px; border-radius: 16px; overflow: hidden; }
	.entry-divider { height: 1px; margin-left: 60px; margin-right: 16px; background-color: #F4EBE4; }
	.flow-stem { position: absolute; left: 15px; top: 8px; width: 2px; height: 15px; background-color: #C2410C; }
	.flow-tip { position: absolute; left: 12px; top: 15px; width: 6px; height: 6px; border-right-width: 2px; border-right-style: solid; border-right-color: #C2410C; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #C2410C; transform: rotate(45deg); }
	.flow-tip-out { top: 9px; transform: rotate(225deg); }
	.person-head { position: absolute; top: 6px; left: 12px; width: 8px; height: 8px; border-radius: 4px; background-color: #C2410C; }
	.person-body { position: absolute; top: 17px; left: 8px; width: 16px; height: 9px; border-radius: 6px; border-width: 2px; border-style: solid; border-color: #C2410C; }
	.lock-hoop { position: absolute; top: 6px; left: 11px; width: 10px; height: 10px; border-radius: 5px; border-width: 2px; border-style: solid; border-color: #C2410C; }
	.lock-body { position: absolute; top: 14px; left: 8px; width: 16px; height: 12px; border-radius: 3px; background-color: #C2410C; }
	.signout-button { display: flex; margin: 0; padding: 14px; border-width: 0; border-radius: 12px; background-color: #F5EAE0; align-items: center; }
	.signout-label { font-size: 14px; line-height: 20px; color: #7A6C60; }
	.mine-footer { margin-top: 22px; font-size: 11px; line-height: 18px; text-align: center; color: #A2968B; }

	/* #ifdef WEB */
	.account-page .profile-card { flex-direction: row; }
	/* #endif */

    .wallet-icon-outline { position: absolute; left: 6px; top: 9px; width: 20px; height: 15px; border-width: 2px; border-style: solid; border-color: #C2410C; border-radius: 4px; }
    .wallet-icon-pocket { position: absolute; left: 19px; top: 14px; width: 7px; height: 5px; border-radius: 2px; background-color: #C2410C; }

    .order-center { margin-bottom: 24px; padding: 16px; border-radius: 18px; background-color: #FFFFFF; }
    .order-center-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
    .order-center-all { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; min-height: 44px; margin: 0; padding: 0 0 0 12px; border-width: 0; background-color: transparent; line-height: 20px; }
    .order-center-all-text { font-size: 12px; line-height: 20px; color: #7A6C60; }
    .order-center-shortcuts { display: flex; flex-direction: row; padding-top: 14px; }
    .order-center-shortcut { display: flex; flex-direction: column; flex: 1; min-width: 0; align-items: center; margin: 0; padding: 8px 0; border-width: 0; border-radius: 12px; background-color: transparent; line-height: 20px; }
    .order-center-symbol { position: relative; width: 44px; height: 44px; border-radius: 14px; background-color: #FDF0E8; }
    .order-center-label { margin-top: 9px; font-size: 13px; line-height: 20px; color: #211C18; }
    .center-clock { position: absolute; left: 11px; top: 11px; width: 22px; height: 22px; border-width: 2px; border-style: solid; border-color: #C2410C; border-radius: 11px; }
    .center-clock-hand { position: absolute; left: 21px; top: 16px; width: 6px; height: 8px; border-left-width: 2px; border-left-style: solid; border-left-color: #C2410C; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #C2410C; }
    .center-receipt { position: absolute; left: 13px; top: 9px; width: 18px; height: 26px; border-width: 2px; border-style: solid; border-color: #C2410C; border-radius: 4px; }
    .center-receipt-line { position: absolute; left: 18px; top: 17px; width: 8px; height: 2px; background-color: #C2410C; }
    .center-receipt-line-two { top: 24px; }
    .center-check { position: absolute; left: 17px; top: 17px; width: 10px; height: 6px; border-left-width: 2px; border-left-style: solid; border-left-color: #C2410C; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #C2410C; transform: rotate(-45deg); }
    /* #ifdef WEB */
    .account-page .order-center-heading, .account-page .order-center-shortcuts { flex-direction: row; }
    .order-center-all::after, .order-center-shortcut::after { border: none; }
    /* #endif */
</style>
