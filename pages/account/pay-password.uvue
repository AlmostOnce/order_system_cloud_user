<template>
	<view class="account-page account-secondary">
		<view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav vapor-account-secondary--account-nav"><button class="account-back vapor-account-secondary--account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">支付密码</text></view>
		<scroll-view class="account-scroll" scroll-y="true" :refresher-enabled="!saving && (refreshing || !loading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
                <refresh-header slot="refresher" :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
<view class="account-content vapor-account-secondary--account-content">
            <view class="account-banner">
                <view class="banner-copy">
                    <text class="banner-kicker">账户安全</text>
                    <text class="banner-title">独立密码，安心用餐</text>
                    <text class="banner-note">用于确认充值和余额支付，请妥善保管。</text>
                </view>
                <view class="banner-symbol symbol-lock" aria-hidden="true"><view class="symbol-part-one vapor-symbol-lock--symbol-part-one"></view><view class="symbol-part-two vapor-symbol-lock--symbol-part-two"></view><view class="symbol-part-three vapor-symbol-lock--symbol-part-three"></view></view>
            </view>
			<view class="account-card vapor-account-secondary--account-card">
				<text class="account-heading">{{ loading ? '正在获取密码状态…' : (passwordSet ? '修改支付密码' : '先设置支付密码') }}</text>
				<text class="account-note">支付密码用于充值和余额支付，与登录密码分开管理。</text>
				<view v-if="ready">
					<text class="account-label vapor-account-secondary--account-label">{{ passwordSet ? '原支付密码' : '登录密码' }}</text><input class="account-input vapor-account-secondary--account-input" type="text" :password="true" v-model="credential" :maxlength="64" :disabled="saving" :placeholder="passwordSet ? '请输入原支付密码' : '输入登录密码以确认身份'" />
					<text class="account-label vapor-account-secondary--account-label">新支付密码</text><input class="account-input vapor-account-secondary--account-input" type="text" :password="true" v-model="newPassword" :maxlength="20" :disabled="saving" placeholder="6 至 20 位，不能与登录密码相同" />
					<text class="account-label vapor-account-secondary--account-label">再次输入</text><input class="account-input vapor-account-secondary--account-input" type="text" :password="true" v-model="confirmPassword" :maxlength="20" :disabled="saving" placeholder="再次输入新支付密码" confirm-type="done" @confirm="save" />
				</view>
				<text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
				<button v-if="ready" class="account-primary vapor-account-secondary--account-primary" :disabled="saving" :class="saving ? 'account-disabled' : ''" @click="save"><text class="account-primary-text">{{ saving ? '正在保存…' : (nextPage == 'recharge' ? '保存并前往充值' : '保存支付密码') }}</text></button>

				<text v-if="successText.length > 0" class="account-note">{{ successText }}</text>
			</view>
		</view></scroll-view>
	</view>
</template>

<script setup lang="uts">
import { reactive, toRefs } from 'vue'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue';
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts';
import { fetchMyBalance, setPayPassword, walletPayload } from '../../api/wallet.uts';
import { HttpResult } from '../../common/http.uts';
import { jsonBoolean } from '../../common/json.uts';
import { isLoggedIn, currentUser } from '../../store/auth.uts';
import { backToAccount } from '../../common/account.uts';

const state = reactive({ refreshing: false, currentRefreshTime: '', statusBarHeight: 0, loading: false, ready: false, passwordSet: false,
    credential: '', newPassword: '', confirmPassword: '', errorText: '', successText: '', saving: false, nextPage: '', pageVisible: false })

const { refreshing, currentRefreshTime, statusBarHeight, loading, ready, passwordSet, credential, newPassword, confirmPassword, errorText, successText, saving, nextPage, pageVisible } = toRefs(state)

function refreshPage() {
    if (state.refreshing || state.loading || state.saving)
        return;
    state.refreshing = true;
    const refreshStartedAt = Date.now();
    state.currentRefreshTime = refreshTimeLabel(refreshStartedAt);
    loadStatus().then(() => {
        finishPullRefresh(refreshStartedAt, state.ready && state.errorText.length == 0, (time: string) => {
            if (time.length > 0)
                state.currentRefreshTime = time;
            state.refreshing = false;
        });
    }).catch(() => {
        finishPullRefresh(refreshStartedAt, false, (_time: string) => { state.refreshing = false; });
    });
}

function goBack() {
    backToAccount();
}

function clearPasswords() {
    state.credential = '';
    state.newPassword = '';
    state.confirmPassword = '';
}

function loadStatus(): Promise<void> {
    if (state.loading)
        return Promise.resolve();
    state.loading = true;
    state.ready = false;
    state.errorText = '';
    return fetchMyBalance().then((result: HttpResult) => {
        state.loading = false;
        if (!state.pageVisible)
            return;
        const data = walletPayload(result);
        if (data == null || jsonBoolean(data, 'payPasswordSet') == null) {
            state.errorText = result.message.length > 0 ? result.message : '支付密码状态获取失败';
            return;
        }
        state.passwordSet = jsonBoolean(data, 'payPasswordSet') ?? false;
        state.ready = true;
    });
}

function save() {
    if (!state.ready || state.saving)
        return;
    state.errorText = '';
    state.successText = '';
    if (state.credential.length == 0) {
        state.errorText = state.passwordSet ? '请输入原支付密码' : '请输入登录密码';
        return;
    }
    if (state.newPassword.length < 6 || state.newPassword.length > 20) {
        state.errorText = '支付密码长度为 6 至 20 位';
        return;
    }
    if (state.newPassword != state.confirmPassword) {
        state.errorText = '两次输入的支付密码不一致';
        return;
    }
    state.saving = true;
    setPayPassword(state.passwordSet ? '' : state.credential, state.passwordSet ? state.credential : '', state.newPassword).then((result: HttpResult) => {
        state.saving = false;
        clearPasswords();
        if (!result.ok) {
            state.errorText = result.message;
            return;
        }
        state.passwordSet = true;
        state.successText = '支付密码已保存';
        if (state.pageVisible && state.nextPage == 'recharge')
            uni.redirectTo({ url: '/pages/wallet/recharge' });
    });
}

onLoad((options: OnLoadOptions) => {
    if (options['next'] == 'recharge')
        state.nextPage = 'recharge';
})

onPageShow(() => {
    state.pageVisible = true;
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight;
    if (!isLoggedIn()) {
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    const user = currentUser();
    if (user == null || user.roleCode != 'CUSTOMER') {
        uni.switchTab({ url: '/pages/mine/mine' });
        return;
    }
    loadStatus();
})

onPageHide(() => {
    state.pageVisible = false;
    clearPasswords();
})

onUnload(() => {
    state.pageVisible = false;
    clearPasswords();
})
</script>

<style>
	@import '../../styles/account.css';
</style>
