<template>
	<view class="account-page account-secondary">
		<view class="account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav"><button class="account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">支付密码</text></view>
		<scroll-view class="account-scroll" scroll-y="true" :refresher-enabled="!saving && (refreshing || !loading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
                <refresh-header slot="refresher" :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
<view class="account-content">
            <view class="account-banner">
                <view class="banner-copy">
                    <text class="banner-kicker">账户安全</text>
                    <text class="banner-title">独立密码，安心用餐</text>
                    <text class="banner-note">用于确认充值和余额支付，请妥善保管。</text>
                </view>
                <view class="banner-symbol symbol-lock" aria-hidden="true"><view class="symbol-part-one"></view><view class="symbol-part-two"></view><view class="symbol-part-three"></view></view>
            </view>
			<view class="account-card">
				<text class="account-heading">{{ loading ? '正在获取密码状态…' : (passwordSet ? '修改支付密码' : '先设置支付密码') }}</text>
				<text class="account-note">支付密码用于充值和余额支付，与登录密码分开管理。</text>
				<view v-if="ready">
					<text class="account-label">{{ passwordSet ? '原支付密码' : '登录密码' }}</text><input class="account-input" type="text" :password="true" v-model="credential" :maxlength="64" :disabled="saving" :placeholder="passwordSet ? '请输入原支付密码' : '输入登录密码以确认身份'" />
					<text class="account-label">新支付密码</text><input class="account-input" type="text" :password="true" v-model="newPassword" :maxlength="20" :disabled="saving" placeholder="6 至 20 位，不能与登录密码相同" />
					<text class="account-label">再次输入</text><input class="account-input" type="text" :password="true" v-model="confirmPassword" :maxlength="20" :disabled="saving" placeholder="再次输入新支付密码" confirm-type="done" @confirm="save" />
				</view>
				<text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
				<button v-if="ready" class="account-primary" :disabled="saving" :class="saving ? 'account-disabled' : ''" @click="save"><text class="account-primary-text">{{ saving ? '正在保存…' : (nextPage == 'recharge' ? '保存并前往充值' : '保存支付密码') }}</text></button>

				<text v-if="successText.length > 0" class="account-note">{{ successText }}</text>
			</view>
		</view></scroll-view>
	</view>
</template>

<script lang="uts">
    import RefreshHeader from '../../components/refresh-header/refresh-header.uvue'
    import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
	import { fetchMyBalance, setPayPassword, walletPayload } from '../../api/wallet.uts'
	import { HttpResult } from '../../common/http.uts'
	import { jsonBoolean } from '../../common/json.uts'
	import { isLoggedIn, currentUser } from '../../store/auth.uts'
	import { backToAccount } from '../../common/account.uts'

	export default {
        components: { RefreshHeader },
		data() { return { refreshing: false, currentRefreshTime: '', statusBarHeight: 0, loading: false, ready: false, passwordSet: false,
			credential: '', newPassword: '', confirmPassword: '', errorText: '', successText: '', saving: false, nextPage: '', pageVisible: false } },
		onLoad(options: OnLoadOptions) { if (options['next'] == 'recharge') this.nextPage = 'recharge' },
		onShow() {
			this.pageVisible = true
			this.statusBarHeight = uni.getWindowInfo().statusBarHeight
			if (!isLoggedIn()) { uni.reLaunch({ url: '/pages/login/login' }); return }
			const user = currentUser()
			if (user == null || user.roleCode != 'CUSTOMER') { uni.switchTab({ url: '/pages/mine/mine' }); return }
			this.loadStatus()
		},
		onHide() { this.pageVisible = false; this.clearPasswords() },
		onUnload() { this.pageVisible = false; this.clearPasswords() },
		methods: {
            refreshPage() {
                if (this.refreshing || this.loading || this.saving) return
                this.refreshing = true
                const refreshStartedAt = Date.now()
                this.currentRefreshTime = refreshTimeLabel(refreshStartedAt)
                this.loadStatus().then(() => {
                    finishPullRefresh(refreshStartedAt, this.ready && this.errorText.length == 0, (time: string) => {
                        if (time.length > 0) this.currentRefreshTime = time
                        this.refreshing = false
                    })
                }).catch(() => {
                    finishPullRefresh(refreshStartedAt, false, (_time: string) => { this.refreshing = false })
                })
            },
			goBack() { backToAccount() },
			clearPasswords() { this.credential = ''; this.newPassword = ''; this.confirmPassword = '' },
			loadStatus(): Promise<void> {
				if (this.loading) return Promise.resolve()
				this.loading = true; this.ready = false; this.errorText = ''
				return fetchMyBalance().then((result: HttpResult) => {
					this.loading = false
					if (!this.pageVisible) return
					const data = walletPayload(result)
					if (data == null || jsonBoolean(data, 'payPasswordSet') == null) { this.errorText = result.message.length > 0 ? result.message : '支付密码状态获取失败'; return }
					this.passwordSet = jsonBoolean(data, 'payPasswordSet') ?? false; this.ready = true
				})
			},
			save() {
				if (!this.ready || this.saving) return
				this.errorText = ''; this.successText = ''
				if (this.credential.length == 0) { this.errorText = this.passwordSet ? '请输入原支付密码' : '请输入登录密码'; return }
				if (this.newPassword.length < 6 || this.newPassword.length > 20) { this.errorText = '支付密码长度为 6 至 20 位'; return }
				if (this.newPassword != this.confirmPassword) { this.errorText = '两次输入的支付密码不一致'; return }
				this.saving = true
				setPayPassword(this.passwordSet ? '' : this.credential, this.passwordSet ? this.credential : '', this.newPassword).then((result: HttpResult) => {
					this.saving = false; this.clearPasswords()
					if (!result.ok) { this.errorText = result.message; return }
					this.passwordSet = true; this.successText = '支付密码已保存'
					if (this.pageVisible && this.nextPage == 'recharge') uni.redirectTo({ url: '/pages/wallet/recharge' })
				})
			}
		}
	}
</script>

<style>
	@import '../../styles/account.css';
</style>
