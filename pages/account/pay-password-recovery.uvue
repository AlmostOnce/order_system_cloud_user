<template>
    <view class="account-page account-secondary recovery-page">
        <view class="account-status vapor-account-secondary--account-status"
            :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav vapor-account-secondary--account-nav">
            <view class="account-back vapor-account-secondary--account-back"
                @click="() => { if (!(busy)) back() }" :style="(busy) ? 'opacity:0.5' : ''">
                <view class="account-back-icon"></view>
            </view>
            <text class="account-title">找回支付密码</text>
        </view>
        <scroll-view class="account-scroll" direction="vertical">
            <view class="account-content vapor-account-secondary--account-content">
                <view class="recovery-intro">
                    <text class="recovery-eyebrow">账号安全 · {{ step == 0 ? '验证登录密码' : (step == 1 ? '验证邮箱' : (step == 2 ? '设置新密码' : '已完成')) }}</text>
                    <text class="recovery-title">{{ step == 0 ? '先确认是你本人' : (step == 1 ? '验证绑定邮箱' : (step == 2 ? '设置新的支付密码' : '密码已更新')) }}</text>
                    <text class="recovery-note">{{ step == 0 ? '请输入登录密码，验证后继续找回支付密码。' : (step == 1 ? '先完成人机验证，再向当前绑定邮箱发送验证码。' : (step == 2 ? '邮箱身份已验证，请在5分钟内完成设置。' : '请使用新支付密码进行充值和余额支付。')) }}</text>
                </view>
                <view v-if="step == 0" class="account-card vapor-account-secondary--account-card">
                    <text class="account-label vapor-account-secondary--account-label">登录密码</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="loginPassword" :password="true" :maxlength="64" :disabled="busy" placeholder="输入登录密码确认身份" aria-label="登录密码" confirm-type="done" @confirm="authorize" />
                    <button class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" :disabled="busy" @click="authorize">{{ busy ? '正在验证…' : '验证并继续' }}</button>
                </view>
                <view v-if="step == 1" class="account-card vapor-account-secondary--account-card">
                    <text class="account-label vapor-account-secondary--account-label">绑定邮箱</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="email" :maxlength="254"
                        :disabled="true" placeholder="请输入账号绑定的邮箱" aria-label="绑定邮箱" />
                    <view v-if="!codeSent">
                        <text class="account-label vapor-account-secondary--account-label">图片验证码</text>
                        <view class="recovery-captcha-row">
                            <input class="account-input vapor-account-secondary--account-input recovery-captcha-input"
                                v-model="captchaCode" :maxlength="8" :disabled="busy || captchaLoading"
                                placeholder="输入图中字符" aria-label="图片验证码" />
                            <view class="recovery-captcha-button" @click="() => { if (!(busy || captchaLoading)) loadCaptcha() }" :style="(busy || captchaLoading) ? 'opacity:0.5' : ''">
                                <image v-if="captchaImage.length > 0" class="recovery-captcha-image" :src="captchaImage"
                                    mode="aspectFit"></image>
                                <text v-else class="account-muted">{{ captchaLoading ? '加载中…' : '点击获取' }}</text>
                        </view>
                        </view>
                        <button class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50"
                            :disabled="busy || captchaLoading" @click="sendCode">{{ busy ? '正在发送…' : '发送邮箱验证码' }}</button>
                    </view>
                    <view v-else>
                        <text class="recovery-note recovery-sent">验证码已发送至绑定邮箱，10分钟内有效。</text>
                        <text class="account-label vapor-account-secondary--account-label">邮箱验证码</text>
                        <input class="account-input vapor-account-secondary--account-input" v-model="emailCode"
                            type="number" :maxlength="6" :disabled="busy" placeholder="请输入六位数字" aria-label="邮箱验证码" />
                        <button class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" :disabled="busy"
                            @click="verifyCode">{{ busy ? '正在验证…' : '验证并继续' }}</button>
                        <button class="account-link account-link-text button-text button-text-44" :disabled="busy || countdown > 0" @click="prepareResend">{{ countdown > 0 ? countdown + '秒后可重新发送' : '重新发送验证码' }}
                        </button>
                    </view>
                </view>
                <view v-if="step == 2" class="account-card vapor-account-secondary--account-card">
                    <text class="account-label vapor-account-secondary--account-label">新支付密码</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="password"
                        :password="true" :maxlength="20" :disabled="busy" placeholder="6至20位" aria-label="新支付密码" />
                    <text class="account-label vapor-account-secondary--account-label">确认新密码</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="confirmation"
                        :password="true" :maxlength="20" :disabled="busy" placeholder="请再次输入新密码" aria-label="确认新密码"
                        confirm-type="done" @confirm="resetPassword" />
                    <button class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" :disabled="busy"
                        @click="resetPassword">{{ busy ? '正在保存…' : '确认重置密码' }}</button>
                    <button class="account-link account-link-text button-text button-text-44" :disabled="busy" @click="restart">重新验证身份</button>
                </view>
                <text v-if="errorText.length >0" class="account-error">
{{ errorText }}</text>
                <button v-if="step == 3" class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" @click="back">返回支付密码</button>
                <button v-if="step == 1" class="account-link account-link-text button-text button-text-44" :disabled="busy" @click="restart">重新验证登录密码</button>
                <text v-if="step == 1" class="account-note">未绑定邮箱时，请先到个人资料中绑定邮箱。</text>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import { toast } from '../../common/feedback.uts'
    import { reactive, toRefs } from 'vue'
    import { fetchCaptcha } from '../../api/auth.uts'
    import { authorizePayPasswordRecovery, sendPayPasswordRecoveryCode, verifyPayPasswordRecoveryCode, confirmPayPasswordRecovery } from '../../api/wallet.uts'
    import { isLoggedIn, currentUser } from '../../store/auth.uts'
    import { jsonObject, jsonString, jsonNumber } from '../../common/json.uts'
    import { backToAccount } from '../../common/account.uts'


    const state = reactive({ statusBarHeight: 0, step: 0, loginPassword: '', authorizationToken: '', email: '', captchaId: '', captchaImage: '', captchaCode: '', captchaLoading: false, emailCode: '', codeSent: false, countdown: 0, busy: false, errorText: '', resetToken: '', grantExpiresAt: 0, password: '', confirmation: '' })
    const { statusBarHeight, step, loginPassword, email, captchaImage, captchaCode, captchaLoading, emailCode, codeSent, countdown, busy, errorText, password, confirmation } = toRefs(state)
    let timer = 0
    let pageVersion = 0
    function stopTimer() { if (timer > 0) { clearInterval(timer); timer = 0 } }
    let resendAvailableAt = 0
function updateCountdown() { state.countdown = Math.max(0, Math.ceil((resendAvailableAt - Date.now()) / 1000)); if (state.countdown == 0) stopTimer() }
function startCountdown() { stopTimer(); resendAvailableAt = Date.now() + 60000; updateCountdown(); timer = setInterval(updateCountdown, 1000) }
    async function loadCaptcha() : Promise<void> {
        if (state.captchaLoading || state.busy || state.codeSent) return
        const version = pageVersion; state.captchaLoading = true; state.captchaCode = ''; state.captchaId = ''; state.captchaImage = ''
        try {

            const result = await fetchCaptcha(); if (version != pageVersion) return
            const data = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
            state.captchaId = data == null ? '' : (jsonString(data, 'captchaId') ?? ''); state.captchaImage = data == null ? '' : (jsonString(data, 'imageBase64') ?? '')
            if (state.captchaId.length == 0 || state.captchaImage.length == 0) state.errorText = result.message.length > 0 ? result.message : '图片验证码加载失败，请点击重试'
        } catch (_error) { if (version == pageVersion) state.errorText = '图片验证码加载失败，请点击重试' } finally { if (version == pageVersion) state.captchaLoading = false }
    }
    async function sendCode() : Promise<void> {
        if (state.busy || state.captchaLoading || state.codeSent || state.step != 1) return
        state.errorText = ''
        if (state.captchaId.length == 0 || state.captchaCode.trim().length == 0) { toast('请填写图片验证码'); return }
        const version = pageVersion; state.busy = true
        try {

            const result = await sendPayPasswordRecoveryCode(state.authorizationToken, state.captchaId, state.captchaCode.trim()); if (version != pageVersion) return
            if (!result.ok) { toast(result.message.length > 0 ? result.message : '发送失败，请稍后重试'); return }
            state.codeSent = true; state.captchaCode = ''; state.captchaId = ''; state.captchaImage = ''; startCountdown()
        } catch (_error) { if (version == pageVersion) toast('发送失败，请稍后重新验证发送') } finally { if (version == pageVersion) { state.busy = false; if (!state.codeSent) loadCaptcha() } }
    }
    async function verifyCode() : Promise<void> {
        if (state.busy || !state.codeSent || state.step != 1) return
        state.errorText = ''
        if (!/^[0-9]{6}$/.test(state.emailCode)) { toast('请输入六位邮箱验证码'); return }
        const version = pageVersion; state.busy = true
        try {

            const result = await verifyPayPasswordRecoveryCode(state.authorizationToken, state.emailCode); if (version != pageVersion) return
            const raw = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
            const token = raw == null ? '' : (jsonString(raw, 'resetToken') ?? ''); const expires = raw == null ? 0 : (jsonNumber(raw, 'expiresIn') ?? 0)
            if (!/^[a-f0-9]{64}$/.test(token) || expires <= 0 || expires > 300) { toast(result.message.length > 0 ? result.message : '邮箱验证失败，请重新获取验证码'); return }
            state.authorizationToken = ''; state.resetToken = token; state.grantExpiresAt = Date.now() + expires * 1000; state.emailCode = ''; state.step = 2; stopTimer()
        } catch (_error) { if (version == pageVersion) toast('验证结果未确认，请重新获取验证码') } finally { if (version == pageVersion) state.busy = false }
    }
    async function resetPassword() : Promise<void> {
        if (state.busy || state.step != 2) return
        state.errorText = ''
        if (state.resetToken.length == 0 || Date.now() >= state.grantExpiresAt) { restart(); toast('身份验证已过期，请重新验证邮箱'); return }
        if (state.password.length < 6 || state.password.length > 20) { toast('新密码须为6至20位'); return }
        if (state.password != state.confirmation) { toast('两次输入的密码不一致'); return }
        const version = pageVersion; state.busy = true
        try {

            const result = await confirmPayPasswordRecovery(state.resetToken, state.password); if (version != pageVersion) return
            if (!result.ok) { toast(result.statusCode == 0 ? '结果暂未确认，请返回支付密码页确认；如未生效，请重新找回' : (result.message.length > 0 ? result.message : '重置失败，请重新验证邮箱')); if (result.statusCode == 409) state.resetToken = ''; return }
            state.step = 3; state.resetToken = ''; state.grantExpiresAt = 0;
        } catch (_error) { if (version == pageVersion) toast('结果暂未确认，请返回支付密码页确认；如未生效，请重新找回') } finally { if (version == pageVersion) { state.busy = false; state.password = ''; state.confirmation = '' } }
    }
    function prepareResend() { if (state.busy || state.countdown > 0) return; state.codeSent = false; state.emailCode = ''; state.errorText = ''; loadCaptcha() }
    function restart() { if (state.busy) return; state.step = 0; state.authorizationToken = ''; state.loginPassword = ''; state.codeSent = false; state.resetToken = ''; state.grantExpiresAt = 0; state.password = ''; state.confirmation = ''; state.emailCode = ''; state.errorText = ''; state.countdown = 0; stopTimer() }
    async function authorize(): Promise<void> {
        if (state.busy || state.step != 0) return
        state.errorText = ''
        if (state.loginPassword.length == 0) { toast('请输入登录密码'); return }
        const version = pageVersion; state.busy = true
        try {
            const result = await authorizePayPasswordRecovery(state.loginPassword); if (version != pageVersion) return
            const data = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
            const token = data == null ? '' : (jsonString(data, 'authorizationToken') ?? '')
            if (!/^[a-f0-9]{64}$/.test(token)) { toast(result.message.length > 0 ? result.message : '身份验证失败'); return }
            state.authorizationToken = token; state.email = (data == null ? null : jsonString(data, 'maskedEmail')) ?? ''; state.step = 1
        } catch (_error) { if (version == pageVersion) toast('验证失败，请稍后重试') }
        finally { if (version == pageVersion) { state.loginPassword = ''; state.busy = false; if (state.step == 1) loadCaptcha() } }
    }
    function back() { if (!state.busy) backToAccount() }
    function clearPage() {
        pageVersion++; stopTimer(); state.authorizationToken = ''; state.resetToken = ''; state.loginPassword = '';
        state.grantExpiresAt = 0; state.password = ''; state.confirmation = ''; state.emailCode = '';
        state.captchaId = ''; state.captchaImage = ''; state.captchaCode = ''; state.email = '';
        state.step = 0; state.codeSent = false; state.busy = false; state.captchaLoading = false; state.countdown = 0; state.errorText = ''
    }
    onLoad(() => { state.statusBarHeight = uni.getWindowInfo().statusBarHeight })
    onPageHide(() => { state.loginPassword = ''; state.password = ''; state.confirmation = '' })
    onUnload(() => { clearPage() })
    onPageShow(() => {
        updateCountdown()
        if (!isLoggedIn()) { uni.reLaunch({ url: '/pages/login/login' }); return }
        const user = currentUser()
        if (user == null || user.roleCode != 'CUSTOMER') { uni.switchTab({ url: '/pages/mine/mine' }); return }
    })
</script>
<style>
    @import '../../styles/account.css';

    .recovery-intro {
        padding: 4px 2px 12px;
    }

    .recovery-eyebrow {
        font-size: 12px;
        line-height: 20px;
        color: #C2410C;
    }

    .recovery-title {
        margin-top: 4px;
        font-size: 20px;
        line-height: 28px;
        color: #211C18;
        font-weight: bold;
    }

    .recovery-note {
        margin-top: 6px;
        font-size: 12px;
        line-height: 18px;
        color: #7A6C60;
    }

    .recovery-sent {
        padding: 12px;
        border-radius: 10px;
        background-color: #FDF6F0;
    }

    .recovery-captcha-row {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .recovery-captcha-input {
        flex: 1;
        width: 0;
        min-width: 0;
        margin-right: 12px;
    }

    .recovery-captcha-button {
        display: flex;
        flex-shrink: 0;
        width: 112px;
        height: 50px;
        padding: 0;
        margin: 0;
        align-items: center;
        justify-content: center;
        border-width: 1px;
        border-style: solid;
        border-color: #E8DED4;
        border-radius: 12px;
        background-color: #FDF6F0;
    }

    .recovery-captcha-image {
        width: 108px;
        height: 44px;
    }

    /* #ifdef WEB */
    .account-page .recovery-captcha-row {
        flex-direction: row;
    }

    .recovery-captcha-input {
        box-sizing: border-box;
    }

    .recovery-captcha-button::after {
        border: none;
    }

    /* #endif */
</style>
