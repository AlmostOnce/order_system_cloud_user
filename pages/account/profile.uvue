<template>
	<view class="account-page account-secondary">
		<view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav vapor-account-secondary--account-nav">
            <view class="account-back vapor-account-secondary--account-back" @click="goBack">
                <view class="account-back-icon"></view>
            </view>
            <text class="account-title">个人资料</text></view>
        <scroll-view class="account-scroll" direction="vertical" :refresher-enabled="!editing && !emailAuthorizationVisible && !profileSaving && !avatarChoosing && !avatarUploading && (refreshing || !loading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
<view class="account-content vapor-account-secondary--account-content">
			<view v-if="loading" class="account-card vapor-account-secondary--account-card"><text class="account-muted">正在获取资料…</text></view>
			<view v-else-if="errorText.length > 0" class="account-card vapor-account-secondary--account-card"><text class="account-error">{{ errorText }}</text></view>
			<view v-else class="profile-details">
                <view class="profile-identity">
                        <view class="profile-initial avatar-preview-trigger" @click="openAvatarPreview">
                            <business-image :src="avatarUrl" kind="avatar"></business-image>
                        </view>
                    <text class="profile-identity-name">{{ username }}</text>
                    <text class="profile-role-badge">{{ roleName }}</text>
                    <text class="profile-identity-note">你的校园用餐账号</text>
                </view>
                <view class="account-card vapor-account-secondary--account-card">
                        <view class="profile-card-header"><text class="account-heading">账号资料</text></view>
<view>
				<!-- 编辑入口归属于昵称字段，复用邮箱行的布局，长昵称换行也不会挤走右侧按钮。 -->
                <view class="profile-detail-row vapor-account-secondary--profile-detail-row"><text class="profile-detail-label">昵称</text><view class="profile-field-line"><text class="profile-detail-value vapor-account-secondary--profile-detail-value profile-field-value">{{ username }}</text>
                    <button class="profile-field-edit profile-field-edit-text button-text button-text-34" :disabled="refreshing || avatarChoosing || avatarUploading" @click="startEdit">修改昵称</button>
                </view></view>
				<view class="profile-detail-row vapor-account-secondary--profile-detail-row"><text class="profile-detail-label">用户号</text><text class="profile-detail-value vapor-account-secondary--profile-detail-value">{{ userNo }}</text></view>
				<view class="profile-detail-row vapor-account-secondary--profile-detail-row"><text class="profile-detail-label">身份</text><text class="profile-detail-value vapor-account-secondary--profile-detail-value">{{ roleName }}</text></view>
                            <view class="profile-detail-row vapor-account-secondary--profile-detail-row"><text class="profile-detail-label">邮箱</text><view class="profile-field-line"><text class="profile-detail-value vapor-account-secondary--profile-detail-value profile-field-value">{{ email.length > 0 ? email : '未绑定' }}</text>
                                    <button class="profile-field-edit profile-field-edit-text button-text button-text-34" :disabled="refreshing || avatarChoosing || avatarUploading" @click="openEmailAuthorization">编辑</button>
                                </view></view>
				<view class="profile-detail-row vapor-account-secondary--profile-detail-row"><text class="profile-detail-label">注册时间</text><text class="profile-detail-value vapor-account-secondary--profile-detail-value">{{ createdAt }}</text></view>
                </view>
			</view>
            </view>
            </view>
    <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            </view>
        </scroll-view>
        <!-- 输入放在滚动区外的统一弹层中，原资料列表始终保留，避免编辑时改变页面高度。 -->
        <confirm-dialog v-if="editing" title="修改昵称" message="请输入2至64个字符的昵称" confirm-text="保存" :busy="profileSaving" busy-text="保存中…" @cancel="cancelEdit" @confirm="saveProfile">
            <input class="profile-dialog-input" v-model="draftUsername" :maxlength="64" :disabled="profileSaving" placeholder="请输入昵称" confirm-type="done" @confirm="saveProfile" />
        </confirm-dialog>
        <confirm-dialog v-if="emailAuthorizationVisible" title="验证登录密码" message="验证通过后进入邮箱更换页面。" confirm-text="验证并继续" :busy="emailAuthorizationLoading" busy-text="验证中…" @cancel="closeEmailAuthorization" @confirm="authorizeAndEditEmail">
            <input class="profile-dialog-input" v-model="emailAuthorizationPassword" :password="true" :maxlength="64" :disabled="emailAuthorizationLoading" placeholder="请输入登录密码" confirm-type="done" @confirm="authorizeAndEditEmail" />
        </confirm-dialog>
	</view>
</template>

<script setup lang="uts">
import { reactive, toRefs } from 'vue'
import ConfirmDialog from '../../components/confirm-dialog/confirm-dialog.uvue';
import BusinessImage from '../../components/business-image/business-image.uvue';
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue';
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts';
import { updateMyProfile, authorizeEmailChange, fetchMyProfile, walletPayload } from '../../api/wallet.uts';
import { setEmailChangeAuthorization, clearEmailChangeAuthorization } from '../../common/email-change-session.uts';
import { toast, toastSuccess } from '../../common/feedback.uts';
import { HttpResult } from '../../common/http.uts';
import { jsonString, jsonNumber } from '../../common/json.uts';
import { uploadImage, saveAvatar } from '../../api/files.uts';
import { saveImageToAlbum } from '../../common/save-image.uts';
import { imageSource } from '../../common/images.uts';
import { chooseLocalImage, ImageChoice } from '../../common/image-picker.uts';
import { isLoggedIn } from '../../store/auth.uts';
import { accountRoleLabel, accountDate, backToAccount } from '../../common/account.uts';

const state = reactive({ editing: false, profileSaving: false, emailAuthorizationVisible: false, emailAuthorizationLoading: false, emailAuthorizationPassword: '', emailAuthorizationError: '', draftUsername: '', profileError: '', refreshing: false, currentRefreshTime: '', statusBarHeight: 0, loading: true, avatarUrl: '', avatarChoosing: false, avatarUploading: false, avatarError: '', pendingAvatarKey: '', errorText: '', username: '', userUuid: '', roleName: '', email: '', userNo: '', createdAt: '' })

const { editing, profileSaving, emailAuthorizationVisible, emailAuthorizationLoading, emailAuthorizationPassword, emailAuthorizationError, draftUsername, profileError, refreshing, currentRefreshTime, statusBarHeight, loading, avatarUrl, avatarChoosing, avatarUploading, avatarError, pendingAvatarKey, errorText, username, userUuid, roleName, email, userNo, createdAt } = toRefs(state)

function startEdit() {
    if (state.loading || state.refreshing || state.emailAuthorizationVisible || state.avatarChoosing || state.avatarUploading) return;
    state.draftUsername = state.username;
    state.profileError = '';
    state.editing = true;
}

function cancelEdit() {
    if (state.profileSaving) return;
    state.editing = false;
    state.draftUsername = '';
    state.profileError = '';
}

function saveProfile(): Promise<void> {
    if (!state.editing || state.profileSaving) return Promise.resolve();
    const name = state.draftUsername.trim();
    state.profileError = '';
    if (name.length < 2 || name.length > 64) { toast('昵称长度为2至64个字符'); return Promise.resolve(); }
    state.profileSaving = true;
    return updateMyProfile(name).then((result: HttpResult) => {
        const data = walletPayload(result);
        if (data == null) {
            toast(result.message.length > 0 ? result.message : '资料尚未保存，请重试');
            return;
        }
        const savedName = jsonString(data, 'username');
        if (savedName == null) { toast('保存结果异常，请下拉刷新确认'); return; }
        state.username = savedName;
        toastSuccess('资料已保存');
        state.editing = false;
        state.draftUsername = '';
    }).catch(() => { toast('资料保存失败，请重试'); }).finally(() => {
        state.profileSaving = false;
    });
}

function openEmailAuthorization() {
    if (state.loading || state.refreshing || state.editing || state.profileSaving
        || state.avatarChoosing || state.avatarUploading) return;
    clearEmailChangeAuthorization();
    state.emailAuthorizationPassword = '';
    state.emailAuthorizationError = '';
    state.emailAuthorizationVisible = true;
}

function closeEmailAuthorization() {
    if (state.emailAuthorizationLoading) return;
    state.emailAuthorizationVisible = false;
    state.emailAuthorizationPassword = '';
    state.emailAuthorizationError = '';
}

function authorizeAndEditEmail(): Promise<void> {
    if (!state.emailAuthorizationVisible || state.emailAuthorizationLoading) return Promise.resolve();
    if (state.emailAuthorizationPassword.length == 0) {
        toast('请输入登录密码');
        return Promise.resolve();
    }
    state.emailAuthorizationError = '';
    state.emailAuthorizationLoading = true;
    return authorizeEmailChange(state.emailAuthorizationPassword).then((result: HttpResult) => {
        const data = walletPayload(result);
        const token = data == null ? null : jsonString(data, 'authorizationToken');
        if (token == null || token.length != 64) {
            toast(result.message.length > 0 ? result.message : '密码验证失败，请重试');
            return;
        }
        setEmailChangeAuthorization(token);
        state.emailAuthorizationVisible = false;
        state.emailAuthorizationPassword = '';
        uni.navigateTo({ url: '/pages/account/email-change' });
    }).catch(() => { toast('密码验证失败，请重试'); }).finally(() => {
        state.emailAuthorizationLoading = false;
        state.emailAuthorizationPassword = '';
    });
}

onPageHide(() => { state.emailAuthorizationPassword = ''; });
onUnload(() => { state.emailAuthorizationPassword = ''; });

let avatarEntry = '';
function resumeAvatarEntry() {
    if (state.loading) return;
    const entry = avatarEntry; avatarEntry = '';
    if (entry == 'change') changeAvatar();
    else if (entry == 'retry') retryAvatar();
    else if (entry == 'preview') openAvatarPreview();
}
function openAvatarPreview() {
    if (state.loading || state.editing || state.profileSaving || state.refreshing || state.emailAuthorizationVisible || state.avatarChoosing || state.avatarUploading) return;
    const source = imageSource(state.avatarUrl, 'avatar');
    uni.previewImage({
        current: 0, urls: [source],
        longPressActions: {
            itemList: state.pendingAvatarKey.length > 0 ? ['保存图片', '更换头像', '重试保存'] : ['保存图片', '更换头像'],
            success: (result: LongPressActionsSuccessResult) => {
                if (result.tapIndex == 0) { saveImageToAlbum(source); return; }
                if (result.tapIndex != 1 && result.tapIndex != 2) return;
                avatarEntry = result.tapIndex == 1 ? 'change' : 'retry';
                uni.closePreviewImage({ success: () => { resumeAvatarEntry(); }, fail: () => { avatarEntry = ''; } });
            }
        }
    });
}

function refreshPage() {
    if (state.editing || state.profileSaving || state.refreshing || state.loading || state.avatarChoosing || state.avatarUploading || state.emailAuthorizationVisible)
        return;
    state.refreshing = true;
    const refreshStartedAt = Date.now();
    state.currentRefreshTime = refreshTimeLabel(refreshStartedAt);
    loadProfile().then(() => {
        finishPullRefresh(refreshStartedAt, state.errorText.length == 0, (time: string) => {
            if (time.length > 0)
                state.currentRefreshTime = time;
            state.refreshing = false;
        });
    }).catch(() => {
        finishPullRefresh(refreshStartedAt, false, (_time: string) => { state.refreshing = false; });
    });
}

function changeAvatar() {
    if (state.avatarChoosing || state.avatarUploading || state.refreshing || state.loading || state.userUuid.length == 0)
        return;
    state.avatarError = '';
    state.avatarChoosing = true;
    chooseLocalImage().then((choice: ImageChoice) => {
        state.avatarChoosing = false;
        if (choice.error.length > 0) {
            state.avatarError = choice.error;
            toast(state.avatarError);
            state.avatarUploading = false;
            return;
        }
        if (choice.path.length == 0) {
            state.avatarUploading = false;
            return;
        }
        state.avatarUploading = true;
        state.pendingAvatarKey = '';
        uploadImage(choice.path, 'USER_AVATAR', 0).then((result: HttpResult) => {
            const data = walletPayload(result);
            const key = data == null ? '' : (jsonString(data, 'fileKey') ?? '');
            if (key.length == 0) {
                state.avatarUploading = false;
                state.avatarError = result.message.length > 0 ? result.message : '头像上传失败';
                toast(state.avatarError);
                return;
            }
            state.pendingAvatarKey = key;
            bindAvatar();
        });
    });
}

function retryAvatar() {
    if (state.avatarUploading || state.refreshing || state.loading || state.pendingAvatarKey.length == 0)
        return;
    state.avatarUploading = true;
    state.avatarError = '';
    bindAvatar();
}

function bindAvatar() {
    saveAvatar(state.pendingAvatarKey).then((result: HttpResult) => {
        state.avatarUploading = false;
        if (!result.ok || result.data == null) {
            state.avatarError = result.message.length > 0 ? result.message : '头像尚未保存，请重试';
            toast(state.avatarError);
            return;
        }
        const url = jsonString(result.data, 'data') ?? '';
        if (url.length == 0) {
            state.avatarError = '头像保存结果异常，请重试';
            toast(state.avatarError);
            return;
        }
        state.avatarUrl = url;
        state.pendingAvatarKey = '';
    });
}

function goBack() {
    if (state.profileSaving) return;
    if (state.emailAuthorizationVisible) { closeEmailAuthorization(); return; }
    if (state.editing) { cancelEdit(); return; }
    backToAccount();
}

function loadProfile(): Promise<void> {
    state.loading = true;
    state.errorText = '';
    return fetchMyProfile().then((result: HttpResult) => {
        state.loading = false;
        const data = walletPayload(result);
        if (data == null) {
            state.errorText = result.message.length > 0 ? result.message : '资料获取失败';
            return;
        }
        state.avatarUrl = jsonString(data, 'avatarUrl') ?? '';
        state.username = jsonString(data, 'username') ?? '';
        state.userUuid = jsonString(data, 'userUuid') ?? '';
        state.roleName = accountRoleLabel(jsonString(data, 'roleCode') ?? '');
        state.email = jsonString(data, 'email') ?? '';
        state.userNo = jsonString(data, 'userNo') ?? '';
        state.createdAt = accountDate(jsonString(data, 'createdAt') ?? '');
    });
}

onLoad((options: OnLoadOptions) => {
    avatarEntry = (options['avatar'] ?? '') as string;
})

onPageShow(() => {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight;
    if (!isLoggedIn()) {
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    if (!state.editing && !state.emailAuthorizationVisible && !state.profileSaving && !state.avatarChoosing && !state.avatarUploading)
        loadProfile().then(() => { resumeAvatarEntry(); });
})
</script>

<style>
	@import '../../styles/account.css';
    .profile-card-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
	.profile-detail-row { padding-top: 10px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #F4EBE4; }
	.profile-detail-label { font-size: 12px; line-height: 18px; color: #7A6C60; }
	.profile-detail-value { margin-top: 6px; font-size: 15px; line-height: 22px; color: #211C18; }
    .profile-field-line { display: flex; flex-direction: row; align-items: center; width: 100%; min-width: 0; }
    .profile-field-value { flex: 1; min-width: 0; margin-top: 6px; }
    .profile-field-edit { display: flex; flex-shrink: 0; min-height: 34px; margin: 0 0 0 10px; padding: 0 12px; align-items: center; justify-content: center; border-width: 1px; border-style: solid; border-color: #EADDD1; border-radius: 10px; background-color: #FCF9F6; }
    .profile-field-edit-text { color: #C2410C; font-size: 12px; line-height: 18px; }
    /* 输入区沿用账户表单颜色，固定触控高度，键盘提交复用同一保存/验证函数。 */
    .profile-dialog-input { height: 46px; margin-top: 18px; padding: 0 12px; border-width: 1px; border-style: solid; border-color: #EADDD1; border-radius: 12px; background-color: #FCF9F6; font-size: 14px; color: #211C18; }
    .profile-initial { overflow: hidden; }
    /* #ifdef WEB */
    .account-page .profile-card-header, .account-page .profile-field-line { flex-direction: row; }
    .account-page .profile-field-value { overflow-wrap: anywhere; }
    /* #endif */
</style>
