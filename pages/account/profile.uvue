<template>
	<view class="account-page account-secondary">
		<view class="account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav"><button class="account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">个人资料</text></view>
		<scroll-view class="account-scroll" scroll-y="true" :refresher-enabled="!avatarPreviewVisible && !avatarChoosing && !avatarUploading && (refreshing || !loading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
                <refresh-header slot="refresher" :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
<view class="account-content">
			<view v-if="loading" class="account-card"><text class="account-muted">正在获取资料…</text></view>
			<view v-else-if="errorText.length > 0" class="account-card"><text class="account-error">{{ errorText }}</text></view>
			<view v-else class="profile-details">
                <view class="profile-identity">
                    <button class="profile-initial avatar-preview-trigger" aria-label="预览头像" @click="openAvatarPreview"><business-image :src="avatarUrl" kind="avatar"></business-image></button>
                    <text class="profile-identity-name">{{ username }}</text>
                    <text class="profile-role-badge">{{ roleName }}</text>
                    <text class="profile-identity-note">你的校园用餐账号</text>
                </view>
                <view class="account-card">
				<text class="account-heading">账号资料</text>
				<view class="profile-detail-row"><text class="profile-detail-label">用户名</text><text class="profile-detail-value">{{ username }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">用户编号</text><text class="profile-detail-value">{{ userUuid }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">身份</text><text class="profile-detail-value">{{ roleName }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">邮箱</text><text class="profile-detail-value">{{ email.length > 0 ? email : '未绑定' }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">手机号</text><text class="profile-detail-value">{{ phone.length > 0 ? phone : '未绑定' }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">注册时间</text><text class="profile-detail-value">{{ createdAt }}</text></view>
			</view>
            </view>
		</view></scroll-view>
        <view v-if="avatarPreviewVisible" class="avatar-preview-mask" @click="closeAvatarPreview">
            <view class="avatar-preview-panel" role="dialog" aria-label="头像预览" @click.stop>
                <view class="avatar-preview-top"><text class="account-heading">头像预览</text><button class="avatar-preview-close" aria-label="关闭预览" @click="closeAvatarPreview"><view class="avatar-close-line"></view><view class="avatar-close-line avatar-close-other"></view></button></view>
                <view class="avatar-preview-picture"><image class="avatar-preview-image" :src="avatarPreviewSource" mode="aspectFit" @error="previewImageError"></image></view>
                <text v-if="avatarChoosing || avatarUploading" class="account-note">{{ avatarChoosing ? '正在打开相册…' : '正在上传并保存头像…' }}</text>
                <text v-if="avatarError.length > 0" class="account-error">{{ avatarError }}</text>
                <button class="account-primary" :disabled="avatarChoosing || avatarUploading || refreshing || loading" @click="changeAvatar"><text class="account-primary-text">更换头像</text></button>
                <button v-if="pendingAvatarKey.length > 0 && !avatarChoosing && !avatarUploading" class="account-link" @click="retryAvatar"><text class="account-link-text">重试保存</text></button>
            </view>
        </view>
	</view>
</template>

<script lang="uts">
    import BusinessImage from '../../components/business-image/business-image.uvue'
    import RefreshHeader from '../../components/refresh-header/refresh-header.uvue'
    import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
	import { fetchMyProfile, walletPayload } from '../../api/wallet.uts'
	import { HttpResult } from '../../common/http.uts'
	import { jsonString, jsonNumber } from '../../common/json.uts'
	import { uploadImage, saveAvatar } from '../../api/files.uts'
    import { imageSource, defaultImage } from '../../common/images.uts'
    import { chooseLocalImage, ImageChoice } from '../../common/image-picker.uts'
    import { isLoggedIn } from '../../store/auth.uts'
	import { accountRoleLabel, accountDate, backToAccount } from '../../common/account.uts'

	export default {
        components: { RefreshHeader, BusinessImage },
		data() { return { refreshing: false, currentRefreshTime: '', statusBarHeight: 0, loading: true, avatarUrl: '', avatarPreviewVisible: false, avatarPreviewFailed: false, avatarChoosing: false, avatarUploading: false, avatarError: '', pendingAvatarKey: '', errorText: '', username: '', userUuid: '', roleName: '', email: '', phone: '', createdAt: '' } },
        onLoad(options: OnLoadOptions) { if (options['avatar'] == 'preview') this.avatarPreviewVisible = true },
        computed: { avatarPreviewSource(): string { return this.avatarPreviewFailed ? defaultImage('avatar') : imageSource(this.avatarUrl, 'avatar') } },
		onShow() {
			this.statusBarHeight = uni.getWindowInfo().statusBarHeight
			if (!isLoggedIn()) { uni.reLaunch({ url: '/pages/login/login' }); return }
			if (!this.avatarChoosing && !this.avatarUploading) this.loadProfile()
		},
		methods: {
            openAvatarPreview() { this.avatarPreviewFailed = false; this.avatarPreviewVisible = true },
            closeAvatarPreview() { this.avatarPreviewVisible = false },
            previewImageError() { this.avatarPreviewFailed = true },
            refreshPage() {
                if (this.refreshing || this.loading || this.avatarPreviewVisible || this.avatarChoosing || this.avatarUploading) return
                this.refreshing = true
                const refreshStartedAt = Date.now()
                this.currentRefreshTime = refreshTimeLabel(refreshStartedAt)
                this.loadProfile().then(() => {
                    finishPullRefresh(refreshStartedAt, this.errorText.length == 0, (time: string) => {
                        if (time.length > 0) this.currentRefreshTime = time
                        this.refreshing = false
                    })
                }).catch(() => {
                    finishPullRefresh(refreshStartedAt, false, (_time: string) => { this.refreshing = false })
                })
            },
            changeAvatar() {
                if (this.avatarChoosing || this.avatarUploading || this.refreshing || this.loading || this.userUuid.length == 0) return
                this.avatarError = ''; this.avatarChoosing = true
                chooseLocalImage().then((choice: ImageChoice) => {
                    this.avatarChoosing = false
                    if (choice.error.length > 0) { this.avatarError = choice.error; this.avatarUploading = false; return }
                    if (choice.path.length == 0) { this.avatarUploading = false; return }
                    this.avatarUploading = true; this.pendingAvatarKey = ''
                    uploadImage(choice.path, 'USER_AVATAR', 0).then((result: HttpResult) => {
                        const data = walletPayload(result)
                        const key = data == null ? '' : (jsonString(data, 'fileKey') ?? '')
                        if (key.length == 0) { this.avatarUploading = false; this.avatarError = result.message.length > 0 ? result.message : '头像上传失败'; return }
                        this.pendingAvatarKey = key
                        this.bindAvatar()
                    })
                })
            },
            retryAvatar() {
                if (this.avatarUploading || this.refreshing || this.loading || this.pendingAvatarKey.length == 0) return
                this.avatarUploading = true; this.avatarError = ''; this.bindAvatar()
            },
            bindAvatar() {
                saveAvatar(this.pendingAvatarKey).then((result: HttpResult) => {
                    this.avatarUploading = false
                    if (!result.ok || result.data == null) { this.avatarError = result.message.length > 0 ? result.message : '头像尚未保存，请重试'; return }
                    const url = jsonString(result.data, 'data') ?? ''
                    if (url.length == 0) { this.avatarError = '头像保存结果异常，请重试'; return }
                    this.avatarUrl = url; this.avatarPreviewFailed = false; this.pendingAvatarKey = ''
                })
            },
			goBack() { backToAccount() },
			loadProfile(): Promise<void> {
				this.loading = true; this.errorText = ''
				return fetchMyProfile().then((result: HttpResult) => {
					this.loading = false
					const data = walletPayload(result)
					if (data == null) { this.errorText = result.message.length > 0 ? result.message : '资料获取失败'; return }
					this.avatarUrl = jsonString(data, 'avatarUrl') ?? ''
					this.username = jsonString(data, 'username') ?? ''
					this.userUuid = jsonString(data, 'userUuid') ?? ''
					this.roleName = accountRoleLabel(jsonString(data, 'roleCode') ?? '')
					this.email = jsonString(data, 'email') ?? ''; this.phone = jsonString(data, 'phone') ?? ''
					this.createdAt = accountDate(jsonString(data, 'createdAt') ?? '')
				})
			}
		}
	}
</script>

<style>
	@import '../../styles/account.css';
	.profile-detail-row { padding-top: 18px; padding-bottom: 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #F4EBE4; }
	.profile-detail-label { font-size: 12px; line-height: 18px; color: #7A6C60; }
	.profile-detail-value { margin-top: 6px; font-size: 15px; line-height: 22px; color: #211C18; }
    .profile-initial { overflow: hidden; }
    .avatar-preview-trigger { margin: 0; padding: 0; border-width: 0; line-height: 20px; }
    .avatar-preview-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 24px; background-color: rgba(33, 28, 24, 0.72); }
    .avatar-preview-panel { width: 100%; max-width: 380px; padding: 20px; border-radius: 22px; background-color: #FFFFFF; }
    .avatar-preview-top { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
    .avatar-preview-close { position: relative; flex-shrink: 0; width: 44px; height: 44px; margin: 0; padding: 0; border-width: 0; border-radius: 12px; background-color: #FDF6F0; }
    .avatar-close-line { position: absolute; left: 14px; top: 21px; width: 16px; height: 2px; background-color: #7A6C60; transform: rotate(45deg); }
    .avatar-close-other { transform: rotate(-45deg); }
    .avatar-preview-picture { height: 240px; margin-top: 16px; border-radius: 16px; overflow: hidden; background-color: #F7F2EE; }
    .avatar-preview-image { width: 100%; height: 100%; }
    /* #ifdef WEB */
    .account-page .avatar-preview-top { flex-direction: row; }
    /* #endif */
</style>
