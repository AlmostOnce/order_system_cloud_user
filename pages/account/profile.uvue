<template>
	<view class="account-page account-secondary">
		<view class="account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav"><button class="account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">个人资料</text></view>
		<scroll-view class="account-scroll" scroll-y="true"><view class="account-content">
			<view v-if="loading" class="account-card"><text class="account-muted">正在获取资料…</text></view>
			<view v-else-if="errorText.length > 0" class="account-card"><text class="account-error">{{ errorText }}</text><button class="account-link" @click="loadProfile"><text class="account-link-text">重新加载</text></button></view>
			<view v-else class="profile-details">
                <view class="profile-identity">
                    <view class="profile-initial"><text class="profile-initial-text">{{ username.substring(0, 1) }}</text></view>
                    <text class="profile-identity-name">{{ username }}</text>
                    <text class="profile-role-badge">{{ roleName }} · ID {{ userId }}</text>
                    <text class="profile-identity-note">你的校园用餐账号</text>
                </view>
                <view class="account-card">
				<text class="account-heading">账号资料</text>
				<view class="profile-detail-row"><text class="profile-detail-label">用户名</text><text class="profile-detail-value">{{ username }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">用户 ID</text><text class="profile-detail-value">{{ userId }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">身份</text><text class="profile-detail-value">{{ roleName }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">邮箱</text><text class="profile-detail-value">{{ email.length > 0 ? email : '未绑定' }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">手机号</text><text class="profile-detail-value">{{ phone.length > 0 ? phone : '未绑定' }}</text></view>
				<view class="profile-detail-row"><text class="profile-detail-label">注册时间</text><text class="profile-detail-value">{{ createdAt }}</text></view>
			</view>
            </view>
		</view></scroll-view>
	</view>
</template>

<script lang="uts">
	import { fetchMyProfile, walletPayload } from '../../api/wallet.uts'
	import { HttpResult } from '../../common/http.uts'
	import { jsonString, jsonNumber } from '../../common/json.uts'
	import { isLoggedIn } from '../../store/auth.uts'
	import { accountRoleLabel, accountDate, backToAccount } from '../../common/account.uts'

	export default {
		data() { return { statusBarHeight: 0, loading: true, errorText: '', username: '', userId: 0, roleName: '', email: '', phone: '', createdAt: '' } },
		onShow() {
			this.statusBarHeight = uni.getWindowInfo().statusBarHeight
			if (!isLoggedIn()) { uni.reLaunch({ url: '/pages/login/login' }); return }
			this.loadProfile()
		},
		methods: {
			goBack() { backToAccount() },
			loadProfile() {
				this.loading = true; this.errorText = ''
				fetchMyProfile().then((result: HttpResult) => {
					this.loading = false
					const data = walletPayload(result)
					if (data == null) { this.errorText = result.message.length > 0 ? result.message : '资料获取失败'; return }
					this.username = jsonString(data, 'username') ?? ''
					this.userId = jsonNumber(data, 'userId') ?? 0
					this.roleName = accountRoleLabel(jsonString(data, 'roleCode') ?? '')
					this.email = jsonString(data, 'email') ?? ''; this.phone = jsonString(data, 'phone') ?? ''
					this.createdAt = accountDate(jsonString(data, 'createdAt') ?? '')
				})
			}
		}
	}
</script>

<style>
	@import '../../styles/account.css';
	.profile-detail-row { padding-top: 18px; padding-bottom: 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #F4EBE4; }
	.profile-detail-label { font-size: 12px; line-height: 18px; color: #7A6C60; }
	.profile-detail-value { margin-top: 6px; font-size: 15px; line-height: 22px; color: #211C18; }
</style>
