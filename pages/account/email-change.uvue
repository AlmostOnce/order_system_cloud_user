<template>
	<view class="account-page account-secondary email-change-page">
		<view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav vapor-account-secondary--account-nav">
			<button class="account-back vapor-account-secondary--account-back" aria-label="返回" @click="cancel"><view class="account-back-icon"></view></button>
			<text class="account-title">更换邮箱</text>
		</view>
		<scroll-view class="account-scroll" scroll-y="true">
			<view class="account-content vapor-account-secondary--account-content">
				<view class="email-intro"><text class="email-step-kicker">账号安全</text><text class="email-intro-title">绑定新的邮箱</text><text class="email-intro-note">完成图片验证后，我们会向新邮箱发送六位验证码。</text></view>
				<view class="account-card vapor-account-secondary--account-card email-form-card">
					<text class="account-label vapor-account-secondary--account-label">新邮箱</text>
					<input class="account-input vapor-account-secondary--account-input" v-model="email" type="text" :maxlength="254" :disabled="sending || changing || captchaVerified || codeSent" placeholder="请输入常用邮箱" aria-label="新邮箱" />

					<view class="email-step-heading"><view class="email-step-number"><text class="email-step-number-text">1</text></view><view class="email-step-copy"><text class="email-step-title">验证图片验证码</text><text class="email-step-note">点击图片可换一张</text></view></view>
					<view class="email-captcha-row">
						<input class="account-input vapor-account-secondary--account-input email-captcha-input" v-model="captchaCode" :maxlength="8" :disabled="captchaLoading || verifyingCaptcha || captchaVerified" placeholder="输入图片中的字符" aria-label="图片验证码" />
						<button class="email-captcha-image-button" :disabled="captchaLoading || verifyingCaptcha || captchaVerified" aria-label="刷新图片验证码" @click="loadCaptcha"><image v-if="captchaImage.length > 0" class="email-captcha-image" :src="captchaImage" mode="aspectFit"></image><text v-else class="email-captcha-placeholder">{{ captchaLoading ? '加载中' : '点击获取' }}</text></button>
					</view>
					<button v-if="!captchaVerified" class="account-primary vapor-account-secondary--account-primary" :disabled="verifyingCaptcha || captchaLoading || changing" @click="verifyCaptcha"><text class="account-primary-text">{{ verifyingCaptcha ? '验证中…' : '验证图片验证码' }}</text></button>
					<view v-else class="email-verified-state"><view class="email-check-mark"></view><text class="email-verified-text">图片验证码已通过</text></view>

					<text v-if="captchaError.length > 0" class="account-error" role="alert">{{ captchaError }}</text>

					<view v-if="captchaVerified" class="email-step-heading email-step-two"><view class="email-step-number email-step-number-current"><text class="email-step-number-text email-step-number-current-text">2</text></view><view class="email-step-copy"><text class="email-step-title">发送邮箱验证码</text><text class="email-step-note">验证通过后才能向新邮箱发送</text></view></view>
					<button v-if="captchaVerified && !codeSent" class="email-send-action" :disabled="sending || changing" @click="sendCode"><text class="email-send-action-text">{{ sending ? '正在发送…' : '发送邮箱验证码' }}</text></button>
					<view v-if="codeSent" class="email-sent-state"><text class="email-sent-title">验证码已发送</text><text class="email-sent-note">请查看 {{ normalizedEmail }}，验证码 10 分钟内有效。</text></view>

					<view v-if="codeSent" class="email-code-section">
						<text class="account-label vapor-account-secondary--account-label">邮箱验证码</text>
						<input class="account-input vapor-account-secondary--account-input" v-model="emailCode" type="number" :maxlength="6" :disabled="changing" placeholder="输入六位数字" aria-label="邮箱验证码" />
						<button v-if="countdown > 0" class="email-resend-action" disabled><text class="email-resend-action-text">{{ countdown }} 秒后可重新验证发送</text></button>
						<button v-else class="email-resend-action" :disabled="sending || changing" @click="prepareResend"><text class="email-resend-action-text">重新验证并发送</text></button>
					</view>
					<text v-if="formError.length > 0" class="account-error" role="alert">{{ formError }}</text>
					<button v-if="codeSent" class="account-primary vapor-account-secondary--account-primary email-confirm-action" :disabled="changing || sending" @click="confirmChange"><text class="account-primary-text">{{ changing ? '正在保存…' : '确认更换邮箱' }}</text></button>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { reactive, toRefs, computed } from 'vue'
import { changeMyEmail, sendEmailCode, verifyEmailCaptcha, walletPayload } from '../../api/wallet.uts'
import { fetchCaptcha } from '../../api/auth.uts'
import { HttpResult } from '../../common/http.uts'
import { jsonString } from '../../common/json.uts'
import { clearEmailChangeAuthorization, getEmailChangeAuthorization } from '../../common/email-change-session.uts'
import { toastSuccess } from '../../common/feedback.uts'

const state = reactive({ statusBarHeight: 0, email: '', captchaId: '', captchaImage: '', captchaCode: '', captchaLoading: false, verifyingCaptcha: false, captchaVerified: false, captchaVerificationToken: '', captchaError: '', sending: false, codeSent: false, emailCode: '', countdown: 0, changing: false, formError: '', timer: 0 })
const { statusBarHeight, email, captchaId, captchaImage, captchaCode, captchaLoading, verifyingCaptcha, captchaVerified, captchaError, sending, codeSent, emailCode, countdown, changing, formError } = toRefs(state)
const normalizedEmail = computed((): string => state.email.trim().toLowerCase())

onLoad(() => {
	state.statusBarHeight = uni.getWindowInfo().statusBarHeight
	if (getEmailChangeAuthorization().length != 64) {
		uni.showToast({ title: '验证已失效，请重新验证登录密码', icon: 'none' })
		uni.navigateBack({ delta: 1 })
		return
	}
	loadCaptcha()
})

onUnload(() => {
	if (state.timer > 0) clearInterval(state.timer)
	clearEmailChangeAuthorization()
})

function cancel() {
	if (state.sending || state.changing) return
	clearEmailChangeAuthorization()
	uni.navigateBack({ delta: 1 })
}

function loadCaptcha(preserveError: boolean = false): void {
	if (state.captchaLoading || state.verifyingCaptcha || state.captchaVerified) return
	state.captchaLoading = true
	if (!preserveError) state.captchaError = ''
	state.captchaId = ''
	state.captchaImage = ''
	fetchCaptcha().then((result: HttpResult) => {
		const data = walletPayload(result)
		const id = data == null ? null : jsonString(data, 'captchaId')
		const image = data == null ? null : jsonString(data, 'imageBase64')
		if (!result.ok || id == null || image == null || id.length == 0 || image.length == 0) {
			state.captchaError = result.message.length > 0 ? result.message : '图片验证码加载失败，请点击重试'
			return
		}
		state.captchaId = id
		state.captchaImage = image
	}).finally(() => { state.captchaLoading = false })
}

function verifyCaptcha(): void {
	if (state.verifyingCaptcha || state.captchaVerified) return
	const emailValue = state.email.trim().toLowerCase()
	if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailValue) || emailValue.length > 254) { state.captchaError = '请先输入正确的新邮箱'; return }
	if (state.captchaId.length == 0 || state.captchaCode.trim().length == 0) { state.captchaError = '请加载并填写图片验证码'; return }
	state.captchaError = ''
	state.verifyingCaptcha = true
	let refreshAfterVerification = false
	verifyEmailCaptcha(emailValue, getEmailChangeAuthorization(), state.captchaId, state.captchaCode.trim()).then((result: HttpResult) => {
		const data = walletPayload(result)
		const ticket = data == null ? null : jsonString(data, 'captchaVerificationToken')
		if (!result.ok || ticket == null || ticket.length != 64) {
			state.captchaError = result.message.length > 0 ? result.message : '图片验证码校验失败，请重新输入'
			state.captchaCode = ''
			state.captchaId = ''
			state.captchaImage = ''
			refreshAfterVerification = true
			return
		}
		state.email = emailValue
		state.captchaVerificationToken = ticket
		state.captchaVerified = true
		state.captchaImage = ''
		state.captchaCode = ''
	}).finally(() => {
		state.verifyingCaptcha = false
		if (refreshAfterVerification) loadCaptcha(true)
	})
}

function sendCode(): void {
	if (!state.captchaVerified || state.sending || state.codeSent) return
	const emailValue = state.email.trim().toLowerCase()
	if (emailValue.length == 0) { state.formError = '请输入新邮箱'; return }
	state.formError = ''
	state.sending = true
	let refreshAfterSendFailure = false
	sendEmailCode(emailValue, getEmailChangeAuthorization(), state.captchaVerificationToken).then((result: HttpResult) => {
		if (!result.ok) {
			state.formError = result.message.length > 0 ? result.message : '验证码发送失败'
			state.captchaVerified = false
			state.captchaVerificationToken = ''
			refreshAfterSendFailure = true
			return
		}
		state.codeSent = true
		state.captchaVerified = false
		state.captchaVerificationToken = ''
		state.countdown = 60
		state.timer = setInterval(() => {
			if (state.countdown > 0) state.countdown--
			else if (state.timer > 0) { clearInterval(state.timer); state.timer = 0 }
		}, 1000)
	}).finally(() => {
		state.sending = false
		if (refreshAfterSendFailure) loadCaptcha(true)
	})
}

function prepareResend(): void {
	if (state.sending || state.changing || state.countdown > 0) return
	state.codeSent = false
	state.emailCode = ''
	state.captchaVerified = false
	state.captchaVerificationToken = ''
	state.captchaCode = ''
	state.captchaError = ''
	loadCaptcha()
}

function confirmChange(): void {
	if (!state.codeSent || state.changing) return
	if (!/^[0-9]{6}$/.test(state.emailCode)) { state.formError = '请输入六位邮箱验证码'; return }
	state.formError = ''
	state.changing = true
	changeMyEmail(state.email.trim().toLowerCase(), getEmailChangeAuthorization(), state.emailCode).then((result: HttpResult) => {
		if (!result.ok) { state.formError = result.message.length > 0 ? result.message : '邮箱更换失败，请重试'; return }
		clearEmailChangeAuthorization()
		toastSuccess('邮箱已更新')
		uni.navigateBack({ delta: 1 })
	}).finally(() => { state.changing = false })
}
</script>

<style>
	@import '../../styles/account.css';
	.email-change-page { background-color: #FDF6F0; }
	.email-intro { margin: 6px 2px 18px 2px; }
	.email-step-kicker { color: #C2410C; font-size: 11px; line-height: 18px; font-weight: bold; letter-spacing: 1px; }
	.email-intro-title { margin-top: 6px; color: #211C18; font-size: 24px; line-height: 32px; font-weight: bold; }
	.email-intro-note { margin-top: 7px; color: #7A6C60; font-size: 13px; line-height: 21px; }
	.email-form-card { padding: 22px; }
	.email-step-heading { display: flex; flex-direction: row; align-items: center; margin-top: 26px; margin-bottom: 13px; }
	.email-step-number { display: flex; flex-shrink: 0; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: 10px; background-color: #FBE3D5; }
	.email-step-number-text { color: #C2410C; font-size: 13px; line-height: 18px; font-weight: bold; }
	.email-step-number-current { background-color: #E4572E; }
	.email-step-number-current-text { color: #FFFFFF; }
	.email-step-copy { flex: 1; min-width: 0; margin-left: 10px; }
	.email-step-title { color: #211C18; font-size: 14px; line-height: 20px; font-weight: bold; }
	.email-step-note { margin-top: 2px; color: #8B7B6F; font-size: 11px; line-height: 17px; }
	.email-captcha-row { display: flex; flex-direction: row; align-items: center; gap: 10px; }
	.email-captcha-input { flex: 1; min-width: 0; }
	.email-captcha-image-button { display: flex; flex-shrink: 0; width: 116px; height: 50px; margin: 0; padding: 3px; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #EADDD1; border-radius: 12px; background-color: #FFFFFF; }
	.email-captcha-image { width: 108px; height: 42px; }
	.email-captcha-placeholder { color: #C2410C; font-size: 11px; line-height: 16px; }
	.email-verified-state { display: flex; flex-direction: row; align-items: center; min-height: 48px; margin-top: 14px; padding: 0 14px; border-radius: 12px; background-color: #EDF5EB; }
	.email-check-mark { width: 9px; height: 5px; margin-right: 10px; border-left: 2px solid #386341; border-bottom: 2px solid #386341; transform: rotate(-45deg); }
	.email-verified-text { color: #386341; font-size: 13px; line-height: 20px; font-weight: bold; }
	.email-step-two { margin-top: 24px; }
	.email-send-action { display: flex; width: 100%; height: 50px; margin: 0; padding: 0; align-items: center; justify-content: center; border: 1px solid #E4572E; border-radius: 14px; background-color: #FFF9F5; }
	.email-send-action-text { color: #C2410C; font-size: 14px; line-height: 20px; font-weight: bold; }
	.email-sent-state { margin-top: 16px; padding: 15px; border-radius: 13px; background-color: #EDF5EB; }
	.email-sent-title { color: #386341; font-size: 14px; line-height: 20px; font-weight: bold; }
	.email-sent-note { margin-top: 4px; color: #526B51; font-size: 12px; line-height: 19px; overflow-wrap: anywhere; }
	.email-code-section { margin-top: 2px; }
	.email-resend-action { display: flex; min-height: 42px; margin: 6px 0 0 0; padding: 8px 0; align-items: center; justify-content: center; border: 0; background-color: transparent; }
	.email-resend-action-text { color: #C2410C; font-size: 12px; line-height: 18px; }
	.email-confirm-action { margin-top: 22px; }
	/* #ifdef WEB */
	.account-page .email-captcha-row, .account-page .email-step-heading, .account-page .email-verified-state { flex-direction: row; }
	.account-page .email-step-copy { min-width: 0; }
	.account-page .email-captcha-input { box-sizing: border-box; }
	/* #endif */
</style>
