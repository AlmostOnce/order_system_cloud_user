<template>
    <view class="account-page account-secondary recovery-page">
        <view class="account-status vapor-account-secondary--account-status"
            :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav vapor-account-secondary--account-nav">
            <button class="account-back vapor-account-secondary--account-back" :disabled="busy" aria-label="返回登录"
                @click="back">
                <view class="account-back-icon"></view>
            </button>
            <text class="account-title">找回登录密码</text>
        </view>
        <scroll-view class="account-scroll" scroll-y="true">
            <view class="account-content vapor-account-secondary--account-content">
                <view class="recovery-intro">
                    <text class="recovery-eyebrow">账号安全 · {{ step == 1 ? '验证邮箱' : (step == 2 ? '设置新密码' : '已完成') }}
                    </text>
                    <text class="recovery-title">{{ step == 1 ? '用邮箱找回账号' : (step == 2 ? '设置新的登录密码' : '密码已更新') }}</text>
                    <text class="recovery-note">
                        {{ step == 1 ? '请输入账号绑定的邮箱，验证后即可设置新密码。' : (step == 2 ? '邮箱身份已验证，请在5分钟内完成设置。' : '所有设备的旧登录会话已失效，请使用新密码重新登录。') }}
                    </text>
                </view>
                <view v-if="step == 1" class="account-card vapor-account-secondary--account-card">
                    <text class="account-label vapor-account-secondary--account-label">绑定邮箱</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="email" :maxlength="254"
                        :disabled="busy || codeSent" placeholder="请输入账号绑定的邮箱" aria-label="绑定邮箱" />
                    <view v-if="!codeSent">
                        <text class="account-label vapor-account-secondary--account-label">图片验证码</text>
                        <view class="recovery-captcha-row">
                            <input class="account-input vapor-account-secondary--account-input recovery-captcha-input"
                                v-model="captchaCode" :maxlength="8" :disabled="busy || captchaLoading"
                                placeholder="输入图中字符" aria-label="图片验证码" />
                            <button class="recovery-captcha-button" :disabled="busy || captchaLoading"
                                aria-label="更换图片验证码" @click="loadCaptcha">
                                <image v-if="captchaImage.length > 0" class="recovery-captcha-image" :src="captchaImage"
                                    mode="aspectFit"></image>
                                <text v-else class="account-muted">{{ captchaLoading ? '加载中…' : '点击获取' }}</text>
                            </button>
                        </view>
                        <button class="account-primary vapor-account-secondary--account-primary"
                            :disabled="busy || captchaLoading" @click="sendCode">
                            <text class="account-primary-text">{{ busy ? '正在发送…' : '发送邮箱验证码' }}</text>
                        </button>
                    </view>
                    <view v-else>
                        <text class="recovery-note recovery-sent">若该邮箱已绑定可用账号，将收到验证码，10分钟内有效。</text>
                        <text class="account-label vapor-account-secondary--account-label">邮箱验证码</text>
                        <input class="account-input vapor-account-secondary--account-input" v-model="emailCode"
                            type="number" :maxlength="6" :disabled="busy" placeholder="请输入六位数字" aria-label="邮箱验证码" />
                        <button class="account-primary vapor-account-secondary--account-primary" :disabled="busy"
                            @click="verifyCode">
                            <text class="account-primary-text">{{ busy ? '正在验证…' : '验证并继续' }}</text>
                        </button>
                        <button class="account-link" :disabled="busy || countdown > 0" @click="prepareResend">
                            <text class="account-link-text">{{ countdown > 0 ? countdown + '秒后可重新发送' : '重新发送或更换邮箱' }}
                            </text>
                        </button>
                    </view>
                </view>
                <view v-if="step == 2" class="account-card vapor-account-secondary--account-card">
                    <text class="account-label vapor-account-secondary--account-label">新登录密码</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="password"
                        :password="true" :maxlength="64" :disabled="busy" placeholder="6至64个字符" aria-label="新登录密码" />
                    <text class="account-label vapor-account-secondary--account-label">确认新密码</text>
                    <input class="account-input vapor-account-secondary--account-input" v-model="confirmation"
                        :password="true" :maxlength="64" :disabled="busy" placeholder="请再次输入新密码" aria-label="确认新密码"
                        confirm-type="done" @confirm="resetPassword" />
                    <button class="account-primary vapor-account-secondary--account-primary" :disabled="busy"
                        @click="resetPassword">
                        <text class="account-primary-text">{{ busy ? '正在保存…' : '确认重置密码' }}</text>
                    </button>
                    <button class="account-link" :disabled="busy" @click="restart">
                        <text class="account-link-text">重新验证邮箱</text>
                    </button>
                </view>
                <text v-if="errorText.length > 0" class="account-error" role="alert">{{ errorText }}</text>
                <button v-if="step == 3" class="account-primary vapor-account-secondary--account-primary" @click="back">
                    <text class="account-primary-text">返回登录</text>
                </button>
                <text v-if="step == 1" class="account-note">未绑定邮箱的账号暂不支持通过邮件自助找回。</text>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
    import { reactive, toRefs } from 'vue'
    import { fetchCaptcha, sendPasswordResetCode, verifyPasswordResetCode, confirmPasswordReset } from '../../api/auth.uts'
    import { jsonObject, jsonString, jsonNumber } from '../../common/json.uts'
    import { clearTokens } from '../../common/storage.uts'
    import { stopNotificationSession } from '../../store/notifications.uts'

    const state = reactive({ statusBarHeight: 0, step: 1, email: '', captchaId: '', captchaImage: '', captchaCode: '', captchaLoading: false, emailCode: '', codeSent: false, countdown: 0, busy: false, errorText: '', resetToken: '', grantExpiresAt: 0, password: '', confirmation: '' })
    const { statusBarHeight, step, email, captchaImage, captchaCode, captchaLoading, emailCode, codeSent, countdown, busy, errorText, password, confirmation } = toRefs(state)
    let timer = 0
    let pageVersion = 0
    function stopTimer() { if (timer > 0) { clearInterval(timer); timer = 0 } }
    function startCountdown() { stopTimer(); state.countdown = 60; timer = setInterval(() => { state.countdown = Math.max(0, state.countdown - 1); if (state.countdown == 0) stopTimer() }, 1000) }
    async function loadCaptcha() : Promise<void> {
        if (state.captchaLoading || state.busy || state.codeSent) return
        const version = pageVersion; state.captchaLoading = true; state.captchaCode = ''; state.captchaId = ''; state.captchaImage = ''
        try {

            const result = await fetchCaptcha(); if (version != pageVersion) return
            const data = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
            state.captchaId = data == null ? '' : (jsonString(data, 'captchaId') ?? ''); state.captchaImage = data == null ? '' : (jsonString(data, 'imageBase64') ?? '')
            if (state.captchaId.length == 0 || state.captchaImage.length == 0) state.errorText = result.message.length > 0 ? result.message : '图片验证码加载失败，请点击重试'
        } catch (_error) { if (version == pageVersion) state.errorText = '图片验证码加载失败，请点击重试' } finally { if (version == pageVersion) state.captchaLoading = false }
    }
    async function sendCode() : Promise<void> {
        if (state.busy || state.captchaLoading || state.codeSent || state.step != 1) return
        state.errorText = ''
        const email = state.email.trim().toLowerCase()
        if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { state.errorText = '请输入正确的绑定邮箱'; return }
        if (state.captchaId.length == 0 || state.captchaCode.trim().length == 0) { state.errorText = '请填写图片验证码'; return }
        const version = pageVersion; state.busy = true
        try {

            const result = await sendPasswordResetCode(email, state.captchaId, state.captchaCode.trim()); if (version != pageVersion) return
            if (!result.ok) { state.errorText = result.message.length > 0 ? result.message : '发送失败，请稍后重试'; return }
            state.email = email; state.codeSent = true; state.captchaCode = ''; state.captchaId = ''; state.captchaImage = ''; startCountdown()
        } catch (_error) { if (version == pageVersion) state.errorText = '发送失败，请稍后重新验证发送' } finally { if (version == pageVersion) { state.busy = false; if (!state.codeSent) loadCaptcha() } }
    }
    async function verifyCode() : Promise<void> {
        if (state.busy || !state.codeSent || state.step != 1) return
        state.errorText = ''
        if (!/^[0-9]{6}$/.test(state.emailCode)) { state.errorText = '请输入六位邮箱验证码'; return }
        const version = pageVersion; state.busy = true
        try {

            const result = await verifyPasswordResetCode(state.email, state.emailCode); if (version != pageVersion) return
            const raw = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
            const token = raw == null ? '' : (jsonString(raw, 'resetToken') ?? ''); const expires = raw == null ? 0 : (jsonNumber(raw, 'expiresIn') ?? 0)
            if (!/^[a-f0-9]{64}$/.test(token) || expires <= 0 || expires > 300) { state.errorText = result.message.length > 0 ? result.message : '邮箱验证失败，请重新获取验证码'; return }
            state.resetToken = token; state.grantExpiresAt = Date.now() + expires * 1000; state.emailCode = ''; state.step = 2; stopTimer()
        } catch (_error) { if (version == pageVersion) state.errorText = '验证结果未确认，请重新获取验证码' } finally { if (version == pageVersion) state.busy = false }
    }
    async function resetPassword() : Promise<void> {
        if (state.busy || state.step != 2) return
        state.errorText = ''
        if (state.resetToken.length == 0 || Date.now() >= state.grantExpiresAt) { restart(); state.errorText = '身份验证已过期，请重新验证邮箱'; return }
        if (state.password.length < 6 || state.password.length > 64) { state.errorText = '新密码须为6至64个字符'; return }
        if (state.password != state.confirmation) { state.errorText = '两次输入的密码不一致'; return }
        const version = pageVersion; state.busy = true
        try {

            const result = await confirmPasswordReset(state.resetToken, state.password); if (version != pageVersion) return
            if (!result.ok) { state.errorText = result.statusCode == 0 ? '结果暂未确认，可尝试使用新密码登录；如未生效，请重新验证邮箱' : (result.message.length > 0 ? result.message : '重置失败，请重新验证邮箱'); if (result.statusCode == 409) state.resetToken = ''; return }
            state.step = 3; state.resetToken = ''; state.grantExpiresAt = 0; clearTokens(); stopNotificationSession(true)
        } catch (_error) { if (version == pageVersion) state.errorText = '结果暂未确认，可尝试使用新密码登录；如未生效，请重新验证邮箱' } finally { if (version == pageVersion) { state.busy = false; state.password = ''; state.confirmation = '' } }
    }
    function prepareResend() { if (state.busy || state.countdown > 0) return; state.codeSent = false; state.emailCode = ''; state.errorText = ''; loadCaptcha() }
    function restart() { if (state.busy) return; state.step = 1; state.codeSent = false; state.resetToken = ''; state.grantExpiresAt = 0; state.password = ''; state.confirmation = ''; state.emailCode = ''; state.errorText = ''; state.countdown = 0; stopTimer(); loadCaptcha() }
    function back() { if (!state.busy) uni.reLaunch({ url: '/pages/login/login' }) }
    onLoad(() => { state.statusBarHeight = uni.getWindowInfo().statusBarHeight; loadCaptcha() })
    onPageHide(() => { pageVersion++; stopTimer(); state.resetToken = ''; state.grantExpiresAt = 0; state.password = ''; state.confirmation = ''; state.emailCode = ''; state.step = 1; state.codeSent = false; state.busy = false; state.captchaLoading = false; state.countdown = 0 })
    onUnload(() => { pageVersion++; stopTimer(); state.resetToken = ''; state.password = ''; state.confirmation = ''; state.emailCode = '' })
    onPageShow(() => { if (state.captchaId.length == 0 && !state.busy && !state.captchaLoading && state.step == 1) loadCaptcha() })
</script>
<style>
    @import '../../styles/account.css';

    .recovery-intro {
        padding: 8px 2px 24px;
    }

    .recovery-eyebrow {
        font-size: 12px;
        line-height: 20px;
        color: #C2410C;
    }

    .recovery-title {
        margin-top: 8px;
        font-size: 24px;
        line-height: 34px;
        color: #211C18;
        font-weight: bold;
    }

    .recovery-note {
        margin-top: 10px;
        font-size: 13px;
        line-height: 22px;
        color: #7A6C60;
    }

    .recovery-sent {
        padding: 12px;
        border-radius: 10px;
        background-color: #FDF6F0;
    }

    .recovery-captcha-row {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .recovery-captcha-input {
        flex: 1;
        width: 0;
        min-width: 0;
        margin-right: 12px;
    }

    .recovery-captcha-button {
        display: flex;
        flex-shrink: 0;
        width: 112px;
        height: 50px;
        padding: 0;
        margin: 0;
        align-items: center;
        justify-content: center;
        border-width: 1px;
        border-style: solid;
        border-color: #E8DED4;
        border-radius: 12px;
        background-color: #FDF6F0;
    }

    .recovery-captcha-image {
        width: 108px;
        height: 44px;
    }

    /* #ifdef WEB */
    .account-page .recovery-captcha-row {
        flex-direction: row;
    }

    .recovery-captcha-input {
        box-sizing: border-box;
    }

    .recovery-captcha-button::after {
        border: none;
    }

    /* #endif */
</style>