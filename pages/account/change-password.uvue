<template>
	<view class="account-page account-secondary">
		<view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
		<view class="account-nav vapor-account-secondary--account-nav">
			<view class="account-back vapor-account-secondary--account-back" @click="goBack">
				<view class="account-back-icon"></view>
			</view>
			<text class="account-title">修改登录密码</text>
		</view>
		<scroll-view class="account-scroll" direction="vertical">
			<view class="account-content vapor-account-secondary--account-content">
				<view class="account-card vapor-account-secondary--account-card">
					<text class="account-heading">修改登录密码</text>
					<text class="account-note">需要先验证当前密码。修改成功后，本账号在所有设备上的登录状态都会失效，请使用新密码重新登录。</text>
					<text class="account-label vapor-account-secondary--account-label">当前密码</text>
					<input class="account-input vapor-account-secondary--account-input" type="text" :password="true" v-model="currentPassword" :maxlength="64" :disabled="saving" placeholder="请输入当前登录密码" />
					<text class="account-label vapor-account-secondary--account-label">新密码</text>
					<input class="account-input vapor-account-secondary--account-input" type="text" :password="true" v-model="newPassword" :maxlength="64" :disabled="saving" placeholder="6 至 64 位，不能与当前密码相同" />
					<text class="account-label vapor-account-secondary--account-label">再次输入新密码</text>
					<input class="account-input vapor-account-secondary--account-input" type="text" :password="true" v-model="confirmPassword" :maxlength="64" :disabled="saving" placeholder="再次输入新密码" confirm-type="done" @confirm="save" />
					<text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
					<button class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" :disabled="saving" :class="saving ? 'account-disabled' : ''" @click="save">{{ saving ? '正在保存…' : '确认修改' }}</button>
					<text class="account-note">如果已经忘记当前密码，请退出登录后使用登录页的“忘记密码”找回。</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { reactive, toRefs } from 'vue'
import { toast, toastSuccess } from '../../common/feedback.uts'
import { changeLoginPassword } from '../../api/wallet.uts'
import { HttpResult } from '../../common/http.uts'
import { isLoggedIn, currentUser, logout } from '../../store/auth.uts'
import { backToAccount } from '../../common/account.uts'

/**
 * 页面状态。
 * 三个密码字段只在内存中保存，离开页面即清空，避免被系统快照或返回栈长期保留。
 */
const state = reactive({ statusBarHeight: 0, currentPassword: '', newPassword: '', confirmPassword: '', errorText: '', saving: false })

const { statusBarHeight, currentPassword, newPassword, confirmPassword, errorText, saving } = toRefs(state)

function goBack() {
	if (!state.saving)
		backToAccount()
}

function clearPasswords() {
	state.currentPassword = ''
	state.newPassword = ''
	state.confirmPassword = ''
}

function goLogin() {
	uni.reLaunch({ url: '/pages/login/login' })
}

/**
 * 提交修改。
 *
 * 先做与服务端一致的字符长度校验，减少无意义请求；当前密码错误由服务端返回
 * 明确提示，不能用本地校验替代。成功后服务端已递增凭据版本，本地必须清理
 * 全部登录态并回到登录页，否则后续请求会持续收到 401。
 */
function save() {
	if (state.saving)
		return
	state.errorText = ''
	if (state.currentPassword.length == 0) {
		state.errorText = '请输入当前登录密码'
		toast(state.errorText)
		return
	}
	if (state.newPassword.length < 6 || state.newPassword.length > 64) {
		state.errorText = '新密码长度为 6 至 64 位'
		toast(state.errorText)
		return
	}
	if (state.newPassword != state.confirmPassword) {
		state.errorText = '两次输入的新密码不一致'
		toast(state.errorText)
		return
	}
	if (state.newPassword == state.currentPassword) {
		state.errorText = '新密码不能与当前密码相同'
		toast(state.errorText)
		return
	}
	state.saving = true
	changeLoginPassword(state.currentPassword, state.newPassword).then((result: HttpResult) => {
		state.saving = false
		if (!result.ok) {
			state.errorText = result.message.length > 0 ? result.message : '修改失败，请稍后重试'
			toast(state.errorText)
			return
		}
		clearPasswords()
		toastSuccess('密码已修改，请重新登录')
		// 服务端版本已变化，无论退出接口是否成功都必须清空本地凭据。
		logout().then(() => { goLogin() }).catch(() => { goLogin() })
	}).catch(() => {
		state.saving = false
		state.errorText = '网络异常，请稍后重试'
		toast(state.errorText)
	})
}

onPageShow(() => {
	state.statusBarHeight = uni.getWindowInfo().statusBarHeight
	if (!isLoggedIn()) {
		uni.reLaunch({ url: '/pages/login/login' })
		return
	}
	const user = currentUser()
	// 管理角色使用独立管理端，学生端只允许 CUSTOMER。
	if (user == null || user.roleCode != 'CUSTOMER') {
		uni.switchTab({ url: '/pages/mine/mine' })
	}
})

onPageHide(() => {
	clearPasswords()
})

onUnload(() => {
	clearPasswords()
})
</script>

<style>
	@import '../../styles/account.css';
</style>
