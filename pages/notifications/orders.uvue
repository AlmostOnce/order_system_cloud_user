<template>
    <view class="account-page order-thread">
        <view class="account-status thread-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav thread-nav">
            <view class="account-back thread-back" @click="goBack">
                <view class="account-back-icon"></view>
            </view>
            <view class="thread-heading"><text class="thread-title">订单中心</text></view><view class="thread-nav-spacer"></view></view>
        <scroll-view class="account-scroll" direction="vertical" :scroll-into-view="scrollTarget" @scrolltoupper="loadMore" :refresher-enabled="refreshing || !loading" :refresher-triggered="refreshing" refresher-background="#F1F1F1" refresher-default-style="none" :refresher-threshold="72" @refresherrefresh="refreshPage">
            <view class="thread-content">
                <text v-if="loading" class="thread-history-hint">正在获取通知…</text>
                <text v-else-if="loaded && !hasMore && chronologicalItems.length > 0" class="thread-history-hint">以上为全部订单通知</text>
                <text v-else-if="hasMore" class="thread-history-hint">向上滑动查看更早通知</text>
                <text v-if="errorText.length >0" class="account-error">
{{ errorText }}</text>
                <view v-if="loaded && items.length == 0 && errorText.length == 0" class="thread-empty"><image class="thread-empty-avatar" src="/static/notifications/order-center.svg" mode="aspectFit"></image><text class="thread-empty-title">暂无订单通知</text><text class="thread-empty-note">订单状态更新后，通知会显示在这里</text></view>
                <view v-for="item in chronologicalItems" :id="'notice-' + item.notificationId" :key="item.notificationId" class="thread-message">
                    <text class="thread-time">{{ formatDate(item.createdAt) }}</text>
                    <view class="thread-message-row"><image class="thread-avatar" src="/static/notifications/order-center.svg" mode="aspectFit"></image><view class="thread-message-content"><text class="thread-sender">订单中心</text>
                            <view class="thread-bubble" @click="() => { if (!(item.orderId <= 0)) openNotification(item) }" :style="(item.orderId <= 0) ? 'opacity:0.5' : ''">
                                <text class="thread-bubble-title">{{ item.title }}</text><text class="thread-body">{{ item.content }}</text><view v-if="item.orderId > 0" class="thread-order-link"><text class="thread-order-label">查看订单</text><view class="thread-order-arrow"></view></view>
                            </view>
                        </view></view>
                </view>
                <view id="thread-bottom" class="thread-bottom"></view>
            </view>
            <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import { reactive, toRefs, computed } from 'vue'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue'
import { NotificationItem, fetchNotifications, markNotificationRead, parseNotificationPage } from '../../api/notifications.uts'
import { startNotificationSession, subscribeNotifications, unsubscribeNotifications, refreshNotificationCount } from '../../store/notifications.uts'
import { accountDate } from '../../common/account.uts'
import { currentUser } from '../../store/auth.uts'
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
import { toast } from '../../common/feedback.uts'

const initialItems: Array<NotificationItem> = []
const state = reactive({ statusBarHeight: 0, userUuid: '', version: 0, items: initialItems, loading: false, loaded: false, refreshing: false, currentRefreshTime: '', errorText: '', cursor: '', hasMore: false, opening: false, scrollTarget: '' })
let pageVisible = false
let pendingRefresh = false
const chronologicalItems = computed((): Array<NotificationItem> => state.items.slice().reverse())
const { statusBarHeight, items, loading, loaded, refreshing, currentRefreshTime, errorText, hasMore, scrollTarget } = toRefs(state)
async function load(reset: boolean): Promise<void> {
    if (state.loading || (!reset && !state.hasMore)) return
    state.loading = true; state.errorText = ''
    const version = state.version
    try {
        const result = await fetchNotifications(reset ? '' : state.cursor)
        if (version != state.version || currentUser()?.userUuid != state.userUuid) return
        const page = parseNotificationPage(result)
        if (page == null || (!reset && page.hasMore && page.nextCursor == state.cursor)) { state.errorText = result.message.length > 0 ? result.message : '消息暂时不可用，请下拉重试'; return }
        const previousOldest = state.items.length > 0 ? state.items[state.items.length - 1].notificationId : ''
        const overlaps = page.items.some((item: NotificationItem): boolean => state.items.some((old: NotificationItem): boolean => old.notificationId == item.notificationId))
        const firstPage = !state.loaded || state.items.length == 0 || (reset && !overlaps && page.hasMore)
        if (reset) {
            const older = firstPage ? [] as Array<NotificationItem> : state.items.filter((old: NotificationItem): boolean => !page.items.some((item: NotificationItem): boolean => item.notificationId == old.notificationId))
            state.items = page.items.concat(older)
        }
        else for (let i = 0; i < page.items.length; i++) { const item = page.items[i]; if (!state.items.some((old: NotificationItem): boolean => old.notificationId == item.notificationId)) state.items.push(item) }
        if (!reset || firstPage) { state.cursor = page.nextCursor; state.hasMore = page.hasMore }
        state.loaded = true
        state.scrollTarget = ''
        setTimeout(() => {
            if (version == state.version && pageVisible) state.scrollTarget = reset ? 'thread-bottom' : 'notice-' + previousOldest
        }, 0)
        // Only notifications actually loaded into this conversation are marked read.
        await Promise.all(page.items.map(async (item: NotificationItem): Promise<void> => {
            if (item.readAt.length > 0) return
            const readResult = await markNotificationRead(item.notificationId)
            if (version != state.version || currentUser()?.userUuid != state.userUuid) return
            if (readResult.ok) item.readAt = new Date().toISOString()
        }))
        refreshNotificationCount()
    } finally {
        if (version == state.version) {
            state.loading = false
            if (pendingRefresh && pageVisible) { pendingRefresh = false; load(true) }
        }
    }
}
function loadMore() { if (!state.refreshing) load(false) }
function refreshPage() {
    if (state.loading || state.refreshing) return
    state.refreshing = true; const start = Date.now(); state.currentRefreshTime = refreshTimeLabel(start)
    load(true).then(() => { finishPullRefresh(start, state.errorText.length == 0, (_time: string) => { state.refreshing = false }) }).catch(() => { finishPullRefresh(start, false, (_time: string) => { state.refreshing = false }) })
}
async function openNotification(item: NotificationItem): Promise<void> {
    if (state.opening) return
    state.opening = true
    const version = state.version
    try {
        if (item.readAt.length == 0) { const result = await markNotificationRead(item.notificationId); if (version != state.version || currentUser()?.userUuid != state.userUuid) return; if (!result.ok) { toast(result.message.length > 0 ? result.message : '消息状态更新失败'); return } item.readAt = new Date().toISOString(); refreshNotificationCount() }
        if (item.orderId > 0) uni.navigateTo({ url: '/pages/order/detail?orderId=' + item.orderId })
    } finally { state.opening = false }
}
function goBack() { uni.navigateBack({ delta: 1, fail: () => { uni.switchTab({ url: '/pages/notifications/list' }) } }) }
function formatDate(value: string): string { return accountDate(value) }
function notificationChanged(): void {
    if (!pageVisible) return
    if (state.loading) pendingRefresh = true
    else load(true)
}
onPageShow(() => {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight
    const user = currentUser()
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    if (state.userUuid != user.userUuid) { state.version++; state.userUuid = user.userUuid; state.items = []; state.loading = false; state.loaded = false; state.cursor = ''; state.hasMore = false; state.errorText = ''; state.scrollTarget = '' }
    load(true)
    pageVisible = true; subscribeNotifications(notificationChanged); startNotificationSession()
})
onPageHide(() => { pageVisible = false; pendingRefresh = false; unsubscribeNotifications(notificationChanged) })
onUnload(() => { pageVisible = false; state.version++; unsubscribeNotifications(notificationChanged) })
</script>
<style>
@import '../../styles/account.css';
.order-thread { background-color: #F1F1F1; }
.thread-status { background-color: #F5F5F5; }
.thread-nav { height: 52px; padding: 0 8px; background-color: #F5F5F5; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #E5E5E5; }
.thread-back { background-color: transparent; border-radius: 0; }
.thread-heading { flex: 1; align-items: center; }
.thread-title { color: #202020; font-size: 17px; line-height: 24px; font-weight: bold; }
.thread-nav-spacer { width: 44px; flex-shrink: 0; }
.thread-content { padding: 16px 12px 8px; }
.thread-history-hint { text-align: center; font-size: 11px; line-height: 18px; color: #999999; padding-bottom: 16px; }
.thread-message { margin-bottom: 20px; }
.thread-time { color: #999999; font-size: 11px; line-height: 18px; text-align: center; margin-bottom: 12px; }
.thread-message-row { flex-direction: row; align-items: flex-start; }
.thread-avatar { width: 38px; height: 38px; flex-shrink: 0; border-radius: 8px; }
.thread-message-content { flex: 1; min-width: 0; margin-left: 9px; margin-right: 16px; }
.thread-sender { color: #888888; font-size: 11px; line-height: 16px; margin-bottom: 4px; }
.thread-bubble { width: 100%; padding: 12px; border-radius: 3px 10px 10px 10px; background-color: #FFFFFF; }
.thread-bubble-title { color: #202020; font-size: 14px; line-height: 21px; font-weight: bold; }
.thread-body { margin-top: 6px; color: #444444; font-size: 14px; line-height: 22px; }
.thread-order-link { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-top-style: solid; border-top-color: #EEEEEE; }
.thread-order-label { color: #C2410C; font-size: 12px; line-height: 18px; }
.thread-order-arrow { width: 6px; height: 6px; border-right-width: 1px; border-right-style: solid; border-right-color: #C2410C; border-top-width: 1px; border-top-style: solid; border-top-color: #C2410C; transform: rotate(45deg); margin-right: 3px; }
.thread-bottom { height: 12px; }
.thread-empty { align-items: center; padding: 64px 12px; }
.thread-empty-avatar { width: 54px; height: 54px; margin-bottom: 16px; }
.thread-empty-title { font-size: 16px; line-height: 24px; color: #666666; }
.thread-empty-note { margin-top: 6px; font-size: 12px; line-height: 20px; color: #888888; text-align: center; }
/* #ifdef WEB */
.account-page .thread-nav, .account-page .thread-message-row, .account-page .thread-order-link { flex-direction: row; }
.account-page .thread-nav { height: 52px; min-height: 52px; padding: 0 8px; }
.account-page .thread-bubble { box-sizing: border-box; }
/* #endif */
</style>
