<template>
    <view class="account-page conversation-page">
        <view class="account-status conversation-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav conversation-nav"><text class="conversation-page-title">消息</text></view>
        <scroll-view class="account-scroll" direction="vertical" :refresher-enabled="refreshing || !loading" :refresher-triggered="refreshing" refresher-background="#F5F5F5" refresher-default-style="none" :refresher-threshold="72" @refresherrefresh="refreshPage">
            <view class="conversation-list">
                <view class="conversation-entry" hover-class="conversation-entry-pressed" @click="openOrders">
                    <image class="conversation-avatar" src="/static/notifications/order-center.svg" mode="aspectFit"></image>
                    <view class="conversation-copy">
                        <text class="conversation-name" :max-lines="1">订单中心</text>
                        <text class="conversation-preview" :max-lines="1">{{ preview }}</text>
                    </view>
                    <view class="conversation-meta">
                        <text v-if="latest != null" class="conversation-time">{{ latestTime }}</text>
                        <view v-if="unreadCount > 0" class="conversation-badge"><text class="conversation-badge-text">{{ unreadCount > 99 ? '99+' : unreadCount }}</text></view>
                    </view>
                </view>
                <view class="conversation-divider"></view>
                <text v-if="errorText.length >0" class="conversation-error">
{{ errorText }}</text>
            </view>
            <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import { reactive, toRefs, computed } from 'vue'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue'
import { NotificationItem, fetchNotifications, parseNotificationPage } from '../../api/notifications.uts'
import { notificationState, startNotificationSession, subscribeNotifications, unsubscribeNotifications, refreshNotificationCount } from '../../store/notifications.uts'
import { currentUser } from '../../store/auth.uts'
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
import { accountDate } from '../../common/account.uts'

const state = reactive({ statusBarHeight: 0, userUuid: '', version: 0, loading: false, loaded: false, refreshing: false, currentRefreshTime: '', errorText: '', latest: null as NotificationItem | null })
const { statusBarHeight, loading, refreshing, currentRefreshTime, errorText, latest } = toRefs(state)
const unreadCount = computed((): number => notificationState.unreadCount)
const preview = computed((): string => {
    const item = state.latest
    return item != null ? item.content : (state.loading ? '正在获取最新通知…' : (state.loaded ? '暂无订单通知' : '订单状态更新会显示在这里'))
})
const latestTime = computed((): string => {
    const item = state.latest
    return item == null ? '' : accountDate(item.createdAt).substring(5, 16)
})
let visible = false
let pending = false
async function load(): Promise<void> {
    if (state.loading) { pending = true; return }
    state.loading = true; state.errorText = ''
    const version = state.version
    try {
        const result = await fetchNotifications('')
        if (version != state.version || currentUser()?.userUuid != state.userUuid) return
        const page = parseNotificationPage(result)
        if (page == null) { state.errorText = result.message.length > 0 ? result.message : '消息暂时不可用，请下拉重试'; return }
        state.latest = page.items.length > 0 ? page.items[0] : null
        state.loaded = true
    } finally {
        if (version == state.version) {
            state.loading = false
            if (pending && visible) { pending = false; load() }
        }
    }
}
function refreshPage(): void {
    if (state.loading || state.refreshing) return
    state.refreshing = true
    const start = Date.now(); state.currentRefreshTime = refreshTimeLabel(start)
    Promise.all([load(), refreshNotificationCount()]).finally(() => {
        finishPullRefresh(start, state.errorText.length == 0, (_time: string) => { state.refreshing = false })
    })
}
function changed(): void { if (visible) load() }
function openOrders(): void { uni.navigateTo({ url: '/pages/notifications/orders' }) }
onPageShow(() => {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight
    const user = currentUser()
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    if (user.userUuid != state.userUuid) { state.version++; state.userUuid = user.userUuid; state.latest = null; state.loaded = false; state.loading = false; state.errorText = '' }
    visible = true; subscribeNotifications(changed); startNotificationSession(); load()
})
onPageHide(() => { visible = false; pending = false; unsubscribeNotifications(changed) })
onUnload(() => { visible = false; state.version++; unsubscribeNotifications(changed) })
</script>
<style>
@import '../../styles/account.css';
.conversation-page { background-color: #FFFFFF; }
.conversation-status { background-color: #F5F5F5; }
.conversation-nav { height: 52px; padding: 0 16px; background-color: #F5F5F5; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #EAEAEA; }
.conversation-page-title { color: #202020; font-size: 20px; line-height: 28px; font-weight: bold; }
.conversation-list { padding-bottom: 24px; }
.conversation-entry { flex-direction: row; align-items: center; width: 100%; min-height: 80px; padding: 14px 16px; background-color: #FFFFFF; }
.conversation-entry-pressed { background-color: #F2F2F2; }
.conversation-avatar { width: 50px; height: 50px; border-radius: 10px; flex-shrink: 0; margin-right: 12px; }
.conversation-copy { flex: 1; min-width: 0; }
.conversation-name { color: #202020; font-size: 16px; line-height: 23px; }
.conversation-preview { color: #888888; font-size: 13px; line-height: 20px; margin-top: 4px; }
.conversation-meta { width: 72px; height: 47px; flex-shrink: 0; margin-left: 8px; align-items: flex-end; justify-content: space-between; }
.conversation-time { color: #999999; font-size: 10px; line-height: 16px; }
.conversation-badge { min-width: 18px; height: 18px; padding: 0 5px; align-items: center; justify-content: center; border-radius: 10px; background-color: #EF4B4B; }
.conversation-badge-text { color: #FFFFFF; font-size: 10px; line-height: 18px; }
.conversation-divider { height: 1px; margin-left: 78px; background-color: #EEEEEE; }
.conversation-error { padding: 14px 16px; color: #B73920; font-size: 12px; line-height: 20px; }
/* #ifdef WEB */
.account-page .conversation-nav, .account-page .conversation-entry { flex-direction: row; }
.account-page .conversation-nav { height: 52px; padding: 0 16px; min-height: 52px; }
.account-page .conversation-name, .account-page .conversation-preview { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; overflow-wrap: normal; }
/* #endif */
</style>
