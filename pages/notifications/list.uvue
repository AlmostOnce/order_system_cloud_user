<template>
    <view class="account-page account-secondary">
        <view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav vapor-account-secondary--account-nav conversation-nav"><text class="conversation-page-title">消息</text></view>
        <scroll-view class="account-scroll" scroll-y="true" :refresher-enabled="refreshing || !loading" :refresher-triggered="refreshing" refresher-background="#FDF6F0" refresher-default-style="none" :refresher-threshold="72" @refresherrefresh="refreshPage">
            <refresh-header slot="refresher" :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            <view class="conversation-list">
                <button class="conversation-entry" aria-label="订单中心，查看所有订单通知" @click="openOrders">
                    <view class="conversation-avatar-wrap"><image class="conversation-avatar" src="/static/notifications/order-center.svg" mode="aspectFit"></image><view v-if="unreadCount > 0" class="conversation-badge"><text class="conversation-badge-text">{{ unreadCount > 99 ? '99+' : unreadCount }}</text></view></view>
                    <view class="conversation-copy"><view class="conversation-title-row"><text class="conversation-name">订单中心</text><text v-if="latest != null" class="conversation-time">{{ latestTime }}</text></view><text class="conversation-preview">{{ preview }}</text></view>
                </button>
                <text v-if="errorText.length > 0" class="conversation-error" role="alert">{{ errorText }}</text>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import { reactive, toRefs, computed } from 'vue'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue'
import { NotificationItem, fetchNotifications, parseNotificationPage } from '../../api/notifications.uts'
import { notificationState, startNotificationSession, subscribeNotifications, unsubscribeNotifications, refreshNotificationCount } from '../../store/notifications.uts'
import { currentUser } from '../../store/auth.uts'
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
import { accountDate } from '../../common/account.uts'

const state = reactive({ statusBarHeight: 0, userUuid: '', version: 0, loading: false, loaded: false, refreshing: false, currentRefreshTime: '', errorText: '', latest: null as NotificationItem | null })
const { statusBarHeight, loading, refreshing, currentRefreshTime, errorText, latest } = toRefs(state)
const unreadCount = computed((): number => notificationState.unreadCount)
const preview = computed((): string => {
    const item = state.latest
    return item != null ? item.content : (state.loading ? '正在获取最新通知…' : (state.loaded ? '暂无订单通知' : '订单状态更新会显示在这里'))
})
const latestTime = computed((): string => {
    const item = state.latest
    return item == null ? '' : accountDate(item.createdAt).substring(5, 16)
})
let visible = false
let pending = false
async function load(): Promise<void> {
    if (state.loading) { pending = true; return }
    state.loading = true; state.errorText = ''
    const version = state.version
    try {
        const result = await fetchNotifications('')
        if (version != state.version || currentUser()?.userUuid != state.userUuid) return
        const page = parseNotificationPage(result)
        if (page == null) { state.errorText = result.message.length > 0 ? result.message : '消息暂时不可用，请下拉重试'; return }
        state.latest = page.items.length > 0 ? page.items[0] : null
        state.loaded = true
    } finally {
        if (version == state.version) {
            state.loading = false
            if (pending && visible) { pending = false; load() }
        }
    }
}
function refreshPage(): void {
    if (state.loading || state.refreshing) return
    state.refreshing = true
    const start = Date.now(); state.currentRefreshTime = refreshTimeLabel(start)
    Promise.all([load(), refreshNotificationCount()]).finally(() => {
        finishPullRefresh(start, state.errorText.length == 0, (_time: string) => { state.refreshing = false })
    })
}
function changed(): void { if (visible) load() }
function openOrders(): void { uni.navigateTo({ url: '/pages/notifications/orders' }) }
onPageShow(() => {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight
    const user = currentUser()
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    if (user.userUuid != state.userUuid) { state.version++; state.userUuid = user.userUuid; state.latest = null; state.loaded = false; state.loading = false; state.errorText = '' }
    visible = true; subscribeNotifications(changed); startNotificationSession(); load()
})
onPageHide(() => { visible = false; pending = false; unsubscribeNotifications(changed) })
onUnload(() => { visible = false; state.version++; unsubscribeNotifications(changed) })
</script>
<style>
@import '../../styles/account.css';
.conversation-nav { padding: 12px 22px 18px; }
.conversation-page-title { color: #211C18; font-size: 25px; line-height: 34px; font-weight: bold; }
.conversation-list { padding: 4px 16px 24px; }
.conversation-entry { display: flex; flex-direction: row; align-items: center; width: 100%; padding: 20px 14px; margin: 0; border: 1px solid #F1E5DA; border-radius: 18px; background-color: #FFFFFF; text-align: left; overflow: visible; }
.conversation-avatar-wrap { position: relative; width: 54px; height: 54px; flex-shrink: 0; margin-right: 14px; overflow: visible; }
.conversation-avatar { width: 54px; height: 54px; border-radius: 17px; }
.conversation-badge { position: absolute; top: -8px; right: -6px; z-index: 1; min-width: 20px; height: 20px; padding: 0 4px; align-items: center; justify-content: center; border: 2px solid #FFFFFF; border-radius: 12px; background-color: #C9442B; }
.conversation-badge-text { color: #FFFFFF; font-size: 10px; line-height: 14px; }
.conversation-copy { flex: 1; min-width: 0; }
.conversation-title-row { flex-direction: row; align-items: center; justify-content: space-between; }
.conversation-name { color: #211C18; font-size: 17px; line-height: 25px; font-weight: bold; }
.conversation-time { color: #A2968B; font-size: 10px; line-height: 16px; flex-shrink: 0; margin-left: 8px; }
.conversation-preview { color: #8B7B6F; font-size: 13px; line-height: 21px; margin-top: 6px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.conversation-error { padding: 16px 8px; color: #B73920; font-size: 12px; line-height: 20px; }
/* #ifdef WEB */
.account-page .conversation-title-row { flex-direction: row; }
.account-page .conversation-preview { display: block; overflow-wrap: normal; }
/* #endif */
</style>
