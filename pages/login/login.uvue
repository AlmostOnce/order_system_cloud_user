    .password-eye-slash {
        position: absolute;
        left: 0;
        top: 11px;
        width: 24px;
        height: 2px;
        border-radius: 1px;
        background-color: #C2410C;
        transform: rotate(-45deg);
    }
    /* #ifdef WEB */
    .field-action::after { border: none; }
    /* #endif */

	/* ---------- 验证码 ---------- */

	/* 输入框与图片同排，图片固定在右侧 */
	.captcha-row {
		margin-top: 6px;
		flex-direction: row;
		align-items: center;
	}

	/* 验证码输入框占据剩余宽度，与普通字段的输入框对齐 */
	.captcha-input {
		flex: 1;
		margin-top: 0;
	}

	/* 图片尺寸固定，避免不同验证码比例导致布局跳动 */
	.captcha-image {
		width: 110px;
		height: 36px;
		margin-left: 12px;
		border-radius: 6px;
		background-color: #FDF6F0;
	}

	/* 图片尚未取到时的占位，点击可重新获取 */
	.captcha-empty {
		width: 110px;
		height: 36px;
		margin-left: 12px;
		border-radius: 6px;
		background-color: #FDF6F0;
		align-items: center;
		justify-content: center;
	}

	.captcha-empty-text {
		font-size: 12px;
		color: #C2410C;
	}

	/* ---------- 选项行 ---------- */

	.options {
		margin-top: 20px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.remember {
		flex-direction: row;
		align-items: center;
	}

	.remember-box {
		width: 18px;
		height: 18px;
		border-radius: 5px;
		border-width: 1px;
		border-style: solid;
		border-color: #D8C7B8;
		align-items: center;
		justify-content: center;
		transition-property: background-color, border-color;
		transition-duration: 0.22s;
		transition-timing-function: ease-out;
	}

	.remember-box-on {
		background-color: #E4572E;
		border-color: #E4572E;
	}

	/* 勾选时对勾由小放大并淡入，取消勾选时反向收回 */
	.remember-tick {
		font-size: 12px;
		color: #FFFFFF;
		font-weight: bold;
		transition-property: opacity, transform;
		transition-duration: 0.22s;
		/* 弹一下再落定，让勾选动作有反馈感 */
		transition-timing-function: cubic-bezier(0.34, 1.8, 0.64, 1);
	}

	.remember-tick-on {
		opacity: 1;
		transform: scale(1);
	}

	.remember-tick-off {
		opacity: 0;
		transform: scale(0);
	}

	.remember-text {
		margin-left: 8px;
		font-size: 13px;
		color: #6B5F56;
	}

	.options-hint {
		font-size: 10px;
		color: #C9BDB2;
	}

	/* ---------- 主按钮 ---------- */

	/* 按钮只负责按压反馈：卡片整体淡入时已带着它一起出现 */
	.submit {
		margin-top: 26px;
		height: 50px;
		border-radius: 14px;
		background-color: #E4572E;
		align-items: center;
		justify-content: center;
		transform: scale(1);
		transition-property: transform, background-color;
		transition-duration: 0.2s;
		transition-timing-function: ease-out;
	}

	.submit-hover {
		background-color: #C2410C;
		transform: scale(0.97);
	}

	.submit-busy {
		background-color: #EFA184;
	}

	.submit-text {
		font-size: 17px;
		font-weight: bold;
		color: #FFFFFF;
		letter-spacing: 4px;
	}

	/* ---------- 注册入口 ---------- */

	.register-row {
		margin-top: 18px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.register-hint {
		font-size: 13px;
		color: #A2968B;
	}

	.register-link {
		font-size: 13px;
		font-weight: bold;
		color: #C2410C;
	}

	/* ---------- 页脚 ---------- */

	.footer {
		margin-top: auto;
		padding-bottom: 26px;
		align-items: center;
	}

	.footer-text {
