<template>
    <view class="account-page account-secondary">
        <view class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav vapor-account-secondary--account-nav">
            <view class="account-back vapor-account-secondary--account-back" @click="goBack">
                <view class="account-back-icon"></view>
            </view>
            <text class="account-title">订单详情</text></view>
        <scroll-view class="account-scroll" direction="vertical" :refresher-enabled="!paying && !cancelling && (refreshing || (!loading && !balanceLoading && !cleanupLoading))" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
<view class="account-content vapor-account-secondary--account-content">
            <view v-if="order != null" class="order-status-card">
                <text class="order-status-label">{{ order!.status }}</text>
                <view v-if="order!.status == '待支付' && !paymentSuccess" class="order-payment-countdown">
                    <text class="order-countdown-label">剩余支付时间</text>
                    <text class="order-countdown-number">{{ remainingPaymentText }}</text>
                    <text v-if="!paymentDeadlineKnown" class="order-status-note">下单时间暂不可用，请下拉刷新。</text>
                    <text v-else-if="paymentExpired" class="order-status-note">支付期限已到，正在等待系统确认订单状态。</text>
                </view>
                <text class="order-status-note">{{ order!.status == '待支付' ? (paymentSuccess ? '支付已成功，订单状态确认中' : (paymentExpired ? '订单状态以系统确认为准' : '请在下单后十五分钟内完成支付')) : (order!.status == '已取消' ? '订单已取消' : (order!.status == '已完成' ? '已凭取餐码核销，订单已完成' : '请留意订单进度，到窗口取餐')) }}</text>
            </view>
            <view v-if="order != null && (order!.status == '已支付' || order!.status == '制作中' || order!.status == '待取货')" class="account-card vapor-account-secondary--account-card pickup-code-card">
                <text class="pickup-code-label">取餐码</text>
                <text v-if="pickupCode.length > 0" class="pickup-code-number">{{ pickupCode }}</text>
                <text v-else class="account-note">{{ pickupLoading ? '正在获取取餐码…' : '取餐码暂不可用' }}</text>
                <text class="pickup-code-note">{{ order!.status == '待取货' ? '到窗口向商家出示，核销成功后完成订单' : '制作完成后凭码取餐，请勿提前泄露' }}</text>
                    <text v-if="pickupError.length >0" class="account-error">
{{ pickupError }}</text>
            </view>
            <view v-if="order != null" class="account-card vapor-account-secondary--account-card">
                <text class="account-heading">{{ order!.windowName.length > 0 ? order!.windowName : '店铺名称暂不可用' }}</text>
                <view v-for="item in order!.items" :key="item.productId" class="order-line"><view class="order-line-copy"><text class="order-line-name">{{ item.productName }}</text><text class="account-muted">¥{{ item.unitPrice.toFixed(2) }} × {{ item.quantity }}</text></view><text class="order-line-price">¥{{ item.lineAmount.toFixed(2) }}</text></view>
                <view class="order-total"><text class="account-muted">订单金额</text><text class="order-total-price">¥{{ order!.totalAmount.toFixed(2) }}</text></view>
                <text class="account-note">订单号 {{ order!.orderNo }}</text><text class="account-note">下单时间 {{ formatDate(order!.createdAt) }}</text>
                <text v-if="order!.remark.length > 0" class="account-note">备注：{{ order!.remark }}</text>
                    <button v-if="order!.status == '已完成'" class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" :disabled="loading" @click="reviewWindow">{{ reviewStatusReady ? (orderReviewComplete ? '查看评价' : (orderReviewed ? '查看评价 / 继续评价' : '评价订单')) : '订单评价' }}</button>
            </view>
            <view v-if="order != null && order!.status == '待支付' && !paymentSuccess" class="account-card vapor-account-secondary--account-card">
                <text class="account-heading">余额支付</text>
                <text class="account-note">可用余额 {{ balanceReady ? '¥' + balanceText : '--' }}</text>
                    <button class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" :disabled="paymentExpanded || paying || loading || cancelling || !balanceReady || !paymentReady || paymentExpired" :class="paying || loading || cancelling || !balanceReady || !paymentReady || paymentExpired ? 'account-disabled' : ''" @click="openPayment">支付订单</button>
                    <button class="account-link account-link-text button-text button-text-44" :disabled="paying" @click="openRecharge">前往充值</button>
                <text v-if="!paymentReady" class="account-note">支付状态暂未确认，请稍后查看。</text>
                <text v-if="paymentUncertain" class="account-note">上次支付结果待确认，请稍后查看或重试同一订单，避免重复操作。</text>
                    <button class="account-link account-muted button-text button-text-44" :disabled="cancelConfirm || cancelling || paying || loading || !paymentReady || paymentUncertain" @click="askCancel">{{ cancelling ? '正在取消…' : '取消订单' }}</button>
            </view>
            <text v-if="loading" class="account-note">正在获取订单…</text>
            <text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
            <text v-if="cleanupMessage.length > 0" class="account-note">{{ cleanupMessage }}</text>
                <button class="account-link account-link-text button-text button-text-44" :disabled="paying || cancelling" @click="openOrders">查看我的订单</button>
            </view>
    <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            </view>
        </scroll-view>
        <confirm-dialog v-if="cancelConfirm" title="取消订单？" message="确认后将取消这笔待支付订单，想吃的话可以重新下单。" cancel-text="保留订单" confirm-text="确认取消" :busy="cancelling" busy-text="正在取消…" @cancel="keepOrder" @confirm="cancel" />
    </view>
</template>
<script setup lang="uts">
import ConfirmDialog from '../../components/confirm-dialog/confirm-dialog.uvue';
import { requestPaymentPassword, cancelPaymentPassword } from '../../common/payment-password.uts'
import { toast } from '../../common/feedback.uts'
import { startOrderLiveRefresh } from '../../common/order-live.uts'
import { reactive, toRefs } from 'vue'
import { orderPaymentDeadline, orderPaymentTimeLabel } from '../../common/order-countdown.uts'
import { Review, fetchOrderReviews, parseOrderReviews, commentPayload } from '../../api/comments.uts'
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue';
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts';
import { OrderLine, CustomerOrder, fetchOrder, fetchPickupCode, fetchOrderPayment, payOrder, cancelOrder, cleanupOrderCart, orderPayload, parseOrder } from '../../api/order.uts';
import { fetchMyBalance, walletPayload } from '../../api/wallet.uts';
import { HttpResult } from '../../common/http.uts';
import { jsonString, jsonNumber, jsonBoolean } from '../../common/json.uts';
import { readStoredObject, cleanupKey, paymentPendingKey } from '../../common/checkout.uts';
import { currentUser } from '../../store/auth.uts';
import { backToAccount, accountDate } from '../../common/account.uts';

let pickupPageVisible = false
let pickupVersion = 0
let orderLoadVersion = 0
let stopLiveOrders: (() => void) | null = null
function stopOrderUpdates() {
    if (stopLiveOrders != null) { stopLiveOrders!(); stopLiveOrders = null }
}
const state = reactive({ paymentDeadlineKnown: false, paymentExpired: false, remainingPaymentText: '--:--', reviewStatusReady: false, orderReviewed: false, orderReviewComplete: false, pickupCode: '', pickupLoading: false, pickupError: '', refreshing: false, currentRefreshTime: '', balanceLoading: false, cleanupLoading: false, statusBarHeight: 0, orderId: 0, userUuid: '', order: null as CustomerOrder | null, loading: false, paying: false, cancelling: false, cancelConfirm: false, errorText: '', balanceReady: false, balanceText: '--', payPasswordSet: false, payPassword: '', paymentExpanded: false, paymentReady: false, paymentSuccess: false, paymentUncertain: false, cleanupMessage: '' })

const { paymentDeadlineKnown, paymentExpired, remainingPaymentText, reviewStatusReady, orderReviewed, orderReviewComplete, pickupCode, pickupLoading, pickupError, refreshing, currentRefreshTime, balanceLoading, cleanupLoading, statusBarHeight, orderId, userUuid, order, loading, paying, cancelling, cancelConfirm, errorText, balanceReady, balanceText, payPasswordSet, payPassword, paymentExpanded, paymentReady, paymentSuccess, paymentUncertain, cleanupMessage } = toRefs(state)

let paymentClock = 0
let deadlineChecked = false
function stopPaymentClock() { if (paymentClock > 0) { clearInterval(paymentClock); paymentClock = 0 } }
function startPaymentClock(order: CustomerOrder) {
    stopPaymentClock()
    if (order.status != '待支付') { state.paymentExpired = false; state.paymentDeadlineKnown = false; return }
    const receivedAt = Date.now()
    const deadline = orderPaymentDeadline(order.createdAt)
    state.paymentDeadlineKnown = deadline > 0
    if (!state.paymentDeadlineKnown) { state.paymentExpired = true; state.remainingPaymentText = '--:--'; closePayment(); return }
    const initialRemaining = Math.max(0, deadline - (order.serverTime > 0 ? order.serverTime : receivedAt))
    const tick = () => {
        const seconds = Math.max(0, Math.ceil((initialRemaining - Math.max(0, Date.now() - receivedAt)) / 1000))
        state.paymentExpired = seconds == 0
        state.remainingPaymentText = orderPaymentTimeLabel(seconds)
        if (state.paymentExpired) {
            closePayment()
            if (deadlineChecked) { stopPaymentClock(); return }
            if (pickupPageVisible && !state.loading && !state.paying && !state.cancelling) {
                deadlineChecked = true; stopPaymentClock(); refresh()
            }
        }
    }
    tick()
    if (!deadlineChecked && pickupPageVisible) paymentClock = setInterval(tick, 1000)
}

function refreshPage() {
    if (state.refreshing || state.loading || state.paying || state.cancelling || state.balanceLoading || state.cleanupLoading)
        return;
    state.refreshing = true;
    const refreshStartedAt = Date.now();
    state.currentRefreshTime = refreshTimeLabel(refreshStartedAt);
    Promise.all([refresh(), retryCleanup()]).then(() => {
        finishPullRefresh(refreshStartedAt, state.errorText.length == 0 && state.cleanupMessage.length == 0, (time: string) => {
            if (time.length > 0)
                state.currentRefreshTime = time;
            state.refreshing = false;
        });
    }).catch(() => {
        finishPullRefresh(refreshStartedAt, false, (_time: string) => { state.refreshing = false; });
    });
}

function goBack() {
    if (!state.paying && !state.cancelling)
        backToAccount();
}

function formatDate(value: string): string {
    return accountDate(value);
}

async function loadReviewStatus(): Promise<void> {
    const version = orderLoadVersion;
    state.reviewStatusReady = false; state.orderReviewed = false; state.orderReviewComplete = false
    if (state.order == null || state.order!.status != '已完成') return
    const result = await fetchOrderReviews(state.orderId)
    if (version != orderLoadVersion) return;
    const raw = commentPayload(result); const reviews = raw == null ? null : parseOrderReviews(raw)
    if (reviews != null && reviews.orderId == state.orderId) { state.reviewStatusReady = true; state.orderReviewed = reviews.windowReview != null || reviews.productReviews.length > 0
        state.orderReviewComplete = reviews.windowReview != null && state.order != null && state.order!.items.every((item: OrderLine): boolean => reviews.productReviews.some((review: Review): boolean => review.productId == item.productId))
    }
}

function reviewWindow() {
    if (state.loading || state.order == null || state.order!.status != '已完成') return;
    uni.navigateTo({ url: '/pages/review/create?orderId=' + state.orderId });
}

function openOrders() {
    uni.navigateTo({ url: '/pages/order/list' });
}

function openRecharge() {
    uni.navigateTo({ url: '/pages/wallet/recharge' });
}

function openPassword() {
    uni.navigateTo({ url: '/pages/account/pay-password?next=order' });
}

function openPayment() {
    if (state.paymentExpired) return;
    if (state.paymentExpanded || state.paying || state.loading || state.cancelling || !state.balanceReady || !state.paymentReady || state.paymentSuccess || state.order == null || state.order!.status != '待支付') return;
    if (!state.payPasswordSet) { openPassword(); return; }
    state.cancelConfirm = false;
    state.payPassword = '';
    state.paymentExpanded = true;
    requestPaymentPassword('确认支付', '¥' + state.order!.totalAmount.toFixed(2)).then((password: string | null) => {
        if (!state.paymentExpanded) return;
        if (password == null || !pickupPageVisible) { closePayment(); return; }
        if (state.paymentExpired) { closePayment(); toast('支付期限已到，请查看订单状态'); return; }
        state.payPassword = password;
        pay();
        state.paymentExpanded = false;
        state.payPassword = '';
    });
}

function closePayment() {
    if (state.paying) return;
    if (state.paymentExpanded) cancelPaymentPassword();
    state.paymentExpanded = false;
    state.payPassword = '';
}

function keepOrder() {
    if (!state.cancelling) state.cancelConfirm = false;
}

function askCancel() {
    if (state.cancelConfirm || state.cancelling || state.paymentUncertain || !state.paymentReady || state.paymentSuccess || state.paying || state.loading || state.order == null || state.order!.status != '待支付') return;
    closePayment();
    state.cancelConfirm = true;
}

function refresh(): Promise<void> {
    if (state.loading || state.paying || state.cancelling)
        return Promise.resolve();
    if (!Number.isInteger(state.orderId) || state.orderId <= 0) {
        state.errorText = '订单编号无效';
        return Promise.resolve();
    }
    const version = ++orderLoadVersion;
    state.loading = true;
    state.errorText = '';
    state.paymentReady = false;
    state.cancelConfirm = false;
    return fetchOrder(state.orderId).then((result: HttpResult) => {
        if (version != orderLoadVersion) return;
        const data = orderPayload(result);
        const order = data == null ? null : parseOrder(data);
        if (order == null) {
            state.loading = false;
            state.order = null;
            state.errorText = result.message.length > 0 ? result.message : '订单信息异常';
            return;
        }
        state.order = order;
        startPaymentClock(order);
        state.pickupCode = ''; state.pickupError = '';
        if (order.status != '待支付') {
            closePayment();
            state.paymentUncertain = false;
            uni.removeStorageSync(paymentPendingKey(state.userUuid, state.orderId));
            state.loading = false;
            state.paymentReady = true;
            return Promise.all([loadPickupCode(), loadReviewStatus()]).then(() => {});
        }
        // 未发起过支付时只读取订单与余额，不查询尚不存在的支付单。
        if (!state.paymentUncertain && !state.paymentSuccess) {
            state.paymentReady = true;
            return loadBalance().then(() => { if (version == orderLoadVersion) state.loading = false; });
        }
        const paymentTask = fetchOrderPayment(state.orderId).then((payment: HttpResult) => {
            if (version != orderLoadVersion) return;
            const payData = orderPayload(payment);
            state.paymentSuccess = state.paymentSuccess || (payData != null && jsonString(payData, 'status') == 'SUCCESS');
            const status = payData == null ? '' : (jsonString(payData, 'status') ?? '');
            state.paymentReady = status == 'SUCCESS' || status == 'CREATED' || status == 'FAILED' || status == 'CLOSED' || payment.statusCode == 404;
            if (state.paymentSuccess) closePayment();
            if (state.paymentSuccess || status == 'FAILED' || status == 'CLOSED') {
                state.paymentUncertain = false;
                uni.removeStorageSync(paymentPendingKey(state.userUuid, state.orderId));
            }
            if (!state.paymentReady)
                state.errorText = '支付状态获取失败，请稍后重试';
            state.loading = false;
        });
        return Promise.all([paymentTask, loadBalance()]).then(() => { });
    });
}

function loadPickupCode(): Promise<void> {
    if (!pickupPageVisible || state.order == null || !['已支付', '制作中', '待取货'].includes(state.order!.status)) return Promise.resolve();
    const id = state.orderId;
    const owner = state.userUuid;
    const version = ++pickupVersion;
    state.pickupLoading = true;
    return fetchPickupCode(id).then((result: HttpResult) => {
        if (!pickupPageVisible || version != pickupVersion || state.orderId != id || currentUser()?.userUuid != owner) return;
        const data = orderPayload(result);
        const code = data == null ? '' : (jsonString(data, 'pickupCode') ?? '');
        if (!result.ok || !/^[0-9]{6}$/.test(code)) { state.pickupError = result.message.length > 0 ? result.message : '取餐码获取失败，请下拉重试'; return; }
        state.pickupCode = code;
    }).finally(() => { if (version == pickupVersion) state.pickupLoading = false; });
}

function loadBalance(): Promise<void> {
    const version = orderLoadVersion;
    state.balanceLoading = true;
    state.balanceReady = false;
    return fetchMyBalance().then((result: HttpResult) => {
        if (version != orderLoadVersion) return;
        state.balanceLoading = false;
        const data = walletPayload(result);
        if (data == null || jsonNumber(data, 'balance') == null) {
            state.errorText = result.message.length > 0 ? result.message : '余额获取失败，请稍后重试';
            return;
        }
        state.balanceText = (jsonNumber(data, 'balance') ?? 0).toFixed(2);
        state.payPasswordSet = jsonBoolean(data, 'payPasswordSet') ?? false;
        state.balanceReady = true;
    });
}

function retryCleanup(): Promise<void> {
    const key = cleanupKey(state.userUuid, state.orderId);
    const snapshot = readStoredObject(key);
    if (snapshot == null)
        return Promise.resolve();
    state.cleanupLoading = true;
    return cleanupOrderCart(state.orderId, snapshot).then((result: HttpResult) => {
        state.cleanupLoading = false;
        if (result.ok) {
            uni.removeStorageSync(key);
            state.cleanupMessage = '';
        }
        else
            state.cleanupMessage = '订单已保留，购物车清理暂未完成。';
    });
}

function pay() {
    if (state.paymentExpired) return;
    if (!state.paymentExpanded || state.paying || state.loading || state.cancelling || !state.balanceReady || !state.paymentReady || state.paymentSuccess || state.order == null || state.order!.status != '待支付')
        return;
    if (!state.payPasswordSet) {
        openPassword();
        return;
    }
    if (state.payPassword.length == 0) {
        toast('请输入支付密码');
        return;
    }
    state.paying = true;
    state.errorText = '';
    state.cancelConfirm = false;
    const password = state.payPassword;
    state.payPassword = '';
    // 发请求前保存恢复标记，刷新或关闭页面后仍能核实这次支付的结果。
    uni.setStorageSync(paymentPendingKey(state.userUuid, state.orderId), true);
    payOrder(state.orderId, password).then((result: HttpResult) => {
        state.paying = false;
        const data = orderPayload(result);
        const success = data != null && jsonString(data, 'status') == 'SUCCESS';
        state.paymentUncertain = !success && (result.statusCode == 0 || result.statusCode >= 500 || result.ok);
        if (!state.paymentUncertain)
            uni.removeStorageSync(paymentPendingKey(state.userUuid, state.orderId));
        const message = success ? '' : (result.message.length > 0 ? result.message : '支付结果待确认，请稍后查看');
        if (success) {
            state.paymentSuccess = true;
            closePayment();
        }
        refresh();
        state.errorText = state.paymentUncertain ? message : '';
        if (message.length > 0) toast(message);
    });
}

function cancel() {
    if (!state.cancelConfirm || state.paying || state.cancelling || state.loading || !state.paymentReady || state.paymentSuccess || state.paymentUncertain || state.order == null || state.order!.status != '待支付')
        return;
    state.cancelling = true;
    state.errorText = '';
    cancelOrder(state.orderId).then((result: HttpResult) => {
        state.cancelling = false;
        state.cancelConfirm = false;
        if (!result.ok) {
            toast(result.message);
            return;
        }
        refresh();
    });
}

onLoad((options: OnLoadOptions) => {
    state.orderId = Number(options['orderId'] ?? '0');
})

onPageShow(() => {
    stopOrderUpdates();
    pickupPageVisible = true; deadlineChecked = false;
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight;
    const user = currentUser();
    if (user == null) {
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    if (user.roleCode != 'CUSTOMER') {
        uni.switchTab({ url: '/pages/home/home' });
        return;
    }
    state.userUuid = user.userUuid;
    state.paymentUncertain = state.paymentUncertain || uni.getStorageSync(paymentPendingKey(state.userUuid, state.orderId)) === true;
    refresh();
    retryCleanup();
    const liveOwner = user.userUuid;
    stopLiveOrders = startOrderLiveRefresh((): Promise<void> => {
        if (!pickupPageVisible || currentUser()?.userUuid != liveOwner) return Promise.resolve();
        return refresh();
    }, (): boolean => state.loading || state.paying || state.cancelling || state.refreshing || state.balanceLoading || state.cleanupLoading);
})

onPageHide(() => {
    state.cancelConfirm = false;
    stopOrderUpdates();
    orderLoadVersion++; state.loading = false; state.balanceLoading = false;
    stopPaymentClock();
    pickupPageVisible = false; pickupVersion++; state.pickupCode = ""; state.pickupLoading = false;
    if (state.paymentExpanded) cancelPaymentPassword();
    state.paymentExpanded = false;
    state.payPassword = '';
})

onUnload(() => {
    state.cancelConfirm = false;
    stopOrderUpdates();
    orderLoadVersion++; state.loading = false; state.balanceLoading = false;
    stopPaymentClock();
    pickupPageVisible = false; pickupVersion++; state.pickupCode = ""; state.pickupLoading = false;
    if (state.paymentExpanded) cancelPaymentPassword();
    state.paymentExpanded = false;
    state.payPassword = '';
})
</script>
<style>
    @import '../../styles/account.css';
    @import '../../styles/order.css';
    @import '../../styles/review.css';
    .pickup-code-card { align-items: center; }
    .pickup-code-label { color: #7A6C60; font-size: 13px; line-height: 20px; }
    .pickup-code-number { color: #C2410C; font-size: 38px; line-height: 54px; letter-spacing: 7px; font-weight: bold; margin-top: 10px; }
    .pickup-code-note { color: #8B7B6F; font-size: 12px; line-height: 20px; margin-top: 10px; text-align: center; }
</style>
