<template>
    <view class="account-page account-secondary">
        <view class="account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav"><button class="account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">我的订单</text></view>
        <view class="order-filter-bar"><button v-for="tab in filterTabs" :key="tab.code" class="order-filter" :class="filter == tab.code ? 'order-filter-on' : ''" @click="selectFilter(tab.code)"><text class="order-filter-text">{{ tab.label }}</text></button></view>
        <scroll-view class="account-scroll" scroll-y="true"><view class="account-content">
            <view class="account-banner"><view class="banner-copy"><text class="banner-kicker">校园食堂 · 用餐记录</text><text class="banner-title">这一餐，进行到哪了</text><text class="banner-note">查看订单进度，继续支付或到窗口取餐。</text></view></view>
            <view v-if="pendingWindowId > 0" class="account-card"><text class="account-heading">有一笔提交结果待确认</text><text class="account-note">继续确认原订单，避免重复下单。</text><button class="account-primary" @click="resume"><text class="account-primary-text">继续确认</text></button></view>
            <button v-for="item in visibleOrders" :key="item.orderId" class="order-list-card" @click="openOrder(item.orderId)">
                <view class="order-list-top"><text class="order-line-name">窗口 {{ item.windowId }}</text><text class="order-list-status">{{ item.status }}</text></view>
                <text class="account-muted order-list-date">{{ formatDate(item.createdAt) }}</text>
                <text class="account-muted">订单号 {{ item.orderNo }}</text>
                <view class="order-list-top order-list-bottom"><text class="account-muted">查看订单详情</text><text class="order-total-price">¥{{ item.totalAmount.toFixed(2) }}</text></view>
            </button>
            <view v-if="!loading && visibleOrders.length == 0 && errorText.length == 0" class="account-card"><text class="account-heading">{{ filter == 'all' ? '还没有订单' : '暂无该状态的订单' }}</text><text class="account-note">去食堂挑选喜欢的菜品，开启下一餐。</text><button class="account-primary" @click="goHome"><text class="account-primary-text">去点餐</text></button></view>
            <text v-if="loading" class="account-note">正在获取订单…</text><text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
            <button class="account-link" :disabled="loading" @click="load"><text class="account-link-text">刷新订单</text></button>
        </view></scroll-view>
    </view>
</template>
<script lang="uts">
    import { CustomerOrder, fetchOrders, parseOrder } from '../../api/order.uts'
    import { jsonArray } from '../../common/json.uts'
    import { HttpResult } from '../../common/http.uts'
    import { currentUser } from '../../store/auth.uts'
    import { readCheckout } from '../../common/checkout.uts'
    import { accountDate, backToAccount } from '../../common/account.uts'
    type OrderFilterTab = { code: string, label: string }
    export default {
        data() { const orders: Array<CustomerOrder> = []; const filterTabs: Array<OrderFilterTab> = [{ code: 'all', label: '全部' }, { code: 'pending', label: '待支付' }, { code: 'active', label: '进行中' }, { code: 'completed', label: '已完成' }]; return { filter: 'all', filterTabs: filterTabs, statusBarHeight: 0, orders: orders, loading: false, errorText: '', pendingWindowId: 0 } },
        onLoad(options: OnLoadOptions) {
            const value = options['filter'] ?? 'all'
            if (value == 'pending' || value == 'active' || value == 'completed') this.filter = value as string
        },
        computed: {
            visibleOrders(): Array<CustomerOrder> {
                if (this.filter == 'all') return this.orders
                return this.orders.filter((item: CustomerOrder): boolean => {
                    if (this.filter == 'pending') return item.status == '待支付'
                    if (this.filter == 'completed') return item.status == '已完成'
                    return item.status == '已支付' || item.status == '制作中' || item.status == '待取货'
                })
            }
        },
        onShow() {
            this.statusBarHeight = uni.getWindowInfo().statusBarHeight
            const user = currentUser()
            if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
            if (user.roleCode != 'CUSTOMER') { uni.switchTab({ url: '/pages/home/home' }); return }
            const draft = readCheckout(user.userId); this.pendingWindowId = draft == null ? 0 : draft.windowId
            this.load()
        },
        methods: {
            selectFilter(value: string) { if (value == 'all' || value == 'pending' || value == 'active' || value == 'completed') this.filter = value },
            goBack() { backToAccount() },
            goHome() { uni.switchTab({ url: '/pages/home/home' }) },
            formatDate(value: string): string { return accountDate(value) },
            openOrder(id: number) { uni.navigateTo({ url: '/pages/order/detail?orderId=' + id }) },
            resume() { uni.navigateTo({ url: '/pages/order/confirm?windowId=' + this.pendingWindowId }) },
            load() {
                if (this.loading) return
                this.loading = true; this.errorText = ''
                fetchOrders().then((result: HttpResult) => {
                    this.loading = false
                    const rows = result.ok && result.data != null ? jsonArray(result.data, 'data') : null
                    if (rows == null) { this.errorText = result.message.length > 0 ? result.message : '订单列表格式异常'; return }
                    const orders: Array<CustomerOrder> = []
                    for (let i = 0; i < rows.length; i++) {
                        if (rows[i] == null || typeof rows[i] != 'object' || Array.isArray(rows[i])) { this.errorText = '订单数据异常'; return }
                        const order = parseOrder(rows[i] as UTSJSONObject)
                        if (order == null) { this.errorText = '订单数据异常'; return }
                        orders.push(order)
                    }
                    orders.sort((a: CustomerOrder, b: CustomerOrder): number => b.orderId - a.orderId)
                    this.orders = orders
                })
            }
        }
    }
</script>
<style>
    @import '../../styles/account.css';
    @import '../../styles/order.css';
</style>
