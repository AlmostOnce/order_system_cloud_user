<template>
    <view class="account-page account-secondary">
        <view class="account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <view class="account-nav"><button class="account-back" aria-label="返回" @click="goBack"><view class="account-back-icon"></view></button><text class="account-title">确认订单</text></view>
        <scroll-view class="account-scroll" scroll-y="true"><view class="account-content">
            <view class="account-banner"><view class="banner-copy"><text class="banner-kicker">校园食堂 · 到店取餐</text><text class="banner-title">确认这一餐</text><text class="banner-note">核对菜品与数量，提交后前往支付。</text></view></view>
            <view v-if="loading" class="account-card"><text class="account-muted">正在核对购物车…</text></view>
            <view v-if="items.length > 0" class="account-card">
                <text class="account-heading">{{ windowName.length > 0 ? windowName : '窗口 ' + windowId }}</text>
                <text class="account-note">到店自取</text>
                <view v-for="item in items" :key="item.productId" class="order-line">
                    <view class="order-line-copy"><text class="order-line-name">{{ item.productName }}</text><text class="account-muted">¥{{ item.unitPrice.toFixed(2) }} × {{ item.quantity }}</text></view>
                    <text class="order-line-price">¥{{ item.lineAmount.toFixed(2) }}</text>
                </view>
                <view class="order-total"><text class="account-muted">预估合计</text><text class="order-total-price">¥{{ totalText }}</text></view>
                <text class="account-note">最终金额以提交后订单为准。</text>
            </view>
            <view v-if="items.length > 0" class="account-card"><text class="account-heading">订单备注</text><textarea class="order-remark" v-model="remark" :maxlength="255" :disabled="submitting || pending" placeholder="口味偏好等，可选填" /><text class="account-muted">{{ remark.length }}/255</text></view>
            <text v-if="pending" class="account-note">上次提交结果待确认，菜品与备注已锁定。再次确认会查询同一笔订单。</text>
            <text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
            <button v-if="createdOrderId > 0" class="account-primary" @click="openCreated"><text class="account-primary-text">查看已提交订单</text></button>
            <button v-else-if="items.length > 0" class="account-primary" :disabled="submitting || loading" :class="submitting || loading ? 'account-disabled' : ''" @click="submit"><text class="account-primary-text">{{ submitting ? '正在提交…' : (pending ? '确认提交结果' : '提交订单') }}</text></button>
            <button v-if="!pending && !submitting && createdOrderId == 0" class="account-link" @click="loadCart"><text class="account-link-text">重新核对购物车</text></button>
            <button class="account-link" :disabled="submitting" @click="openOrders"><text class="account-link-text">我的订单</text></button>
        </view></scroll-view>
    </view>
</template>
<script lang="uts">
    import { fetchCart, CartResult } from '../../api/cart.uts'
    import { createOrder, cleanupOrderCart, orderPayload, parseOrder } from '../../api/order.uts'
    import { CheckoutLine, CheckoutDraft, checkoutKey, cleanupKey, readCheckout, orderBody, cleanupBody } from '../../common/checkout.uts'
    import { HttpResult } from '../../common/http.uts'
    import { currentUser } from '../../store/auth.uts'
    import { backToAccount } from '../../common/account.uts'
    export default {
        data() { const items: Array<CheckoutLine> = []; return { statusBarHeight: 0, userId: 0, windowId: 0, windowName: '', items: items, remark: '', totalText: '0.00', loading: false, submitting: false, pending: false, requestKey: '', errorText: '', createdOrderId: 0, pageVisible: false } },
        onLoad(options: OnLoadOptions) {
            this.windowId = Number(options['windowId'] ?? '0')
            const name = options['windowName']
            if (name != null) this.windowName = name as string
        },
        onShow() {
            this.pageVisible = true
            this.statusBarHeight = uni.getWindowInfo().statusBarHeight
            const user = currentUser()
            if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
            if (user.roleCode != 'CUSTOMER') { uni.switchTab({ url: '/pages/home/home' }); return }
            this.userId = user.userId
            if (this.submitting || this.createdOrderId > 0) return
            const draft = readCheckout(this.userId)
            if (draft != null) {
                this.windowId = draft.windowId; this.windowName = draft.windowName; this.items = draft.items
                this.remark = draft.remark; this.requestKey = draft.key; this.pending = true; this.updateTotal()
            } else this.loadCart()
        },
        onHide() { this.pageVisible = false },
        onUnload() { this.pageVisible = false },
        methods: {
            goBack() { if (!this.submitting) backToAccount() },
            openOrders() { uni.navigateTo({ url: '/pages/order/list' }) },
            openCreated() { uni.redirectTo({ url: '/pages/order/detail?orderId=' + this.createdOrderId }) },
            updateTotal() { let cents = 0; for (let i = 0; i < this.items.length; i++) cents += Math.round(this.items[i].lineAmount * 100); this.totalText = (cents / 100).toFixed(2) },
            loadCart() {
                if (this.loading || this.pending || this.submitting || this.createdOrderId > 0) return
                this.loading = true; this.errorText = ''; this.items = []
                fetchCart().then((result: CartResult) => {
                    this.loading = false
                    if (!result.ok || result.cart == null) { this.errorText = result.message; return }
                    const cart = result.cart!
                    for (let i = 0; i < cart.windows.length; i++) {
                        const group = cart.windows[i]
                        if (group.windowId != this.windowId) continue
                        if (!group.windowActive) { this.errorText = '该窗口暂不可下单'; return }
                        const lines: Array<CheckoutLine> = []
                        for (let j = 0; j < group.items.length; j++) {
                            const item = group.items[j]
                            if (!item.checked) continue
                            if (!item.available || item.revision.length == 0) { this.errorText = item.productName + ' 暂不可下单，请返回购物车调整'; return }
                            lines.push({ productId: item.productId, productName: item.productName, quantity: item.quantity, revision: item.revision, unitPrice: item.unitPrice, lineAmount: item.lineAmount })
                        }
                        if (lines.length > 100) { this.errorText = '每单最多 100 项菜品'; return }
                        this.items = lines; this.updateTotal()
                    }
                    if (this.items.length == 0) this.errorText = '没有可提交的已勾选菜品，请返回选择'
                })
            },
            submit() {
                if (this.submitting || this.loading || this.items.length == 0 || this.createdOrderId > 0) return
                this.errorText = ''
                if (!this.pending) this.requestKey = 'order-' + Date.now() + '-' + Math.floor(Math.random() * 1000000000)
                const draft: CheckoutDraft = { key: this.requestKey, windowId: this.windowId, windowName: this.windowName, remark: this.remark, items: this.items }
                try { uni.setStorageSync(checkoutKey(this.userId), JSON.stringify(draft)) }
                catch (error) { this.errorText = '无法保存提交信息，请检查设备存储后重试'; return }
                this.pending = true; this.submitting = true
                createOrder(orderBody(draft), draft.key).then((result: HttpResult) => {
                    this.submitting = false
                    const data = orderPayload(result)
                    const order = data == null ? null : parseOrder(data)
                    if (order == null) {
                        this.errorText = result.message.length > 0 ? result.message : '订单结果待确认，请重试'
                        // 5xx、超时、异常响应与幂等键冲突保留原始请求，避免创建第二笔。
                        if (!result.ok && (result.statusCode == 400 || result.statusCode == 403 || result.statusCode == 404 || result.statusCode == 422 || (result.statusCode == 409 && result.message.indexOf('Idempotency-Key') < 0))) {
                            this.pending = false; this.requestKey = ''; uni.removeStorageSync(checkoutKey(this.userId))
                        }
                        return
                    }
                    this.createdOrderId = order.orderId; this.pending = false
                    const snapshot = cleanupBody(draft)
                    try { uni.setStorageSync(cleanupKey(this.userId, order.orderId), JSON.stringify(snapshot)); uni.removeStorageSync(checkoutKey(this.userId)) }
                    catch (error) { this.errorText = '订单已提交，购物车清理信息保存失败。请勿重复下单。' }
                    cleanupOrderCart(order.orderId, snapshot).then((cleaned: HttpResult) => {
                        if (cleaned.ok) uni.removeStorageSync(cleanupKey(this.userId, order.orderId))
                        if (this.pageVisible) this.openCreated()
                    })
                })
            }
        }
    }
</script>
<style>
    @import '../../styles/account.css';
    @import '../../styles/order.css';
</style>
