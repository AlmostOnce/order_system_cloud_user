<template>
	<view class="page">
		<!-- 状态栏底色与品牌区同色，避免顶部出现米色缝隙 -->
		<view class="statusfill" :style="'height:' + statusBarHeight + 'px'"></view>
        <scroll-view class="home-scroll" direction="vertical" :refresher-enabled="roleCode == 'CUSTOMER' && (refreshing || !loading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" @refresherrefresh="refreshPage" refresher-default-style="none" :refresher-threshold="72">
		<!-- 品牌区：只保留一行品牌字与搜索入口，压缩首屏高度，把空间留给推荐和档口 -->
		<view class="hero">
			<view class="hero-shape hero-shape-1" :class="heroShapesEntered ? '' : 'hero-shape-1-pre'"></view>
			<view class="hero-shape hero-shape-2" :class="heroShapesEntered ? '' : 'hero-shape-2-pre'"></view>
			<view class="hero-body">
				<view class="hero-top" :class="entered ? '' : 'hero-top-pre'">
					<text class="hero-brand">校园食堂</text>
					<!-- 餐厅筛选入口：只占一个胶囊，点开后所有食堂在底部面板纵向排列，数量再多也不必横向滑动 -->
					<view
						v-if="roleCode == 'CUSTOMER' && restaurants.length > 0"
						class="hero-picker"
						hover-class="hero-picker-hover"
						@click="togglePicker"
					>
						<text class="hero-picker-text" :max-lines="1">{{ selectedRestaurantName }}</text>
						<text class="hero-picker-arrow" :class="pickerVisible ? 'hero-picker-arrow-open' : ''">⌄</text>
					</view>
				</view>
				<!-- 菜品搜索入口：点击进入独立搜索页，仅学生角色可见 -->
				<view
					v-if="roleCode == 'CUSTOMER'"
					class="search-entry"
					:class="entered ? '' : 'search-entry-pre'"
					hover-class="search-entry-hover"
					@click="openSearch"
				>
					<view class="search-lens">
						<view class="search-lens-handle"></view>
					</view>
					<text class="search-entry-text">搜索菜品、档口或餐厅</text>
				</view>
			</view>
		</view>

		<!-- 首页公告：独立于推荐与档口加载；没有公告或接口失败时整块不渲染，不占位 -->
		<view
			v-if="roleCode == 'CUSTOMER' && announcementVisible"
			class="announcement-bar"
			hover-class="announcement-bar-hover"
			@click="openAnnouncement"
		>
			<view class="announcement-badge">
				<text class="announcement-badge-text">公告</text>
			</view>
			<text class="announcement-text" :max-lines="1">{{ announcementTitle }}</text>
			<text class="announcement-arrow">›</text>
		</view>

        <!-- 推荐独立于目录加载；卡片只进入既有菜单，不直接加购或复用历史规格。 -->
        <view v-if="roleCode == 'CUSTOMER'" class="section">
            <view class="section-head">
                <text class="section-title">今天想吃什么</text>
                <text class="section-count">{{ recommendationModeText() }}</text>
            </view>
            <view v-if="recommendationLoading && recommendationItems.length == 0" class="recommendation-state">
                <text class="state-text">正在挑选推荐菜品…</text>
            </view>
            <view v-else-if="recommendationError.length > 0 && recommendationItems.length == 0" class="recommendation-state">
                <text class="state-text">{{ recommendationError }}</text>
            </view>
            <view v-else-if="recommendationMode == 'FALLBACK' && recommendationItems.length == 0" class="recommendation-state">
                <text class="state-text">推荐暂时不可用，请稍后再试</text>
            </view>
            <view v-else-if="recommendationItems.length == 0" class="recommendation-state">
                <text class="state-text">当前餐厅范围暂无可推荐菜品</text>
            </view>
            <view v-else>
                <text v-if="recommendationError.length > 0" class="recommendation-error">{{ recommendationError }}</text>
                <!-- 图片 + 一行菜名 + 档口 + 价格；压缩到 166px 高，一屏可露出第三张卡提示横向可滑 -->
                <scroll-view class="recommendation-scroll" direction="horizontal">
                    <view class="recommendation-list" :style="'width: ' + (recommendationItems.length * 134) + 'px'">
                        <view v-for="item in recommendationItems" :key="item.productId" class="recommendation-card" hover-class="recommendation-card-hover" @click="openRecommendation(item)">
                            <view class="recommendation-image">
                                <business-image :src="item.imageUrl" kind="product" :preview="false"></business-image>
                                <!-- 推荐理由收敛为图片角标，避免在窄卡里再占一行正文 -->
                                <view class="recommendation-reason">
                                    <text class="recommendation-reason-text" :max-lines="1">{{ recommendationReason(item.reasonCode) }}</text>
                                </view>
                            </view>
                            <view class="recommendation-body">
                                <text class="recommendation-name" :max-lines="1">{{ item.productName }}</text>
                                <text v-if="recommendationWindowName(item).length > 0" class="recommendation-window" :max-lines="1">{{ recommendationWindowName(item) }}</text>
                                <view class="recommendation-price-row">
                                    <text class="recommendation-price">¥{{ recommendationPrice(item) }}</text>
                                    <text class="recommendation-arrow">›</text>
                                </view>
                            </view>
                        </view>
                    </view>
                </scroll-view>
            </view>
        </view>
		<!-- 档口列表：区头先入场，卡片等数据到位后依次浮入 -->
		<view class="section">
			<view class="section-head" :class="entered ? '' : 'section-head-pre'">
				<text class="section-title">{{ listTitle() }}</text>
				<text
					v-if="roleCode == 'CUSTOMER' && !loading && loadError.length == 0"
					class="section-count"
				>{{ openWindowCount() }} 个营业中{{ restWindowCount() > 0 ? ' · ' + restWindowCount() + ' 个休息中' : '' }}</text>
			</view>
			<view v-if="loading" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">正在加载档口列表…</text>
			</view>
			<view v-else-if="loadError.length > 0" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">{{ loadError }}</text>
			</view>
			<view v-else-if="roleCode != 'CUSTOMER'" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">档口展示面向学生用户开放</text>
				<text class="state-hint">请用学生账号登录查看</text>
			</view>
			<view v-else-if="visibleWindows.length == 0" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">{{ emptyHint() }}</text>
			</view>
			<view v-else class="stalls">
				<view
					class="stall"
					:class="(listReady ? '' : 'stall-pre') + (item.isOpen == 1 ? '' : ' stall-resting')"
					:style="stallDelay(index)"
					hover-class="stall-hover"
					v-for="(item, index) in visibleWindows"
					:key="item.windowId"
					@click="openWindow(item)"
				>
					<view class="stall-badge">
						<business-image :src="item.imageUrl" kind="window" :preview="false"></business-image>
					</view>
					<view class="stall-body">
						<!-- 第一行只放档口名和评分徽标，第二行合并月售、食堂与楼层，减少一行空白 -->
						<view class="stall-line">
							<text class="stall-name" :max-lines="1">{{ item.windowName }}</text>
							<view
								v-if="stallRatingBadge(item).length > 0"
								class="stall-rating-badge"
								:class="stallRatingBadge(item) == '暂无评分' ? 'stall-rating-badge-none' : ''"
							>
								<text class="stall-rating-badge-text" :class="stallRatingBadge(item) == '暂无评分' ? 'stall-rating-badge-text-none' : ''">{{ stallRatingBadge(item) }}</text>
							</view>
							<!-- 休息中的档口仍可进入看菜单，但明确标注且不能下单 -->
							<view v-if="item.isOpen != 1" class="stall-closed-badge">
								<text class="stall-closed-badge-text">休息中</text>
							</view>
						</view>
						<text class="stall-meta" :max-lines="1">{{ stallMetaLine(item) }}</text>
					</view>
					<text class="stall-arrow">›</text>
				</view>
			</view>
		</view>
		<view class="footer">
			<text class="footer-text">湖北经济学院 · 食堂管理中心</text>
		</view>
            <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            </view>
        </scroll-view>
		<!-- 餐厅选择面板：遮罩淡入，面板自底部上滑；食堂较多时面板内部纵向滚动，不影响页面本身 -->
		<view
			v-if="pickerVisible"
			class="mask"
			:class="pickerReady ? '' : 'mask-pre'"
			@click="closePicker"
		></view>
		<view v-if="pickerVisible" class="sheet" :class="pickerReady ? '' : 'sheet-pre'">
			<text class="sheet-title">选择餐厅</text>
			<scroll-view class="sheet-list" direction="vertical" :style="sheetListStyle()">
				<view
					class="sheet-item"
					hover-class="sheet-item-hover"
					@click="selectRestaurant(0, '全部餐厅')"
				>
					<view class="sheet-item-body">
						<text class="sheet-item-name" :class="selectedRestaurantId == 0 ? 'sheet-item-name-on' : ''">全部餐厅</text>
					</view>
					<text v-if="selectedRestaurantId == 0" class="sheet-item-tick">✓</text>
				</view>
				<view
					class="sheet-item"
					hover-class="sheet-item-hover"
					:key="item.restaurantId"
					v-for="item in restaurants"
					@click="selectRestaurant(item.restaurantId, item.restaurantName)"
				>
					<view class="sheet-item-body">
						<text
							class="sheet-item-name"
							:class="selectedRestaurantId == item.restaurantId ? 'sheet-item-name-on' : ''"
						>{{ item.restaurantName }}</text>
						<text v-if="item.location.length > 0" class="sheet-item-loc">{{ item.location }}</text>
						<!-- 餐厅公告与电话由管理端维护，选中餐厅前即可看到，不再只在后台可见 -->
						<text v-if="item.notice.length > 0" class="sheet-item-notice" :max-lines="2">{{ item.notice }}</text>
						<text v-if="item.phone.length > 0" class="sheet-item-phone" @click.stop="callRestaurant(item.phone)">电话 {{ item.phone }}</text>
					</view>
					<text v-if="selectedRestaurantId == item.restaurantId" class="sheet-item-tick">✓</text>
				</view>
			</scroll-view>
		</view>
		<!-- 公告详情弹层：复用底部面板交互，正文过长时在面板内部纵向滚动 -->
		<view
			v-if="announcementSheetVisible"
			class="mask"
			:class="announcementSheetReady ? '' : 'mask-pre'"
			@click="closeAnnouncement"
		></view>
		<view
			v-if="announcementSheetVisible"
			class="sheet"
			:class="announcementSheetReady ? '' : 'sheet-pre'"
		>
			<text class="sheet-title">公告</text>
			<view class="announcement-head">
				<text class="announcement-detail-title">{{ announcementTitle }}</text>
				<text v-if="announcementTimeText().length > 0" class="announcement-detail-time">{{ announcementTimeText() }} 发布</text>
			</view>
			<scroll-view class="announcement-detail" direction="vertical" :style="announcementContentStyle()">
				<text class="announcement-detail-content">{{ announcementContent }}</text>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { startNotificationSession } from '../../store/notifications.uts'
import { reactive, toRefs } from 'vue'
import BusinessImage from '../../components/business-image/business-image.uvue';
import RefreshHeader from '../../components/refresh-header/refresh-header.uvue';
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts';
// 导入登录态：登录判断与当前身份读取（退出入口已迁到「我的」页）。
import { isLoggedIn, currentUser } from '../../store/auth.uts';
import { getSessionVersion } from '../../common/storage.uts';
import { fetchHomeRecommendations, HomeRecommendationItem, HomeRecommendationResult } from '../../api/recommendations.uts';
// 导入商品查询与结果类型：档口列表、餐厅列表及其返回结构。
import { listActiveWindows, listActiveRestaurants, WindowItem, WindowListResult, RestaurantItem, RestaurantListResult, fetchHomeAnnouncement, HomeAnnouncementResult } from '../../api/product.uts';
import { CardRating, fetchCardRatings } from '../../api/comments.uts';
import { fetchMonthlyWindowSales, MonthlyWindowSalesItem } from '../../api/statistics.uts';
/** 表示「全部餐厅」的哨兵值，与任何真实餐厅 ID 都不会冲突。 */
const ALL_RESTAURANTS: number = 0;
/** 「全部餐厅」的展示名称。 */
const ALL_RESTAURANTS_NAME: string = '全部餐厅';
const initialMonthlyWindowSales: Array<MonthlyWindowSalesItem> = [];

// 档口列表与可见档口共用同一份空数组，避免先渲染时出现 undefined。
const initialEmptyWindows: Array<WindowItem> = [];
const initialWindowRatings: Array<CardRating> = [];
let windowRatingVersion = 0;
let windowSalesVersion = 0;
let catalogOwner = '';
/** 推荐请求和已展示数据各自归属某次登录会话，退出后重新登录同账号也不得接纳旧结果。 */
let recommendationRequestVersion = 0;
let recommendationOwner = '';
let recommendationSessionVersion = -1;
/** 公告独立于推荐与目录，用同一套版本/账号校验阻止晚到响应串号。 */
let announcementRequestVersion = 0;
let announcementOwner = '';
let announcementSessionVersion = -1;
const initialRecommendations: Array<HomeRecommendationItem> = [];
// 餐厅列表的初始空数组。
const initialEmptyRestaurants: Array<RestaurantItem> = [];
const state = reactive({ refreshing: false, currentRefreshTime: '',
    // 状态栏高度（px），用于顶部占位，避免内容被系统状态栏遮挡。
    statusBarHeight: 0,
    // 当前角色编码，用于模板判断是否展示档口列表。
    roleCode: '',
    /** 推荐列表及其独立状态；加载失败不会改写目录的 loading/loadError。 */
    recommendationItems: initialRecommendations,
    recommendationLoading: false,
    recommendationError: '',
    /** 服务端实际结果模式，只有已确认的个性化结果才使用个人偏好文案。 */
    recommendationMode: '',
    // 后端返回的档口全量列表。
    windows: initialEmptyWindows,
    windowRatings: initialWindowRatings,
    // 与档口列表分开读取的月售汇总；统计服务失败不会影响档口浏览。
    monthlyWindowSales: initialMonthlyWindowSales,
    monthlyWindowSalesReady: false,
    // 按当前选中餐厅筛选后、供页面渲染的档口列表。
    visibleWindows: initialEmptyWindows,
    // 后端返回的餐厅列表，供餐厅选择面板渲染。
    restaurants: initialEmptyRestaurants,
    // 当前选中的餐厅 ID，0 表示「全部餐厅」。
    selectedRestaurantId: ALL_RESTAURANTS,
    // 当前选中餐厅的展示名称，用于档口区头标题与空态文案。
    selectedRestaurantName: ALL_RESTAURANTS_NAME,
    // 是否正在加载档口与餐厅数据。
    loading: true,
    // 加载失败的错误文案，非空时页面展示错误态。
    loadError: '',
    // 是否已进入入场动画终态，切换后驱动各元素的过渡。
    entered: false,
    // 右上角图形独立重播，不让正文和列表在返回首页时一起隐藏或重刷。
    heroShapesEntered: false,
    // 档口列表是否已就绪，控制卡片依次浮入的过渡。
    listReady: false,
    // 餐厅选择面板是否已挂载显示。
    pickerVisible: false,
    // 餐厅选择面板是否已进入终态，控制其滑入滑出过渡。
    pickerReady: false,
    /** 首页公告内容；拆成基本字段，避免在 uvue 响应式对象中持有可空业务对象。 */
    announcementTitle: '',
    announcementContent: '',
    announcementPublishedAt: '',
    /** 是否有可展示公告；无公告或接口失败时为 false，整块不渲染。 */
    announcementVisible: false,
    /** 公告详情弹层是否已挂载与是否进入终态。 */
    announcementSheetVisible: false,
    announcementSheetReady: false })

// 首页模板直接读取推荐模式与筛选结果，因此一并暴露为响应式引用，避免运行时找不到变量。
const { refreshing, currentRefreshTime, statusBarHeight, roleCode, recommendationItems, recommendationLoading, recommendationError, recommendationMode, windows, windowRatings, visibleWindows, restaurants, selectedRestaurantId, selectedRestaurantName, loading, loadError, entered, heroShapesEntered, listReady, pickerVisible, pickerReady, announcementTitle, announcementContent, announcementPublishedAt, announcementVisible, announcementSheetVisible, announcementSheetReady } = toRefs(state)

function refreshPage() {
    if (state.refreshing || state.loading || state.pickerVisible || state.roleCode != 'CUSTOMER')
        return;
    state.refreshing = true;
    const refreshStartedAt = Date.now();
    state.currentRefreshTime = refreshTimeLabel(refreshStartedAt);
    // 推荐与目录分别发起；推荐返回慢或失败都不阻塞原有目录和下拉刷新收起。
    loadRecommendations();
    // 公告同样独立加载：失败只隐藏公告条，不改变推荐与档口的状态。
    loadAnnouncement();
    loadCatalog().then(() => {
        finishPullRefresh(refreshStartedAt, state.loadError.length == 0, (time: string) => {
            if (time.length > 0)
                state.currentRefreshTime = time;
            state.refreshing = false;
        });
    }).catch(() => {
        finishPullRefresh(refreshStartedAt, false, (_time: string) => { state.refreshing = false; });
    });
}

function stallDelay(index: number): string {
    // 预置各档位的延迟秒数，下标即卡片序号。
    const delays: string[] = ['0.34s', '0.40s', '0.46s', '0.52s', '0.58s', '0.64s', '0.70s', '0.76s'];
    // 下标异常（负数）时退回第一档，避免取值越界。
    if (index < 0) {
        return 'transition-delay: 0.34s';
    }
    // 超出预设档位的卡片统一沿用最后一档，防止等待时间无限增长。
    if (index >= delays.length) {
        return 'transition-delay: 0.76s';
    }
    // 正常档位：拼出内联的 transition-delay 声明。
    return 'transition-delay: ' + delays[index];
}

function listTitle(): string {
    // 选中「全部餐厅」时展示通用标题。
    if (state.selectedRestaurantId == ALL_RESTAURANTS) {
        return '全部档口';
    }
    // 否则直接以当前餐厅名作为区头标题。
    return state.selectedRestaurantName;
}

function emptyHint(): string {
    // 「全部餐厅」下的空态：整体没有营业档口。
    if (state.selectedRestaurantId == ALL_RESTAURANTS) {
        return '当前没有正在营业的档口';
    }
    // 指定餐厅下的空态：把餐厅名拼进提示，明确是哪一个餐厅无档口。
    return state.selectedRestaurantName + ' 暂无营业中的档口';
}

/**
 * 档口评分徽标。
 *
 * <p>评分是异步补充数据：加载中或接口不可用时返回空串，卡片只显示月售与位置，
 * 避免每张卡都出现「加载中」这类临时噪声；成功但零评价时显示「暂无评分」，
 * 让新档口有明确标识而不是空白。</p>
 *
 * @param item 当前档口
 * @return 可直接展示的徽标文案，空串表示本次不展示
 */
function stallRatingBadge(item: WindowItem): string {
    for (let i = 0; i < state.windowRatings.length; i++) {
        const rating = state.windowRatings[i];
        if (rating.id != item.windowId) continue;
        if (!rating.available) return '';
        if (rating.reviewCount == 0 || rating.averageScore == null) return '暂无评分';
        return '★ ' + rating.averageScore!.toFixed(1);
    }
    // 尚未拿到该档口评分时保持留白，等批量评分返回后自然出现。
    return '';
}

/**
 * 档口卡片的副标题行：月售、食堂与位置合并为一行。
 *
 * <p>选中具体食堂时区头已经说明食堂名，卡片内不再重复；
 * 位置若已包含食堂全称，也不再重复拼接。月售尚未读取完成时省略该段，
 * 不展示「-- 份」这种占位噪音；全部信息都缺失时给出位置待补充。</p>
 *
 * @param item 当前档口
 * @return 用于单行省略展示的副标题
 */
function stallMetaLine(item: WindowItem): string {
    const parts: Array<string> = [];
    const sales = monthlyWindowSalesText(item.windowId);
    if (sales != '--') parts.push('月售 ' + sales + ' 份');
    // 通过所属餐厅 ID 关联完整名称，不使用顶部筛选器的简称。
    let restaurantName = '';
    for (let i = 0; i < state.restaurants.length; i++) {
        if (state.restaurants[i].restaurantId == item.restaurantId) {
            restaurantName = state.restaurants[i].restaurantName.trim();
            break;
        }
    }
    // 仅「全部餐厅」范围需要在卡片里提示食堂归属。
    if (state.selectedRestaurantId == ALL_RESTAURANTS && restaurantName.length > 0) {
        parts.push(restaurantName);
    }
    const location = item.location.trim();
    if (location.length > 0 && (restaurantName.length == 0 || location.indexOf(restaurantName) < 0)) {
        parts.push(location);
    }
    if (parts.length == 0) return '位置待补充';
    return parts.join(' · ');
}

function loadProfile() {
    // 从本地令牌解析出当前用户信息。
    const profile = currentUser();
    // 令牌存在但解析失败，说明凭据已不可用，回到登录页重新获取。
    if (profile == null) {
        clearRecommendations();
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    // 只保留角色编码用于判断是否展示档口列表，其余个人信息不在首页展示。
    state.roleCode = profile.roleCode;
    // 仅顾客角色需要拉取档口与餐厅数据。
    if (state.roleCode == 'CUSTOMER') {
        // 新会话即使仍是同一账号也先清理推荐，防止退出重登后短暂显示旧个性化结果。
        if (recommendationOwner != profile.userUuid || recommendationSessionVersion != getSessionVersion()) clearRecommendations();
        if (catalogOwner == profile.userUuid) {
            // 返回首页时独立更新月售与推荐，保持窗口目录、筛选和档口卡片动画不动。
            refreshMonthlyWindowSales();
            loadRecommendations();
            // 公告可能已在运营端更新或到期，返回首页时重新读取一次。
            loadAnnouncement();
            return;
        }
        catalogOwner = profile.userUuid;
        windowRatingVersion++;
        state.windows = [];
        state.visibleWindows = [];
        state.restaurants = [];
        state.windowRatings = [];
        windowSalesVersion++;
        state.monthlyWindowSales = [];
        state.monthlyWindowSalesReady = false;
        state.selectedRestaurantId = ALL_RESTAURANTS;
        state.selectedRestaurantName = ALL_RESTAURANTS_NAME;
        loadRecommendations();
        loadCatalog();
        loadAnnouncement();
    }
    else {
        clearRecommendations();
        clearAnnouncement();
        // 后端餐厅与档口查询接口只放行顾客角色，其它角色在此直接给出说明，
        // 省掉一次必然失败的请求，也不会在首页上摆一个错误提示。
        state.loading = false;
        state.loadError = '';
    }
}

/** 清理推荐所属身份并使所有在途请求失效；仅影响推荐，不修改目录或餐厅筛选。 */
function clearRecommendations(): void {
    recommendationRequestVersion++;
    recommendationOwner = '';
    recommendationSessionVersion = -1;
    state.recommendationItems = [];
    state.recommendationMode = '';
    state.recommendationLoading = false;
    state.recommendationError = '';
}

/**
 * 清空公告展示数据并收起详情弹层。
 *
 * <p>只重置界面状态、不递增请求版本：用于"当前没有生效公告"和接口失败后的隐藏，
 * 让同一会话内的后续刷新仍能正常接纳结果。</p>
 */
function resetAnnouncementData(): void {
    state.announcementTitle = '';
    state.announcementContent = '';
    state.announcementPublishedAt = '';
    state.announcementVisible = false;
    state.announcementSheetVisible = false;
    state.announcementSheetReady = false;
}

/** 清空公告并使在途请求失效；用于退出登录、切换账号或角色不符。 */
function clearAnnouncement(): void {
    announcementRequestVersion++;
    announcementOwner = '';
    announcementSessionVersion = -1;
    resetAnnouncementData();
}

/**
 * 读取学生端首页公告。
 *
 * <p>公告是第三条独立加载链：网络失败或没有公告都只隐藏公告条，不影响推荐与档口。
 * 与推荐一致，用请求版本、会话版本和账号三重校验丢弃退出、切换账号或离页后的迟到响应，
 * 避免把上一个账号的公告渲染给当前用户。</p>
 */
function loadAnnouncement(): void {
    // 页面不可见时直接放弃，离页后不再发起请求或改写隐藏视图。
    if (!homeVisible) {
        clearAnnouncement();
        return;
    }
    const profile = currentUser();
    if (!isLoggedIn() || profile == null || profile.roleCode != 'CUSTOMER') {
        clearAnnouncement();
        return;
    }
    const owner = profile.userUuid;
    const sessionVersion = getSessionVersion();
    const version = ++announcementRequestVersion;
    announcementOwner = owner;
    announcementSessionVersion = sessionVersion;
    fetchHomeAnnouncement().then((result: HomeAnnouncementResult) => {
        const current = currentUser();
        if (!homeVisible || version != announcementRequestVersion || sessionVersion != getSessionVersion() ||
            !isLoggedIn() || current == null || current.userUuid != owner || current.roleCode != 'CUSTOMER') return;
        // 接口失败或当前没有生效公告：同样隐藏公告条，不展示错误打断首页浏览。
        if (!result.ok || result.data == null) {
            resetAnnouncementData();
            return;
        }
        state.announcementTitle = result.data!.title;
        state.announcementContent = result.data!.content;
        state.announcementPublishedAt = result.data!.publishedAt;
        state.announcementVisible = true;
    });
}

/**
 * 按当前学生和餐厅独立读取推荐；成功替换排序，刷新失败保留同会话同范围的旧列表。
 * 请求版本、会话版本、账号与筛选共同校验，阻止快速切换、退出重登及离页后的晚到响应污染首页。
 */
function loadRecommendations(): void {
    // 页面不可见时直接放弃：离页后不应再读取本地登录态或发起请求。
    if (!homeVisible) {
        clearRecommendations();
        return;
    }
    const profile = currentUser();
    if (!isLoggedIn() || profile == null || profile.roleCode != 'CUSTOMER') {
        clearRecommendations();
        return;
    }
    const owner = profile.userUuid;
    const sessionVersion = getSessionVersion();
    const restaurantId = state.selectedRestaurantId;
    const version = ++recommendationRequestVersion;
    recommendationOwner = owner;
    recommendationSessionVersion = sessionVersion;
    state.recommendationLoading = true;
    state.recommendationError = '';
    fetchHomeRecommendations(restaurantId).then((result: HomeRecommendationResult) => {
        const current = currentUser();
        if (!homeVisible || version != recommendationRequestVersion || sessionVersion != getSessionVersion() ||
            !isLoggedIn() || current == null || current.userUuid != owner || current.roleCode != 'CUSTOMER' ||
            restaurantId != state.selectedRestaurantId) return;
        state.recommendationLoading = false;
        if (!result.ok || result.data == null) {
            state.recommendationError = result.message;
            return;
        }
        state.recommendationItems = result.data!.items;
        state.recommendationMode = result.data!.mode;
    });
}

/** 降级或新用户结果使用热门口径；未知模式不推测为个性化。 */
function recommendationModeText(): string {
    if (state.recommendationLoading) return '正在更新';
    if (state.recommendationMode == 'PERSONALIZED') return '猜你喜欢';
    if (state.recommendationMode == 'COLD_START') return '热门与发现';
    if (state.recommendationMode == 'FALLBACK') return '暂不可用';
    return '精选菜品';
}

/** 仅将约定的理由代码转成短文案，未知值显示中性描述而不透传内部代码。 */
function recommendationReason(reasonCode: string): string {
    if (reasonCode == 'PURCHASED') return '再尝尝喜欢的味道';
    if (reasonCode == 'FAVORITED') return '你收藏过这道菜';
    if (reasonCode == 'FLAVOR_MATCH') return '也许合你的口味';
    if (reasonCode == 'CONTENT_SIMILAR') return '与你喜欢的菜品相近';
    if (reasonCode == 'SEARCH_RELATED') return '与你最近的搜索相关';
    if (reasonCode == 'WINDOW_FAVORITE') return '来自收藏的档口';
    if (reasonCode == 'POPULAR') return '大家都在吃';
    if (reasonCode == 'EXPLORE') return '换个新口味';
    return '看看这道菜';
}

/** 仅 STARTING 使用起价后缀；未知价格类型如实标注基础价，绝不冒充规格成交价。 */
function recommendationPrice(item: HomeRecommendationItem): string {
    const price = item.basePrice.toFixed(2);
    if (item.priceType == 'STARTING') return price + ' 起';
    if (item.priceType == 'FIXED') return price;
    return price + ' 基础价';
}

/**
 * 把推荐菜品关联到本店档口名。
 *
 * <p>推荐接口只返回 windowId，档口名来自同一页面的档口目录；目录尚未返回或档口已下架时
 * 返回空串，卡片隐藏这一行，不影响菜品名与价格展示。</p>
 *
 * @param item 推荐菜品
 * @return 档口名称，取不到时为空串
 */
function recommendationWindowName(item: HomeRecommendationItem): string {
    for (let i = 0; i < state.windows.length; i++) {
        if (state.windows[i].windowId == item.windowId) return state.windows[i].windowName.trim();
    }
    return '';
}

/** 推荐只定位当前菜品，不发送购物车写请求；规格仍由顾客在菜单页主动选择。 */
function openRecommendation(item: HomeRecommendationItem): void {
    const profile = currentUser();
    if (!isLoggedIn() || profile == null || profile.roleCode != 'CUSTOMER' ||
        profile.userUuid != recommendationOwner || recommendationSessionVersion != getSessionVersion()) return;
    uni.navigateTo({ url: '/pages/menu/menu?windowId=' + item.windowId + '&productId=' + item.productId });
}

function loadCatalog(): Promise<void> {
    // 档口区单独进入加载态并清掉上一次的档口错误；餐厅失败不参与这个状态。
    state.loading = true;
    state.loadError = '';
    // 归零列表就绪标记，数据回来后再重播入场。
    state.listReady = false;

    // 餐厅列表只服务于筛选面板，与档口列表互不依赖；任一失败都不能阻断另一个。
    const restaurantsTask = listActiveRestaurants().then((restaurantResult: RestaurantListResult) => {
        // 餐厅失败时保留上一次成功加载的列表；首次失败则选择器自然隐藏，档口照常展示。
        if (!restaurantResult.ok) return;
        state.restaurants = restaurantResult.items;
        // 冷启动时恢复本账号上次选择的餐厅，再校验是否仍在最新列表中。
        restoreRestaurantPreference();
        // 选中的餐厅若已不在最新列表，回落到全部餐厅，避免筛出空档口且无法取消筛选。
        let selectedExists = state.selectedRestaurantId == ALL_RESTAURANTS;
        for (let i = 0; i < state.restaurants.length; i++) {
            if (state.restaurants[i].restaurantId == state.selectedRestaurantId) {
                selectedExists = true;
                break;
            }
        }
        if (!selectedExists) {
            state.selectedRestaurantId = ALL_RESTAURANTS;
            state.selectedRestaurantName = ALL_RESTAURANTS_NAME;
            // 偏好指向的餐厅已失效，连同本地记录一起清理，下次不再尝试恢复。
            const preferenceKey = restaurantPreferenceKey();
            if (preferenceKey.length > 0) uni.removeStorageSync(preferenceKey);
        }
        // 餐厅可能晚于档口返回，筛选数据变化后立即重算，不必等档口再次加载。
        buildVisibleWindows();
    }).catch(() => {
        // 网络异常同样只影响筛选面板，不改写档口错误或加载状态。
    });

    // 档口失败只把档口区切到错误态，不影响餐厅面板、公告与推荐。
    const windowsTask = listActiveWindows().then((windowResult: WindowListResult) => {
        // 档口列表失败时落到档口区错误态，并结束档口区加载态。
        if (!windowResult.ok) {
            state.loadError = windowResult.message;
            state.loading = false;
            return;
        }
        // 写入档口全量数据。
        state.windows = windowResult.items;
        const version = ++windowRatingVersion;
        state.windowRatings = [];
        // 窗口目录刷新后重新取月售；此时清空旧汇总，避免新旧目录混用旧销量。
        state.monthlyWindowSales = [];
        state.monthlyWindowSalesReady = false;
        const ids: Array<number> = [];
        for (let i = 0; i < state.windows.length; i++) if (state.windows[i].windowId > 0) ids.push(state.windows[i].windowId);
        fetchCardRatings('windows', ids).then((ratings: Array<CardRating>) => { if (version == windowRatingVersion) state.windowRatings = ratings; });
        // 月售是独立的可选展示数据：失败显示“--”，不改变档口列表的成功状态。
        refreshMonthlyWindowSales();
        // 档口先于餐厅返回也立即展示；餐厅随后返回时再重算筛选，互不阻塞。
        state.loading = false;
        buildVisibleWindows();
        // 列表渲染完成后再切到「已入场」，卡片才会依次浮入。
        setTimeout(() => {
            state.listReady = true;
        }, 60);
    }).catch(() => {
        // 档口请求异常时明确提示档口区，而不是让 loading 永久停留。
        state.loadError = '档口列表加载失败，请下拉重试';
        state.loading = false;
    });

    // 只等待两件事都结束以结束下拉刷新；展示与否各自独立，不在这里互相覆盖。
    return Promise.all([restaurantsTask, windowsTask]).then(() => {});
}

/**
 * 静默刷新首页窗口月售汇总，不重载商品目录或重播窗口卡片动画。
 *
 * <p>订单支付后，销量事件会经消息队列异步写入统计读模型；顾客返回首页时重新读取一次，
 * 使卡片尽快显示最新自然月销量。返回首页时不会先清空已展示的数据，因此请求失败仍保留旧值；
 * 首次加载或下拉刷新会由目录加载流程先清空统计状态，失败时显示“--”。递增请求序号会丢弃迟到响应，
 * 避免旧请求覆盖较新的汇总。</p>
 */
function refreshMonthlyWindowSales() {
    const requestVersion = ++windowSalesVersion;
    fetchMonthlyWindowSales().then((salesResult) => {
        if (requestVersion != windowSalesVersion || !salesResult.ok) return;
        state.monthlyWindowSales = salesResult.items;
        state.monthlyWindowSalesReady = true;
    });
}

/** 把批量月售结果按窗口编号映射成卡片文案；服务失败时明确显示占位符。 */
function monthlyWindowSalesText(windowId: number): string {
    if (!state.monthlyWindowSalesReady) return '--';
    for (let i = 0; i < state.monthlyWindowSales.length; i++) {
        const item = state.monthlyWindowSales[i];
        if (item.windowId == windowId) return '' + item.sales;
    }
    // 成功响应未列出的窗口本月销量为零，不把服务失败伪装成零销量。
    return '0';
}

function buildVisibleWindows() {
    // 选中「全部餐厅」时直接展示全量列表。
    if (state.selectedRestaurantId == ALL_RESTAURANTS) {
        state.visibleWindows = state.windows;
        return;
    }
    // 收集属于当前选中餐厅的档口。
    const filtered: Array<WindowItem> = [];
    for (let i = 0; i < state.windows.length; i++) {
        // 档口所属餐厅与选中餐厅一致时纳入可见列表。
        if (state.windows[i].restaurantId == state.selectedRestaurantId) {
            filtered.push(state.windows[i]);
        }
    }
    // 写回筛选结果，驱动页面重新渲染。
    state.visibleWindows = filtered;
}

/** 当前筛选范围内营业中的档口数；休息档口仍展示并单独计数。 */
function openWindowCount(): number {
    let count = 0;
    for (let i = 0; i < state.visibleWindows.length; i++) {
        if (state.visibleWindows[i].isOpen == 1) count++;
    }
    return count;
}

/** 当前筛选范围内休息中的档口数。 */
function restWindowCount(): number {
    return state.visibleWindows.length - openWindowCount();
}

/**
 * 餐厅选择面板列表的高度。
 *
 * <p>每项固定 52px，首项是「全部餐厅」，因此条目数为餐厅数加一。面板最多展示 6 条，
 * 食堂更多时在面板内部纵向滚动，既不会撑高页面，也不要求用户横向滑动筛选条。</p>
 *
 * @return 可直接绑定到 scroll-view 的高度样式
 */
function sheetListStyle(): string {
    const total = state.restaurants.length + 1;
    const visible = total > 6 ? 6 : total;
    return 'height: ' + (visible * 52) + 'px';
}

/** 面板展开/收起共用两个计时器；快速重复点击时先取消旧计时器，避免迟到的卸载把新面板关掉。 */
let pickerShowTimer = 0;
let pickerHideTimer = 0;

/** 面板已展开时点击胶囊即收起，否则展开。 */
function togglePicker() {
    if (state.pickerVisible) {
        closePicker();
        return;
    }
    openPicker();
}

/** 先以初始态挂载面板，下一帧切终态，让上滑过渡真正播放。 */
function openPicker() {
    if (pickerHideTimer > 0) {
        clearTimeout(pickerHideTimer);
        pickerHideTimer = 0;
    }
    state.pickerReady = false;
    state.pickerVisible = true;
    if (pickerShowTimer > 0) clearTimeout(pickerShowTimer);
    pickerShowTimer = setTimeout(() => {
        pickerShowTimer = 0;
        state.pickerReady = true;
    }, 30);
}

/** 先回落到初始态触发滑出，等过渡结束后再卸载节点，避免动画被截断。 */
function closePicker() {
    if (!state.pickerVisible) {
        return;
    }
    if (pickerShowTimer > 0) {
        clearTimeout(pickerShowTimer);
        pickerShowTimer = 0;
    }
    state.pickerReady = false;
    if (pickerHideTimer > 0) clearTimeout(pickerHideTimer);
    pickerHideTimer = setTimeout(() => {
        pickerHideTimer = 0;
        state.pickerVisible = false;
    }, 240);
}

/** 本账号的餐厅偏好存储键；按账号隔离，换人后不会沿用别人的选择。 */
function restaurantPreferenceKey(): string {
    const user = currentUser();
    return user == null ? '' : 'home_restaurant_' + user.userUuid;
}

/** 恢复上次选择的餐厅；列表里已不存在时清除存储，避免筛出空档口。 */
function restoreRestaurantPreference(): void {
    // 当前已有明确选择时不覆盖（例如返回首页或下拉刷新）。
    if (state.selectedRestaurantId != ALL_RESTAURANTS) return;
    const key = restaurantPreferenceKey();
    if (key.length == 0) return;
    const storedId = Number(uni.getStorageSync(key) ?? 0);
    if (storedId <= 0) return;
    for (let i = 0; i < state.restaurants.length; i++) {
        if (state.restaurants[i].restaurantId == storedId) {
            state.selectedRestaurantId = storedId;
            state.selectedRestaurantName = state.restaurants[i].restaurantName;
            return;
        }
    }
    // 餐厅已停用或删除，清掉失效偏好，回到全部餐厅。
    uni.removeStorageSync(key);
}

/**
 * 餐厅选择面板的点击处理。
 *
 * <p>先收起面板再切换数据；切换食堂会同步影响档口列表和推荐范围，因此清空旧推荐并废弃在途请求，
 * 避免短暂展示其他食堂的菜品。重复点击当前食堂只收起面板，不重复请求、也不重播列表动画。</p>
 *
 * @param restaurantId 目标食堂 ID，0 表示全部餐厅
 * @param restaurantName 目标食堂名称，用于区头与空态文案
 */
function selectRestaurant(restaurantId: number, restaurantName: string) {
    // 无论是否切换都先收起面板，保持点选的即时反馈。
    closePicker();
    // 已选中同一食堂时无需刷新。
    if (state.selectedRestaurantId == restaurantId) return;
    state.selectedRestaurantId = restaurantId;
    state.selectedRestaurantName = restaurantName;
    // 记住本账号的选择：下次冷启动仍停留在同一食堂；选择全部时清除偏好。
    const preferenceKey = restaurantPreferenceKey();
    if (preferenceKey.length > 0) {
        if (restaurantId == ALL_RESTAURANTS) uni.removeStorageSync(preferenceKey);
        else uni.setStorageSync(preferenceKey, restaurantId);
    }
    // 餐厅是推荐的硬范围，切换时立即清空旧卡片并废弃旧请求，不能短暂展示其他餐厅结果。
    clearRecommendations();
    loadRecommendations();
    // 按新餐厅重新筛选可见档口。
    buildVisibleWindows();
    // 重新筛选后重播一次入场：先归零再切终态，卡片会再次依次浮入。
    state.listReady = false;
    setTimeout(() => {
        state.listReady = true;
    }, 60);
}

function openWindow(item: WindowItem) {
    // 进入该档口的点餐详情页，由菜单页负责拉取菜单与购物车。
    uni.navigateTo({ url: '/pages/menu/menu?windowId=' + item.windowId });
}

function openSearch() {
    // 进入菜品搜索页，由搜索页负责关键词查询与分页。
    uni.navigateTo({ url: '/pages/search/search' });
}

/** 拨打餐厅电话；号码为空时不触发系统拨号。 */
function callRestaurant(phone: string) {
    if (phone.length == 0) return;
    uni.makePhoneCall({ phoneNumber: phone });
}

/** 公告弹层展开/收起计时器；重复点击时先取消旧计时器，避免迟到的卸载关掉新弹层。 */
let announcementShowTimer = 0;
let announcementHideTimer = 0;

/** 打开公告详情弹层：先以初始态挂载，下一帧切终态以播放上滑过渡。 */
function openAnnouncement() {
    // 没有内容时不打开空弹层。
    if (!state.announcementVisible) return;
    // 打开前再核对账号与会话，防止页面切换过程中展示上一个账号的公告。
    const profile = currentUser();
    if (!isLoggedIn() || profile == null || profile.roleCode != 'CUSTOMER' ||
        profile.userUuid != announcementOwner || announcementSessionVersion != getSessionVersion()) return;
    if (announcementHideTimer > 0) {
        clearTimeout(announcementHideTimer);
        announcementHideTimer = 0;
    }
    state.announcementSheetReady = false;
    state.announcementSheetVisible = true;
    if (announcementShowTimer > 0) clearTimeout(announcementShowTimer);
    announcementShowTimer = setTimeout(() => {
        announcementShowTimer = 0;
        state.announcementSheetReady = true;
    }, 30);
}

/** 关闭公告详情弹层：先回落到初始态触发滑出，过渡结束后再卸载节点。 */
function closeAnnouncement() {
    if (!state.announcementSheetVisible) return;
    if (announcementShowTimer > 0) {
        clearTimeout(announcementShowTimer);
        announcementShowTimer = 0;
    }
    state.announcementSheetReady = false;
    if (announcementHideTimer > 0) clearTimeout(announcementHideTimer);
    announcementHideTimer = setTimeout(() => {
        announcementHideTimer = 0;
        state.announcementSheetVisible = false;
    }, 240);
}

/** 把后端时间裁剪为「YYYY-MM-DD HH:mm」；空串表示不展示发布时间行。 */
function announcementTimeText(): string {
    const value = state.announcementPublishedAt;
    if (value.length == 0) return '';
    return value.replace('T', ' ').substring(0, 16);
}

/**
 * 公告正文滚动区高度。
 *
 * <p>按每行约 18 个汉字、22px 行高估算：短公告让面板贴身展示，长公告最多 300px，
 * 超出部分在面板内部滚动，避免弹层盖满整个首页。</p>
 */
function announcementContentStyle(): string {
    const lines = Math.ceil(state.announcementContent.length / 18);
    const estimated = lines * 22;
    const height = estimated > 300 ? 300 : estimated;
    return 'height: ' + (height < 44 ? 44 : height) + 'px';
}

// 首页为缓存tab页，onReady只执行一次；可见性生命周期单独管理图形动画。
let heroShapesTimer = 0;
let homeReady = false;
let homeVisible = false;
/** 取消迟到回调并恢复动画起点；离页后不再操作隐藏视图。 */
function stopHeroShapes() {
    if (heroShapesTimer > 0) { clearTimeout(heroShapesTimer); heroShapesTimer = 0; }
    state.heroShapesEntered = false;
}
/** 等待起始样式完成一帧布局，再切换终态以触发现有缩放和透明度过渡。 */
function replayHeroShapes() {
    stopHeroShapes();
    heroShapesTimer = setTimeout(() => {
        heroShapesTimer = 0;
        if (homeVisible) state.heroShapesEntered = true;
    }, 60);
}
onPageHide(() => {
    homeVisible = false;
    recommendationRequestVersion++;
    state.recommendationLoading = false;
    // 公告同样废弃在途请求，并立即收起详情弹层，返回首页不残留遮罩。
    announcementRequestVersion++;
    if (announcementShowTimer > 0) { clearTimeout(announcementShowTimer); announcementShowTimer = 0; }
    if (announcementHideTimer > 0) { clearTimeout(announcementHideTimer); announcementHideTimer = 0; }
    state.announcementSheetVisible = false;
    state.announcementSheetReady = false;
    // 离开页面时立即收起餐厅面板并取消延迟计时器，返回首页不残留遮罩。
    if (pickerShowTimer > 0) { clearTimeout(pickerShowTimer); pickerShowTimer = 0; }
    if (pickerHideTimer > 0) { clearTimeout(pickerHideTimer); pickerHideTimer = 0; }
    state.pickerVisible = false;
    state.pickerReady = false;
    stopHeroShapes();
});
onUnload(() => {
    homeVisible = false;
    clearRecommendations();
    clearAnnouncement();
    if (announcementShowTimer > 0) { clearTimeout(announcementShowTimer); announcementShowTimer = 0; }
    if (announcementHideTimer > 0) { clearTimeout(announcementHideTimer); announcementHideTimer = 0; }
    if (pickerShowTimer > 0) { clearTimeout(pickerShowTimer); pickerShowTimer = 0; }
    if (pickerHideTimer > 0) { clearTimeout(pickerHideTimer); pickerHideTimer = 0; }
    state.pickerVisible = false;
    state.pickerReady = false;
    stopHeroShapes();
});

onPageShow(() => {
    homeVisible = true;
    if (homeReady) replayHeroShapes();
    startNotificationSession()
    // 状态栏高度取不到时用 24px 兜底，避免顶部内容被系统栏遮挡。
    const info = uni.getWindowInfo();
    state.statusBarHeight = info.statusBarHeight > 0 ? info.statusBarHeight : 24;
    // 令牌被清空（如退出登录）时不允许停留在本页。
    if (!isLoggedIn()) {
        clearRecommendations();
        uni.reLaunch({ url: '/pages/login/login' });
        return;
    }
    loadProfile();
})

onReady(() => {
    homeReady = true;
    if (homeVisible) replayHeroShapes();
    // 页面渲染完成后窗口信息才准确（app-android 尤其如此），此处再同步一次状态栏高度。
    const readyInfo = uni.getWindowInfo();
    state.statusBarHeight = readyInfo.statusBarHeight > 0 ? readyInfo.statusBarHeight : 24;
    // 首帧绘制完成后再切到「已入场」状态，属性变化才会驱动入场过渡动画。
    setTimeout(() => {
        state.entered = true;
    }, 60);
})
</script>

<style>
	.page {
		flex: 1;
		background-color: #FDF6F0;
	}

	/* ---------- 品牌区 ---------- */

	/* 状态栏底色：与品牌区同色，让头部整块连贯 */
	.statusfill {
		background-color: #E4572E;
	}

	/* 品牌区压缩为「一行品牌字 + 一行搜索」，底边圆角让橙色块像一张盖在页面上的封头 */
	.hero {
		position: relative;
		background-color: #E4572E;
		padding-top: 8px;
		padding-bottom: 16px;
		border-bottom-left-radius: 24px;
		border-bottom-right-radius: 24px;
		overflow: hidden;
	}

	.hero-shape {
		position: absolute;
		border-radius: 999px;
		transition-property: opacity, transform;
		/* 带回弹的缓动曲线：放大到终值前先冲过头再收回，形成弹性出场 */
		transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.hero-shape-1 {
		width: 128px;
		height: 128px;
		right: -44px;
		top: -52px;
		background-color: #FFFFFF;
		opacity: 0.12;
		transform: scale(1);
		transition-duration: 0.7s;
		transition-delay: 0.06s;
	}

	.hero-shape-1-pre {
		opacity: 0;
		transform: scale(0.5);
	}

	/* 琥珀色实心小圆作为点睛，避免整块纯橙过于单调 */
	.hero-shape-2 {
		width: 22px;
		height: 22px;
		right: 104px;
		top: 14px;
		background-color: #F2A93B;
		opacity: 1;
		transform: scale(1);
		transition-duration: 0.5s;
		transition-delay: 0.16s;
	}

	.hero-shape-2-pre {
		opacity: 0;
		transform: scale(0);
	}

	.hero-body {
		padding-left: 20px;
		padding-right: 20px;
	}

	.hero-top {
		flex-direction: row;
		align-items: center;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.08s;
	}

	.hero-top-pre {
		opacity: 0;
		transform: translateY(12px);
	}

	/* 品牌字：首页唯一保留的标题，占满左侧把筛选胶囊推到右边 */
	.hero-brand {
		flex: 1;
		font-size: 18px;
		font-weight: bold;
		color: #FFFFFF;
		letter-spacing: 2px;
	}

	/* 搜索入口：白底圆角块压在橙色封头上 */
	.search-entry {
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
		height: 40px;
		padding-left: 14px;
		padding-right: 14px;
		border-radius: 14px;
		background-color: #FFFFFF;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.20s;
	}

	.search-entry-pre {
		opacity: 0;
		transform: translateY(14px);
	}

	.search-entry-hover {
		background-color: #FDF0E8;
	}

	/* 放大镜：圆形镜片 + 右下角斜向手柄，用两个方块拼出来 */
	.search-lens {
		position: relative;
		flex-shrink: 0;
		width: 12px;
		height: 12px;
		border-radius: 999px;
		border-width: 2px;
		border-style: solid;
		border-color: #E4572E;
	}

	.search-lens-handle {
		position: absolute;
		right: -5px;
		bottom: -1px;
		width: 6px;
		height: 2px;
		background-color: #E4572E;
		transform: rotate(45deg);
	}

	.search-entry-text {
		flex: 1;
		margin-left: 10px;
		font-size: 13px;
		color: #A2968B;
	}

	/* ---------- 餐厅筛选入口 ---------- */

	/* 筛选胶囊：只显示当前食堂，点开后在底部面板里纵向选择，食堂再多也不横向滚动 */
	.hero-picker {
		flex-shrink: 0;
		flex-direction: row;
		align-items: center;
		max-width: 176px;
		height: 30px;
		padding-left: 12px;
		padding-right: 10px;
		border-radius: 999px;
		background-color: rgba(255, 255, 255, 0.22);
	}

	.hero-picker-hover {
		background-color: rgba(255, 255, 255, 0.42);
	}

	.hero-picker-text {
		flex-shrink: 1;
		font-size: 13px;
		font-weight: bold;
		color: #FFFFFF;
	}

	.hero-picker-arrow {
		margin-left: 6px;
		font-size: 12px;
		color: #FFD9C7;
		transform: rotate(0deg);
		transition-property: transform;
		transition-duration: 0.25s;
		transition-timing-function: ease-out;
	}

	.hero-picker-arrow-open {
		transform: rotate(180deg);
	}

	/* ---------- 档口列表 ---------- */

	.section {
		margin-top: 18px;
		padding-left: 16px;
		padding-right: 16px;
	}

	.section-head {
		flex-direction: row;
		align-items: center;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.32s;
	}

	.section-head-pre {
		opacity: 0;
		transform: translateY(14px);
	}

	.section-title {
		font-size: 15px;
		font-weight: bold;
		color: #211C18;
		letter-spacing: 1px;
	}

	.section-count {
		margin-left: 8px;
		font-size: 11px;
		color: #A2968B;
	}

	/* 加载中 / 失败 / 空态的公共容器，跟随区头稍晚淡入 */
	.state {
		margin-top: 14px;
		background-color: #FFFFFF;
		border-radius: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #EFE1D6;
		padding-top: 30px;
		padding-bottom: 30px;
		padding-left: 20px;
		padding-right: 20px;
		align-items: center;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.36s;
	}

	.state-pre {
		opacity: 0;
		transform: translateY(16px);
	}

	.state-text {
		font-size: 13px;
		color: #A2968B;
		text-align: center;
	}

	.state-hint {
		margin-top: 6px;
		font-size: 11px;
		color: #C9BDB2;
		text-align: center;
	}

	.state-action {
		margin-top: 14px;
		padding-left: 18px;
		padding-right: 18px;
		padding-top: 8px;
		padding-bottom: 8px;
		border-radius: 999px;
		background-color: #E4572E;
	}

	.state-action-hover {
		background-color: #C2410C;
	}

	.state-action-text {
		font-size: 13px;
		font-weight: bold;
		color: #FFFFFF;
	}

	.stalls {
		margin-top: 12px;
	}

	/* 推荐横向浏览：124px 窄卡只留图片、菜名、档口和价格，十条推荐不再挤占整屏 */
	.recommendation-scroll { width: 100%; height: 180px; margin-top: 12px; }
	.recommendation-list { flex-direction: row; }
	.recommendation-card {
		width: 124px;
		height: 166px;
		margin-right: 10px;
		flex-shrink: 0;
		border-radius: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #F1E5DA;
		background-color: #FFFFFF;
		overflow: hidden;
	}
	.recommendation-card-hover { background-color: #FDF0E8; border-color: #E4572E; }
	.recommendation-image { position: relative; width: 100%; height: 90px; flex-shrink: 0; background-color: #FDF0E8; overflow: hidden; }
	/* 推荐理由做成图片左下角的白色小角标，不再占正文行高 */
	.recommendation-reason {
		position: absolute;
		left: 7px;
		bottom: 7px;
		max-width: 108px;
		flex-direction: row;
		align-items: center;
		padding-left: 6px;
		padding-right: 6px;
		padding-top: 3px;
		padding-bottom: 3px;
		border-radius: 6px;
		background-color: rgba(255, 255, 255, 0.92);
	}
	.recommendation-reason-text { font-size: 9px; color: #C2410C; }
	.recommendation-body { flex: 1; padding-left: 9px; padding-right: 9px; padding-top: 7px; padding-bottom: 8px; }
	.recommendation-name { font-size: 13px; font-weight: bold; color: #211C18; text-overflow: ellipsis; }
	.recommendation-window { margin-top: 3px; font-size: 10px; color: #A2968B; text-overflow: ellipsis; }
	.recommendation-price-row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: auto; }
	.recommendation-price { font-size: 14px; font-weight: bold; color: #C2410C; }
	.recommendation-arrow { font-size: 15px; color: #D8C6B8; }
	.recommendation-state { height: 110px; margin-top: 12px; padding: 20px; border-radius: 16px; background-color: #FFFFFF; justify-content: center; align-items: center; }
	.recommendation-error { margin-top: 10px; font-size: 12px; color: #7A6C60; }

	/* 每张卡片的延展时间由 stallDelay 以行内样式给出，实现由上到下依次浮入 */
	.stall {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		border-radius: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #F1E5DA;
		padding: 12px;
		margin-bottom: 8px;
		opacity: 1;
		transform: translateY(0);
		/* 只过渡入场用的透明度与位移：底色/描边不在过渡列表内，
		   按下时颜色立即切换，不会被入场延迟拖住 */
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.stall-pre {
		opacity: 0;
		transform: translateY(18px);
	}

	/* 按下时底色转米色、描边转柿子橙，形成干脆的触感反馈 */
	.stall-hover {
		background-color: #FDF6F0;
		border-color: #E4572E;
	}

	.stall-badge {
		overflow: hidden;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background-color: #FDF0E8;
		align-items: center;
		justify-content: center;
	}

	.stall-body {
		flex: 1;
		margin-left: 12px;
	}

	.stall-line {
		flex-direction: row;
		align-items: center;
	}

	.stall-name {
		flex: 1;
		font-size: 15px;
		font-weight: bold;
		color: #211C18;
	}

	/* 评分收紧成小徽标，和档口名同一行，省掉一整行指标区 */
	.stall-rating-badge {
		flex-shrink: 0;
		flex-direction: row;
		align-items: center;
		margin-left: 8px;
		padding-left: 6px;
		padding-right: 6px;
		padding-top: 2px;
		padding-bottom: 2px;
		border-radius: 6px;
		background-color: #FDF0E8;
	}
	.stall-rating-badge-text { font-size: 10px; font-weight: bold; color: #C2410C; }

	/* 零评价使用中性底色，不伪装成有分数的热门档口 */
	.stall-rating-badge-none {
		background-color: #F7F1EB;
	}
	.stall-rating-badge-text-none { color: #A2968B; }

	/* 休息中的档口仍可进入看菜单，用中性底色和徽标与营业档口区分 */
	.stall-resting {
		background-color: #FAF6F2;
	}
	.stall-closed-badge {
		flex-shrink: 0;
		margin-left: 8px;
		padding-left: 6px;
		padding-right: 6px;
		padding-top: 2px;
		padding-bottom: 2px;
		border-radius: 6px;
		background-color: #F0EAE3;
	}
	.stall-closed-badge-text { font-size: 10px; font-weight: bold; color: #8A7C6F; }

	/* 月售、食堂与楼层合并为一行，超长时单行省略 */
	.stall-meta {
		margin-top: 5px;
		font-size: 11px;
		color: #A2968B;
	}

	.stall-arrow {
		font-size: 20px;
		color: #D8C6B8;
	}

	/* ---------- 餐厅选择面板 ---------- */

	/* 半透明遮罩：点击空白处关闭，淡入淡出与面板同步 */
	.mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(33, 28, 24, 0.36);
		opacity: 1;
		transition-property: opacity;
		transition-duration: 0.24s;
		transition-timing-function: ease-out;
	}

	.mask-pre {
		opacity: 0;
	}

	/* 底部面板：圆角白卡 + 拖拽条，内部列表按食堂数量决定高度并纵向滚动 */
	.sheet {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: #FFFFFF;
		border-top-left-radius: 24px;
		border-top-right-radius: 24px;
		padding-top: 10px;
		padding-bottom: 22px;
		padding-left: 16px;
		padding-right: 16px;
		transform: translateY(0);
		transition-property: transform;
		transition-duration: 0.24s;
		transition-timing-function: ease-out;
	}

	.sheet-pre {
		transform: translateY(440px);
	}

	.sheet-title {
		align-self: center;
		font-size: 13px;
		font-weight: bold;
		color: #211C18;
	}

	.sheet-list {
		margin-top: 10px;
	}

	.sheet-item {
		flex-direction: row;
		align-items: center;
		height: 52px;
		padding-left: 8px;
		padding-right: 8px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F7EFE7;
	}

	.sheet-item-hover {
		background-color: #FDF6F0;
	}

	.sheet-item-body {
		flex: 1;
	}

	.sheet-item-name {
		font-size: 15px;
		color: #211C18;
	}

	.sheet-item-name-on {
		font-weight: bold;
		color: #C2410C;
	}

	.sheet-item-loc {
		margin-top: 2px;
		font-size: 11px;
		color: #A2968B;
	}

	/* 餐厅公告最多两行，电话可点击直接拨号 */
	.sheet-item-notice {
		margin-top: 2px;
		font-size: 11px;
		line-height: 15px;
		color: #8A7C6F;
	}

	.sheet-item-phone {
		margin-top: 2px;
		font-size: 11px;
		color: #E4572E;
	}

	.sheet-item-tick {
		font-size: 15px;
		font-weight: bold;
		color: #E4572E;
	}

	/* ---------- 首页公告 ---------- */

	/* 公告条：单行胶囊卡片，位于品牌区与推荐区之间；无公告时整块不渲染 */
	.announcement-bar {
		flex-direction: row;
		align-items: center;
		height: 44px;
		margin-top: 12px;
		margin-left: 16px;
		margin-right: 16px;
		padding-left: 10px;
		padding-right: 12px;
		border-radius: 14px;
		background-color: #FFFFFF;
	}

	.announcement-bar-hover {
		background-color: #FDF0E8;
	}

	/* 小徽标只占一行高度，避免与标题争夺横向空间 */
	.announcement-badge {
		height: 20px;
		padding-left: 8px;
		padding-right: 8px;
		border-radius: 999px;
		background-color: #FDE7DC;
		justify-content: center;
		align-items: center;
	}

	.announcement-badge-text {
		font-size: 10px;
		font-weight: bold;
		color: #E4572E;
	}

	.announcement-text {
		flex: 1;
		margin-left: 8px;
		margin-right: 8px;
		font-size: 13px;
		color: #4A4038;
	}

	.announcement-arrow {
		font-size: 16px;
		color: #B9A99B;
	}

	.announcement-head {
		margin-top: 12px;
	}

	.announcement-detail-title {
		font-size: 16px;
		font-weight: bold;
		color: #211C18;
	}

	.announcement-detail-time {
		margin-top: 6px;
		font-size: 11px;
		color: #A2968B;
	}

	.announcement-detail {
		margin-top: 10px;
		margin-bottom: 8px;
	}

	.announcement-detail-content {
		font-size: 14px;
		line-height: 22px;
		color: #4A4038;
	}

	/* ---------- 页脚 ---------- */

	.footer {
		margin-top: auto;
		padding-top: 18px;
		padding-bottom: 24px;
		align-items: center;
