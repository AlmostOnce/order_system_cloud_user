<template>
	<view class="page">
		<!-- 状态栏底色与品牌区同色，避免顶部出现米色缝隙 -->
		<view class="statusfill" :style="'height:' + statusBarHeight + 'px'"></view>

		<!-- 品牌区：柿子橙实色块 + 半透明几何圆，控件与标题错峰上浮 -->
		<view class="hero">
			<view class="hero-shape hero-shape-1" :class="entered ? '' : 'hero-shape-1-pre'"></view>
			<view class="hero-shape hero-shape-2" :class="entered ? '' : 'hero-shape-2-pre'"></view>
			<view class="hero-body">
				<!-- 左上角餐厅选择入口：点击后从底部弹出餐厅列表 -->
				<view class="hero-top" :class="entered ? '' : 'hero-top-pre'">
					<view
						v-if="roleCode == 'CUSTOMER'"
						class="picker"
						hover-class="picker-hover"
						@click="togglePicker"
					>
						<text class="picker-text">{{ selectedRestaurantName }}</text>
						<text class="picker-arrow" :class="pickerVisible ? 'picker-arrow-open' : ''">⌄</text>
					</view>
					<text class="hero-eyebrow">CAMPUS CANTEEN</text>
				</view>
				<text class="hero-greeting" :class="entered ? '' : 'hero-greeting-pre'">{{ greeting }}</text>
				<text class="hero-desc" :class="entered ? '' : 'hero-desc-pre'">看看今天哪个档口合胃口</text>
			</view>
		</view>

		<!-- 档口列表：区头先入场，卡片等数据到位后依次浮入 -->
		<view class="section">
			<view class="section-head" :class="entered ? '' : 'section-head-pre'">
				<text class="section-title">{{ listTitle() }}</text>
				<text
					v-if="roleCode == 'CUSTOMER' && !loading && loadError.length == 0"
					class="section-count"
				>{{ visibleWindows.length }} 个在营业</text>
			</view>

			<view v-if="loading" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">正在加载档口列表…</text>
			</view>

			<view v-else-if="loadError.length > 0" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">{{ loadError }}</text>
				<view class="state-action" hover-class="state-action-hover" @click="loadCatalog">
					<text class="state-action-text">重新加载</text>
				</view>
			</view>

			<view v-else-if="roleCode != 'CUSTOMER'" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">档口展示面向学生用户开放</text>
				<text class="state-hint">请用学生账号登录查看</text>
			</view>

			<view v-else-if="visibleWindows.length == 0" class="state" :class="entered ? '' : 'state-pre'">
				<text class="state-text">{{ emptyHint() }}</text>
			</view>

			<view v-else class="stalls">
				<view
					class="stall"
					:class="listReady ? '' : 'stall-pre'"
					:style="stallDelay(index)"
					hover-class="stall-hover"
					v-for="(item, index) in visibleWindows"
					:key="item.windowId"
					@click="openWindow(item)"
				>
					<view class="stall-badge">
						<text class="stall-badge-text">{{ stallGlyph(item) }}</text>
					</view>
					<view class="stall-body">
						<text class="stall-name">{{ item.windowName }}</text>
						<text class="stall-meta">{{ stallMeta(item) }}</text>
						<text v-if="item.description.trim().length > 0" class="stall-desc">{{ stallDescription(item) }}</text>
					</view>
					<text class="stall-arrow">›</text>
				</view>
			</view>
		</view>

		<view class="footer">
			<text class="footer-text">湖北经济学院 · 食堂管理中心</text>
		</view>

		<!-- 餐厅选择面板：遮罩淡入，面板自底部上滑；关闭时先回落再卸载节点 -->
		<view
			v-if="pickerVisible"
			class="mask"
			:class="pickerReady ? '' : 'mask-pre'"
			@click="closePicker"
		></view>
		<view v-if="pickerVisible" class="sheet" :class="pickerReady ? '' : 'sheet-pre'">
			<text class="sheet-title">选择餐厅</text>
			<scroll-view class="sheet-list" scroll-y="true" :style="sheetListStyle()">
				<view
					class="sheet-item"
					hover-class="sheet-item-hover"
					@click="selectRestaurant(0, '全部餐厅')"
				>
					<view class="sheet-item-body">
						<text class="sheet-item-name" :class="selectedRestaurantId == 0 ? 'sheet-item-name-on' : ''">全部餐厅</text>
					</view>
					<text v-if="selectedRestaurantId == 0" class="sheet-item-tick">✓</text>
				</view>
				<view
					class="sheet-item"
					hover-class="sheet-item-hover"
					:key="item.restaurantId"
					v-for="item in restaurants"
					@click="selectRestaurant(item.restaurantId, item.restaurantName)"
				>
					<view class="sheet-item-body">
						<text
							class="sheet-item-name"
							:class="selectedRestaurantId == item.restaurantId ? 'sheet-item-name-on' : ''"
						>{{ item.restaurantName }}</text>
						<text v-if="item.location.length > 0" class="sheet-item-loc">{{ item.location }}</text>
					</view>
					<text v-if="selectedRestaurantId == item.restaurantId" class="sheet-item-tick">✓</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script lang="uts">
	// 导入登录态：登录判断与当前身份读取（退出入口已迁到「我的」页）。
	import { isLoggedIn, currentUser } from '../../store/auth.uts'
	// 导入商品查询与结果类型：档口列表、餐厅列表及其返回结构。
	import { listActiveWindows, listActiveRestaurants, WindowItem, WindowListResult, RestaurantItem, RestaurantListResult } from '../../api/product.uts'

	/** 表示「全部餐厅」的哨兵值，与任何真实餐厅 ID 都不会冲突。 */
	const ALL_RESTAURANTS: number = 0

	/** 「全部餐厅」的展示名称。 */
	const ALL_RESTAURANTS_NAME: string = '全部餐厅'

	/**
	 * 按当前时刻生成问候语。
	 *
	 * 首页不再展示任何个人信息，问候语只按时段变化，不拼用户名。
	 *
	 * @return 纯时段问候语
	 */
	function buildGreeting(): string {
		// 取本机当前小时数，用于选择时段问候语。
		const hour = new Date().getHours()
		// 默认按晚间问候，再由时段判断覆盖。
		let prefix = '晚上好'
		// 深夜 0-5 点。
		if (hour < 6) {
			prefix = '夜里好'
		} else if (hour < 11) {
			// 早晨 6-10 点。
			prefix = '早上好'
		} else if (hour < 14) {
			// 中午 11-13 点。
			prefix = '中午好'
		} else if (hour < 18) {
			// 下午 14-17 点。
			prefix = '下午好'
		}
		// 直接返回时段问候，不拼接用户名等个人信息。
		return prefix
	}

	/**
	 * 名称过长时截断，避免把品牌区第一行撑破。
	 *
	 * @param name 原始名称
	 * @return 展示用名称
	 */
	function shortenName(name: string): string {
		// 超过 8 个字符时截断并追加省略号。
		if (name.length > 8) {
			return name.substring(0, 8) + '…'
		}
		// 未超长则原样返回。
		return name
	}

	export default {
		data() {
			// 档口列表与可见档口共用同一份空数组，避免先渲染时出现 undefined。
			const emptyWindows: Array<WindowItem> = []
			// 餐厅列表的初始空数组。
			const emptyRestaurants: Array<RestaurantItem> = []

			return {
				// 状态栏高度（px），用于顶部占位，避免内容被系统状态栏遮挡。
				statusBarHeight: 0,
				// 顶部问候语：初值必须保持为空字符串，不能在此调用依赖当前时间的函数。
				// H5 端首屏会先做服务端预渲染再在客户端 hydrate，data() 里的 new Date()
				// 在两端取值可能不一致，会触发 hydration mismatch 警告。
				greeting: '',
				// 当前角色编码，用于模板判断是否展示档口列表。
				roleCode: '',
				// 后端返回的档口全量列表。
				windows: emptyWindows,
				// 按当前选中餐厅筛选后、供页面渲染的档口列表。
				visibleWindows: emptyWindows,
				// 后端返回的餐厅列表，供选择面板渲染。
				restaurants: emptyRestaurants,
				// 当前选中的餐厅 ID，0 表示「全部餐厅」。
				selectedRestaurantId: ALL_RESTAURANTS,
				// 当前选中餐厅的展示名称。
				selectedRestaurantName: ALL_RESTAURANTS_NAME,
				// 是否正在加载档口与餐厅数据。
				loading: true,
				// 加载失败的错误文案，非空时页面展示错误态。
				loadError: '',
				// 是否已进入入场动画终态，切换后驱动各元素的过渡。
				entered: false,
				// 档口列表是否已就绪，控制卡片依次浮入的过渡。
				listReady: false,
				// 餐厅选择面板是否已挂载显示。
				pickerVisible: false,
				// 餐厅选择面板是否已进入终态，控制其滑入滑出过渡。
				pickerReady: false
			}
		},
		onShow() {
			// 状态栏高度取不到时用 24px 兜底，避免顶部内容被系统栏遮挡。
			const info = uni.getWindowInfo()
			this.statusBarHeight = info.statusBarHeight > 0 ? info.statusBarHeight : 24

			// 令牌被清空（如退出登录）时不允许停留在本页。
			if (!isLoggedIn()) {
				uni.reLaunch({ url: '/pages/login/login' })
				return
			}
			this.loadProfile()
		},
		onReady() {
			// 页面渲染完成后窗口信息才准确（app-android 尤其如此），此处再同步一次状态栏高度。
			const readyInfo = uni.getWindowInfo()
			this.statusBarHeight = readyInfo.statusBarHeight > 0 ? readyInfo.statusBarHeight : 24

			// 首帧绘制完成后再切到「已入场」状态，属性变化才会驱动入场过渡动画。
			setTimeout(() => {
				this.entered = true
			}, 60)
		},
		methods: {
			/**
			 * 计算各档口卡片的入场延迟，让列表从上到下依次浮入。
			 *
			 * 直接列出各档位秒数，避免浮点运算产生冗长的小数文本；
			 * 超出预设档位的一律沿用最后一档，防止长列表出现越来越长的等待。
			 *
			 * @param index 卡片下标
			 * @return 内联的 transition-delay 声明
			 */
			stallDelay(index: number): string {
				// 预置各档位的延迟秒数，下标即卡片序号。
				const delays: string[] = ['0.34s', '0.40s', '0.46s', '0.52s', '0.58s', '0.64s', '0.70s', '0.76s']
				// 下标异常（负数）时退回第一档，避免取值越界。
				if (index < 0) {
					return 'transition-delay: 0.34s'
				}
				// 超出预设档位的卡片统一沿用最后一档，防止等待时间无限增长。
				if (index >= delays.length) {
					return 'transition-delay: 0.76s'
				}
				// 正常档位：拼出内联的 transition-delay 声明。
				return 'transition-delay: ' + delays[index]
			},
			/**
			 * 计算餐厅面板的高度，按条目数自适应并最多展示 6 条。
			 *
			 * @return 内联的 height 声明
			 */
			sheetListStyle(): string {
				// 每项固定 52px，首项是「全部餐厅」，故条目数为餐厅数加一。
				const total = this.restaurants.length + 1
				// 面板最多展示 6 条，超出部分靠内部滚动查看。
				const visible = total > 6 ? 6 : total
				// 按可见条目数换算出面板高度。
				return 'height: ' + (visible * 52) + 'px'
			},
			/**
			 * 区头标题，跟随当前选中的餐厅变化。
			 *
			 * @return 标题文案
			 */
			listTitle(): string {
				// 选中「全部餐厅」时展示通用标题。
				if (this.selectedRestaurantId == ALL_RESTAURANTS) {
					return '全部档口'
				}
				// 否则直接以当前餐厅名作为区头标题。
				return this.selectedRestaurantName
			},
			/**
			 * 空态文案，区分「整体无营业档口」与「某个餐厅暂无营业档口」。
			 *
			 * @return 空态文案
			 */
			emptyHint(): string {
				// 「全部餐厅」下的空态：整体没有营业档口。
				if (this.selectedRestaurantId == ALL_RESTAURANTS) {
					return '当前没有正在营业的档口'
				}
				// 指定餐厅下的空态：把餐厅名拼进提示，明确是哪一个餐厅无档口。
				return this.selectedRestaurantName + ' 暂无营业中的档口'
			},
			/**
			 * 取档口名称首字作为卡片标记，避免引入位图图标。
			 *
			 * @param item 档口
			 * @return 单个汉字
			 */
			stallGlyph(item: WindowItem): string {
				// 有名称时取首字作为标记。
				if (item.windowName.length > 0) {
					return item.windowName.substring(0, 1)
				}
				// 名称为空时用「档」兜底，保证标记区不出现空白。
				return '档'
			},
			/**
			 * 生成档口副标题，展示所属食堂及档口位置（楼层）。
			 *
			 * @param item 档口
			 * @return 副标题文案
			 */
			stallMeta(item: WindowItem): string {
				// 通过所属餐厅 ID 关联完整名称，不使用顶部筛选器的简称。
				let restaurantName = ''
				for (let i = 0; i < this.restaurants.length; i++) {
					if (this.restaurants[i].restaurantId == item.restaurantId) {
						restaurantName = this.restaurants[i].restaurantName.trim()
						break
					}
				}
				const location = item.location.trim()
				if (restaurantName.length == 0) {
					return '食堂待补充 · ' + (location.length > 0 ? location : '楼层待补充')
				}
				if (location.length == 0) {
					return restaurantName + ' · 楼层待补充'
				}
				// 位置已包含完整食堂名称时，避免重复拼接。
				if (location.indexOf(restaurantName) >= 0) {
					return location
				}
				return restaurantName + ' · ' + location
			},
			/** 首页仅展示简介摘要，完整内容在点单页查看。 */
			stallDescription(item: WindowItem): string {
				const description = item.description.trim()
				return description.length > 48 ? description.substring(0, 48) + '…' : description
			},
			loadProfile() {
				// 从本地令牌解析出当前用户信息。
				const profile = currentUser()
				// 令牌存在但解析失败，说明凭据已不可用，回到登录页重新获取。
				if (profile == null) {
					uni.reLaunch({ url: '/pages/login/login' })
					return
				}
				// 只保留角色编码用于判断是否展示档口列表，其余个人信息不在首页展示。
				this.roleCode = profile.roleCode
				// 每次进入页面按时段刷新问候语。
				this.greeting = buildGreeting()

				// 仅顾客角色需要拉取档口与餐厅数据。
				if (this.roleCode == 'CUSTOMER') {
					this.loadCatalog()
				} else {
					// 后端餐厅与档口查询接口只放行顾客角色，其它角色在此直接给出说明，
					// 省掉一次必然失败的请求，也不会在首页上摆一个错误提示。
					this.loading = false
					this.loadError = ''
				}
			},
			/**
			 * 拉取餐厅列表与档口列表。
			 *
			 * 先取餐厅再取档口：餐厅决定了选择面板的内容，接口语义上更靠前，
			 * 顺序请求也让加载中的状态文案更直观。
			 */
			loadCatalog() {
				// 进入加载态并清掉上一次的错误文案。
				this.loading = true
				this.loadError = ''
				// 归零列表就绪标记，数据回来后再重播入场。
				this.listReady = false

				listActiveRestaurants().then((restaurantResult: RestaurantListResult) => {
					// 餐厅列表失败时直接落到错误态，不再发起档口请求。
					if (!restaurantResult.ok) {
						this.loading = false
						this.loadError = restaurantResult.message
						return
					}
					// 餐厅数据一次性写入，供选择面板渲染。
					this.restaurants = restaurantResult.items

					listActiveWindows().then((windowResult: WindowListResult) => {
						// 档口结果返回后统一结束加载态。
						this.loading = false
						// 档口列表失败时落到错误态。
						if (!windowResult.ok) {
							this.loadError = windowResult.message
							return
						}
						// 写入档口全量数据。
						this.windows = windowResult.items
						// 按当前选中餐厅算出可见档口。
						this.buildVisibleWindows()
						// 列表渲染完成后再切到「已入场」，卡片才会依次浮入。
						setTimeout(() => {
							this.listReady = true
						}, 60)
					})
				})
			},
			/**
			 * 按当前选中的餐厅筛选档口。
			 *
			 * 档口全量只有几十条，一次拉全再本地筛选，避免为切换餐厅再开一个接口。
			 */
			buildVisibleWindows() {
				// 选中「全部餐厅」时直接展示全量列表。
				if (this.selectedRestaurantId == ALL_RESTAURANTS) {
					this.visibleWindows = this.windows
					return
				}

				// 收集属于当前选中餐厅的档口。
				const filtered: Array<WindowItem> = []
				for (let i = 0; i < this.windows.length; i++) {
					// 档口所属餐厅与选中餐厅一致时纳入可见列表。
					if (this.windows[i].restaurantId == this.selectedRestaurantId) {
						filtered.push(this.windows[i])
					}
				}
				// 写回筛选结果，驱动页面重新渲染。
				this.visibleWindows = filtered
			},
			togglePicker() {
				// 面板已展开时点击入口即收起。
				if (this.pickerVisible) {
					this.closePicker()
					return
				}
				// 面板未展开时点击入口即展开。
				this.openPicker()
			},
			/**
			 * 展开选择面板：先渲染初始态，下一帧再切终态以触发过渡。
			 */
			openPicker() {
				// 先置为初始态，保证面板以「未就绪」的样子挂载。
				this.pickerReady = false
				// 挂载面板节点（此时还是初始态）。
				this.pickerVisible = true
				// 下一帧切到终态，属性变化驱动滑入过渡。
				setTimeout(() => {
					this.pickerReady = true
				}, 30)
			},
			/**
			 * 收起选择面板：先回落到初始态，等过渡结束再卸载节点。
			 */
			closePicker() {
				// 面板本就未显示时无需处理。
				if (!this.pickerVisible) {
					return
				}
				// 先回落到初始态，触发滑出过渡。
				this.pickerReady = false
				// 等过渡播放完毕（240ms）再卸载节点，避免动画被截断。
				setTimeout(() => {
					this.pickerVisible = false
				}, 240)
			},
			/**
			 * 选择餐厅并刷新档口列表。
			 *
			 * @param restaurantId 餐厅 ID，取 0 表示全部餐厅
			 * @param restaurantName 餐厅名称
			 */
			selectRestaurant(restaurantId: number, restaurantName: string) {
				// 选中后立即收起选择面板。
				this.closePicker()
				// 记录选中的餐厅 ID。
				this.selectedRestaurantId = restaurantId
				// 名称过长时截断后再展示。
				this.selectedRestaurantName = shortenName(restaurantName)
				// 按新餐厅重新筛选可见档口。
				this.buildVisibleWindows()

				// 重新筛选后重播一次入场：先归零再切终态，卡片会再次依次浮入。
				this.listReady = false
				setTimeout(() => {
					this.listReady = true
				}, 60)
			},
			openWindow(item: WindowItem) {
				// 进入该档口的点餐详情页，由菜单页负责拉取菜单与购物车。
				uni.navigateTo({ url: '/pages/menu/menu?windowId=' + item.windowId })
			}
		}
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #FDF6F0;
	}

	/* ---------- 品牌区 ---------- */

	/* 状态栏底色：与品牌区同色，让头部整块连贯 */
	.statusfill {
		background-color: #E4572E;
	}

	.hero {
		position: relative;
		background-color: #E4572E;
		padding-top: 22px;
		/* 首页已移除重叠的用户信息卡，底部只留常规留白 */
		padding-bottom: 24px;
		overflow: hidden;
	}

	.hero-shape {
		position: absolute;
		border-radius: 999px;
		transition-property: opacity, transform;
		/* 带回弹的缓动曲线：放大到终值前先冲过头再收回，形成弹性出场 */
		transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.hero-shape-1 {
		width: 156px;
		height: 156px;
		right: -54px;
		top: -42px;
		background-color: #FFFFFF;
		opacity: 0.14;
		transform: scale(1);
		transition-duration: 0.7s;
		transition-delay: 0.06s;
	}

	.hero-shape-1-pre {
		opacity: 0;
		transform: scale(0.5);
	}

	/* 琥珀色实心小圆作为点睛，避免整块纯橙过于单调 */
	.hero-shape-2 {
		width: 28px;
		height: 28px;
		right: 36px;
		top: 54px;
		background-color: #F2A93B;
		opacity: 1;
		transform: scale(1);
		transition-duration: 0.5s;
		transition-delay: 0.16s;
	}

	.hero-shape-2-pre {
		opacity: 0;
		transform: scale(0);
	}

	.hero-body {
		padding-left: 24px;
		padding-right: 24px;
	}

	/* 第一行：左侧餐厅选择入口，右侧品牌小字，整行一起上浮入场 */
	.hero-top {
		flex-direction: row;
		align-items: center;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.08s;
	}

	.hero-top-pre {
		opacity: 0;
		transform: translateY(12px);
	}

	/* 餐厅选择胶囊：半透明白底压在橙色块上；底色不在过渡列表内，按下立即变化 */
	.picker {
		flex-direction: row;
		align-items: center;
		padding-left: 12px;
		padding-right: 10px;
		padding-top: 7px;
		padding-bottom: 7px;
		border-radius: 999px;
		background-color: rgba(255, 255, 255, 0.22);
	}

	.picker-hover {
		background-color: rgba(255, 255, 255, 0.42);
	}

	.picker-text {
		font-size: 13px;
		font-weight: bold;
		color: #FFFFFF;
	}

	.picker-arrow {
		margin-left: 6px;
		font-size: 12px;
		color: #FFD9C7;
		transform: rotate(0deg);
		transition-property: transform;
		transition-duration: 0.25s;
		transition-timing-function: ease-out;
	}

	.picker-arrow-open {
		transform: rotate(180deg);
	}

	.hero-eyebrow {
		margin-left: 10px;
		font-size: 11px;
		color: #FFD9C7;
		letter-spacing: 3px;
		font-weight: bold;
	}

	.hero-greeting {
		margin-top: 10px;
		font-size: 26px;
		font-weight: bold;
		color: #FFFFFF;
		letter-spacing: 1px;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.55s;
		/* 短语到位时略过冲再回落，避免机械的匀速滑入 */
		transition-timing-function: cubic-bezier(0.22, 1.3, 0.36, 1);
		transition-delay: 0.14s;
	}

	.hero-greeting-pre {
		opacity: 0;
		transform: translateY(16px);
	}

	.hero-desc {
		margin-top: 8px;
		font-size: 12px;
		color: #FFD9C7;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.20s;
	}

	.hero-desc-pre {
		opacity: 0;
		transform: translateY(14px);
	}

	/* ---------- 档口列表 ---------- */

	.section {
		margin-top: 24px;
		padding-left: 20px;
		padding-right: 20px;
	}

	.section-head {
		flex-direction: row;
		align-items: center;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.32s;
	}

	.section-head-pre {
		opacity: 0;
		transform: translateY(14px);
	}

	.section-title {
		font-size: 15px;
		font-weight: bold;
		color: #211C18;
		letter-spacing: 1px;
	}

	.section-count {
		margin-left: 8px;
		font-size: 11px;
		color: #A2968B;
	}

	/* 加载中 / 失败 / 空态的公共容器，跟随区头稍晚淡入 */
	.state {
		margin-top: 14px;
		background-color: #FFFFFF;
		border-radius: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #EFE1D6;
		padding-top: 30px;
		padding-bottom: 30px;
		padding-left: 20px;
		padding-right: 20px;
		align-items: center;
		opacity: 1;
		transform: translateY(0);
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: ease-out;
		transition-delay: 0.36s;
	}

	.state-pre {
		opacity: 0;
		transform: translateY(16px);
	}

	.state-text {
		font-size: 13px;
		color: #A2968B;
		text-align: center;
	}

	.state-hint {
		margin-top: 6px;
		font-size: 11px;
		color: #C9BDB2;
		text-align: center;
	}

	.state-action {
		margin-top: 14px;
		padding-left: 18px;
		padding-right: 18px;
		padding-top: 8px;
		padding-bottom: 8px;
		border-radius: 999px;
		background-color: #E4572E;
	}

	.state-action-hover {
		background-color: #C2410C;
	}

	.state-action-text {
		font-size: 13px;
		font-weight: bold;
		color: #FFFFFF;
	}

	.stalls {
		margin-top: 14px;
	}

	/* 每张卡片的延展时间由 stallDelay 以行内样式给出，实现由上到下依次浮入 */
	.stall {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		border-radius: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #EFE1D6;
		padding: 14px;
		margin-bottom: 12px;
		opacity: 1;
		transform: translateY(0);
		/* 只过渡入场用的透明度与位移：底色/描边不在过渡列表内，
		   按下时颜色立即切换，不会被入场延迟拖住 */
		transition-property: opacity, transform;
		transition-duration: 0.5s;
		transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.stall-pre {
		opacity: 0;
		transform: translateY(18px);
	}

	/* 按下时底色转米色、描边转柿子橙，形成干脆的触感反馈 */
	.stall-hover {
		background-color: #FDF6F0;
		border-color: #E4572E;
	}

	.stall-badge {
		width: 44px;
		height: 44px;
		border-radius: 15px;
		background-color: #FDF0E8;
		align-items: center;
		justify-content: center;
	}

	.stall-badge-text {
		font-size: 19px;
		font-weight: bold;
		color: #E4572E;
	}

	.stall-body {
		flex: 1;
		margin-left: 12px;
	}

	.stall-name {
		font-size: 15px;
		font-weight: bold;
		color: #211C18;
	}

	.stall-meta {
		margin-top: 5px;
		font-size: 11px;
		color: #A2968B;
	}

	.stall-arrow {
		font-size: 20px;
		color: #D8C6B8;
	}

	.stall-desc {
		margin-top: 6px;
		font-size: 12px;
		line-height: 18px;
		color: #7A6C60;
	}

	/* ---------- 餐厅选择面板 ---------- */

	/* 遮罩：铺满全屏，点击即收起面板 */
	.mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		/* 原生 tabBar 的层级固定为 998（H5 端 .uni-tabbar），遮罩必须高于它，
		   否则面板展开时底部一条会被 tabBar 盖住，且 tabBar 仍可点击 */
		z-index: 999;
		background-color: rgba(33, 28, 24, 0.45);
		opacity: 1;
		transition-property: opacity;
		transition-duration: 0.24s;
		transition-timing-function: ease-out;
	}

	.mask-pre {
		opacity: 0;
	}

	/* 面板：自底部上滑到位时略过冲再回落 */
	.sheet {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		/* 层级需同时高于 tabBar(998) 与遮罩(999)，面板底部才不会被 tabBar 遮挡 */
		z-index: 1000;
		background-color: #FFFFFF;
		border-top-left-radius: 22px;
		border-top-right-radius: 22px;
		padding-top: 18px;
		padding-bottom: 24px;
		transform: translateY(0);
		transition-property: transform;
		transition-duration: 0.3s;
		transition-timing-function: cubic-bezier(0.22, 1.3, 0.36, 1);
	}

	.sheet-pre {
		transform: translateY(440px);
	}

	.sheet-title {
		padding-left: 22px;
		font-size: 13px;
		font-weight: bold;
		color: #211C18;
		letter-spacing: 1px;
	}

	.sheet-list {
		margin-top: 8px;
	}

	/* 面板条目：底色不在过渡列表内，按下立即给出反馈 */
	.sheet-item {
		flex-direction: row;
		align-items: center;
		height: 52px;
		padding-left: 22px;
		padding-right: 22px;
	}

	.sheet-item-hover {
		background-color: #FDF6F0;
	}

	.sheet-item-body {
		flex: 1;
	}

	.sheet-item-name {
		font-size: 15px;
		color: #211C18;
	}

	.sheet-item-name-on {
		font-weight: bold;
		color: #E4572E;
	}

	.sheet-item-loc {
		margin-top: 2px;
		font-size: 11px;
		color: #A2968B;
	}

	.sheet-item-tick {
		font-size: 14px;
		font-weight: bold;
		color: #E4572E;
	}

	/* ---------- 页脚 ---------- */

	.footer {
		margin-top: auto;
		padding-top: 18px;
		padding-bottom: 24px;
		align-items: center;
	}

	.footer-text {
		font-size: 11px;
		color: #C9BDB2;
	}
</style>
