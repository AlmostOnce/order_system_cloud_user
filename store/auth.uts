import { clearEmailOwnershipSession, setEnrollmentAuthorization } from '../common/email-ownership-session.uts'
import { jsonObject, jsonString, jsonNumber, jsonBoolean } from '../common/json.uts'
import { clearEmailChangeAuthorization } from '../common/email-change-session.uts'
import { startNotificationSession, stopNotificationSession } from './notifications.uts'
/**
 * 登录态管理。
 *
 * 负责编排「调用接口—解析令牌—落盘凭据」的完整流程，页面只与这里交互，
 * 不直接接触令牌与存储细节。
 *
 * 登录以结构化结果区分成功、邮箱补验与失败；注册返回账号回执。
 */

// 导入认证接口：本层在其之上编排「取令牌—落盘—记住账号」的完整流程。
import { login as loginApi, register as registerApi, logout as logoutApi } from '../api/auth.uts'
// 导入统一请求结果类型，用于标注接口返回值。
import { HttpResult } from '../common/http.uts'
// 导入本地凭据读写：保存/清除双令牌，以及「记住账号」的读写。
import { saveTokens, clearTokens, getAccessToken, getRefreshToken, setRememberedAccount, clearRememberedAccount, beginSessionClose } from '../common/storage.uts'
// 导入 JWT 载荷解析，用于在不请求后端的情况下读取当前登录身份。
import { parseTokenPayload, TokenPayload } from '../common/jwt.uts'

/**
 * 账号密码登录。
 *
 * 登录成功后写入双令牌；「记住账号」只保存用户号或邮箱，不保存密码。
 *
 * @param account 用户号或邮箱
 * @param password 密码
 * @param captchaId 验证码标识，由获取验证码接口下发
 * @param captchaCode 用户输入的验证码字符
 * @param rememberAccount 是否记住登录账号
 * @return 登录结果；需要补验时不保存Access/Refresh Token
 */
export type LoginResult = { ok: boolean, message: string, emailVerificationRequired: boolean, deletionPending: boolean }

/**
 * 待注销会话。
 *
 * 只保存在内存中，不写入本地存储：撤回令牌是一次性安全凭据，应用重启后必须重新
 * 登录获取，避免长期落盘被其他页面或脚本读取。
 */
export type PendingDeletionSession = { effectiveAt: string, cancelToken: string, expiresIn: number }
let pendingDeletionSession: PendingDeletionSession | null = null

/** 缓存登录返回的待注销信息与一次性撤回令牌。 */
export function setPendingDeletionSession(effectiveAt: string, cancelToken: string, expiresIn: number): void {
	pendingDeletionSession = { effectiveAt: effectiveAt, cancelToken: cancelToken, expiresIn: expiresIn }
}

/** 读取当前待注销会话；没有时返回 null。 */
export function getPendingDeletionSession(): PendingDeletionSession | null {
	return pendingDeletionSession
}

/** 撤回成功、令牌过期或用户离开待注销页面后清除内存凭据。 */
export function clearPendingDeletionSession(): void {
	pendingDeletionSession = null
}

export function login(account: string, password: string, captchaId: string, captchaCode: string, rememberAccount: boolean): Promise<LoginResult> {
	// 区分已登录、需补验邮箱、待注销和失败，受限凭据不能当作登录成功。
	return new Promise<LoginResult>((resolve) => {
		clearEmailOwnershipSession()
		// 新登录必然替换旧的待注销凭据，先清空内存中的撤回令牌。
		clearPendingDeletionSession()
		// 调用认证接口发起登录，验证码与账号密码一并提交。
		loginApi(account, password, captchaId, captchaCode).then((result: HttpResult) => {
			// 请求失败：后端 message 已可直接展示，原样返回给页面。
			if (!result.ok) {
				resolve({ok: false, message: result.message, emailVerificationRequired: false, deletionPending: false})
				return
			}

			// 取统一响应体。
			const envelope = result.data
			// 成功却没有响应体属于异常响应。
			if (envelope == null) {
				resolve({ok: false, message: '登录响应异常，请稍后重试', emailVerificationRequired: false, deletionPending: false})
				return
			}

			// 取 data 字段（登录 VO），其中应包含双令牌。
			const rawPayload = jsonObject(envelope, 'data')
			// 缺 data 时无法落盘凭据，按失败提示。
			if (rawPayload == null) {
				resolve({ok: false, message: '登录响应缺少令牌，请稍后重试', emailVerificationRequired: false, deletionPending: false})
				return
			}

			// data 是 any，断言为对象后按字段读取。
			const payload = rawPayload as UTSJSONObject
            if (jsonBoolean(payload, 'emailVerificationRequired') == true) {
                clearTokens(); stopNotificationSession(true)
                if (jsonString(payload, 'roleCode') != 'CUSTOMER') {
                    resolve({ ok: false, message: '请前往管理端完成邮箱验证', emailVerificationRequired: false, deletionPending: false }); return
                }
                const token = jsonString(payload, 'emailVerificationToken') ?? ''
                const expires = jsonNumber(payload, 'emailVerificationExpiresIn') ?? 0
                if (!setEnrollmentAuthorization(token, expires)) {
                    resolve({ ok: false, message: '邮箱补验凭据无效，请重新登录', emailVerificationRequired: false, deletionPending: false }); return
                }
                resolve({ ok: false, message: '', emailVerificationRequired: true, deletionPending: false }); return
            }
			if (jsonBoolean(payload, 'deletionPending') == true) {
				// 待注销账号没有正常令牌，先确保旧凭据和通知连接全部清理。
				clearTokens(); stopNotificationSession(true)
				const effectiveAt = jsonString(payload, 'deletionEffectiveAt') ?? ''
				const cancelToken = jsonString(payload, 'deletionCancelToken') ?? ''
				const expiresIn = jsonNumber(payload, 'deletionCancelExpiresIn') ?? 0
				if (jsonString(payload, 'roleCode') != 'CUSTOMER') {
					resolve({ ok: false, message: '请前往管理端处理账号注销', emailVerificationRequired: false, deletionPending: false }); return
				}
				if (effectiveAt.length == 0) {
					resolve({ ok: false, message: '注销信息异常，请稍后重试', emailVerificationRequired: false, deletionPending: false }); return
				}
				// 冷静期已结束时后端不再签发撤回令牌；此时仍返回待注销状态，
				// 由待注销页展示“撤回入口已失效”，不能把用户误判为登录凭据错误。
				if (cancelToken.length > 0 && cancelToken.length != 64) {
					resolve({ ok: false, message: '注销撤回凭据无效，请重新登录', emailVerificationRequired: false, deletionPending: false }); return
				}
				if (cancelToken.length == 64) {
					setPendingDeletionSession(effectiveAt, cancelToken, expiresIn)
				}
				if (rememberAccount) { setRememberedAccount(account) } else { clearRememberedAccount() }
				resolve({ ok: false, message: '', emailVerificationRequired: false, deletionPending: true }); return
			}
			// 取出访问令牌。
			const accessToken = jsonString(payload, 'accessToken') ?? ''
			// 取出刷新令牌。
			const refreshToken = jsonString(payload, 'refreshToken') ?? ''
			// 任一令牌缺失都说明登录未真正完成，不能落盘。
			if (accessToken.length == 0 || refreshToken.length == 0) {
				resolve({ok: false, message: '登录响应缺少令牌，请稍后重试', emailVerificationRequired: false, deletionPending: false})
				return
			}

			if (parseTokenPayload(accessToken) == null) {
				clearTokens()
				resolve({ok: false, message: '登录凭据格式不兼容，请确认认证服务已更新后重试', emailVerificationRequired: false, deletionPending: false})
				return
			}

			// 双令牌齐全，写入本地存储，后续请求即携带该访问令牌。
			clearTokens()
			saveTokens(accessToken, refreshToken)
			startNotificationSession()
			// 勾选「记住账号」：只记用户名，不落盘密码。
			if (rememberAccount) {
				setRememberedAccount(account)
			} else {
				// 未勾选：清掉历史记住的用户名，避免下次误回填。
				clearRememberedAccount()
			}
			// 返回空串表示登录成功。
			resolve({ok: true, message: '', emailVerificationRequired: false, deletionPending: false})
		})
	})
}

/**
 * 注册新用户。
 *
 * 注册成功后不自动登录，由调用方引导用户回到登录页手动登录，
 * 与后端「注册只创建账号」的语义保持一致。
 *
 * @param username 用户名
 * @param email 邮箱
 * @param password 密码
 * @return 注册结果及系统分配的用户号
 */
export type RegistrationResult = { ok: boolean, message: string, userNo: string }
export function register(username: string, email: string, password: string, emailVerificationToken: string): Promise<RegistrationResult> {
    return registerApi(username, email.trim().toLowerCase(), password, emailVerificationToken).then((result: HttpResult): RegistrationResult => {
        if (!result.ok) return { ok: false, message: result.message, userNo: '' }
        const payload = result.data == null ? null : jsonObject(result.data, 'data')
        const userNo = payload == null ? '' : (jsonString(payload, 'userNo') ?? '')
        setRememberedAccount(userNo.length > 0 ? userNo : email.trim().toLowerCase())
        return { ok: true, message: '', userNo: userNo }
    })
}

/**
 * 退出登录。
 *
 * 先通知服务端失效刷新令牌，无论结果如何都清空本地凭据——本地退出必须成功，
 * 否则用户会卡在「退不出去」的状态。
 */
let logoutPending: Promise<void> | null = null
export function logout(): Promise<void> {
    if (logoutPending != null) return logoutPending
    beginSessionClose()
    const operation = Promise.resolve().then(() => {
        try {
            // 同步取得退出时的凭据快照，撤销请求在后台完成，不阻塞页面返回。
            if (getRefreshToken().length > 0) logoutApi().catch(() => {})
        } finally {
            clearTokens()
            clearEmailChangeAuthorization(); clearEmailOwnershipSession()
            // 退出后不能再凭旧内存令牌撤回，下一次登录会重新签发。
            clearPendingDeletionSession()
            // 通知 UI 或连接清理失败不能阻止本地退出。
            try { stopNotificationSession(true) } catch (_error) {}
        }
    }).finally(() => { logoutPending = null })
    logoutPending = operation
    return operation
}

/**
 * 判断本地是否存在登录凭据。
 *
 * @return 已登录返回 true
 */
export function isLoggedIn(): boolean {
	// 与业务页使用同一身份解析规则，避免登录页和首页互相跳转。
	return currentUser() != null
}

/**
 * 读取当前登录用户的身份信息。
 *
 * 身份信息直接取自访问令牌载荷，不额外请求后端。
 *
 * @return 身份信息，未登录或令牌非法时返回 null
 */
export function currentUser(): TokenPayload | null {
	// 读取本地访问令牌。
	const accessToken = getAccessToken()
	// 无令牌说明未登录，直接返回空。
	if (accessToken.length == 0) {
		return null
	}
	// 解析令牌载荷得到身份信息；令牌非法时解析函数返回 null。
	const user = parseTokenPayload(accessToken)
	if (user == null) {
		// 旧版数字标识或损坏凭据不能继续驱动自动跳转；保留记住的账号。
		clearTokens()
	}
	return user
}
