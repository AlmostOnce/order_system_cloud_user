import { httpGet, httpPost, HttpResult } from '../common/http.uts'
import { jsonObject, jsonArray, jsonString, jsonNumber, jsonBoolean } from '../common/json.uts'

export type Review = { commentId: string, productId: number, windowId: number, authorName: string, authorAvatarUrl: string, score: number, content: string, images: Array<string>, tags: Array<string>, createdAt: string }
export type ReviewPage = { items: Array<Review>, nextCursor: string, hasMore: boolean }
export type ProductRating = { productId: number, reviewCount: number, averageScore: number | null }
export type CardRating = { id: number, reviewCount: number, averageScore: number | null, available: boolean }

/** 分批获取评分；失败的批次标记不可用，不伪造零评价。 */
export async function fetchCardRatings(kind: string, ids: Array<number>): Promise<Array<CardRating>> {
    const output: Array<CardRating> = []
    for (let start = 0; start < ids.length; start += 100) {
        const chunk = ids.slice(start, start + 100)
        let rows: Array<any> | null = null
        try {
            const result = await httpGet('/comments/ratings/batch?kind=' + kind + '&ids=' + chunk.join(','), true)
            rows = result.ok && result.data != null ? jsonArray(result.data, 'data') : null
        } catch (_error) { rows = null }
        let valid = rows != null
        const found: Array<CardRating> = []
        if (rows != null) for (let i = 0; i < rows.length; i++) {
            const row = rows[i]
            if (row == null || typeof row != 'object' || Array.isArray(row)) { valid = false; break }
            const raw = row as UTSJSONObject
            const id = jsonNumber(raw, 'id') ?? 0
            const count = jsonNumber(raw, 'reviewCount')
            const average = jsonNumber(raw, 'averageScore')
            if (!chunk.includes(id) || count == null || !Number.isInteger(count) || count < 0 || (count > 0 && (average == null || average < 1 || average > 5)) || found.some((item: CardRating): boolean => item.id == id)) { valid = false; break }
            found.push({ id: id, reviewCount: count, averageScore: count == 0 ? null : average, available: true })
        }
        for (let i = 0; i < chunk.length; i++) {
            const item = valid ? found.find((entry: CardRating): boolean => entry.id == chunk[i]) : null
            output.push(item != null ? item : { id: chunk[i], reviewCount: 0, averageScore: null, available: valid })
        }
    }
    return output
}
export function cardRatingText(ratings: Array<CardRating>, id: number): string {
    const rating = ratings.find((item: CardRating): boolean => item.id == id)
    if (rating == null) return '评分加载中'
    if (!rating.available) return '评分暂不可用'
    if (rating.reviewCount == 0 || rating.averageScore == null) return '暂无评分'
    return '★ ' + rating.averageScore!.toFixed(1) + ' · ' + rating.reviewCount + '条评价'
}

export function commentPayload(result: HttpResult): UTSJSONObject | null {
    return result.ok && result.data != null ? jsonObject(result.data, 'data') : null
}
export function strings(raw: UTSJSONObject, name: string): Array<string> | null {
    const values = jsonArray(raw, name)
    if (values == null) return null
    const output: Array<string> = []
    for (let i = 0; i < values.length; i++) {
        if (typeof values[i] != 'string') return null
        output.push(values[i] as string)
    }
    return output
}
export function parseComment(raw: UTSJSONObject): Review | null {
    const id = jsonString(raw, 'commentId') ?? ''
    const product = jsonNumber(raw, 'productId') ?? 0
    const window = jsonNumber(raw, 'windowId') ?? 0
    const score = jsonNumber(raw, 'score') ?? 0
    const images = strings(raw, 'images')
    const tags = strings(raw, 'tags')
    if (id.length == 0 || product <= 0 || window <= 0 || !Number.isInteger(score) || score < 1 || score > 5 || images == null || tags == null) return null
    return { commentId: id, productId: product, windowId: window, authorName: jsonString(raw, 'authorName') ?? '校园用户', authorAvatarUrl: jsonString(raw, 'authorAvatarUrl') ?? '', score: score,
        content: jsonString(raw, 'content') ?? '', images: images, tags: tags, createdAt: jsonString(raw, 'createdAt') ?? '' }
}
export function parseCommentPage(raw: UTSJSONObject): ReviewPage | null {
    const rows = jsonArray(raw, 'items')
    const more = jsonBoolean(raw, 'hasMore')
    const cursor = jsonString(raw, 'nextCursor') ?? ''
    if (rows == null || more == null || (more && (cursor.length == 0 || rows.length == 0))) return null
    const items: Array<Review> = []
    for (let i = 0; i < rows.length; i++) {
        if (rows[i] == null || typeof rows[i] != 'object' || Array.isArray(rows[i])) return null
        const item = parseComment(rows[i] as UTSJSONObject)
        if (item == null) return null
        items.push(item)
    }
    return { items: items, nextCursor: cursor, hasMore: more }
}
export function parseRating(raw: UTSJSONObject): ProductRating | null {
    const id = jsonNumber(raw, 'productId') ?? 0
    const count = jsonNumber(raw, 'reviewCount')
    const average = jsonNumber(raw, 'averageScore')
    if (id <= 0 || count == null || !Number.isInteger(count) || count < 0 || (count > 0 && (average == null || average < 1 || average > 5))) return null
    return { productId: id, reviewCount: count, averageScore: count == 0 ? null : average }
}
/** 一星/五星由服务端先筛选再分页；0表示全部，兼容既有两参数调用。 */
export function fetchComments(productId: number, cursor: string, score: number = 0, hasImages: boolean = false): Promise<HttpResult> {
    const base = productId > 0 ? '/comments/products/' + productId : '/comments/me'
    return httpGet(base + '?limit=20' + (cursor.length > 0 ? '&cursor=' + encodeURIComponent(cursor) : '') + (score == 1 || score == 5 ? '&score=' + score : '') + (hasImages ? '&hasImages=true' : ''), true)
}
export function fetchProductRating(productId: number): Promise<HttpResult> { return httpGet('/comments/products/' + productId + '/rating', true) }
export function createComment(body: UTSJSONObject, key: string): Promise<HttpResult> { return httpPost('/comments', body, true, key) }
export function createWindowReview(body: UTSJSONObject, key: string): Promise<HttpResult> { return httpPost('/comments/window-reviews', body, true, key) }
/** 店铺与本人店铺评价沿用相同筛选规则，不在客户端过滤一页数据。 */
export function fetchWindowReviews(windowId: number, cursor: string, score: number = 0, hasImages: boolean = false): Promise<HttpResult> {
    const base = windowId > 0 ? '/comments/window-reviews/windows/' + windowId : '/comments/window-reviews/me'
    return httpGet(base + '?limit=20' + (cursor.length > 0 ? '&cursor=' + encodeURIComponent(cursor) : '') + (score == 1 || score == 5 ? '&score=' + score : '') + (hasImages ? '&hasImages=true' : ''), true)
}
export function fetchWindowRating(windowId: number): Promise<HttpResult> { return httpGet('/comments/window-reviews/windows/' + windowId + '/rating', true) }
export function parseWindowReviewPage(raw: UTSJSONObject): ReviewPage | null {
    const rows = jsonArray(raw, 'items')
    const more = jsonBoolean(raw, 'hasMore')
    const cursor = jsonString(raw, 'nextCursor') ?? ''
    if (rows == null || more == null || (more && (cursor.length == 0 || rows.length == 0))) return null
    const items: Array<Review> = []
    for (let i = 0; i < rows.length; i++) {
        if (rows[i] == null || typeof rows[i] != 'object' || Array.isArray(rows[i])) return null
        const item = rows[i] as UTSJSONObject
        const id = jsonString(item, 'reviewId') ?? ''
        const windowId = jsonNumber(item, 'windowId') ?? 0
        const score = jsonNumber(item, 'score') ?? 0
        const images = strings(item, 'images')
        const tags = strings(item, 'tags')
        if (id.length == 0 || windowId <= 0 || !Number.isInteger(score) || score < 1 || score > 5 || images == null || tags == null) return null
        items.push({ commentId: id, productId: 0, windowId: windowId, authorName: jsonString(item, 'authorName') ?? '校园用户', authorAvatarUrl: jsonString(item, 'authorAvatarUrl') ?? '', score: score, content: jsonString(item, 'content') ?? '', images: images, tags: tags, createdAt: jsonString(item, 'createdAt') ?? '' })
    }
    return { items: items, nextCursor: cursor, hasMore: more }
}

export type OrderReviews = { orderId: number, windowReview: Review | null, productReviews: Array<Review> }
export function fetchOrderReviews(orderId: number): Promise<HttpResult> { return httpGet('/comments/orders/' + orderId, true) }
export function parseOrderReviews(raw: UTSJSONObject): OrderReviews | null {
    const orderId = jsonNumber(raw, 'orderId') ?? 0
    const products = jsonArray(raw, 'productReviews')
    if (orderId <= 0 || products == null) return null
    const productReviews: Array<Review> = []
    for (let i = 0; i < products.length; i++) {
        const row = products[i]
        if (row == null || typeof row != 'object' || Array.isArray(row)) return null
        const review = parseComment(row as UTSJSONObject)
        if (review == null || productReviews.some((existing: Review): boolean => existing.productId == review.productId)) return null
        productReviews.push(review)
    }
    let windowReview: Review | null = null
    if (raw['windowReview'] != null) {
        const page = parseWindowReviewPage({ items: [raw['windowReview']], hasMore: false, nextCursor: null })
        if (page == null) return null
        windowReview = page.items[0]
    }
    return { orderId: orderId, windowReview: windowReview, productReviews: productReviews }
}

/** 概览对应全部评价，不随当前一星/五星筛选改变。 */
export type ReviewSummary = { reviewCount: number, averageScore: number | null, positiveCount: number, negativeCount: number, imageCount: number | null }
export function fetchReviewSummary(windowId: number, productId: number): Promise<HttpResult> {
    const base = windowId > 0 ? '/comments/window-reviews/windows/' + windowId : '/comments/products/' + productId
    return httpGet(base + '/summary', true)
}
/** 严格校验统计上限；接口缺字段或故障不伪装成0条，也不由当前页推算总量。 */
export function parseReviewSummary(raw: UTSJSONObject): ReviewSummary | null {
    const count = jsonNumber(raw, 'reviewCount')
    const positive = jsonNumber(raw, 'positiveCount')
    const negative = jsonNumber(raw, 'negativeCount')
    const average = jsonNumber(raw, 'averageScore')
    const images = jsonNumber(raw, 'imageCount')
    if (images != null && (!Number.isInteger(images) || images < 0 || (count != null && images > count))) return null
    if (count == null || positive == null || negative == null || !Number.isInteger(count) || !Number.isInteger(positive) || !Number.isInteger(negative) || count < 0 || positive < 0 || negative < 0 || positive + negative > count || (count > 0 && (average == null || !Number.isFinite(average) || average < 1 || average > 5))) return null
    return { reviewCount: count, averageScore: count == 0 ? null : average, positiveCount: positive, negativeCount: negative, imageCount: images }
}
