/**
 * 认证服务接口定义。
 *
 * 路径与后端 auth-service 的 AuthController 一一对应。对外统一经网关 /api 前缀访问，
 * 因此这里只写服务自身路径。接口只负责发请求，登录态落盘由 store/auth.uts 负责。
 */

// 导入统一请求入口：本层只负责拼装请求体与路径，不处理令牌与存储。
import { httpPost, HttpResult } from '../common/http.uts'

/**
 * 账号密码登录。
 *
 * @param username 用户名
 * @param password 密码
 * @return 请求结果，成功时 data 内含 accessToken、refreshToken、expiresIn
 */
export function login(username: string, password: string): Promise<HttpResult> {
	// 按后端 LoginRequest 契约组装请求体。
	const body: UTSJSONObject = { username: username, password: password }
	// 登录接口是免鉴权入口，不携带旧令牌。
	return httpPost('/auth/login', body, false)
}

/**
 * 注册新用户，注册成功后由后端默认分配 CUSTOMER 角色。
 *
 * @param username 用户名，2-64 个字符
 * @param phone 手机号，需匹配 1[3-9] 开头的 11 位号码
 * @param password 登录密码，6-64 个字符
 * @return 请求结果，成功时 data 内含 userId、username、roleCode
 */
export function register(username: string, phone: string, password: string): Promise<HttpResult> {
	// 按后端 RegisterRequest 契约组装请求体：用户名、手机号、登录密码。
	const body: UTSJSONObject = { username: username, phone: phone, password: password }
	// 注册同为免鉴权入口，不携带旧令牌。
	return httpPost('/auth/register', body, false)
}

/**
 * 注销当前会话，使刷新令牌在服务端失效。
 *
 * @param refreshToken 刷新令牌
 * @return 请求结果
 */
export function logout(refreshToken: string): Promise<HttpResult> {
	// 按后端 RefreshTokenRequest 契约组装请求体，注销只依赖刷新令牌。
	const body: UTSJSONObject = { refreshToken: refreshToken }
	// 注销需要携带访问令牌：后端要据此校验刷新令牌归属并写入黑名单。
	return httpPost('/auth/logout', body, true)
}
