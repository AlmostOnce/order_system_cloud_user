/**
 * 认证服务接口定义。
 *
 * 路径与后端 auth-service 的 AuthController 一一对应。对外统一经网关 /api 前缀访问，
 * 因此这里只写服务自身路径。接口只负责发请求，登录态落盘由 store/auth.uts 负责。
 */

// 导入统一请求入口：本层只负责拼装请求体与路径，不处理令牌与存储。
import { httpGet, httpPost, httpLogout, HttpResult } from '../common/http.uts'

/**
 * 获取登录用图片验证码。
 *
 * 每次调用都会生成一张新图，旧验证码仍可能在有效期内，但只能被使用一次。
 *
 * @return 请求结果，成功时 data 内含 captchaId、imageBase64、expiresIn
 */
export function fetchCaptcha(): Promise<HttpResult> {
	// 验证码接口是免鉴权入口，不携带任何令牌。
	return httpGet('/auth/captcha', false)
}

/**
 * 账号密码登录。
 *
 * @param account 用户号或邮箱
 * @param password 密码
 * @param captchaId 验证码标识，由 fetchCaptcha 下发
 * @param captchaCode 用户输入的验证码字符
 * @return 请求结果，成功时 data 内含 accessToken、refreshToken、expiresIn
 */
export function login(account: string, password: string, captchaId: string, captchaCode: string): Promise<HttpResult> {
	// 按后端 LoginRequest 契约组装请求体，验证码标识与字符必须原样回传。
	const body: UTSJSONObject = {
		account: account,
		password: password,
		captchaId: captchaId,
		captchaCode: captchaCode
	}
	// 登录接口是免鉴权入口，不携带旧令牌。
	return httpPost('/auth/login', body, false)
}

/**
 * 注册新用户，注册成功后由后端默认分配 CUSTOMER 角色。
 *
 * @param username 用户名，2-64 个字符
 * @param email 邮箱，合法邮箱地址
 * @param password 登录密码，6-64 个字符
 * @param emailVerificationToken 前置邮箱验证获得的一次性授权
 * @return 请求结果，成功时 data 内含 userUuid、userNo、username、roleCode
 */
export function register(username: string, email: string, password: string, emailVerificationToken: string): Promise<HttpResult> {
	// 按后端 RegisterRequest 契约组装请求体：用户名、邮箱、登录密码。
	const body: UTSJSONObject = { username: username, email: email, password: password, emailVerificationToken: emailVerificationToken }
	// 注册同为免鉴权入口，不携带旧令牌。
	return httpPost('/auth/register', body, false)
}

/**
 * 注销当前会话，使刷新令牌在服务端失效。
 *
 * @return 请求结果
 */
export function logout(): Promise<HttpResult> {
    return httpLogout()
}

/** 匿名找回登录密码，凭据仅在当前页面内存中保留。 */
export function sendPasswordResetCode(email: string, captchaId: string, captchaCode: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, captchaId: captchaId, captchaCode: captchaCode }
    return httpPost('/auth/password-reset/code', body, false)
}
export function verifyPasswordResetCode(email: string, code: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, code: code }
    return httpPost('/auth/password-reset/verify', body, false)
}
export function confirmPasswordReset(resetToken: string, newPassword: string): Promise<HttpResult> {
    const body: UTSJSONObject = { resetToken: resetToken, newPassword: newPassword }
    return httpPost('/auth/password-reset/confirm', body, false)
}

/**
 * 查询本人账号注销资格。
 *
 * 只读接口，返回余额、可放弃上限、邮箱验证状态与订单/退款/工单阻断项。
 * 前端只负责展示，提交时服务端会重新核对。
 */
export function fetchAccountDeletionEligibility(): Promise<HttpResult> {
	return httpGet('/users/me/deletion/eligibility', true)
}

/** 向当前绑定邮箱发送注销验证码；账号必须已登录且邮箱已验证。 */
export function sendAccountDeletionCode(): Promise<HttpResult> {
	return httpPost('/users/me/deletion/verification-code', null, true)
}

/** 校验注销验证码并换取 10 分钟有效的一次性授权令牌。 */
export function authorizeAccountDeletion(code: string): Promise<HttpResult> {
	const body: UTSJSONObject = { code: code }
	return httpPost('/users/me/deletion/authorization', body, true)
}

/**
 * 提交注销申请。
 *
 * @param authorizationToken 邮箱验证换取的一次性授权令牌
 * @param forfeitBalance 是否已确认放弃余额；有余额时必须为 true
 */
export function submitAccountDeletion(authorizationToken: string, forfeitBalance: boolean): Promise<HttpResult> {
	const body: UTSJSONObject = { authorizationToken: authorizationToken, forfeitBalance: forfeitBalance }
	return httpPost('/users/me/deletion', body, true)
}

/**
 * 凭一次性撤回令牌撤回注销申请。
 *
 * 注销冷静期内账号没有正常访问令牌，因此该请求不携带旧 Token。
 */
export function cancelAccountDeletion(cancelToken: string): Promise<HttpResult> {
	const body: UTSJSONObject = { cancelToken: cancelToken }
	return httpPost('/users/me/deletion/cancel', body, false)
}

/** 注册与旧账号补验均为匿名接口，不携带旧Token或触发续期。 */
export function sendRegistrationEmailCode(email: string, captchaId: string, captchaCode: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, captchaId: captchaId, captchaCode: captchaCode }
    return httpPost('/auth/registration/code', body, false)
}
export function verifyRegistrationEmail(email: string, code: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, code: code }
    return httpPost('/auth/registration/verify', body, false)
}
export function sendEnrollmentEmailCode(authorizationToken: string, email: string, captchaId: string, captchaCode: string): Promise<HttpResult> {
    const body: UTSJSONObject = { authorizationToken: authorizationToken, email: email, captchaId: captchaId, captchaCode: captchaCode }
    return httpPost('/auth/email-enrollment/code', body, false)
}
export function confirmEmailEnrollment(authorizationToken: string, email: string, code: string): Promise<HttpResult> {
    const body: UTSJSONObject = { authorizationToken: authorizationToken, email: email, code: code }
    return httpPost('/auth/email-enrollment/confirm', body, false)
}
