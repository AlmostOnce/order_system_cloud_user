import { httpGet, httpPost, HttpResult } from '../common/http.uts'
import { jsonArray, jsonBoolean, jsonNumber, jsonObject, jsonString } from '../common/json.uts'

export type NotificationItem = { notificationId: string, title: string, content: string, orderId: number, createdAt: string, readAt: string }
export type NotificationPage = { items: Array<NotificationItem>, nextCursor: string, hasMore: boolean }
export function fetchNotifications(cursor: string): Promise<HttpResult> {
    return httpGet('/notifications?limit=20' + (cursor.length > 0 ? '&cursor=' + encodeURIComponent(cursor) : ''), true)
}
export function fetchUnreadNotificationCount(): Promise<HttpResult> { return httpGet('/notifications/unread-count', true) }
export function markNotificationRead(id: string): Promise<HttpResult> { return httpPost('/notifications/' + id + '/read', {}, true) }
export function requestNotificationSocketTicket(): Promise<HttpResult> { return httpPost('/notifications/socket-ticket', {}, true) }
export function parseNotificationSocketTicket(result: HttpResult): string {
    const data = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
    return data == null ? '' : (jsonString(data, 'ticket') ?? '')
}
export function parseNotificationPage(result: HttpResult): NotificationPage | null {
    const data = result.ok && result.data != null ? jsonObject(result.data, 'data') : null
    if (data == null) return null
    const rows = jsonArray(data, 'items'); const more = jsonBoolean(data, 'hasMore'); const cursor = jsonString(data, 'nextCursor') ?? ''
    if (rows == null || more == null || (more && (cursor.length == 0 || rows.length == 0))) return null
    const items: Array<NotificationItem> = []
    for (let i = 0; i < rows.length; i++) {
        if (rows[i] == null || typeof rows[i] != 'object' || Array.isArray(rows[i])) return null
        const row = rows[i] as UTSJSONObject; const id = jsonString(row, 'notificationId') ?? ''
        if (id.length == 0) return null
        items.push({ notificationId: id, title: jsonString(row, 'title') ?? '', content: jsonString(row, 'content') ?? '', orderId: jsonNumber(row, 'orderId') ?? 0, createdAt: jsonString(row, 'createdAt') ?? '', readAt: jsonString(row, 'readAt') ?? '' })
    }
    return { items: items, nextCursor: cursor, hasMore: more }
}
