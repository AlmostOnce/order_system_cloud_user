import { jsonArray, jsonBoolean, jsonNumber, jsonObject, jsonString } from '../common/json.uts'
/**
 * 档口菜单（点餐详情）接口。
 *
 * 对应后端 ProductMenuController 的 GET /products/windows/{windowId}/menu。
 * 接口只返回查询时刻的菜单快照，价格与可售状态在真正下单时会重新核价，
 * 因此页面上的价格仅用于展示与预估。
 */

// 导入统一请求入口：菜单查询是鉴权的 GET 请求。
import { httpGet, HttpResult } from '../common/http.uts'

/** 菜品可选规格组；价格加价仅用于当前菜单预览，最终金额由商品服务重新计算。 */
export type ProductSpecificationGroup = {
	/** 规格组编号；只用于稳定渲染和区分选择状态。 */
	groupId: number
	/** 规格组名称，例如份量或辣度。 */
	name: string
	/** 是否必须选择本组的一项；单组只允许选择一个选项。 */
	required: boolean
	/** 当前组启用的选项，顺序由商品服务给出。 */
	options: Array<ProductSpecificationOption>
}

/** 单组选项。 */
export type ProductSpecificationOption = {
	/** 选项编号；加购请求只提交该编号，不提交选项名称或价格。 */
	optionId: number
	/** 学生端展示的选项名称。 */
	name: string
	/** 在菜品基础售价上增加的金额，仅用于当前菜单单价预览。 */
	additionalPrice: number
}

/**
 * 菜单中的单个菜品，对应后端 MenuProductVO。
 */
export type MenuProduct = {
	/** 菜品 ID。 */
	productId: number
	/** 窗口内菜品编码。 */
	productCode: string
	/** 菜品名称。 */
	productName: string
	/** 菜品描述。 */
	description: string
	/** 菜品图片地址，可能为空。 */
	imageUrl: string
	/** 当前售价。 */
	price: number
	/** 窗口内排序值。 */
	sortOrder: number
	/** 启用规格组；无配置的菜品返回空数组，仍可直接加购。 */
	specificationGroups: Array<ProductSpecificationGroup>
}

/**
 * 菜单分类，对应后端 ProductCategoryMenuVO。
 *
 * 分类下可能没有在售菜品，页面需要保留分类但展示空态。
 */
export type MenuCategory = {
	/** 分类 ID。 */
	categoryId: number
	/** 分类名称。 */
	categoryName: string
	/** 分类排序值。 */
	sortOrder: number
	/** 该分类下的在售菜品。 */
	products: Array<MenuProduct>
}

/**
 * 档口菜单，对应后端 WindowMenuVO。
 */
export type WindowMenu = {
    /** 首页封面，保持旧契约；点餐页使用下面的完整有序列表。 */
    imageUrl: string
    /** 最多五张展示图片；无图时页面使用本地默认图。 */
    imageUrls: Array<string>
	/** 档口 ID。 */
	windowId: number
	/** 档口编码。 */
	windowCode: string
	/** 档口名称。 */
	windowName: string
	/** 窗口简介。 */
	description: string
	/** 档口位置。 */
	location: string
	/** 营业状态：1 营业，0 休息；休息时菜单可浏览但不可加购和结算。 */
	isOpen: number
	/** 启用的分类，含空分类。 */
	categories: Array<MenuCategory>
	/** 未归入分类的在售菜品。 */
	uncategorizedProducts: Array<MenuProduct>
}

/** 读取有序图片列表；兼容旧服务仅返回封面，显式空数组不回退，避免清空后旧图复活。 */
export function windowGalleryUrls(raw: UTSJSONObject): Array<string> {
    const rows = jsonArray(raw, 'imageUrls');
    const urls = [] as Array<string>;
    if (rows == null) {
        const cover = jsonString(raw, 'imageUrl') ?? '';
        if (cover.length > 0) urls.push(cover);
        return urls;
    }
    // 服务端限制五张；客户端同样限制数量并去重，损坏条目不产生空白轮播页。
    for (let i = 0; i < rows.length && urls.length < 5; i++) {
        const value = rows[i];
        if (typeof value == 'string') {
            const url = (value as string).trim();
            if (url.length > 0 && !urls.includes(url)) urls.push(url);
        }
    }
    return urls;
}

/**
 * 菜单查询结果。
 */
export type WindowMenuResult = {
	/** 是否查询成功。 */
	ok: boolean
	/** 失败时的提示文案。 */
	message: string
	/** 成功时的菜单快照，失败时为 null。 */
	menu: WindowMenu | null
}

/**
 * 把后端返回的 any 元素转换为强类型菜品。
 *
 * @param raw 后端返回的菜品对象
 * @return 强类型菜品
 */
function toProduct(raw: UTSJSONObject): MenuProduct {
	// 逐字段读取，缺失字段用类型安全的默认值兜底，避免页面出现 undefined。
	const product: MenuProduct = {
		// 菜品 ID，缺失按 0 处理。
		productId: jsonNumber(raw, 'productId') ?? 0,
		// 菜品编码。
		productCode: jsonString(raw, 'productCode') ?? '',
		// 菜品名称。
		productName: jsonString(raw, 'productName') ?? '',
		// 菜品描述。
		description: jsonString(raw, 'description') ?? '',
		// 图片地址，可能为空，页面据此决定是否展示图片区。
		imageUrl: jsonString(raw, 'imageUrl') ?? '',
		// 价格，缺失按 0 处理。
		price: jsonNumber(raw, 'price') ?? 0,
		// 排序值。
		sortOrder: jsonNumber(raw, 'sortOrder') ?? 0,
		// 新旧菜单响应都归一为空数组，避免页面把缺字段误判为必选规格。
		specificationGroups: toSpecificationGroups(jsonArray(raw, 'specificationGroups'))
	}
	// 返回转换后的菜品。
	return product
}

/**
 * 将菜单规格转换为页面选择器需要的安全结构；损坏的组或选项不会成为可提交选项。
 * @param rawGroups 后端菜单规格数组
 * @return 按服务端排序排列的有效规格组
 */
function toSpecificationGroups(rawGroups: Array<any> | null): Array<ProductSpecificationGroup> {
	const groups = [] as Array<ProductSpecificationGroup>
	if (rawGroups == null) return groups
	for (let i = 0; i < rawGroups.length; i++) {
		const rawGroup = rawGroups[i]
		if (rawGroup == null || typeof rawGroup != 'object' || Array.isArray(rawGroup)) continue
		const groupObject = rawGroup as UTSJSONObject
		const groupId = jsonNumber(groupObject, 'groupId') ?? 0
		const rawOptions = jsonArray(groupObject, 'options')
		if (groupId <= 0 || rawOptions == null) continue
		const options = [] as Array<ProductSpecificationOption>
		for (let j = 0; j < rawOptions.length; j++) {
			const rawOption = rawOptions[j]
			if (rawOption == null || typeof rawOption != 'object' || Array.isArray(rawOption)) continue
			const optionObject = rawOption as UTSJSONObject
			const optionId = jsonNumber(optionObject, 'optionId') ?? 0
			const name = jsonString(optionObject, 'name') ?? ''
			const additionalPrice = jsonNumber(optionObject, 'additionalPrice') ?? -1
			if (optionId > 0 && name.length > 0 && additionalPrice >= 0)
				options.push({ optionId: optionId, name: name, additionalPrice: additionalPrice })
		}
		if (options.length == 0) continue
		groups.push({ groupId: groupId, name: jsonString(groupObject, 'name') ?? '',
			required: jsonBoolean(groupObject, 'required') ?? false, options: options })
	}
	return groups
}

/**
 * 把后端返回的数组转换为强类型菜品数组。
 *
 * @param rawList 后端数组，可能为 null
 * @return 菜品数组，无数据时返回空数组
 */
function toProductList(rawList: Array<any> | null): Array<MenuProduct> {
	// 空数组或字段缺失都按「没有菜品」处理。
	const items: Array<MenuProduct> = []
	if (rawList == null) {
		return items
	}
	// 逐项转换，元素是 any 需先断言为对象。
	for (let i = 0; i < rawList.length; i++) {
		const raw = rawList[i] as UTSJSONObject
		items.push(toProduct(raw))
	}
	// 返回完整列表。
	return items
}

/**
 * 查询指定档口的菜单。
 *
 * @param windowId 档口 ID
 * @return 菜单查询结果
 */
export function fetchWindowMenu(windowId: number): Promise<WindowMenuResult> {
	// 用 Promise 收敛结果：成功带菜单，失败带可直接展示的提示。
	return new Promise<WindowMenuResult>((resolve) => {
		httpGet('/products/windows/' + windowId + '/menu', true).then((result: HttpResult) => {
			// 请求整体失败（网络、401、403 等）：原样透传后端提示。
			if (!result.ok) {
				const failed: WindowMenuResult = { ok: false, message: result.message, menu: null }
				resolve(failed)
				return
			}

			// 成功需要从统一响应体中取出 data 字段。
			const envelope = result.data
			if (envelope == null) {
				const abnormal: WindowMenuResult = { ok: false, message: '菜单响应异常，请稍后重试', menu: null }
				resolve(abnormal)
				return
			}

			// data 是菜单对象，缺失说明档口不存在或已停用。
			const rawMenu = jsonObject(envelope, 'data')
			if (rawMenu == null) {
				const missing: WindowMenuResult = { ok: false, message: '该档口暂无菜单', menu: null }
				resolve(missing)
				return
			}

			// data 是 any，断言为对象后按字段读取。
			const menuObject = rawMenu as UTSJSONObject
			// 读取分类数组，逐个转换分类与其下菜品。
			const categories: Array<MenuCategory> = []
			const rawCategories = jsonArray(menuObject, 'categories')
			if (rawCategories != null) {
				for (let i = 0; i < rawCategories.length; i++) {
					const rawCategory = rawCategories[i] as UTSJSONObject
					const category: MenuCategory = {
						// 分类 ID。
						categoryId: jsonNumber(rawCategory, 'categoryId') ?? 0,
						// 分类名称。
						categoryName: jsonString(rawCategory, 'categoryName') ?? '',
						// 分类排序值。
						sortOrder: jsonNumber(rawCategory, 'sortOrder') ?? 0,
						// 分类下的菜品列表。
						products: toProductList(jsonArray(rawCategory, 'products'))
					}
					categories.push(category)
				}
			}

			// 组装强类型菜单快照。
			const menu: WindowMenu = {
                imageUrl: jsonString(menuObject, 'imageUrl') ?? '',
                imageUrls: windowGalleryUrls(menuObject),
				// 档口 ID。
				windowId: jsonNumber(menuObject, 'windowId') ?? windowId,
				// 档口编码。
				windowCode: jsonString(menuObject, 'windowCode') ?? '',
				// 档口名称。
				windowName: jsonString(menuObject, 'windowName') ?? '',
				// 窗口简介，未填写时不展示简介区域。
				description: jsonString(menuObject, 'description') ?? '',
				// 档口位置。
				location: jsonString(menuObject, 'location') ?? '',
				// 营业状态：缺失时按营业中兼容旧服务，真正的下单资格仍由服务端核价决定。
				isOpen: jsonNumber(menuObject, 'isOpen') ?? 1,
				// 分类列表。
				categories: categories,
				// 未归类菜品。
				uncategorizedProducts: toProductList(jsonArray(menuObject, 'uncategorizedProducts'))
			}

			// 返回成功结果。
			const success: WindowMenuResult = { ok: true, message: '', menu: menu }
			resolve(success)
		})
	})
}
