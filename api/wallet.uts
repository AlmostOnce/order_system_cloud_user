import { httpGet, httpPost, httpPut, HttpResult } from '../common/http.uts'
import { jsonObject } from '../common/json.uts'

export function fetchMyProfile(): Promise<HttpResult> {
	return httpGet('/users/me/profile', true)
}

export function fetchMyBalance(): Promise<HttpResult> {
	return httpGet('/users/me/balance', true)
}

export function fetchBalanceRecords(type: string, beforeId: number): Promise<HttpResult> {
	let path = '/users/me/balance/records?limit=20'
	if (type.length > 0) {
		path = path + '&type=' + type
	}
	if (beforeId > 0) {
		path = path + '&beforeId=' + beforeId
	}
	return httpGet(path, true)
}

export function rechargeBalance(amount: number, payPassword: string, requestKey: string): Promise<HttpResult> {
	const body: UTSJSONObject = { amount: amount, payPassword: payPassword }
	return httpPost('/users/me/recharges', body, true, requestKey)
}

export function setPayPassword(loginPassword: string, oldPayPassword: string, newPayPassword: string): Promise<HttpResult> {
	const body: UTSJSONObject = {
		loginPassword: loginPassword, oldPayPassword: oldPayPassword, newPayPassword: newPayPassword
	}
	return httpPut('/users/pay-password', body, true)
}

/** 统一提取业务对象，避免把缺少 data 的异常响应展示为余额 0。 */
export function walletPayload(result: HttpResult): UTSJSONObject | null {
	return result.ok && result.data != null ? jsonObject(result.data, 'data') : null
}

/** 仅更新本人昵称，不接受邮箱或安全凭据。 */
export function updateMyProfile(username: string): Promise<HttpResult> {
    const body: UTSJSONObject = { username: username }
    return httpPut('/users/me/profile', body, true)
}

export function authorizeEmailChange(loginPassword: string): Promise<HttpResult> {
    const body: UTSJSONObject = { loginPassword: loginPassword }
    return httpPost('/users/me/email/authorization', body, true)
}

export function verifyEmailCaptcha(email: string, authorizationToken: string, captchaId: string, captchaCode: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, authorizationToken: authorizationToken, captchaId: captchaId, captchaCode: captchaCode }
    return httpPost('/users/me/email/captcha', body, true)
}

export function sendEmailCode(email: string, authorizationToken: string, captchaVerificationToken: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, authorizationToken: authorizationToken, captchaVerificationToken: captchaVerificationToken }
    return httpPost('/users/me/email/verification-code', body, true)
}

/** 仅执行本人邮箱换绑，密码已经在前置步骤校验，不重复传递。 */
export function changeMyEmail(email: string, authorizationToken: string, emailCode: string): Promise<HttpResult> {
    const body: UTSJSONObject = { email: email, authorizationToken: authorizationToken, emailCode: emailCode }
    return httpPut('/users/me/email', body, true)
}
