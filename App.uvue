<script setup lang="uts">
import { onLaunch, onShow, onHide, onExit } from '@dcloudio/uni-app'
// #ifdef APP-ANDROID
import { onLastPageBackPress } from '@dcloudio/uni-app'
let firstBackTime = 0
onLastPageBackPress(() => {
    if (firstBackTime == 0) {
        uni.showToast({ title: '再按一次退出应用', position: 'bottom' })
        firstBackTime = Date.now()
        setTimeout(() => { firstBackTime = 0 }, 2000)
    } else if (Date.now() - firstBackTime < 2000) {
        firstBackTime = Date.now()
        uni.exit()
    }
})
// #endif
onLaunch(() => { console.log('App Launch') })
onShow(() => { console.log('App Show') })
onHide(() => { console.log('App Hide') })
onExit(() => { console.log('App Exit') })
</script>

<style>
	/* 每个页面公共 css */
	/* 横向排列工具类：供需要把子元素排成一行的容器直接套用 */
	.uni-row {
		flex-direction: row;
	}

	/* 纵向排列工具类：供需要把子元素竖向堆叠的容器直接套用 */
	.uni-column {
		flex-direction: column;
	}
</style>