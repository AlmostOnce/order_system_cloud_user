<script setup lang="uts">
import { startNotificationSession, stopNotificationSession } from './store/notifications.uts'
// #ifdef APP-ANDROID
let firstBackTime = 0
onLastPageBackPress(() => {
    if (firstBackTime == 0) {
        uni.showToast({ title: '再按一次退出应用', position: 'bottom' })
        firstBackTime = Date.now()
        setTimeout(() => { firstBackTime = 0 }, 2000)
    } else if (Date.now() - firstBackTime < 2000) {
        firstBackTime = Date.now()
        uni.exit()
    }
})
// #endif
onLaunch(() => { console.log('App Launch') })
onShow(() => { startNotificationSession() })
onHide(() => { stopNotificationSession() })
onExit(() => { stopNotificationSession() })
</script>

<style>
    /* 原生文字按钮统一行高与高度，避免沿用内部text的短行高而偏上。 */
    .button-text { padding-top: 0; padding-bottom: 0; }
    .button-text-34 { height: 34px; line-height: 34px; }
    .button-text-40 { height: 40px; line-height: 40px; }
    .button-text-42 { height: 42px; line-height: 42px; }
    .button-text-44 { height: 44px; line-height: 44px; }
    .button-text-46 { height: 46px; line-height: 46px; }
    .button-text-48 { height: 48px; line-height: 48px; }
    .button-text-50 { height: 50px; line-height: 50px; }
    .button-text-56 { height: 56px; line-height: 56px; }

    /* 原生刷新插槽必须由有明确尺寸的元素承载，并位于滚动内容末尾。 */
    .native-refresh-slot { width: 100%; height: 72px; }
	/* 每个页面公共 css */
	/* 横向排列工具类：供需要把子元素排成一行的容器直接套用 */
	.uni-row {
		flex-direction: row;
	}

	/* 纵向排列工具类：供需要把子元素竖向堆叠的容器直接套用 */
	.uni-column {
		flex-direction: column;
	}
</style>
