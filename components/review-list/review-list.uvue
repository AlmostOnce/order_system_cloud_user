<template>
    <view class="account-page account-secondary">
        <!-- 抽屉里已经叠在店铺页上，不再垫状态栏，避免顶部多出一块空白。独立评价页仍按原习性留状态栏。 -->
        <view v-if="!embedded" class="account-status vapor-account-secondary--account-status" :style="'height:' + statusBarHeight + 'px'"></view>
        <!-- 店铺页评价标签已经有档口头，不再叠一套返回栏；抽屉和独立页仍保留标题与返回。 -->
        <view v-if="!hideNav" class="account-nav vapor-account-secondary--account-nav">
            <view class="account-back vapor-account-secondary--account-back" @click="goBack">
                <view class="account-back-icon"></view>
            </view>
            <text class="account-title">{{ windowId > 0 ? '店铺评价' : (productId > 0 ? '菜品评价' : '我的评价') }}</text></view>
        <scroll-view class="account-scroll" direction="vertical" :refresher-enabled="refreshing || (!loading && !ratingLoading)" :refresher-triggered="refreshing" refresher-background="#FDF6F0" refresher-default-style="none" :refresher-threshold="72" @refresherrefresh="refreshPage" @scrolltolower="loadMore" :scroll-top="reviewScrollTop" @scroll="reviewListScrolled">
            <view class="review-feed-content">
                <!-- 概览使用独立列表样式，压缩介绍留白，不影响发布评价页的表单密度。 -->
                <view class="review-overview">
                    <!-- 菜品/店铺都是左介绍右评分。店铺标题就是店名，不再在下面重复写一遍店铺名称。 -->
                    <view v-if="productId > 0 || windowId > 0" class="review-overview-main">
                        <view class="review-subject">
                            <view class="review-subject-image"><business-image :src="contextImageUrl" :kind="productId > 0 ? 'product' : 'window'"></business-image></view>
                            <view class="review-subject-copy">
                                <text class="review-overview-label">{{ productId > 0 ? '菜品口碑' : '店铺口碑' }}</text>
                                <text class="review-overview-title" :max-lines="1">{{ productName.length > 0 ? productName : (contextWindowName.length > 0 ? contextWindowName : '看看大家怎么说') }}</text>
                                <text v-if="productId > 0 && contextWindowName.length > 0" class="review-subject-shop" :max-lines="1">{{ contextWindowName }}</text>
                                <text v-if="productId > 0 && contextLocation.length > 0" class="review-subject-location" :max-lines="1">{{ contextLocation }}</text>
                            </view>
                        </view>
                        <view class="review-overview-rating">
                            <view class="review-overview-number"><text class="review-overview-score">{{ ratingReady && averageScore != null ? averageScore!.toFixed(1) : '--' }}</text><text class="review-overview-max">/5</text></view>
                            <text class="review-overview-count">{{ ratingReady && reviewCount == 0 ? '还没有评分' : (ratingReady ? reviewCount + ' 条' : (ratingLoading ? '获取中…' : '暂不可用')) }}</text>
                        </view>
                    </view>
                    <view v-else class="review-subject-copy">
                        <text class="review-overview-label">我的用餐足迹</text>
                        <text class="review-overview-title">每一餐，都有回味</text>
                        <text class="review-overview-note">记录你对店铺与菜品的评价</text>
                    </view>
                </view>
                <view v-if="productId == 0 && windowId == 0" class="review-tags">
                    <button class="review-tag-button review-tag-label button-text button-text-44" @click="selectMine(true)">店铺评价</button>
                    <button class="review-tag-button review-tag-label button-text button-text-44" @click="selectMine(false)">菜品评价</button>
                </view>
                <text v-if="ratingError.length > 0" class="account-error">{{ ratingError }}</text>
                <!-- 原生标签直接绑定当前查询分数；好评/差评数量只出现在分类标签上，不再用条形图占概览。 -->
                <view class="review-score-tabs">
                    <view v-for="score in scoreTabs" :key="score" class="review-score-tab" :class="!photoOnly && scoreFilter == score ? 'review-score-tab-selected' : 'review-score-tab-idle'" @click="selectScore(score)">
                        <text class="review-score-tab-label" :class="!photoOnly && scoreFilter == score ? 'review-score-label-selected' : 'review-score-label-idle'">{{ score == 0 ? '全部' : (score == 5 ? '好评' : '差评') }}</text>
                        <text v-if="ratingReady && (productId > 0 || windowId > 0)" class="review-score-tab-count" :class="!photoOnly && scoreFilter == score ? 'review-score-label-selected' : 'review-score-label-idle'">{{ score == 0 ? reviewCount : (score == 5 ? positiveCount : negativeCount) }}</text>
                    </view>
                    <view class="review-score-tab" :class="photoOnly ? 'review-score-tab-selected' : 'review-score-tab-idle'" @click="selectPhotos">
                        <text class="review-score-tab-label" :class="photoOnly ? 'review-score-label-selected' : 'review-score-label-idle'">有图</text>
                        <text v-if="ratingReady && (productId > 0 || windowId > 0)" class="review-score-tab-count" :class="photoOnly ? 'review-score-label-selected' : 'review-score-label-idle'">{{ imageCount == null ? '--' : imageCount }}</text>
                    </view>
                </view>
                <view class="review-feed-heading"><text class="review-feed-heading-title">{{ productId > 0 || windowId > 0 ? '用餐评价' : (showWindowReviews ? '店铺评价' : '菜品评价') }}</text><text class="review-feed-heading-note">同学们的用餐记录</text></view>
                <view v-for="review in reviews" :key="review.commentId" class="review-feed-card">
                    <!-- 星级与昵称分行，系统大字体及长昵称不挤压星星；时间保留独立次级层次。 -->
                    <view class="review-feed-author-row"><view class="review-feed-avatar"><business-image :src="review.authorAvatarUrl" kind="avatar"></business-image></view><view class="review-author"><text class="review-feed-author-name" :max-lines="1">{{ review.authorName }}</text><text class="review-feed-date">{{ formatDate(review.createdAt) }}</text></view></view>
                    <view class="review-feed-rating"><review-stars :score="review.score"></review-stars><text class="review-feed-rating-label">{{ review.score == 5 ? '好评' : '差评' }}</text></view>
                    <text v-if="review.content.length > 0" class="review-feed-body">{{ review.content }}</text>
                    <view v-if="review.tags.length > 0" class="review-tags"><view v-for="tag in review.tags" :key="tag" class="review-tag"><text class="review-tag-label">{{ tag }}</text></view></view>
                    <view v-if="review.images.length > 0" class="review-photos"><image v-for="(url, index) in review.images" :key="url" class="review-feed-photo" :src="photoSource(url)" mode="aspectFill" @click="previewPhotos(review, index)"></image></view>
                    <view v-if="productId == 0 && windowId == 0 && !showWindowReviews" class="review-product-link" @click="openProduct(review)">
                        <text class="account-link-text">查看这道菜的评价</text><view class="account-arrow"></view>
                    </view>
                </view>
                <text v-if="loading" class="account-note">正在获取评价…</text>
                <text v-if="errorText.length > 0" class="account-error">{{ errorText }}</text>
                <view v-if="loaded && !loading && errorText.length == 0 && reviews.length == 0" class="review-empty"><image class="review-empty-star" src="/static/review/star-outline.svg"></image><text class="account-heading">{{ photoOnly ? '暂时没有带图评价' : (scoreFilter == 5 ? '暂时没有好评' : (scoreFilter == 1 ? '暂时没有差评' : (windowId > 0 ? '店铺还没有评价' : (productId > 0 ? '这道菜还没有评价' : '还没有发布评价')))) }}</text><text class="review-subtitle">{{ photoOnly || scoreFilter > 0 ? '切换分类，看看其他同学的评价' : (productId > 0 || windowId > 0 ? '完成用餐后，来分享第一条感受吧' : '到已完成订单中，分享用餐体验') }}</text>
                    <button v-if="productId == 0 && windowId == 0" class="account-primary vapor-account-secondary--account-primary account-primary-text button-text button-text-50" @click="openCompleted">查看已完成订单</button>
                </view>
                <button v-if="hasMore && !loading" class="account-link account-link-text button-text button-text-44" @click="loadMore">加载更多评价</button>
                <text v-if="loaded && !hasMore && reviews.length > 0 && errorText.length == 0" class="review-end">已经看到全部评价</text>
            </view>
            <view slot="refresher" class="native-refresh-slot">
                <refresh-header :refreshing="refreshing" :current-refresh-time="currentRefreshTime"></refresh-header>
            </view>
        </scroll-view>
    </view>
</template>
<script setup lang="uts">
import ReviewStars from '../review-stars/review-stars.uvue';
import { reactive, toRefs, watch, onMounted, onBeforeUnmount } from 'vue'
import BusinessImage from '../business-image/business-image.uvue'
import RefreshHeader from '../refresh-header/refresh-header.uvue'
import { Review, fetchComments, fetchWindowReviews, commentPayload, parseCommentPage, parseWindowReviewPage } from '../../api/comments.uts'
import { fetchReviewSummary, parseReviewSummary } from '../../api/comments.uts'
import { listProductImages, listActiveWindows, ProductImage, WindowItem } from '../../api/product.uts'
import { currentUser } from '../../store/auth.uts'
import { backToAccount, accountDate } from '../../common/account.uts'
import { finishPullRefresh, refreshTimeLabel } from '../../common/refresh.uts'
import { imageSource } from '../../common/images.uts'
import { openOrderList } from '../../common/order-navigation.uts'

/**
 * 只读评价列表本体。
 *
 * 独立路由页、菜品评价抽屉、店铺页评价标签共用这一套界面与查询习性。
 * 概览、全部/好评/差评/有图、分页和迟到响应隔离都不另写。父级只决定容器：抽屉、标签页或独立路由。
 * 关闭或切走时由父级卸载本组件，进行中的请求靠版本号丢弃，避免写进已离开的界面。
 */
const props = defineProps({
    /** 菜品评价目标；独立页由路由解析后传入，抽屉由当前点击的菜传入。0 表示我的评价。小于 0 表示编号非法。 */
    embedProductId: { type: Number, default: 0 },
    /** 店铺评价目标；与菜品编号互斥使用。 */
    embedWindowId: { type: Number, default: 0 },
    /** 概览标题用的对象名称，不作为查询条件，避免把路由里的任意文案当成筛选。 */
    embedProductName: { type: String, default: '' },
    /** 非法编号时由页面解析后传入；组件不再自己读路由，这样抽屉场景也能复用同一套失败文案。 */
    embedError: { type: String, default: '' },
    /** true 时嵌在店铺页里：挂载即拉数，不再等独立页的 onPageShow；返回键只通知父级关闭。 */
    embedded: { type: Boolean, default: false },
    /** true 时隐藏标题栏。店铺评价标签已经有档口头，避免再叠一层返回。抽屉和独立页保持 false。 */
    hideNav: { type: Boolean, default: false }
})
const emit = defineEmits(['close'])
const initialReviews: Array<Review> = []
// 标签仅写全部/好评/差评/有图；分数由0/5/1表达，有图单独使用布尔查询条件。
const scoreTabs: Array<number> = [0, 5, 1]
// 分数筛选与统计分别存储；统计覆盖全部评价，不随分页累计。
const state = reactive({ photoOnly: false, imageCount: null as number | null, scoreFilter: 0, reviewScrollTop: 0, positiveCount: 0, negativeCount: 0, contextImageUrl: '', contextWindowName: '', contextLocation: '', statusBarHeight: 0, productId: 0, windowId: 0, showWindowReviews: true, productName: '', reviews: initialReviews, loading: false, loaded: false, errorText: '', nextCursor: '', hasMore: false,
    refreshing: false, currentRefreshTime: '', ratingLoading: false, ratingReady: false, averageScore: null as number | null, reviewCount: 0, ratingError: '' })
const { photoOnly, imageCount, scoreFilter, reviewScrollTop, nextCursor, positiveCount, negativeCount, contextImageUrl, contextWindowName, contextLocation, statusBarHeight, productId, windowId, showWindowReviews, productName, reviews, loading, loaded, errorText, hasMore, refreshing, currentRefreshTime, ratingLoading, ratingReady, averageScore, reviewCount, ratingError } = toRefs(state)
// 每次切筛选/离页都递增，所有响应在写入前复核；旧finally也不能结束新请求的加载态。
let reviewVersion = 0
let summaryVersion = 0
let contextVersion = 0
let reviewDisposed = false
/** 把父级传入的目标写进查询状态。非法编号只展示错误，不再打评价接口。 */
function applyEmbedTarget() {
    state.productId = props.embedProductId
    state.windowId = props.embedWindowId
    state.productName = props.embedProductName
    if (props.embedError.length > 0) {
        state.productId = -1
        state.errorText = props.embedError
    }
}
/** 按当前筛选拉一页评价。重置时允许打断进行中的旧请求，迟到响应用版本号丢弃。 */
async function loadReviews(reset: boolean): Promise<void> {
    if (reviewDisposed || state.productId < 0 || state.loading || (!reset && !state.hasMore)) return
    const version = ++reviewVersion
    const score = state.scoreFilter
    const withImages = state.photoOnly
    const owner = currentUser()?.userUuid ?? ''
    state.loading = true
    state.errorText = ''
    try {
        const windowMode = state.windowId > 0 || (state.productId == 0 && state.showWindowReviews)
        const cursor = reset ? '' : state.nextCursor
        const result = windowMode ? await fetchWindowReviews(state.windowId, cursor, score, withImages) : await fetchComments(state.productId, cursor, score, withImages)
        if (reviewDisposed || version != reviewVersion || (currentUser()?.userUuid ?? '') != owner) return
        const raw = commentPayload(result)
        const page = raw == null ? null : (windowMode ? parseWindowReviewPage(raw) : parseCommentPage(raw))
        if (page == null || (page.hasMore && page.nextCursor == state.nextCursor && !reset)) { state.errorText = result.message.length > 0 ? result.message : '评价数据异常，请稍后查看'; return }
        // 兼容旧服务的安全边界：它若忽略score，宁可提示未生效，也不错误标为好评/差评。
        if (page.items.some((item: Review): boolean => (state.productId > 0 && item.productId != state.productId) || (state.windowId > 0 && item.windowId != state.windowId) || (score > 0 && item.score != score) || (withImages && item.images.length == 0))) { state.errorText = '评价筛选暂不可用，请稍后重试'; return }
        if (reset) state.reviews = page.items
        else for (let i = 0; i < page.items.length; i++) {
            const item = page.items[i]
            if (!state.reviews.some((existing: Review): boolean => existing.commentId == item.commentId)) state.reviews.push(item)
        }
        state.nextCursor = page.nextCursor
        state.hasMore = page.hasMore
        state.loaded = true
    } catch (_error) {
        if (!reviewDisposed && version == reviewVersion && (currentUser()?.userUuid ?? '') == owner) state.errorText = '评价暂不可用，请下拉重试'
    } finally { if (version == reviewVersion) state.loading = false }
}
/** 统计失败时明确显示不可用；不把旧统计或当前页数量冒充新结果。 */
async function loadRating(): Promise<void> {
    if (reviewDisposed || (state.productId <= 0 && state.windowId <= 0) || state.ratingLoading) return
    const version = ++summaryVersion
    const owner = currentUser()?.userUuid ?? ''
    state.ratingLoading = true
    state.ratingError = ''
    try {
        const result = await fetchReviewSummary(state.windowId, state.productId)
        if (reviewDisposed || version != summaryVersion || (currentUser()?.userUuid ?? '') != owner) return
        const raw = commentPayload(result)
        const summary = raw == null ? null : parseReviewSummary(raw)
        if (summary == null) { state.ratingReady = false; state.ratingError = '评价统计暂不可用，请稍后重试'; return }
        state.reviewCount = summary.reviewCount; state.averageScore = summary.averageScore
        state.positiveCount = summary.positiveCount; state.negativeCount = summary.negativeCount; state.imageCount = summary.imageCount; state.ratingReady = true
    } catch (_error) {
        if (!reviewDisposed && version == summaryVersion && (currentUser()?.userUuid ?? '') == owner) { state.ratingReady = false; state.ratingError = '评价统计暂不可用，请稍后重试' }
    } finally { if (version == summaryVersion) state.ratingLoading = false }
}
/** 图片映射和店铺名称都来自既有商品接口，不信任路由传入任意图片URL。 */
async function loadReviewContext(): Promise<void> {
    if (state.productId <= 0 && state.windowId <= 0) return
    const version = ++contextVersion
    const owner = currentUser()?.userUuid ?? ''
    try {
        const images: Array<ProductImage> = state.productId > 0 ? await listProductImages([state.productId]) : []
        const windows = await listActiveWindows()
        if (reviewDisposed || version != contextVersion || (currentUser()?.userUuid ?? '') != owner) return
        const product = images.find((item: ProductImage): boolean => item.productId == state.productId)
        const windowId = state.windowId > 0 ? state.windowId : (product == null ? 0 : product.windowId)
        if (product != null) state.contextImageUrl = product.imageUrl
        if (windows.ok) {
            const shop = windows.items.find((item: WindowItem): boolean => item.windowId == windowId)
            if (shop != null) {
                state.contextWindowName = shop.windowName; state.contextLocation = shop.location
                if (state.windowId > 0) state.contextImageUrl = shop.imageUrl
            }
        }
    } catch (_error) { /* 介绍信息失败保留标题和默认图，不阻塞评价查询。 */ }
}
/** 登录校验通过后开始拉列表、评分和介绍；非法编号只停在错误文案。 */
function startReviewPage() {
    state.statusBarHeight = uni.getWindowInfo().statusBarHeight
    const user = currentUser()
    if (user == null) { uni.reLaunch({ url: '/pages/login/login' }); return }
    if (!props.embedded && state.productId == 0 && user.roleCode != 'CUSTOMER') { uni.switchTab({ url: '/pages/home/home' }); return }
    if (state.productId < 0) return
    loadReviews(true)
    loadRating()
    loadReviewContext()
}
/** 分数只决定查询条件；二至四星不归类为好评/差评，但保留在全部中。 */
function selectScore(score: number) {
    if (score != 0 && score != 1 && score != 5) return
    changeReviewFilter(score, false)
}
function selectPhotos() { changeReviewFilter(0, true) }
/** 四个标签互斥；有图不限评分，先由服务端筛选再分页，不能过滤当前页凑数。 */
function changeReviewFilter(score: number, withImages: boolean) {
    if (reviewDisposed || state.refreshing || (score == state.scoreFilter && withImages == state.photoOnly)) return
    reviewVersion++; state.loading = false; state.scoreFilter = score; state.photoOnly = withImages
    state.reviews = []; state.nextCursor = ''; state.hasMore = false; state.loaded = false; state.errorText = ''; state.reviewScrollTop = 0
    loadReviews(true)
}
function reviewListScrolled(event: UniScrollEvent) { state.reviewScrollTop = Math.max(0, event.detail.scrollTop) }
function disposeReviews() {
    reviewDisposed = true
    reviewVersion++
    summaryVersion++
    contextVersion++
    state.loading = false
    state.ratingLoading = false
}
onPageHide(() => { reviewVersion++; summaryVersion++; contextVersion++; state.loading = false; state.ratingLoading = false })
onUnload(() => { disposeReviews() })
onBeforeUnmount(() => { disposeReviews() })
function refreshPage() {
    if (state.productId < 0 || state.refreshing || state.loading || state.ratingLoading) return
    state.refreshing = true
    const start = Date.now()
    state.currentRefreshTime = refreshTimeLabel(start)
    Promise.all([loadReviews(true), loadRating()]).then(() => { finishPullRefresh(start, state.errorText.length == 0 && state.ratingError.length == 0, (_time: string) => { state.refreshing = false }) })
}
function loadMore() { if (!state.refreshing) loadReviews(false) }
function photoSource(url: string): string { return imageSource(url, 'product') }
function previewPhotos(review: Review, index: number) {
    const urls: Array<string> = []
    for (let i = 0; i < review.images.length; i++) urls.push(photoSource(review.images[i]))
    if (index >= 0 && index < urls.length) uni.previewImage({ current: urls[index], urls: urls })
}
function formatDate(value: string): string { return accountDate(value) }
/** 独立页回到账户入口；抽屉里把关闭交给父级，避免 navigateBack 把店铺页一并关掉。 */
function goBack() {
    if (props.embedded) emit('close')
    else backToAccount()
}
function openCompleted() { openOrderList('completed') }
function openProduct(review: Review) { uni.navigateTo({ url: '/pages/review/list?productId=' + review.productId }) }
function selectMine(windowMode: boolean) {
    if (state.refreshing || state.showWindowReviews == windowMode) return
    reviewVersion++; state.loading = false; state.scoreFilter = 0; state.photoOnly = false; state.reviewScrollTop = 0
    state.showWindowReviews = windowMode; state.reviews = []; state.loaded = false; state.nextCursor = ''; state.hasMore = false
    loadReviews(true)
}
onMounted(() => {
    // 抽屉打开时父级页面早已 onPageShow，必须在挂载时同步目标并拉数，否则会一直空白。
    if (!props.embedded) return
    applyEmbedTarget()
    startReviewPage()
})
watch((): number => props.embedProductId, (productId: number) => {
    // 同一抽屉换菜时复用实例：先作废旧请求，再按新编号重拉，避免两道菜的评价拼在一起。
    if (!props.embedded || productId == state.productId) return
    reviewVersion++; summaryVersion++; contextVersion++; state.loading = false; state.ratingLoading = false
    state.scoreFilter = 0; state.photoOnly = false; state.reviews = []; state.nextCursor = ''; state.hasMore = false
    state.loaded = false; state.errorText = ''; state.reviewScrollTop = 0; state.ratingReady = false
    applyEmbedTarget()
    startReviewPage()
})
onPageShow(() => {
    if (props.embedded) return
    applyEmbedTarget()
    startReviewPage()
})
</script>
<style>
@import '../../styles/account.css';
@import '../../styles/review.css';

/* 仅作用于只读评价列表；不改写发布页共用的review-*表单样式。 */
/* 移动端一屏要看到更多评价：压缩卡片内边距和筛选条高度，不改标签含义与点击区域划分。 */
.review-feed-content { padding: 8px 12px 16px 12px; }
.review-overview { padding: 12px; border-radius: 14px; background-color: #FFFFFF; border-width: 1px; border-style: solid; border-color: #EFE3D8; }
/* 左侧介绍可收缩换行/截断，右侧评分固定宽度，长菜名不会把分数挤出屏幕。 */
.review-overview-main { flex-direction: row; align-items: center; }
.review-overview-label { font-size: 10px; line-height: 14px; color: #C2410C; }
.review-overview-title { margin-top: 3px; font-size: 16px; line-height: 22px; font-weight: bold; color: #211C18; }
.review-overview-rating { flex-shrink: 0; margin-left: 10px; padding-left: 10px; border-left-width: 1px; border-left-style: solid; border-left-color: #EFE3D8; align-items: flex-end; }
.review-overview-number { flex-direction: row; align-items: flex-end; }
.review-overview-score { font-size: 26px; line-height: 30px; font-weight: bold; color: #C2410C; }
.review-overview-max { margin-bottom: 2px; margin-left: 2px; font-size: 11px; line-height: 16px; color: #A2968B; }
.review-overview-count { margin-top: 2px; font-size: 11px; line-height: 16px; color: #8D7B6E; }
.review-overview-note { margin-top: 8px; font-size: 10px; line-height: 15px; color: #9C8B7D; }
.review-feed-heading { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12px; margin-bottom: 6px; }
.review-feed-heading-title { font-size: 13px; line-height: 18px; font-weight: bold; color: #332820; }
.review-feed-heading-note { font-size: 10px; line-height: 16px; color: #A09083; }
.review-feed-card { padding: 10px 12px; margin-bottom: 8px; border-radius: 12px; background-color: #FFFFFF; }
.review-feed-author-row { flex-direction: row; align-items: center; }
.review-feed-avatar { width: 28px; height: 28px; margin-right: 8px; border-radius: 14px; overflow: hidden; flex-shrink: 0; background-color: #F6EEE7; }
.review-feed-author-name { font-size: 13px; line-height: 18px; font-weight: bold; color: #3C3029; }
.review-feed-date { margin-top: 0; font-size: 10px; line-height: 14px; color: #A09083; }
.review-feed-rating { flex-direction: row; align-items: center; margin-top: 6px; }
.review-feed-rating-label { margin-left: 6px; font-size: 10px; line-height: 16px; color: #B56237; }
.review-feed-body { margin-top: 6px; font-size: 13px; line-height: 20px; color: #463A32; }
/* 最多三张缩略图；窄屏可换行，保持图片预览和正文阅读宽度。 */
.review-feed-photo { width: 64px; height: 64px; margin-right: 5px; margin-bottom: 5px; border-radius: 8px; background-color: #F6EEE7; }
/* #ifdef WEB */
.account-page .review-overview-main, .account-page .review-overview-number, .account-page .review-feed-heading, .account-page .review-feed-author-row, .account-page .review-feed-rating { flex-direction: row; }
/* #endif */

/* 图片和店铺构成评价对象的视觉锚点；介绍失败时仍可阅读评价。 */
.review-subject { flex: 1; min-width: 0; flex-direction: row; align-items: center; }
.review-subject-image { width: 52px; height: 52px; flex-shrink: 0; margin-right: 10px; border-radius: 10px; overflow: hidden; background-color: #FFF0E6; }
.review-subject-copy { flex: 1; min-width: 0; }
.review-subject-shop { margin-top: 3px; font-size: 11px; line-height: 16px; color: #7A6C60; }
.review-subject-location { margin-top: 1px; font-size: 10px; line-height: 14px; color: #A09083; }
/* 四个筛选项并排，高度按小标签收，避免占掉评价卡片的首屏空间。 */
.review-score-tabs { flex-direction: row; margin-top: 10px; }
.review-score-tab { flex: 1; min-width: 0; height: 32px; margin-right: 4px; padding: 0 4px; border-radius: 8px; flex-direction: row; align-items: center; justify-content: center; }
.review-score-tab-selected { background-color: #E4572E; }
.review-score-tab-idle { background-color: #F2E9E1; }
.review-score-tab-label { font-size: 11px; line-height: 16px; }
.review-score-tab-count { margin-left: 3px; font-size: 10px; line-height: 16px; }
.review-score-label-selected { color: #FFFFFF; font-weight: bold; }
.review-score-label-idle { color: #7A6C60; font-weight: normal; }
/* #ifdef WEB */
.account-page .review-subject, .account-page .review-score-tabs, .account-page .review-score-tab { flex-direction: row; }
