import { readStoredObject } from './checkout.uts'
import { jsonObject, jsonNumber, jsonString } from './json.uts'
import { strings } from '../api/comments.uts'

export type PendingReview = { key: string, body: UTSJSONObject }
export function commentPendingKey(userUuid: string, orderId: number, productId: number): string {
    return 'comment_pending_' + userUuid + '_' + orderId + '_' + productId
}
/** 请求幂等标识，不作为认证凭据；格式与评论接口 UUID 契约一致。 */
export function newCommentKey(): string {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (value: string): string => {
        const random = Math.floor(Math.random() * 16)
        return (value == 'x' ? random : (random & 3) | 8).toString(16)
    })
}
export function readPendingReview(storageKey: string, orderId: number, productId: number): PendingReview | null {
    const raw = readStoredObject(storageKey)
    if (raw == null) return null
    const key = jsonString(raw, 'key') ?? ''
    const body = jsonObject(raw, 'body')
    if (!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(key) || body == null) return null
    const score = jsonNumber(body, 'score') ?? 0
    const content = jsonString(body, 'content') ?? ''
    const images = strings(body, 'imageFileKeys')
    const tags = strings(body, 'tags')
    if (jsonNumber(body, 'orderId') != orderId || jsonNumber(body, 'productId') != productId || !Number.isInteger(score) || score < 1 || score > 5 || content.trim().length == 0 || content.length > 1000 || images == null || images.length > 6 || tags == null || tags.length > 5) return null
    for (let i = 0; i < images.length; i++) if (!/^[a-f0-9]{32}$/.test(images[i])) return null
    for (let i = 0; i < tags.length; i++) if (tags[i].trim().length == 0 || tags[i].length > 20) return null
    return { key: key, body: body }
}
