import { jsonArray, jsonNumber, jsonString, parseJsonObject } from './json.uts'
/**
 * JWT 载荷解析工具。
 *
 * 后端签发的访问令牌是标准 JWT（RS256），载荷段为 base64url 编码的 JSON，
 * 其中 sub 为用户 ID、username 为用户名、roles 为角色编码数组。
 * 登录接口只返回令牌、不返回用户资料，因此客户端从载荷中读取展示登录身份所需的信息。
 *
 * 说明：这里只做解码与解析，不做签名校验——签名合法性由服务端负责，
 * 客户端信任自己刚拿到的令牌即可。uni-app x 没有内置 atob/TextDecoder，
 * 故手写 base64url 解码与 UTF-8 解码，避免引入第三方库。
 */

/**
 * base64 字母表，字符下标即该字符对应的 6 位数值。
 */
// 用 indexOf 查字符即可得到其 6 位数值，无需额外查表结构。
const B64_ALPHABET: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

/**
 * 十进制的单个数字，用于把字符串形式的数字转换为数值。
 */
// 同样用 indexOf 得到数字值，等价于 digit = ch - '0'。
const DECIMAL_DIGITS: string = '0123456789'

/**
 * 访问令牌中携带的用户身份信息。
 */
export type TokenPayload = {
	/** 用户 ID，对应令牌的 sub 声明。 */
	userId: number
	/** 用户名，对应令牌的 username 声明。 */
	username: string
	/** 角色编码，取 roles 数组的第一个元素。 */
	roleCode: string
	/** 令牌过期时间，Unix 秒。 */
	expiresAt: number
}

/**
 * 把 base64url 字符串还原为 base64 字符集并补齐 '=' 填充。
 *
 * @param input base64url 编码的字符串
 * @return 标准 base64 字符串
 */
function toStandardBase64(input: string): string {
	// base64url 用 '-' 和 '_' 替换了 '+' 和 '/'，这里逐字符还原。
	// 累积还原后的标准 base64 字符。
	let normalized = ''
	// 遍历 base64url 段落中的每个字符。
	for (let i = 0; i < input.length; i++) {
		// 取出当前位置的字符进行替换判断。
		const ch = input.charAt(i)
		if (ch == '-') {
			// base64url 的 '-' 对应标准 base64 的 '+'。
			normalized += '+'
		} else if (ch == '_') {
			// base64url 的 '_' 对应标准 base64 的 '/'。
			normalized += '/'
		} else {
			// 其余字符与标准 base64 一致，原样保留。
			normalized += ch
		}
	}

	// 补齐到 4 的整数倍，否则按 4 字符一组解码时会错位。
	while (normalized.length % 4 != 0) {
		// 缺少的位数用 '=' 填充。
		normalized += '='
	}
	// 返回可直接按标准 base64 解码的字符串。
	return normalized
}

/**
 * 解码 base64 字符串为字节数组。
 *
 * @param input 标准 base64 字符串
 * @return 字节数组，每个元素取值 0-255
 */
function base64ToBytes(input: string): number[] {
	// 累积解码出的每个字节。
	const bytes: number[] = []

	// buffer 累积尚未满 8 位的比特，bits 记录当前积累的有效位数。
	let buffer = 0
	// 当前 buffer 中已累积的有效比特数，每读入一个字符增加 6。
	let bits = 0
	// 逐字符读取，每 6 位一组还原为原始字节。
	for (let i = 0; i < input.length; i++) {
		// 取出当前字符。
		const ch = input.charAt(i)
		// '=' 是填充符，遇到即表示有效数据已结束。
		if (ch == '=') {
			break
		}
		// 查表得到该字符对应的 6 位数值。
		const value = B64_ALPHABET.indexOf(ch)
		// 不在字母表内说明是脏数据，直接跳过，避免整段解析失败。
		if (value < 0) {
			continue
		}
		// 把 6 位数值并入缓冲区：先左移腾位，再按位或写入。
		buffer = (buffer << 6) | value
		// 缓冲区有效位数增加 6。
		bits += 6
		// 累积够 8 位即可取出一个完整字节。
		if (bits >= 8) {
			// 取走 8 位后剩余位数相应减少。
			bits -= 8
			// 右移到对齐位置并截取低 8 位，得到字节值。
			bytes.push((buffer >> bits) & 0xFF)
		}
	}
	// 返回解码出的字节序列，末尾不足 8 位的残留位按填充丢弃。
	return bytes
}

/**
 * 把字节数组按 UTF-8 解码为字符串。
 *
 * 用户名允许包含中文，不能按单字节 ASCII 处理，故这里实现完整的 UTF-8 解码，
 * 并对超出基本多文种平面的码点按代理对拆分。
 *
 * @param bytes 字节数组
 * @return 解码后的字符串
 */
function utf8ToString(bytes: number[]): string {
	// 累积解码出的字符串。
	let result = ''
	// 当前读取到的字节下标。
	let i = 0
	// 逐字节消费，直到整个字节数组读完。
	while (i < bytes.length) {
		// 先读首字节，由其高位决定这个字符占用几个字节。
		const first = bytes[i]
		// 本字符最终解码出的 Unicode 码点。
		let codePoint = 0

		if (first < 0x80) {
			// 单字节，ASCII 范围。
			codePoint = first
			i += 1
		} else if (first < 0xE0) {
			// 双字节。
			if (i + 1 >= bytes.length) {
				// 剩余字节不足以构成完整字符，终止解码。
				break
			}
			// 首字节贡献低 5 位，次字节贡献低 6 位。
			codePoint = ((first & 0x1F) << 6) | (bytes[i + 1] & 0x3F)
			i += 2
		} else if (first < 0xF0) {
			// 三字节。
			if (i + 2 >= bytes.length) {
				// 剩余字节不足以构成完整字符，终止解码。
				break
			}
			// 依次拼接首字节低 4 位与两个后续字节的低 6 位。
			codePoint = ((first & 0x0F) << 12) | ((bytes[i + 1] & 0x3F) << 6) | (bytes[i + 2] & 0x3F)
			i += 3
		} else {
			// 四字节。
			if (i + 3 >= bytes.length) {
				// 剩余字节不足以构成完整字符，终止解码。
				break
			}
			// 依次拼接首字节低 3 位与三个后续字节的低 6 位。
			codePoint = ((first & 0x07) << 18) | ((bytes[i + 1] & 0x3F) << 12) | ((bytes[i + 2] & 0x3F) << 6) | (bytes[i + 3] & 0x3F)
			i += 4
		}

		if (codePoint <= 0xFFFF) {
			// 基本多文种平面内可直接由码点构造单字符。
			result += String.fromCharCode(codePoint)
		} else {
			// 超过 0xFFFF 的码点需要拆成高位与低位两个代理字符。
			const offset = codePoint - 0x10000
			// 减去 0x10000 后，高 10 位对应高位代理。
			result += String.fromCharCode(0xD800 + (offset >> 10))
			// 低 10 位对应低位代理。
			result += String.fromCharCode(0xDC00 + (offset & 0x3FF))
		}
	}
	// 返回解码后的完整字符串。
	return result
}

/**
 * 把纯数字字符串转换为数值，非数字字符会被忽略。
 *
 * 不用 parseInt 是为了与 UTS 内置能力解耦，也避免进制与空白带来的歧义。
 *
 * @param text 数字字符串
 * @return 解析出的数值，无数字时返回 0
 */
function toNumber(text: string): number {
	// 累积转换结果，按十进制逐位进位。
	let value = 0
	// 逐字符读取，忽略非数字字符。
	for (let i = 0; i < text.length; i++) {
		// 查表得到当前字符对应的数值，非数字返回 -1。
		const digit = DECIMAL_DIGITS.indexOf(text.charAt(i))
		// 非数字字符直接跳过，避免污染结果。
		if (digit < 0) {
			continue
		}
		// 已有结果整体左移一位（乘以 10），再加上当前位的数值。
		value = value * 10 + digit
	}
	// 返回最终数值，无任何数字时结果为 0。
	return value
}

/**
 * 解析访问令牌载荷，取出登录身份信息。
 *
 * @param accessToken 访问令牌
 * @return 解析成功返回身份信息，令牌格式非法时返回 null
 */
export function parseTokenPayload(accessToken: string): TokenPayload | null {
	// JWT 是三段以 '.' 分隔的字符串，拆开后第二段即载荷。
	const segments = accessToken.split('.')
	// JWT 由头部、载荷、签名三段组成，缺少载荷段说明不是 JWT。
	if (segments.length < 2) {
		return null
	}

	// 载荷段是 base64url 编码的 JSON：先还原为标准 base64，再解码字节，最后按 UTF-8 转字符串。
	const payloadText = utf8ToString(base64ToBytes(toStandardBase64(segments[1])))

	try {
		// 把载荷文本解析为对象，非法 JSON 会抛异常由下面的 catch 兜住。
		const payload = parseJsonObject(payloadText)
		if (payload == null) {
			return null
		}

		// 取 sub 声明作为用户 ID；缺失说明载荷不完整。
		const subject = jsonString(payload, 'sub')
		if (subject == null) {
			return null
		}

		// roles 是数组，角色编码取第一个元素；缺失时留空，由页面做兜底展示。
		let roleCode = ''
		// 读取角色数组，可能不存在。
		const roles = jsonArray(payload, 'roles')
		if (roles != null && roles.length > 0) {
			// 只取第一个角色编码，本项目每个用户仅一个角色。
			const firstRole = roles[0]
			if (firstRole != null) {
				// 数组中元素是 any，需显式断言为 string。
				roleCode = firstRole as string
			}
		}

		// 用户名缺失时留空；exp 缺失时按 0 处理（视为无法判定有效期）。
		const username = jsonString(payload, 'username') ?? ''
		// exp 是 Unix 秒级时间戳，供预刷新判断令牌是否临近过期。
		const expiresAt = jsonNumber(payload, 'exp') ?? 0

		// 组装为强类型的身份信息对象返回。
		const result: TokenPayload = {
			// sub 是字符串形式的用户 ID，需转换为数值。
			userId: toNumber(subject),
			username: username,
			roleCode: roleCode,
			expiresAt: expiresAt
		}
		return result
	} catch (error) {
		// 载荷不是合法 JSON 时按解析失败处理。
		return null
	}
}
