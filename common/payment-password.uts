import { toast } from './feedback.uts'

type PasswordRequest = { id: number, title: string, amount: string, resolve: (password: string | null) => void }
export type PasswordPrompt = { title: string, amount: string }
let request: PasswordRequest | null = null
let sequence = 0

/** 密码只通过内存中的单次Promise交回发起页，不经过URL、事件总线或本地存储。 */
export function requestPaymentPassword(title: string, amount: string): Promise<string | null> {
    if (request != null) return Promise.resolve(null)
    const id = ++sequence
    return new Promise<string | null>((resolve) => {
        request = { id: id, title: title, amount: amount, resolve: resolve }
        uni.openDialogPage({
            url: '/pages/wallet/payment-password?id=' + id,
            fail: () => { finishPaymentPassword(id, null); toast('密码输入窗口打开失败，请重试') }
        })
    })
}

export function paymentPasswordPrompt(id: number): PasswordPrompt | null {
    const current = request
    if (current == null || current.id != id) return null
    return { title: current.title, amount: current.amount }
}

export function finishPaymentPassword(id: number, password: string | null): void {
    const current = request
    if (current == null || current.id != id) return
    request = null
    current.resolve(password)
}

export function cancelPaymentPassword(): void {
    const current = request
    if (current == null) return
    finishPaymentPassword(current.id, null)
    uni.closeDialogPage()
}
