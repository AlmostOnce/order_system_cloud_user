import { jsonArray, jsonNumber, jsonString, parseJsonObject } from './json.uts'

/** 可重试订单草稿行；金额只用于展示，提交时依旧由商品服务核价。 */
export type CheckoutLine = {
    /** 菜品编号。 */
    productId: number
    /** 下单前菜单展示的菜名。 */
    productName: string
    /** 下单数量。 */
    quantity: number
    /** 下单前购物车版本，清理购物车时用于避免删除并发新增。 */
    revision: string
    /** 购物车核价展示的单价，不作为订单请求价格。 */
    unitPrice: number
    /** 购物车核价展示的行金额，不作为订单请求金额。 */
    lineAmount: number
    /** 规格选项编号的规范键，购物车下单后清理时精确标识规格行。 */
    selectionKey: string
    /** 商品服务已核验的选项编号；订单创建会再次核验并计算价格。 */
    selectedOptionIds: Array<number>
    /** 当前规格显示文字，重试页与订单确认页可读。 */
    specificationText: string
}
export type CheckoutDraft = {
    key: string
    windowId: number
    windowName: string
    remark: string
    /** 学生主动选用的用户券 ID；0 表示不使用优惠券，服务端下单时重验有效性。 */
    userCouponId: number
    items: Array<CheckoutLine>
}

export function checkoutKey(userUuid: string): string { return 'order_pending_' + userUuid }
export function cleanupKey(userUuid: string, orderId: number): string { return 'order_cleanup_' + userUuid + '_' + orderId }
export function paymentPendingKey(userUuid: string, orderId: number): string { return 'order_payment_pending_' + userUuid + '_' + orderId }
export function readStoredObject(key: string): UTSJSONObject | null {
    const raw = uni.getStorageSync(key)
    return typeof raw == 'string' ? parseJsonObject(raw as string) : null
}
export function readCheckout(userUuid: string): CheckoutDraft | null {
    const raw = readStoredObject(checkoutKey(userUuid))
    if (raw == null) return null
    const key = jsonString(raw, 'key') ?? ''
    const windowId = jsonNumber(raw, 'windowId') ?? 0
    // 老版本的待确认草稿没有券 ID，读取为0并在下单请求中省略该字段。
    const userCouponId = jsonNumber(raw, 'userCouponId') ?? 0
    const items = jsonArray(raw, 'items')
    if (key.length == 0 || windowId <= 0 || userCouponId < 0 || !Number.isSafeInteger(userCouponId)
        || items == null || items.length == 0 || items.length > 100) return null
    const lines: Array<CheckoutLine> = []
    for (let i = 0; i < items.length; i++) {
        if (items[i] == null || typeof items[i] != 'object' || Array.isArray(items[i])) return null
        const row = items[i] as UTSJSONObject
        const id = jsonNumber(row, 'productId') ?? 0
        const qty = jsonNumber(row, 'quantity') ?? 0
        const rev = jsonString(row, 'revision') ?? ''
        if (id <= 0 || qty <= 0 || rev.length == 0) return null
        const optionIds = [] as Array<number>
        const rawOptionIds = jsonArray(row, 'selectedOptionIds')
        if (rawOptionIds != null) {
            for (let optionIndex = 0; optionIndex < rawOptionIds.length; optionIndex++) {
                const optionId = rawOptionIds[optionIndex]
                if (typeof optionId != 'number' || (optionId as number) <= 0) return null
                optionIds.push(optionId as number)
            }
        }
        const selectionKey = jsonString(row, 'selectionKey') ?? (optionIds.length == 0 ? 'base' : '')
        // 本地草稿必须同时保留选项与规格键；不完整的新草稿宁可要求重新读取购物车，也不能静默下成基础价。
        if (selectionKey.length == 0 || (optionIds.length == 0 && selectionKey != 'base')) return null
        lines.push({ productId: id, productName: jsonString(row, 'productName') ?? '菜品', quantity: qty, revision: rev,
            unitPrice: jsonNumber(row, 'unitPrice') ?? 0, lineAmount: jsonNumber(row, 'lineAmount') ?? 0,
            selectionKey: selectionKey, selectedOptionIds: optionIds,
            specificationText: jsonString(row, 'specificationText') ?? '' })
    }
    return { key: key, windowId: windowId, windowName: jsonString(raw, 'windowName') ?? '', remark: jsonString(raw, 'remark') ?? '', userCouponId: userCouponId, items: lines }
}
/**
 * 生成正式下单载荷，只提交购物车所需商品字段与可选用户券 ID；
 * 不发送客户端估算金额，价格和优惠均由订单服务端读取并重新核验。
 */
export function orderBody(draft: CheckoutDraft): UTSJSONObject {
    const items: Array<UTSJSONObject> = []
    for (let i = 0; i < draft.items.length; i++) items.push({ productId: draft.items[i].productId,
        quantity: draft.items[i].quantity, selectedOptionIds: draft.items[i].selectedOptionIds })
    const body: UTSJSONObject = { windowId: draft.windowId, remark: draft.remark, items: items }
    if (draft.userCouponId > 0) body['userCouponId'] = draft.userCouponId
    return body
}
export function cleanupBody(draft: CheckoutDraft): UTSJSONObject {
    const items: Array<UTSJSONObject> = []
    for (let i = 0; i < draft.items.length; i++) items.push({ productId: draft.items[i].productId,
        quantity: draft.items[i].quantity, revision: draft.items[i].revision, selectionKey: draft.items[i].selectionKey })
    return { windowId: draft.windowId, items: items }
}
