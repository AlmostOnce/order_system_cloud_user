/**
 * 全局环境配置。
 *
 * 这是唯一需要按环境改动的文件：页面与业务层一律通过本文件提供的常量与
 * 后端通信，不得在其它位置硬编码地址、超时或状态码。
 */

/**
 * 后端 Nginx 入口地址（可变量，便于按平台改写）。
 *
 * 对外地址 = 网关地址 + /api + 服务自身路径，
 * 例如认证服务的 /auth/login 对外即 {API_BASE_URL}/auth/login。
 */
let apiBaseUrl = 'http://localhost:8088/api'

// #ifdef APP-ANDROID
// Android 真机通过局域网直接访问电脑 Nginx，避免无线调试重连后丢失 ADB 转发而请求失败。
// 手机与电脑须处于可互访的局域网，电脑须开放并监听 8088；连接失败时由统一请求层提示错误。
// 此地址当前由 DHCP 分配，长期使用需在路由器保留 192.168.0.14；换网络或电脑地址变化时同步修改。
// 仅用于本地开发，发布前必须替换为正式 HTTPS 域名；接口、图片和 WebSocket 共用该入口。
apiBaseUrl = 'http://192.168.0.14:8088/api'
// #endif

/**
 * Nginx 统一入口地址，Nginx 将 /api 转发给网关。
 *
 * - 微信小程序：开发者工具运行在开发机上，保持 localhost 即可，
 *   但需在开发者工具中勾选「不校验合法域名」。
 * - Android 本地调试：直接访问电脑局域网地址，不依赖 ADB 连接或端口转发。
 */
// 固化为常量对外导出，页面与业务层只读该常量，不得再用可变量 apiBaseUrl。
export const API_BASE_URL: string = apiBaseUrl

/**
 * 网络请求超时时间，单位毫秒。
 */
// 统一超时口径：过长会让弱网下界面长时间空等，过短会误伤正常慢请求。
export const API_TIMEOUT: number = 10000

/**
 * 后端统一响应体中的成功状态码，取值自 common-response 的 CommonErrorCode.SUCCESS。
 *
 * 注意：后端 code 是字符串而非数字，页面判断成功必须与常量比较，不能写 code == 200。
 */
// 成功码集中在此定义，避免各页面各写一份字符串常量。
export const SUCCESS_CODE: string = 'COMMON_000'
