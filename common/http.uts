import { jsonObject, jsonString, parseJsonObject } from './json.uts'
/**
 * HTTP 请求底座。
 *
 * uni-app x 的 uni.request 不支持 request 拦截器（uni.addInterceptor 只覆盖路由类 API），
 * 因此这里自建统一入口：拼装网关地址、注入 Bearer 令牌、解析后端统一响应体。
 *
 * 约定：本层不抛异常也不 reject，一律以 HttpResult 结构返回结果，调用方判断 ok 即可。
 * 这样页面与业务层完全不必处理异常类型，也避免 UTS 中异常捕获的类型约束差异。
 */

// 导入网关地址、超时与成功码常量；本层不硬编码这些配置值。
import { API_BASE_URL, API_TIMEOUT, SUCCESS_CODE } from './config.uts'
// 导入本地凭据读写：发请求时注入令牌、续期成功后落盘新令牌、会话失效时清空。
import { getAccessToken, getRefreshToken, saveTokens, clearTokens } from './storage.uts'

/**
 * 请求结果。
 */
export type HttpResult = {
	/**
	 * 请求是否成功，成功需同时满足 HTTP 200 与业务码为成功码。
	 */
	ok: boolean

	/**
	 * 失败时的提示文案，可直接展示给用户。
	 */
	message: string

	/**
	 * 成功时的后端统一响应体，结构为 { code, message, data }。
	 */
	data: UTSJSONObject | null

	/**
	 * HTTP 状态码；请求未到达服务端（网络层失败）时为 0。
	 *
	 * 续期逻辑据此识别 401，调用方通常无需关心。
	 */
	statusCode: number
}

/**
 * 构造成功结果。
 *
 * @param envelope 后端统一响应体
 * @return 成功结果
 */
function successResult(envelope: UTSJSONObject, statusCode: number): HttpResult {
	// 成功结果的 message 固定为空串，调用方只判断 ok 即可。
	const result: HttpResult = { ok: true, message: '', data: envelope, statusCode: statusCode }
	// 返回组装好的成功结果。
	return result
}

/**
 * 构造失败结果。
 *
 * @param message 错误提示
 * @return 失败结果
 */
function failureResult(message: string, statusCode: number): HttpResult {
	// 失败结果不带响应体，data 置空，由 message 承载可展示的提示。
	const result: HttpResult = { ok: false, message: message, data: null, statusCode: statusCode }
	// 返回组装好的失败结果。
	return result
}

/**
 * 生成传输层失败的提示文案。
 *
 * 请求没有正常返回统一响应体时使用，按 HTTP 状态码区分常见情况。
 *
 * @param statusCode HTTP 状态码
 * @return 错误提示
 */
function transportErrorMessage(statusCode: number): string {
	// 网关对登录接口配置了令牌桶限流，超限返回 429，单独给出更准确的提示。
	if (statusCode == 429) {
		return '操作过于频繁，请稍后再试'
	}
	// 401 且拿不到响应体，说明凭据已被拒绝，提示重新登录。
	if (statusCode == 401) {
		return '登录状态已失效，请重新登录'
	}
	// 403 表示身份有效但角色无权限访问该资源。
	if (statusCode == 403) {
		return '没有访问该资源的权限'
	}
	// 其余状态码统一给出通用的服务不可用提示。
	return '服务暂不可用，请稍后重试'
}

/**
 * 解析后端返回的统一响应体。
 *
 * GET 与 POST 共用，避免两处重复判断状态码与业务码。
 *
 * @param statusCode HTTP 状态码
 * @param raw 平台解析后的响应数据，类型不确定，需按对象读取
 * @return 请求结果
 */
function parseResponse(statusCode: number, raw: any): HttpResult {
	// 拿不到响应体时读不到业务文案，只能按 HTTP 状态码给出通用提示。
	if (raw == null) {
		return failureResult(transportErrorMessage(statusCode), statusCode)
	}

	// 请求统一按文本接收，在这里安全解析；也兼容已解析的对象。
	let envelope: UTSJSONObject | null = null
	if (typeof raw == 'string') {
		envelope = parseJsonObject(raw as string)
	} else if (typeof raw == 'object' && !Array.isArray(raw)) {
		envelope = raw as UTSJSONObject
	}
	if (envelope == null) {
		return failureResult(statusCode >= 200 && statusCode < 300
			? '服务器返回的数据格式异常，请稍后重试' : transportErrorMessage(statusCode), statusCode)
	}
	// 取统一响应体的业务码；字段缺失时按空串处理。
	const code = jsonString(envelope, 'code') ?? ''
	// 业务码等于成功码才算真正成功，不单看 HTTP 状态。
	if (statusCode >= 200 && statusCode < 300 && code == SUCCESS_CODE) {
		return successResult(envelope, statusCode)
	}

	// 业务失败时后端都会带统一响应体，message 已是可直接展示的文案
	// （如账密错误返回「用户名或密码错误」）。必须先取后端 message，
	// 否则会被 401 等状态码的通用提示覆盖，把登录失败误报成登录过期。
	const businessMessage = jsonString(envelope, 'message')
	// 后端给出了非空文案时优先透传，保留最准确的错误语义。
	if (businessMessage != null && businessMessage.length > 0) {
		return failureResult(businessMessage, statusCode)
	}

	// 响应体不含可用文案（如网关直接拒绝）时才退回状态码通用提示。
	return failureResult(transportErrorMessage(statusCode), statusCode)
}

/**
 * 按需鉴权拼装请求头。
 *
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求头
 */
function buildHeader(needAuth: boolean, idempotencyKey: string = ''): UTSJSONObject {
	// 请求一律按 JSON 提交，后端接口均以 JSON 作为请求体格式。
	const header: UTSJSONObject = { 'Content-Type': 'application/json' }
	if (idempotencyKey.length > 0) {
		header['Idempotency-Key'] = idempotencyKey
	}
	// 仅需要鉴权的请求才注入令牌，免登录接口不携带过期令牌。
	if (needAuth) {
		// 读取本地访问令牌。
		const accessToken = getAccessToken()
		// 有令牌时才拼装 Authorization 头，避免发送空 Bearer。
		if (accessToken.length > 0) {
			header['Authorization'] = 'Bearer ' + accessToken
		}
	}
	// 返回最终请求头。
	return header
}

/**
 * 发送一次 POST 请求，不带任何续期逻辑。
 *
 * @param path 业务路径
 * @param body 请求体，无请求体时传 null
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
function postOnce(
	path: string,
	body: UTSJSONObject | null,
	needAuth: boolean,
	idempotencyKey: string = ''
): Promise<HttpResult> {
	// 用 Promise 包住回调式请求，把 uni.request 的回调结果统一为 Promise 结果。
	return new Promise<HttpResult>((resolve) => {
		uni.request({
			// 网关地址与业务路径拼接，调用方只传服务自身路径。
			url: API_BASE_URL + path,
			// 固定使用 POST 字面量，避免把 method 作为字符串参数带来的类型问题。
			method: 'POST',
			// 请求头按是否需要鉴权动态拼装。
			header: buildHeader(needAuth, idempotencyKey),
			// POST 请求体，允许为空对象以外的 null（如无请求体接口）。
			data: body,
			// 使用全局统一超时时间。
			timeout: API_TIMEOUT,
			// 按文本接收，避免空白或非 JSON 响应在平台自动解析时抛异常。
			dataType: 'text',
			success: (res) => {
				// 请求已到达服务端，按状态码与业务码解析统一响应体。
				resolve(parseResponse(res.statusCode, res.data))
			},
			fail: (err) => {
				// 网络层失败（超时、断网、地址不可达）不会返回 HTTP 状态码。
				resolve(failureResult('网络连接失败，请检查网络后重试', 0))
			}
		})
	})
}

/**
 * 发送一次 GET 请求，不带任何续期逻辑。
 *
 * @param path 业务路径
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
function getOnce(path: string, needAuth: boolean): Promise<HttpResult> {
	// 用 Promise 包住回调式请求，把 uni.request 的回调结果统一为 Promise 结果。
	return new Promise<HttpResult>((resolve) => {
		uni.request({
			// 网关地址与业务路径拼接，调用方只传服务自身路径。
			url: API_BASE_URL + path,
			// 固定使用 GET 字面量，避免把 method 作为字符串参数带来的类型问题。
			method: 'GET',
			// 请求头按是否需要鉴权动态拼装。
			header: buildHeader(needAuth),
			// 使用全局统一超时时间。
			timeout: API_TIMEOUT,
			// 按文本接收，避免空白或非 JSON 响应在平台自动解析时抛异常。
			dataType: 'text',
			success: (res) => {
				// 请求已到达服务端，按状态码与业务码解析统一响应体。
				resolve(parseResponse(res.statusCode, res.data))
			},
			fail: (err) => {
				// 网络层失败（超时、断网、地址不可达）不会返回 HTTP 状态码。
				resolve(failureResult('网络连接失败，请检查网络后重试', 0))
			}
		})
	})
}

/**
 * 发送一次 PUT 请求，不带任何续期逻辑。
 *
 * @param path 业务路径
 * @param body 请求体
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
function putOnce(
	path: string,
	body: UTSJSONObject | null,
	needAuth: boolean
): Promise<HttpResult> {
	// 与 postOnce 结构一致，仅 method 不同，便于各自使用字面量类型。
	return new Promise<HttpResult>((resolve) => {
		uni.request({
			// 网关地址与业务路径拼接，调用方只传服务自身路径。
			url: API_BASE_URL + path,
			// PUT 用于「设置为目标值」类操作，如修改购物车条目的数量。
			method: 'PUT',
			// 请求头按是否需要鉴权动态拼装。
			header: buildHeader(needAuth),
			// PUT 请求体。
			data: body,
			// 使用全局统一超时时间。
			timeout: API_TIMEOUT,
			// 按文本接收，避免空白或非 JSON 响应在平台自动解析时抛异常。
			dataType: 'text',
			success: (res) => {
				// 请求已到达服务端，按状态码与业务码解析统一响应体。
				resolve(parseResponse(res.statusCode, res.data))
			},
			fail: (err) => {
				// 网络层失败（超时、断网、地址不可达）不会返回 HTTP 状态码。
				resolve(failureResult('网络连接失败，请检查网络后重试', 0))
			}
		})
	})
}

/** 发送一次 PATCH 请求，复用统一响应与鉴权处理。 */
