	path: string,
	body: UTSJSONObject | null,
	needAuth: boolean
): Promise<HttpResult> {
	// 与 postOnce 结构一致，仅 method 不同，便于各自使用字面量类型。
	return new Promise<HttpResult>((resolve) => {
		uni.request({
			// 网关地址与业务路径拼接，调用方只传服务自身路径。
			url: API_BASE_URL + path,
			// PATCH 用于取消订单等局部状态变更。
			method: 'PATCH',
			// 请求头按是否需要鉴权动态拼装。
			header: buildHeader(needAuth),
			// PATCH 请求体。
			data: body,
			// 使用全局统一超时时间。
			timeout: API_TIMEOUT,
			// 按文本接收，避免空白或非 JSON 响应在平台自动解析时抛异常。
			dataType: 'text',
			success: (res) => {
				// 请求已到达服务端，按状态码与业务码解析统一响应体。
				resolve(parseResponse(res.statusCode, res.data))
			},
			fail: (err) => {
				// 网络层失败（超时、断网、地址不可达）不会返回 HTTP 状态码。
				resolve(failureResult('网络连接失败，请检查网络后重试', 0))
			}
		})
	})
}

/**
 * 发送一次 DELETE 请求，不带任何续期逻辑。
 *
 * @param path 业务路径
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
function deleteOnce(path: string, needAuth: boolean): Promise<HttpResult> {
	// 与 getOnce 结构一致，仅 method 不同，便于各自使用字面量类型。
	return new Promise<HttpResult>((resolve) => {
		uni.request({
			// 网关地址与业务路径拼接，调用方只传服务自身路径。
			url: API_BASE_URL + path,
			// DELETE 用于删除购物车条目等幂等删除操作。
			method: 'DELETE',
			// 请求头按是否需要鉴权动态拼装。
			header: buildHeader(needAuth),
			// 使用全局统一超时时间。
			timeout: API_TIMEOUT,
			// 按文本接收，避免空白或非 JSON 响应在平台自动解析时抛异常。
			dataType: 'text',
			success: (res) => {
				// 请求已到达服务端，按状态码与业务码解析统一响应体。
				resolve(parseResponse(res.statusCode, res.data))
			},
			fail: (err) => {
				// 网络层失败（超时、断网、地址不可达）不会返回 HTTP 状态码。
				resolve(failureResult('网络连接失败，请检查网络后重试', 0))
			}
		})
	})
}

/**
 * 发送请求，并在需要鉴权的请求收到 401 时尝试自动续期。
 *
 * <p>这是 httpPost 与 httpGet 共用的外层。收到 401 且允许续期时，先走一次
 * 单飞刷新拿到新令牌，再带上新令牌把原请求重试一次；刷新失败则清空本地
 * 凭据并回到登录页。重试时 allowRefresh 置为 false，避免刷新成功后仍失败
 * 时无限循环。</p>
 *
 * <p>只重试一次是安全的：401 表示请求在鉴权阶段就被拒绝，业务尚未执行，
 * 不会产生重复副作用。</p>
 *
 * @param send 实际发送一次请求的函数
 * @param needAuth 该请求是否需要鉴权
 * @param allowRefresh 收到 401 时是否允许自动续期
 * @return 请求结果
 */
function sendWithRefresh(
	send: () => Promise<HttpResult>,
	needAuth: boolean,
	allowRefresh: boolean
): Promise<HttpResult> {
	// 用 Promise 包住整段续期流程，调用方只关心最终结果。
	return new Promise<HttpResult>((resolve) => {
		// 先发送一次原请求，再根据其结果决定是否续期重试。
		send().then((result: HttpResult) => {
			// 非「鉴权失败」的情况一律直接返回：成功、非 401、免鉴权请求或已重试过。
			if (result.ok || result.statusCode != 401 || !needAuth || !allowRefresh) {
				resolve(result)
				return
			}

			// 鉴权失败时先尝试续期：成功则带新令牌重试，失败则判定会话失效。
			refreshSession().then((refreshed: boolean) => {
				// 续期失败（无刷新令牌、已过期或被消费）：清凭据回登录页，返回原始 401。
				if (!refreshed) {
					handleSessionExpired()
					resolve(result)
					return
				}
				// 续期成功：带着新访问令牌重试一次原请求，allowRefresh 置 false 防止无限循环。
				sendWithRefresh(send, needAuth, false).then((retryResult: HttpResult) => {
					resolve(retryResult)
				})
			})
		})
	})
}

/** 进行中的刷新请求；非空表示已有请求在续期，其它 401 请求复用它而不重复刷新。 */
let refreshingPromise: Promise<boolean> | null = null

/**
 * 单飞刷新令牌：并发多个 401 只发起一次刷新，其余请求等待同一结果。
 *
 * <p>后端刷新是「令牌轮换 + 一次性消费」，同一枚旧 Refresh Token 只能成功
 * 刷新一次；若并发请求各自刷新，第二个必然拿到「Refresh Token 无效或已过期」。
 * 同一客户端内部合并为一次刷新，是后端并发保护配套的前端逻辑。</p>
 *
 * @return 刷新成功返回 true
 */
function refreshSession(): Promise<boolean> {
	// 已有刷新在进行中：直接复用同一个 Promise，调用方各自等待其最终结果。
	if (refreshingPromise != null) {
		return refreshingPromise
	}

	// 首次触发：真正发起一次刷新请求。
	const current: Promise<boolean> = performRefresh()
	// 立即占位，使后续并发 401 都指向这次刷新。
	refreshingPromise = current
	// 刷新结束后释放单飞占位，后续再次过期时仍可重新续期。
	current.then((refreshed: boolean) => {
		refreshingPromise = null
	})
	// 返回本次刷新结果给当前调用方。
	return current
}

/**
 * 使用本地 Refresh Token 换取新的双令牌。
 *
 * @return 刷新成功返回 true
 */
function performRefresh(): Promise<boolean> {
	// 把刷新结果统一收敛为布尔值：true 表示已换到并落盘新双令牌。
	return new Promise<boolean>((resolve) => {
		// 读取本地刷新令牌，作为换取新令牌的凭据。
		const refreshToken = getRefreshToken()
		// 没有刷新令牌（未登录或已登出）时直接判定刷新失败，不请求后端。
		if (refreshToken.length == 0) {
			resolve(false)
			return
		}

		// 按后端 RefreshTokenRequest 的契约组装请求体。
		const body: UTSJSONObject = { refreshToken: refreshToken }
		// 刷新接口免鉴权，且直接调用 postOnce，天然不会再触发续期。
		postOnce('/auth/refresh', body, false).then((result: HttpResult) => {
			// 刷新请求本身失败（如旧令牌已被消费）时判定刷新失败。
			if (!result.ok) {
				resolve(false)
				return
			}

			// 取统一响应体，理论上成功时必不为空。
			const envelope = result.data
			// 响应体缺失属于异常响应，按失败处理。
			if (envelope == null) {
				resolve(false)
				return
			}

			// 取 data 字段（登录 VO），缺令牌说明响应异常。
			const rawPayload = jsonObject(envelope, 'data')
			// 缺 data 时无法取出令牌，按失败处理。
			if (rawPayload == null) {
				resolve(false)
				return
			}

			// 平台返回的 data 是 any，需断言为对象后按字段读取。
			const payload = rawPayload as UTSJSONObject
			// 取出新访问令牌。
			const accessToken = jsonString(payload, 'accessToken') ?? ''
			// 取出新刷新令牌（后端采用轮换策略，会返回新的一枚）。
			const newRefreshToken = jsonString(payload, 'refreshToken') ?? ''
			// 任一令牌缺失都说明响应不完整，按失败处理且不落盘。
			if (accessToken.length == 0 || newRefreshToken.length == 0) {
				resolve(false)
				return
			}

			// 轮换后的新双令牌必须立刻落盘，后续重试才会带上新的访问令牌。
			saveTokens(accessToken, newRefreshToken)
			// 告知调用方刷新成功，可以带新令牌重试原请求。
			resolve(true)
		})
	})
}

/**
 * 处理会话失效：清空本地凭据并回到登录页。
 */
function handleSessionExpired(): void {
	// 清空双令牌，避免残留的失效凭据被后续请求继续携带。
	clearTokens()
	// 用 reLaunch 重置页面栈，防止用户用返回键退回需要登录的页面。
	uni.reLaunch({ url: '/pages/login/login' })
}

/**
 * 以 POST 方式请求后端，收到 401 时自动续期并重试一次。
 *
 * @param path 业务路径，如 '/auth/login'
 * @param body 请求体，无请求体时传 null
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
export function httpPost(path: string, body: UTSJSONObject | null, needAuth: boolean, idempotencyKey: string = ''): Promise<HttpResult> {
	// 以闭包传入一次性的 POST 发送动作，由 sendWithRefresh 决定是否续期重试。
	return sendWithRefresh(() => {
		return postOnce(path, body, needAuth, idempotencyKey)
	}, needAuth, true)
}

/**
 * 以 GET 方式请求后端，收到 401 时自动续期并重试一次。
 *
 * @param path 业务路径，如 '/products/windows'
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
export function httpGet(path: string, needAuth: boolean): Promise<HttpResult> {
	// 以闭包传入一次性的 GET 发送动作，由 sendWithRefresh 决定是否续期重试。
	return sendWithRefresh(() => {
		return getOnce(path, needAuth)
	}, needAuth, true)
}

/**
 * 以 PUT 方式请求后端，收到 401 时自动续期并重试一次。
 *
 * @param path 业务路径，如 '/cart/windows/1/items/2'
 * @param body 请求体
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
export function httpPut(path: string, body: UTSJSONObject | null, needAuth: boolean): Promise<HttpResult> {
	// 以闭包传入一次性的 PUT 发送动作，由 sendWithRefresh 决定是否续期重试。
	return sendWithRefresh(() => {
		return putOnce(path, body, needAuth)
	}, needAuth, true)
}

/**
 * 以 DELETE 方式请求后端，收到 401 时自动续期并重试一次。
 *
 * @param path 业务路径，如 '/cart/windows/1/items/2'
 * @param needAuth 是否需要携带 Bearer 令牌
 * @return 请求结果
 */
export function httpDelete(path: string, needAuth: boolean): Promise<HttpResult> {
	// 以闭包传入一次性的 DELETE 发送动作，由 sendWithRefresh 决定是否续期重试。
	return sendWithRefresh(() => {
		return deleteOnce(path, needAuth)
	}, needAuth, true)
}

/** PATCH 使用同样的令牌续期策略。 */
export function httpPatch(path: string, body: UTSJSONObject | null, needAuth: boolean): Promise<HttpResult> {
    return sendWithRefresh(() => { return patchOnce(path, body, needAuth) }, needAuth, true)
}
