/**
 * 本地存储访问封装。
 *
 * 统一收敛存储键名与类型转换：uni-app x 的 getStorageSync 返回 any，
 * 必须显式 as 到目标类型才能安全使用，这里集中处理，避免各页面重复转换。
 * 键名统一使用 auth_ 前缀，避开 uni-app 系统保留的 uni_、dcloud_ 前缀。
 */

/**
 * 访问令牌的存储键。
 */
// 键名统一用 auth_ 前缀，避开 uni-app 系统保留的 uni_、dcloud_ 前缀。
const KEY_ACCESS_TOKEN: string = 'auth_access_token'

/**
 * 刷新令牌的存储键。
 */
// 与访问令牌分开存放，退出登录时二者需要一起清除。
const KEY_REFRESH_TOKEN: string = 'auth_refresh_token'

/**
 * 上次登录登录账号的存储键，仅供「记住账号」回填使用。
 *
 * 刻意不落盘密码：旧版把明文密码写入本地存储，属于必须修掉的安全问题。
 */
// 「记住账号」只记登录账号，不记密码，降低凭据泄露风险。
const KEY_REMEMBERED_ACCOUNT: string = 'auth_remembered_account'

/**
 * 读取访问令牌。
 *
 * @return 访问令牌，未登录时返回空字符串
 */
export function getAccessToken(): string {
	// 从本地存储取值；键不存在时平台返回 any 类型，需要显式判空。
	const value = uni.getStorageSync(KEY_ACCESS_TOKEN)
	// 从未登录过时读不到值，统一按空字符串处理，调用方无需再判空。
	if (value == null) {
		return ''
	}
	// 平台返回的是 any，必须显式断言为 string 才能安全使用。
	return value as string
}

/**
 * 读取刷新令牌。
 *
 * @return 刷新令牌，未登录时返回空字符串
 */
export function getRefreshToken(): string {
	// 从本地存储取值；未登录时返回 null。
	const value = uni.getStorageSync(KEY_REFRESH_TOKEN)
	// 无值时返回空字符串，调用方据此判断是否需要续期。
	if (value == null) {
		return ''
	}
	// 显式断言为 string，避免任何类型直接参与字符串运算。
	return value as string
}

/**
 * 保存双令牌。
 *
 * @param accessToken 访问令牌
 * @param refreshToken 刷新令牌
 */
export function saveTokens(accessToken: string, refreshToken: string): void {
	// 写入访问令牌，供后续业务请求注入 Authorization 头。
	uni.setStorageSync(KEY_ACCESS_TOKEN, accessToken)
	// 写入刷新令牌，供访问令牌过期时换取新令牌。
	uni.setStorageSync(KEY_REFRESH_TOKEN, refreshToken)
}

/**
 * 清除登录凭据，保留「记住账号」。
 */
export function clearTokens(): void {
	// 移除访问令牌，使本地立即进入未登录状态。
	uni.removeStorageSync(KEY_ACCESS_TOKEN)
	// 移除刷新令牌，避免登出后仍可用旧凭据续期。
	uni.removeStorageSync(KEY_REFRESH_TOKEN)
}

/**
 * 读取上次记住的登录账号。
 *
 * @return 记住的登录账号，无记录时返回空字符串
 */
export function getRememberedAccount(): string {
	// 从本地存储读取上次记住的登录账号。
	const value = uni.getStorageSync(KEY_REMEMBERED_ACCOUNT)
	// 没有记录时返回空字符串，登录页据此跳过回填。
	if (value == null) {
		return ''
	}
	// 显式断言为 string，保证可直接用于输入框绑定。
	return value as string
}

/**
 * 记住登录账号，供下次登录回填。
 *
 * @param username 登录账号
 */
export function setRememberedAccount(username: string): void {
	// 仅写入登录账号，不写入密码。
	uni.setStorageSync(KEY_REMEMBERED_ACCOUNT, username)
}

/**
 * 清除已记住的登录账号。
 */
export function clearRememberedAccount(): void {
	// 用户取消「记住账号」时删除记录，下次登录不再自动回填。
	uni.removeStorageSync(KEY_REMEMBERED_ACCOUNT)
}
