/**
 * 学生端协议文本与版本信息。
 *
 * 隐私政策和用户协议目前不依赖后端接口，文本随 App 一起发布：这样做可以保证
 * 离线也能查看，也避免协议内容被未授权的接口随意改写。协议更新时必须同时修改
 * 本文件的版本号与更新日期，页面会直接展示这两个字段，便于用户确认自己看到的
 * 是哪个版本。
 *
 * 页面只负责渲染，不在页面内散落文案；需要调整条款时统一改这里，避免两份页面
 * 出现版本不一致。
 */

/**
 * 协议中的一个章节：标题加若干段正文。
 */
export type LegalSection = {
	title: string;
	paragraphs: Array<string>;
};

/**
 * 一份完整协议：标识、标题、版本、更新日期、导语和章节列表。
 */
export type LegalDocument = {
	key: string;
	title: string;
	version: string;
	updatedAt: string;
	intro: string;
	sections: Array<LegalSection>;
};

/**
 * 当前协议版本号。修改任何条款时同步递增，并在“关于”页展示。
 */
export const LEGAL_VERSION = 'v1.0';

/**
 * 当前协议更新日期，格式为 YYYY-MM-DD，与版本号一起展示。
 */
export const LEGAL_UPDATED_AT = '2026-11-23';

/**
 * 学生端展示的应用名称。
 */
export const APP_DISPLAY_NAME = '湖北经济学院校园食堂点餐系统';

/**
 * 服务提供方，协议落款与关于页共同使用。
 */
export const SERVICE_PROVIDER = '湖北经济学院食堂管理中心';

/**
 * 隐私政策章节。
 *
 * 内容按系统实际收集的信息编写：账号、订单与资产、互动内容、设备日志以及
 * 相册/相机权限。未接入第三方广告或统计 SDK，因此不写“广告合作伙伴”之类
 * 不存在的共享场景。
 */
const privacySections: Array<LegalSection> = [
	{
		title: '一、引言',
		paragraphs: [
			'本政策说明湖北经济学院校园食堂点餐系统（以下简称“本系统”）在学生使用点餐、支付、取餐及相关服务时，如何收集、使用、存储和保护个人信息。',
			'本系统面向校内学生提供食堂点餐服务，服务提供方为湖北经济学院食堂管理中心。请在使用前认真阅读本政策；如不同意本政策，请停止使用相关功能。'
		]
	},
	{
		title: '二、我们收集的信息',
		paragraphs: [
			'账号信息：注册或使用过程中提供的昵称、邮箱，系统生成的用户号、角色、头像以及邮箱验证状态。登录密码仅以不可逆的加密哈希形式保存，系统不保存明文密码。',
			'交易与资产信息：订单内容、金额、下单与取餐状态、取餐码、账户余额、充值记录、消费记录、优惠券、退款记录及售后处理信息。',
			'互动内容：你发布的评价、收藏的店铺与菜品、与商家或管理人员的聊天消息、提交的反馈工单及随附图片。',
			'设备与日志信息：为保障账号与系统安全、排查故障，服务器会记录访问时间、接口路径、错误信息，以及用于登录限流与安全防护的网络地址等运行日志；提交反馈时，客户端可能附带设备品牌、型号、系统版本与 App 版本，用于定位问题。',
			'本机信息：登录令牌、记住的账号、搜索历史、页面草稿等保存在本机；支付密码和登录密码不会保存在本机。',
			'权限使用：仅在需要时申请相册或相机权限，用于选择或拍摄头像、评价和反馈图片；申请相册写入权限用于保存图片。拒绝授权不影响浏览菜品、下单等基础功能。'
		]
	},
	{
		title: '三、信息使用目的',
		paragraphs: [
			'提供账号登录、下单、余额支付、取餐核销、退款、评价、收藏、优惠券、消息通知与反馈处理等服务。',
			'进行安全防护，包括登录保护、失败次数限制、异常请求识别、会话失效与故障排查。',
			'改进服务体验、统计服务运行情况。本系统不会将个人信息用于与校园餐饮服务无关的商业广告。',
			'履行学校管理要求及法律法规规定的义务。'
		]
	},
	{
		title: '四、信息存储',
		paragraphs: [
			'个人信息存储于本系统部署的服务器（校园或项目指定环境），存储期限为账号存续期间及完成本政策所述目的所必需的期限。',
			'超出期限或账号注销后，除法律法规、学校管理或争议处理要求保留的信息外，我们将删除或匿名化处理。'
		]
	},
	{
		title: '五、信息共享、转让与公开披露',
		paragraphs: [
			'我们不会出售你的个人信息。',
			'为发送邮箱验证码，需要将邮箱地址提供给邮件发送服务；除此之外，未经你同意，不向校外第三方共享、转让或公开披露个人信息。',
			'校园内部按角色和授权数据范围访问必要信息，例如食堂管理人员处理订单、退款、评价与反馈；访问受角色与数据范围控制，关键管理操作会留存审计记录。'
		]
	},
	{
		title: '六、你的权利',
		paragraphs: [
			'查询与更正：可在“我的-个人资料”查看和修改昵称、头像。',
			'账号安全：可在“账号与安全”修改登录密码、设置支付密码、通过邮箱找回密码或更换邮箱。',
			'删除与撤回：可删除收藏等自主管理的内容；部分订单、交易和反馈记录因结算、审计或争议处理需要，需在法定期限后删除。',
			'注销账号：当前未开放自助注销。可通过“我的-帮助与反馈”提交申请，由食堂管理中心核验身份并处理；注销前需妥善处理余额、未完成订单、退款、评价等事项。'
		]
	},
	{
		title: '七、未成年人保护',
		paragraphs: [
			'本系统面向在校学生。未满十八周岁的学生应在监护人指导下使用本系统；如监护人认为存在未经授权使用的情况，可通过反馈渠道联系我们处理。'
		]
	},
	{
		title: '八、信息安全',
		paragraphs: [
			'我们采取密码哈希存储、访问权限控制、会话失效、失败次数限制、日志审计等措施保护个人信息。',
			'请妥善保管账号、密码和验证码，不要向他人透露；发现账号异常时，请立即修改密码并通过反馈渠道联系。',
			'如发生个人信息安全事件，我们将按法律法规要求进行处置和告知。'
		]
	},
	{
		title: '九、政策更新',
		paragraphs: [
			'我们可能根据服务或法规变化更新本政策。更新后的政策会在本页面展示版本号和更新日期；涉及重大权益变化的，我们会通过站内通知或页面提示告知。',
			'继续使用服务表示你接受更新后的政策；如不同意，请停止使用相关功能。'
		]
	},
	{
		title: '十、联系我们',
		paragraphs: [
			'如对本政策有疑问、意见或投诉，可通过“我的-帮助与反馈”提交工单，或联系湖北经济学院食堂管理中心。我们会在合理期限内处理并回复。'
		]
	}
];

/**
 * 用户协议章节。
 *
 * 条款围绕系统实际提供的服务编写，不引入当前不存在的第三方支付、配送等功能；
 * 涉及退款、取餐、评价等规则时，以页面展示和食堂管理规则为准。
 */
const termsSections: Array<LegalSection> = [
	{
		title: '一、协议范围与接受',
		paragraphs: [
			'本协议是你与湖北经济学院食堂管理中心之间关于使用校园食堂点餐系统学生端的约定。',
			'你注册、登录或使用本系统，即表示已阅读并同意本协议；如不同意，请停止使用。'
		]
	},
	{
		title: '二、服务内容',
		paragraphs: [
			'本系统提供食堂菜品浏览、下单、余额支付与充值、取餐核销、订单查询、退款申请、评价、收藏、优惠券、消息通知和问题反馈等功能。',
			'服务时间、可售菜品、价格与库存以食堂实际营业情况和页面展示为准；系统维护、升级或食堂营业调整可能暂停部分服务。'
		]
	},
	{
		title: '三、账号注册与使用',
		paragraphs: [
			'你应使用真实、有效的邮箱完成注册与验证，并及时更新联系方式。',
			'账号仅限本人使用，不得转让、出借或出售；因保管不善导致的损失由账号持有人承担。',
			'发现账号被盗用或存在异常时，应立即修改密码并通过反馈渠道联系我们。'
		]
	},
	{
		title: '四、使用规范',
		paragraphs: [
			'不得利用本系统从事违法违规活动，不得攻击、入侵、干扰系统运行，不得使用自动化程序恶意刷单、抢购或爬取数据。',
			'不得发布虚假、侮辱、诽谤、侵权或其他不当内容；不得恶意评价、恶意退款或虚构交易。',
			'违反上述规范的，我们可视情况采取提醒、限制功能、暂停或停用账号等措施，并保留依法追究责任的权利。'
		]
	},
	{
		title: '五、订单、支付与退款',
		paragraphs: [
			'下单前请核对菜品、数量、金额、取餐窗口与时间；订单提交后按页面展示的规则处理。',
			'账户余额为校内餐饮消费余额，充值、支付与退款按页面规则和食堂管理要求执行；支付密码用于余额支付确认，请勿泄露。',
			'因菜品售罄、系统异常或食堂调整导致订单无法履行的，我们将按规则取消订单并退回相应款项。',
			'退款申请需经审核，审核结果通过订单页面和消息通知告知；已核销或超过规定时限的订单可能无法退款。'
		]
	},
	{
		title: '六、取餐与核销',
		paragraphs: [
			'请按订单提示的时间和窗口取餐，取餐码仅限本人使用，不得转借。',
			'逾期未取的订单按食堂管理规则处理；因个人原因造成的损失由用户承担。'
		]
	},
	{
		title: '七、评价与反馈',
		paragraphs: [
			'评价应基于真实消费体验，内容应客观、合法。如需更正或删除已发布内容，可通过“我的-帮助与反馈”提交申请。',
			'我们可对违规评价进行处理；反馈工单的处理进度与结果通过消息通知告知。'
		]
	},
	{
		title: '八、知识产权',
		paragraphs: [
			'本系统的界面设计、文字、图标、程序等知识产权归学校或项目权利人所有，未经许可不得复制、修改、传播或用于商业用途。',
			'你发布的内容应确保拥有相应权利；为提供服务之目的，你授权本系统在必要范围内展示、存储和处理该内容。'
		]
	},
	{
		title: '九、服务变更、中断与终止',
		paragraphs: [
			'我们可能因维护、升级、食堂营业调整、不可抗力或安全原因中断或变更服务，并尽可能提前告知。',
			'你可随时停止使用本系统；如存在违规行为、账号被停用或你申请注销，我们将按规则终止服务。'
		]
	},
	{
		title: '十、责任限制',
		paragraphs: [
			'我们将尽力保障服务稳定与数据安全，但因网络故障、设备故障、不可抗力、第三方服务异常或用户自身原因造成的损失，按法律规定和公平原则处理。',
			'本系统属于校园内部餐饮服务工具，不构成任何形式的商业担保。'
		]
	},
	{
		title: '十一、协议更新与争议解决',
		paragraphs: [
			'我们可能更新本协议，更新后在本页面展示版本号与更新日期；重大变更将通过站内通知或页面提示告知。',
			'因本协议产生的争议，双方应友好协商解决；协商不成的，依照中华人民共和国法律及学校相关管理规定处理。'
		]
	},
	{
		title: '十二、联系我们',
		paragraphs: [
			'如对本协议有疑问，可通过“我的-帮助与反馈”提交工单，或联系湖北经济学院食堂管理中心。'
