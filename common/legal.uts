];

/**
 * 隐私政策完整文档。
 */
export const PRIVACY_DOCUMENT: LegalDocument = {
	key: 'privacy',
	title: '隐私政策',
	version: LEGAL_VERSION,
	updatedAt: LEGAL_UPDATED_AT,
	intro: '我们重视你的个人信息保护。本政策说明在提供校园食堂点餐服务时，我们收集哪些信息、如何使用与保护这些信息，以及你可以行使的权利。',
	sections: privacySections
};

/**
 * 用户协议完整文档。
 */
export const TERMS_DOCUMENT: LegalDocument = {
	key: 'terms',
	title: '用户协议',
	version: LEGAL_VERSION,
	updatedAt: LEGAL_UPDATED_AT,
	intro: '本协议约定你使用校园食堂点餐系统学生端的权利与义务，请在注册和使用前仔细阅读。',
	sections: termsSections
};

/**
 * 按页面参数取协议文档。
 *
 * 未识别或缺失的参数一律回退到隐私政策，避免页面空白；参数只接受 'terms'
 * 和 'privacy' 两种值，不接受任意文本。
 *
 * @param key 页面传入的协议类型
 * @return 对应协议文档
 */
export function legalDocument(key: string): LegalDocument {
	return key == 'terms' ? TERMS_DOCUMENT : PRIVACY_DOCUMENT;
}
